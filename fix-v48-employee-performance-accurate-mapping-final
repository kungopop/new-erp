TS="$(date +%Y%m%d_%H%M%S)"
BACKUP_DIR="$ROOT/backups/FIX_V48_EMPLOYEE_MAPPING_BEFORE_$TS"
mkdir -p "$BACKUP_DIR/files"

cat <<EOF
============================================================
🔧 Roshdy V48: Accurate Employee/Extension Mapping
📦 Backup: $BACKUP_DIR
🛡️ report_api.py / Elastix / CDR / AMI untouched
============================================================
EOF

for f in "$EMP_API" "$EMP_HTML" "$EMP_SCRIPT"; do
  [[ -e "$f" ]] && cp -a "$f" "$BACKUP_DIR/files/$(basename "$f").before" || true
done

echo "🧩 Step 1: Append accurate session-mapping builder override"
python3 - <<'PYPATCH'
