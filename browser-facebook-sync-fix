def _line_filter(lines):
    ignore_contains = ['Inbox','Respond to messages','All messages','Messenger','Instagram','WhatsApp','Facebook comments','Search','Unread','Priority','Ad replies','Follow up','Connect to Instagram','Not now','Connect','View profile','Contact details','Add details','Facebook profile','Activity','Create order','Reply in Messenger','Automations','Available','Manage','Assign this conversation','Learn more','Public info','Local time','Works at','Studied at','Lives in','From ','Recommended','Add a personalized message','Try it','Order status']
    out=[]
    for x in lines:
        t=' '.join(str(x or '').split()).strip()
        if not t or len(t) < 2 or len(t) > 600:
            continue
        if any(bad.lower() in t.lower() for bad in ignore_contains):
            continue
        has_ar = any('\u0600' <= ch <= '\u06ff' for ch in t)
        if has_ar or len(t) >= 12:
            out.append(t)
    seen=set(); ded=[]
    for t in out:
        if t not in seen:
            seen.add(t); ded.append(t)
    return ded[:30]


async def _active_snapshot(channel='Facebook'):
    ctx = await ensure_browser()
    page = ctx.pages[0] if ctx.pages else await ctx.new_page()
    title = await page.title()
    url = page.url
    try:
        data = await page.evaluate("""() => {
            const lines = (document.body.innerText || '').split('\n').map(x => x.trim()).filter(Boolean);
            let profile = '';
            for (const a of Array.from(document.querySelectorAll('a'))) {
                const tx = (a.innerText || '').trim();
                const href = a.href || '';
                if ((tx.toLowerCase().includes('view profile') || href.includes('facebook.com') || href.includes('instagram.com')) && href && !profile) profile = href;
            }
            return {lines, profile};
        }""")
        lines = data.get('lines') or []
        profile_url = data.get('profile') or ''
    except Exception:
        try:
            txt = await page.locator('body').inner_text(timeout=5000)
            lines = [x.strip() for x in txt.split('\n') if x.strip()]
            profile_url = ''
        except Exception:
            lines = []
            profile_url = ''
    customer_name = ''
    for i, l in enumerate(lines):
        if l.strip().lower() == 'view profile' and i > 0:
            customer_name = lines[i-1].strip(); break
    if not customer_name:
        for i, l in enumerate(lines):
            if 'Assign this conversation' in l and i > 0:
                customer_name = lines[i-1].strip(); break
    if not customer_name:
        for l in lines:
            if 2 <= len(l.split()) <= 4 and len(l) <= 80 and not any(x in l for x in ['Inbox','Messenger','Instagram','WhatsApp','Search','Manage']):
                customer_name = l; break
    if not customer_name:
        customer_name = 'Unknown Browser Contact'
    filtered = _line_filter(lines)
    bodies = [x for x in filtered if x != customer_name]
    arabic = [x for x in bodies if any('\u0600' <= ch <= '\u06ff' for ch in x)]
    if arabic:
        bodies = arabic
    messages=[]
    now = datetime.utcnow().isoformat()
    for b in bodies[:20]:
        mid = hashlib.sha256((channel+'|'+customer_name+'|'+b).encode('utf-8','ignore')).hexdigest()
        messages.append({'id': mid, 'direction': 'inbound', 'sender_name': customer_name, 'body': b, 'created_time': now, 'message_type': 'text'})
    external_chat_id = profile_url or hashlib.sha256((channel+'|'+customer_name).encode()).hexdigest()[:18]
    return {'success': True, 'channel_type': channel, 'url': url, 'title': title, 'customer_name': customer_name, 'profile_url': profile_url, 'external_chat_id': external_chat_id, 'messages': messages, 'raw_lines_sample': lines[:120]}


@app.get('/api/fb/active-snapshot')
async def fb_active_snapshot(channel: str = 'Facebook'):
    return await _active_snapshot(channel)


@app.get('/api/fb/sync-active-to-erp')
async def fb_sync_active_to_erp(channel: str = 'Facebook'):
    import urllib.request, urllib.error
    snap = await _active_snapshot(channel)
    if not ERP_INGEST_URL:
        return {'success': False, 'message': 'ERP_INGEST_URL missing', 'snapshot': snap}
    body = json.dumps(snap, ensure_ascii=False).encode('utf-8')
    req = urllib.request.Request(ERP_INGEST_URL, data=body, method='POST', headers={'Content-Type':'application/json', 'X-Roshdy-Connector-Secret': BROWSER_CONNECTOR_SECRET})
    try:
        with urllib.request.urlopen(req, timeout=20) as resp:
            txt = resp.read().decode('utf-8','replace')
            try:
                data = json.loads(txt)
            except Exception:
                data = {'raw': txt}
            return {'success': True, 'snapshot': snap, 'erp_response': data}
    except urllib.error.HTTPError as e:
        txt = e.read().decode('utf-8','replace')
        return {'success': False, 'http_status': e.code, 'error': txt, 'snapshot': snap}
    except Exception as e:
        return {'success': False, 'message': str(e), 'snapshot': snap}
