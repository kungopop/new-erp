ask INSTALL_BROWSER_CONNECTOR "تثبيت Browser Connector التجريبي للفيس/انستا؟ 1 نعم / 0 لا" "$INSTALL_BROWSER_CONNECTOR"

RECORDING_BASE="http://${PBX_IP}/monitor/"

cat <<SUMMARY

==================== SUMMARY ====================
