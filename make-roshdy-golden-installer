read -r -p "نكمل التثبيت؟ اكتب YES: " OK
[[ "$OK" == "YES" ]] || { echo "Cancelled"; exit 1; }

WORK="/tmp/roshdy_install_payload_$(date +%Y%m%d_%H%M%S)"
mkdir -p "$WORK"
PAYLOAD_LINE=$(awk '/^__ROSHDY_GOLDEN_PAYLOAD_BELOW__$/ {print NR + 1; exit 0;}' "$0")
if [[ -z "${PAYLOAD_LINE:-}" ]]; then err "Payload marker not found"; exit 1; fi
tail -n +"$PAYLOAD_LINE" "$0" | base64 -d | tar -xzf - -C "$WORK"

auto_remove_nextcloud(){
  step "[0] Removing Nextcloud if found"
  if snap list 2>/dev/null | awk '{print $1}' | grep -qx nextcloud; then
    warn "Nextcloud snap found; removing"
    snap remove nextcloud || true
  fi
  mapfile -t NC_CONTAINERS < <(docker ps -a --format '{{.Names}}' 2>/dev/null | grep -Ei 'nextcloud' || true)
  if [[ "${#NC_CONTAINERS[@]}" -gt 0 ]]; then
    warn "Nextcloud docker containers found: ${NC_CONTAINERS[*]}"
    docker rm -f "${NC_CONTAINERS[@]}" || true
  fi
}

install_prereqs(){
  step "[1] Installing host prerequisites + Docker"
  apt-get update -y
  apt-get install -y ca-certificates curl gnupg lsb-release git unzip jq python3 python3-pip mariadb-client openssl
  if ! command -v docker >/dev/null 2>&1; then
    curl -fsSL https://get.docker.com | sh
  fi
  systemctl enable --now docker
  if ! docker compose version >/dev/null 2>&1; then
    apt-get install -y docker-compose-plugin
  fi
  log "Docker ready: $(docker --version) | $(docker compose version)"
}

