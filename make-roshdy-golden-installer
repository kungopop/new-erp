  docker exec "$BACKEND" bench --site "$SITE_NAME" set-config asterisk_db_name "$CDR_DB"
  docker exec "$BACKEND" bench --site "$SITE_NAME" set-config asterisk_db_user "$CDR_USER"
  docker exec "$BACKEND" bench --site "$SITE_NAME" set-config asterisk_db_password "$CDR_PASS"
  docker exec "$BACKEND" bench --site "$SITE_NAME" set-config asterisk_ami_port "5038"
  docker exec "$BACKEND" bench --site "$SITE_NAME" set-config asterisk_ami_user "$AMI_USER"
  docker exec "$BACKEND" bench --site "$SITE_NAME" set-config asterisk_ami_secret "$AMI_SECRET"
  docker exec "$BACKEND" bench --site "$SITE_NAME" set-config asterisk_recording_web_base "$RECORDING_BASE"
  docker exec "$BACKEND" bench --site "$SITE_NAME" set-config queue_orders "$ORDER_QUEUE"
  docker exec "$BACKEND" bench --site "$SITE_NAME" set-config queue_complaints "$COMPLAINT_QUEUE"
  docker exec "$BACKEND" bench --site "$SITE_NAME" execute restaurant_ops.scripts.golden_post_install.run --kwargs "{\"place_name\":\"$PLACE_NAME\",\"admin_email\":\"$DEFAULT_ADMIN_EMAIL\",\"admin_username\":\"$DEFAULT_ADMIN_USER\",\"admin_password\":\"$DEFAULT_ADMIN_PASSWORD\",\"sip_from\":\"$SIP_FROM\",\"sip_to\":\"$SIP_TO\"}"

  # Patch common hardcoded old IP only; queue IDs are stored in site_config and current app usually defaults to 123/1234.
  if [[ "$PBX_IP" != "10.11.1.253" ]]; then
    python3 - <<PY2
from pathlib import Path
root=Path('$INSTALL_DIR/apps/restaurant_ops')
for p in root.rglob('*'):
    if p.is_file() and p.suffix in ('.py','.html','.js','.json'):
        try: s=p.read_text()
        except Exception: continue
        ns=s.replace('10.11.1.253','$PBX_IP')
        if ns!=s: p.write_text(ns)
PY2
  fi
  docker exec "$BACKEND" bash -lc "find /home/frappe/frappe-bench/apps/restaurant_ops -name '*.pyc' -delete; find /home/frappe/frappe-bench/apps/restaurant_ops -name '__pycache__' -type d -exec rm -rf {} + 2>/dev/null || true"
  docker exec "$BACKEND" bench --site "$SITE_NAME" migrate
}

install_gowa(){
  [[ "$INSTALL_GOWA" == "1" ]] || return 0
  step "[9] Installing GOWA WhatsApp Web bridge"
  GROOT="/opt/roshdy_social_bridge/gowa-poc"
  mkdir -p "$GROOT/gowa/storages" "$GROOT/gowa/statics" "$GROOT/collector/data"
  cat > "$GROOT/.env" <<EOF
GOWA_IMAGE=aldinokemal2104/go-whatsapp-web-multidevice:v8.11.0
GOWA_BIND=0.0.0.0
GOWA_PORT=33030
COLLECTOR_PORT=33031
GOWA_USER=$GOWA_USER
GOWA_PASS=$GOWA_PASS
APP_BASIC_AUTH=$GOWA_USER:$GOWA_PASS
WHATSAPP_WEBHOOK_SECRET=$(openssl rand -hex 24)
EOF
  chmod 600 "$GROOT/.env"
  cat > "$GROOT/docker-compose.yml" <<'YAML'
name: roshdy_social_poc
services:
  webhook_collector:
    image: python:3.12-alpine
    container_name: roshdy-social-webhook
    restart: unless-stopped
    working_dir: /app
    command: ["python", "-u", "/app/collector.py"]
    environment:
      WEBHOOK_SECRET: "${WHATSAPP_WEBHOOK_SECRET}"
      LOG_FILE: "/data/webhook_events.jsonl"
    volumes:
      - ./collector/collector.py:/app/collector.py:ro
      - ./collector/data:/data
    ports:
      - "127.0.0.1:${COLLECTOR_PORT:-33031}:9001"
  gowa:
    image: "${GOWA_IMAGE}"
    container_name: roshdy-gowa
    restart: unless-stopped
    depends_on: [webhook_collector]
    ports:
      - "${GOWA_BIND:-0.0.0.0}:${GOWA_PORT:-33030}:3000"
    environment:
      APP_HOST: "0.0.0.0"
      APP_PORT: "3000"
      APP_OS: "Roshdy Social Bridge"
      APP_BASIC_AUTH: "${APP_BASIC_AUTH}"
      DB_URI: "file:storages/whatsapp.db?_foreign_keys=on"
      DB_KEYS_URI: "file:storages/whatsapp-keys.db?_foreign_keys=on"
      WHATSAPP_WEBHOOK: "http://webhook_collector:9001/webhook,http://frappe_crm-frontend-1:8080/api/method/restaurant_ops.api.social_inbox_api.webhook"
      WHATSAPP_WEBHOOK_SECRET: "${WHATSAPP_WEBHOOK_SECRET}"
      WHATSAPP_WEBHOOK_EVENTS: "message,message.reaction,message.revoked,message.edited,message.ack,message.deleted,chat_presence,call.offer"
      WHATSAPP_AUTO_MARK_READ: "false"
      WHATSAPP_AUTO_DOWNLOAD_MEDIA: "true"
      WHATSAPP_AUTO_REJECT_CALL: "false"
      WHATSAPP_PRESENCE_ON_CONNECT: "unavailable"
    volumes:
      - ./gowa/storages:/app/storages
      - ./gowa/statics:/app/statics
YAML
  cat > "$GROOT/collector/collector.py" <<'PY'
import json, os, time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
LOG_FILE=os.environ.get('LOG_FILE','/data/webhook_events.jsonl')
os.makedirs(os.path.dirname(LOG_FILE), exist_ok=True)
class H(BaseHTTPRequestHandler):
    def _j(self,c,d):
        b=json.dumps(d,ensure_ascii=False).encode(); self.send_response(c); self.send_header('Content-Type','application/json'); self.send_header('Content-Length',str(len(b))); self.end_headers(); self.wfile.write(b)
    def do_GET(self): self._j(200, {'success':True,'service':'collector','time':time.time()})
    def do_POST(self):
        n=int(self.headers.get('Content-Length','0') or '0'); body=self.rfile.read(n)
        try: data=json.loads(body.decode() or '{}')
        except Exception: data={'raw':body.decode(errors='replace')}
        with open(LOG_FILE,'a',encoding='utf-8') as f: f.write(json.dumps({'received_at':time.strftime('%F %T'),'payload':data},ensure_ascii=False)+'\n')
        self._j(200, {'success':True})
ThreadingHTTPServer(('0.0.0.0',9001),H).serve_forever()
PY
  (cd "$GROOT" && docker compose up -d)
  log "GOWA ready: http://$SERVER_IP:33030 | $GOWA_USER / $GOWA_PASS"
}

