#!/usr/bin/env bash
set -Eeuo pipefail

# make-roshdy-golden-installer
# Run this on the CURRENT stable Roshdy server.
# It captures the current restaurant_ops app and generates a self-contained installer:
#   /opt/ROSHDY_GOLDEN_INSTALLER_YYYYMMDD_HHMMSS.run
# Copy that .run file to a fresh Ubuntu server and run it as root.

CURRENT_ROOT="${CURRENT_ROOT:-/opt/frappe_crm}"
CURRENT_APP="$CURRENT_ROOT/apps/restaurant_ops"
TS="$(date +%Y%m%d_%H%M%S)"
WORK="/opt/roshdy_golden_build_$TS"
OUT="/opt/ROSHDY_GOLDEN_INSTALLER_$TS.run"
SHA="$OUT.sha256"

say(){ echo -e "\n============================================================\n$1\n============================================================"; }

if [[ "${EUID:-$(id -u)}" -ne 0 ]]; then
  echo "❌ شغّل كـ root على السيرفر الحالي: sudo -i ثم ./make-roshdy-golden-installer"
  exit 1
fi

say "1) فحص السيرفر الحالي وتجهيز Payload"
if [[ ! -d "$CURRENT_APP" ]]; then
  echo "❌ لم أجد التطبيق الحالي: $CURRENT_APP"
  exit 1
fi
mkdir -p "$WORK/payload"

# Capture current custom app exactly as it is now.
tar --exclude='__pycache__' --exclude='*.pyc' --exclude='.git' --exclude='.pytest_cache' --exclude='.mypy_cache' \
  -czf "$WORK/payload/restaurant_ops.tar.gz" -C "$CURRENT_ROOT/apps" restaurant_ops

# Optional current references for debugging only.
[[ -f "$CURRENT_ROOT/docker-compose.yml" ]] && cp -a "$CURRENT_ROOT/docker-compose.yml" "$WORK/payload/docker-compose.current.yml" || true
[[ -f "/opt/roshdy_social_bridge/gowa-poc/docker-compose.yml" ]] && mkdir -p "$WORK/payload/gowa" && cp -a "/opt/roshdy_social_bridge/gowa-poc/docker-compose.yml" "$WORK/payload/gowa/docker-compose.current.yml" || true

cat > "$WORK/central_elastix_commands_template.txt" <<'TXT'
ROSHDY / ERPNext — Elastix/Asterisk side commands template
=========================================================
Run these on the PBX/Elastix server as root. Replace values with what the installer prints.

1) MySQL CDR read-only user:
----------------------------
mysql -uroot -p

CREATE USER IF NOT EXISTS 'ERP_CDR_USER'@'ERP_SERVER_IP' IDENTIFIED BY 'ERP_CDR_PASSWORD';
GRANT SELECT ON asteriskcdrdb.* TO 'ERP_CDR_USER'@'ERP_SERVER_IP';
FLUSH PRIVILEGES;

-- Quick test from ERP server:
mysql -h PBX_IP -u ERP_CDR_USER -pERP_CDR_PASSWORD asteriskcdrdb -e "select count(*) from cdr;"

2) AMI user:
------------
Add to /etc/asterisk/manager_custom.conf or /etc/asterisk/manager.conf depending on Elastix version:

[ERP_AMI_USER]
secret=ERP_AMI_SECRET
deny=0.0.0.0/0.0.0.0
permit=ERP_SERVER_IP/255.255.255.255
read=system,call,log,verbose,command,agent,user,config,dtmf,reporting,cdr,dialplan,originate
write=system,call,command,agent,user,originate

Then reload:
asterisk -rx "manager reload"
asterisk -rx "manager show users"

3) Firewall examples:
---------------------
# iptables example:
iptables -I INPUT -p tcp -s ERP_SERVER_IP --dport 3306 -j ACCEPT
iptables -I INPUT -p tcp -s ERP_SERVER_IP --dport 5038 -j ACCEPT
service iptables save || true

# firewalld example:
firewall-cmd --permanent --add-rich-rule='rule family="ipv4" source address="ERP_SERVER_IP" port protocol="tcp" port="3306" accept'
firewall-cmd --permanent --add-rich-rule='rule family="ipv4" source address="ERP_SERVER_IP" port protocol="tcp" port="5038" accept'
firewall-cmd --reload
TXT

say "2) كتابة Installer self-contained"
cat > "$OUT" <<'INSTALLER'
