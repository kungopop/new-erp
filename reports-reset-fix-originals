        html.append("</table>")
    if int(st.get('show_sales',1)):
        html.append("<h3>المبيعات</h3><table border='1' cellspacing='0' cellpadding='6'><tr><th>الموظف</th><th>عمليات</th><th>كمية</th></tr>")
        for x in sales.get('by_agent',[]): html.append(f"<tr><td>{x['employee_name']}</td><td>{x['orders']}</td><td>{x['quantity']}</td></tr>")
        html.append("</table>")
    if st.get('footer_text'): html.append(f"<p>{st.get('footer_text')}</p>")
