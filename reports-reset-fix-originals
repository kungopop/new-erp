import csv
import io
import json
import math
import re
from datetime import datetime, time, timedelta

import frappe
from frappe.utils import getdate, now_datetime

REPORT_ROLES = {"System Manager", "Call Center Admin", "Break Admin", "HR Manager", "HR User", "Sales Manager", "Sales User"}


def _roles():
    try:
        return set(frappe.get_roles(frappe.session.user))
    except Exception:
        return set()


def _allowed():
    return frappe.session.user == "Administrator" or bool(_roles() & REPORT_ROLES)


def _system_only():
    return frappe.session.user == "Administrator" or "System Manager" in _roles()


def _deny():
    return {"success": False, "message": "Permission denied"}


def _safe_date(v, default=None):
    try:
        return getdate(v) if v else (default or getdate())
    except Exception:
        return default or getdate()


def _safe_time(v, default="00:00"):
    v = str(v or default).strip()
    m = re.match(r"^(\d{1,2}):(\d{2})$", v)
    if not m:
        v = default; m = re.match(r"^(\d{1,2}):(\d{2})$", v)
    return time(max(0,min(23,int(m.group(1)))), max(0,min(59,int(m.group(2)))))


def _period(date_from=None, date_to=None, start_time="00:00", end_time="23:59"):
    df = _safe_date(date_from, getdate())
    dt = _safe_date(date_to, df)
    start_dt = datetime.combine(df, _safe_time(start_time,"00:00"))
    end_dt = datetime.combine(dt, _safe_time(end_time,"23:59"))
    if end_dt <= start_dt:
        end_dt += timedelta(days=1)
    return start_dt, end_dt


def _dtstr(x):
    return x.strftime("%Y-%m-%d %H:%M:%S") if hasattr(x,'strftime') else str(x or "")


def _csv(rows):
    if not rows:
        return ""
    out=io.StringIO(); keys=list(rows[0].keys()); w=csv.DictWriter(out, fieldnames=keys); w.writeheader()
    for r in rows: w.writerow({k:r.get(k,"") for k in keys})
    return out.getvalue()


def _fmt(sec):
    sec=int(sec or 0); return f"{sec//3600:02d}:{(sec%3600)//60:02d}:{sec%60:02d}"


@frappe.whitelist(allow_guest=False)
def list_employees(search=""):
    if not _allowed(): return _deny()
    rows=frappe.get_all("Employee", filters={"status":"Active"}, fields=["name","employee_name","user_id","status"], order_by="employee_name asc", limit_page_length=1000)
    if search:
        q=str(search).lower(); rows=[r for r in rows if q in str(r.employee_name or '').lower() or q in str(r.user_id or '').lower() or q in str(r.name or '').lower()]
    return {"success": True, "employees": rows}


@frappe.whitelist(allow_guest=False)
def get_break_report(date_from=None, date_to=None, start_time="00:00", end_time="23:59", employee="", status="All"):
    if not _allowed(): return _deny()
    start_dt,end_dt=_period(date_from,date_to,start_time,end_time)
    where=["b.start_time >= %s", "b.start_time <= %s"]; vals=[start_dt,end_dt]
    if employee: where.append("b.employee=%s"); vals.append(employee)
    if status and status!='All': where.append("b.status=%s"); vals.append(status)
    sql=f"""
        SELECT b.name,b.employee,e.employee_name,e.user_id,b.break_type,b.status,b.break_date,b.start_time,b.end_time,
               b.duration_seconds,b.duration_minutes,b.extension_at_start,b.extension_was_online,b.closed_by,b.closure_type,b.notes
        FROM `tabEmployee Break Log` b
        LEFT JOIN `tabEmployee` e ON b.employee=e.name
        WHERE {' AND '.join(where)} ORDER BY b.start_time DESC
    """
    rows=frappe.db.sql(sql, vals, as_dict=True)
    now=now_datetime()
    for r in rows:
        if (not r.get('duration_seconds')) and r.get('start_time'):
            end=r.get('end_time') or now
            try: r['duration_seconds']=int((end-r.get('start_time')).total_seconds())
            except Exception: pass
        r['duration_minutes_calc']=round(float(r.get('duration_seconds') or 0)/60,2)
        r['start_time_text']=_dtstr(r.get('start_time')); r['end_time_text']=_dtstr(r.get('end_time'))
    by_emp={}; by_type={}
    for r in rows:
        emp=r.get('employee_name') or r.get('employee') or 'غير محدد'; typ=r.get('break_type') or 'غير محدد'; sec=int(r.get('duration_seconds') or 0)
        by_emp.setdefault(emp, {'employee_name':emp,'count':0,'seconds':0,'minutes':0,'total_formatted':'00:00:00'})
        by_emp[emp]['count']+=1; by_emp[emp]['seconds']+=sec; by_emp[emp]['minutes']=round(by_emp[emp]['seconds']/60,2); by_emp[emp]['total_formatted']=_fmt(by_emp[emp]['seconds'])
        by_type.setdefault(typ, {'break_type':typ,'count':0,'seconds':0,'minutes':0,'total_formatted':'00:00:00'})
        by_type[typ]['count']+=1; by_type[typ]['seconds']+=sec; by_type[typ]['minutes']=round(by_type[typ]['seconds']/60,2); by_type[typ]['total_formatted']=_fmt(by_type[typ]['seconds'])
    total_sec=sum(int(r.get('duration_seconds') or 0) for r in rows)
    return {"success":True,"period":{"start":_dtstr(start_dt),"end":_dtstr(end_dt)},"summary":{"total_breaks":len(rows),"total_seconds":total_sec,"total_minutes":round(total_sec/60,2),"total_formatted":_fmt(total_sec)},"by_employee":list(by_emp.values()),"by_type":list(by_type.values()),"rows":rows,"csv":_csv(rows)}


@frappe.whitelist(allow_guest=False)
def get_sales_report(date_from=None, date_to=None, start_time="00:00", end_time="23:59", agent="", item=""):
    if not _allowed(): return _deny()
    start_dt,end_dt=_period(date_from,date_to,start_time,end_time)
    where=["s.sale_date >= %s", "s.sale_date <= %s"]; vals=[start_dt,end_dt]
    if agent: where.append("s.agent=%s"); vals.append(agent)
    if item: where.append("(s.item=%s or i.item_name like %s)"); vals += [item, '%'+item+'%']
    sql=f"""
        SELECT s.name,s.agent,e.employee_name,s.sale_date,s.item,COALESCE(i.item_name,s.item) item_name,COALESCE(i.item_category,i.category,'') item_category,
               s.quantity,s.customer_name,s.customer_phone,s.notes,s.owner,s.creation
        FROM `tabSales Entry` s
        LEFT JOIN `tabSales Item` i ON s.item=i.name
        LEFT JOIN `tabEmployee` e ON s.agent=e.user_id
        WHERE {' AND '.join(where)} ORDER BY s.sale_date DESC,s.creation DESC
    """
    rows=frappe.db.sql(sql, vals, as_dict=True)
    for r in rows: r['quantity']=int(r.get('quantity') or 0); r['sale_date_text']=_dtstr(r.get('sale_date'))
    by_agent={}; by_item={}
    for r in rows:
        ag=r.get('employee_name') or r.get('agent') or 'غير محدد'; it=r.get('item_name') or r.get('item') or 'غير محدد'; qty=int(r.get('quantity') or 0)
        by_agent.setdefault(ag, {'agent':r.get('agent'),'employee_name':ag,'orders':0,'quantity':0}); by_agent[ag]['orders']+=1; by_agent[ag]['quantity']+=qty
        by_item.setdefault(it, {'item_name':it,'orders':0,'quantity':0}); by_item[it]['orders']+=1; by_item[it]['quantity']+=qty
    return {"success":True,"period":{"start":_dtstr(start_dt),"end":_dtstr(end_dt)},"summary":{"total_operations":len(rows),"total_quantity":sum(int(r.get('quantity') or 0) for r in rows),"unique_agents":len(by_agent),"unique_items":len(by_item)},"by_agent":list(by_agent.values()),"by_item":list(by_item.values()),"rows":rows,"csv":_csv(rows)}


@frappe.whitelist(allow_guest=False)
def get_owner_call_summary(date_from=None, date_to=None, start_time="00:00", end_time="23:59"):
    if not _allowed(): return _deny()
    start_dt,end_dt=_period(date_from,date_to,start_time,end_time)
    try: orders_q=str(frappe.conf.get('queue_orders') or '1234'); complaints_q=str(frappe.conf.get('queue_complaints') or '123')
    except Exception: orders_q, complaints_q='1234','123'
    q_in=','.join(["'%s'"%re.sub(r'[^0-9A-Za-z_-]','',q) for q in [orders_q,complaints_q]])
    start=_dtstr(start_dt); end=_dtstr(end_dt)
    from restaurant_ops.api.asterisk_bridge import query_asterisk_cdr_with_error
    qc=f"((lastapp='Queue' AND dst IN ({q_in})) OR (dcontext='ext-queues' AND dst IN ({q_in})))"
    sql=f"""
      SELECT COUNT(*) raw_total,
      SUM(CASE WHEN {qc} THEN 1 ELSE 0 END) queue_total,
      SUM(CASE WHEN {qc} AND disposition='ANSWERED' THEN 1 ELSE 0 END) queue_answered,
      SUM(CASE WHEN {qc} AND disposition!='ANSWERED' THEN 1 ELSE 0 END) queue_not_answered,
      SUM(CASE WHEN NOT ({qc}) THEN 1 ELSE 0 END) before_queue_or_technical,
      SUM(CASE WHEN disposition='BUSY' THEN 1 ELSE 0 END) busy,
      SUM(CASE WHEN disposition in ('NO ANSWER','FAILED') AND duration < 15 THEN 1 ELSE 0 END) short_abandon,
      SUM(CASE WHEN disposition in ('NO ANSWER','FAILED') AND duration >= 15 THEN 1 ELSE 0 END) staff_missed_raw,
      ROUND(AVG(duration),2) avg_duration,
      ROUND(AVG(CASE WHEN {qc} THEN duration ELSE NULL END),2) avg_queue_duration
      FROM cdr WHERE calldate BETWEEN '{start}' AND '{end}'
    """
    rows,err=query_asterisk_cdr_with_error(sql); row=rows[0] if rows else {}
    def i(k): return int(row.get(k) or 0)
    summary={k:i(k) for k in ['raw_total','queue_total','queue_answered','queue_not_answered','before_queue_or_technical','busy','short_abandon','staff_missed_raw']}
    summary['avg_duration']=float(row.get('avg_duration') or 0); summary['avg_queue_duration']=float(row.get('avg_queue_duration') or 0)
    rt=max(1,summary['raw_total']); qt=max(1,summary['queue_total']); summary['answer_rate_of_queue']=round(summary['queue_answered']*100/qt,2); summary['queue_reach_rate_of_all']=round(summary['queue_total']*100/rt,2)
    explanation=[
      {'label':'كل أحداث الاتصال داخل السنترال','count':summary['raw_total'],'note':'رقم تقني يشمل IVR والتحويلات وأحداث داخلية، وليس عدد عملاء حقيقيين بالضرورة.'},
      {'label':'مكالمات وصلت للطوابير الرسمية','count':summary['queue_total'],'note':'المكالمات التي دخلت Queue الأوردرات/الشكاوى فعلياً.'},
      {'label':'تم الرد داخل الطابور','count':summary['queue_answered'],'note':'مكالمات Queue التي رد عليها موظف.'},
      {'label':'لم يتم الرد داخل الطابور','count':summary['queue_not_answered'],'note':'مكالمات دخلت الطابور ولم تنتهِ برد.'},
      {'label':'قبل الطابور / IVR / أحداث تقنية','count':summary['before_queue_or_technical'],'note':'قد تشمل عميل سمع رسالة وقفل أو اختار من IVR وقفل أو أحداث متعددة لنفس الاتصال.'},
      {'label':'مشغول/مرفوض تقني','count':summary['busy'],'note':'أحداث CDR بحالة BUSY.'},
    ]
    return {"success":True,"period":{"start":start,"end":end},"queues":{"orders":orders_q,"complaints":complaints_q},"summary":summary,"explanation":explanation,"error":err}


# Email customizer settings stored in DefaultValue to avoid new DocType complexity.
@frappe.whitelist(allow_guest=False)
def get_email_customizer_settings():
    if not _system_only(): return _deny()
    raw=frappe.db.get_default('roshdy_email_customizer_v3') or '{}'
    try: data=json.loads(raw)
    except Exception: data={}
    defaults={"service_manager_title":"مدير إدارة خدمة العملاء","shift_start":"00:00","shift_end":"23:59","place_name":frappe.conf.get('restaurant_place_name') or 'مطعم رشدي',"show_calls":1,"show_breaks":1,"show_sales":1,"show_complaints":1,"show_staff_missed":1,"intro_text":"","footer_text":""}
    defaults.update(data)
    return {"success":True,"settings":defaults}


@frappe.whitelist(allow_guest=False)
def save_email_customizer_settings(settings_json=None, **kwargs):
    if not _system_only(): return _deny()
    data={}
    if settings_json:
        try: data.update(json.loads(settings_json))
        except Exception: pass
    data.update(kwargs)
    frappe.db.set_default('roshdy_email_customizer_v3', json.dumps(data, ensure_ascii=False))
    frappe.db.commit()
    return {"success":True,"settings":data}


@frappe.whitelist(allow_guest=False)
def preview_enhanced_service_email(date_from=None, date_to=None, shift_start=None, shift_end=None):
