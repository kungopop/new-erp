# 1) Remove wrong/new pages: /break-report, /sales-dashboard, /email-customizer and Social Inbox UI pages.
# 2) Stop/archive GOWA + Browser Connector PoC because Social Inbox is not used now.
# 3) Fix ORIGINAL /break-admin page with real backend data.
# 4) Fix ORIGINAL /sales-report page with dashboard + CSV + print/PDF.
# 5) Patch email_report.py with a real hidden customizer /email-report-customizer whose settings affect previews and sends.
# 6) Validate all backend endpoints and pages + Elastix/CDR health.
# Does NOT touch report_api.py core call report.

ROOT="/opt/frappe_crm"
SITE="crm.local"
APP_HOST="$ROOT/apps/restaurant_ops"
APP_DIR="$APP_HOST/restaurant_ops"
API_DIR="$APP_DIR/api"
WWW_DIR="$APP_DIR/www"
TS="$(date +%Y%m%d_%H%M%S)"
BACKUP_DIR="$ROOT/backups/REPORTS_RESET_FIX_ORIGINALS_BEFORE_$TS"

say(){ echo -e "\n============================================================\n$1\n============================================================"; }

if [[ "${EUID:-$(id -u)}" -ne 0 ]]; then
  echo "❌ شغّل كـ root: sudo -i ثم ./reports-reset-fix-originals"
  exit 1
fi

say "1) Backup كامل قبل تنظيف التقارير والسوشيال"
cd "$ROOT"
BACKEND="$(docker compose ps -q backend || true)"
if [[ -z "$BACKEND" ]]; then
  echo "❌ لم أجد backend container. شغّل: cd /opt/frappe_crm && docker compose up -d"
  exit 1
fi
mkdir -p "$BACKUP_DIR"
cp -a "$APP_HOST" "$BACKUP_DIR/restaurant_ops"
[[ -f "$ROOT/docker-compose.yml" ]] && cp -a "$ROOT/docker-compose.yml" "$BACKUP_DIR/docker-compose.yml"
[[ -d "/opt/roshdy_social_bridge" ]] && cp -a "/opt/roshdy_social_bridge" "$BACKUP_DIR/roshdy_social_bridge" || true
[[ -d "/opt/roshdy_browser_connector" ]] && cp -a "/opt/roshdy_browser_connector" "$BACKUP_DIR/roshdy_browser_connector" || true
echo "✅ Backup: $BACKUP_DIR"

say "2) حذف الصفحات الجديدة/الغلط وإخفاء Social Inbox بالكامل"
mkdir -p "$BACKUP_DIR/removed_pages"
for f in \
  break-report.py break-report.html \
  sales-dashboard.py sales-dashboard.html \
  email-customizer.py email-customizer.html \
  social-inbox.py social-inbox.html \
  social-settings.py social-settings.html \
  social-retention-settings.py social-retention-settings.html \
  social-meta-settings.py social-meta-settings.html \
  browser-connectors.py browser-connectors.html; do
  if [[ -f "$WWW_DIR/$f" ]]; then
    cp -a "$WWW_DIR/$f" "$BACKUP_DIR/removed_pages/$f"
    rm -f "$WWW_DIR/$f"
    echo "removed $f"
  fi
done

# Stop and archive experimental social connectors if present.
if [[ -d "/opt/roshdy_social_bridge/gowa-poc" ]]; then
  (cd /opt/roshdy_social_bridge/gowa-poc && docker compose down) || true
  mkdir -p "$BACKUP_DIR/removed_integrations"
  mv /opt/roshdy_social_bridge/gowa-poc "$BACKUP_DIR/removed_integrations/gowa-poc" || true
  echo "archived/removed GOWA PoC"
fi
if [[ -d "/opt/roshdy_browser_connector" ]]; then
  (cd /opt/roshdy_browser_connector && docker compose down) || true
  mkdir -p "$BACKUP_DIR/removed_integrations"
  mv /opt/roshdy_browser_connector "$BACKUP_DIR/removed_integrations/roshdy_browser_connector" || true
  echo "archived/removed Browser Connector PoC"
fi

