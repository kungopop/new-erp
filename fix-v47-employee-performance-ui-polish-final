#!/usr/bin/env bash
set -Eeuo pipefail

# Roshdy V47 - Employee Performance UI polish only
# Fixes wording + Arabic labels + modal popups for all detail buttons.
# Safety: does NOT touch report_api.py, Elastix, CDR, AMI, queue_log, or watchdog scripts.

ROOT="${ROOT:-/opt/frappe_crm}"
SITE="${SITE:-crm.local}"
APP="restaurant_ops"

cd "$ROOT"

if docker compose version >/dev/null 2>&1; then
  COMPOSE=(docker compose)
else
  COMPOSE=(docker-compose)
fi

BACKEND="$(${COMPOSE[@]} ps -q backend || true)"
if [[ -z "$BACKEND" ]]; then
  echo "❌ backend مش شغال"
  exit 1
fi
bench_exec(){ "${COMPOSE[@]}" exec -T backend bench --site "$SITE" "$@"; }

APP_DIR="$ROOT/apps/$APP"
WWW_DIR="$APP_DIR/$APP/www"
EMP_HTML="$WWW_DIR/employee-performance.html"
EMP_PY="$WWW_DIR/employee-performance.py"
TS="$(date +%Y%m%d_%H%M%S)"
BACKUP_DIR="$ROOT/backups/FIX_V47_EMPLOYEE_PERF_UI_BEFORE_$TS"
mkdir -p "$BACKUP_DIR/files"

cat <<EOF
============================================================
🎨 Roshdy V47: Employee Performance UI Polish
📦 Backup: $BACKUP_DIR
🛡️ report_api.py / Elastix / CDR / AMI untouched
============================================================
EOF

for f in "$EMP_HTML" "$EMP_PY"; do
  [[ -e "$f" ]] && cp -a "$f" "$BACKUP_DIR/files/$(basename "$f").before" || true
done

echo "🧩 Step 1: Rewrite /employee-performance UI text + modal details"
