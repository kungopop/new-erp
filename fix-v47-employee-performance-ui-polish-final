function esc(s){return String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function sec(s){s=Number(s||0); if(s<60)return Math.round(s)+'ث'; let m=Math.floor(s/60), r=Math.round(s%60); if(m<60)return m+'د '+(r?r+'ث':''); let h=Math.floor(m/60); m=m%60; return h+'س '+m+'د'}
function qs(o){let p=new URLSearchParams();Object.keys(o||{}).forEach(k=>{let v=o[k];if(v!==undefined&&v!==null&&v!=='')p.append(k,v)});return p.toString()}
async function api(m,args){let r=await fetch('/api/method/'+m+(args?'?'+qs(args):''),{credentials:'same-origin',cache:'no-store'});let j=await r.json();if(j.exc)throw j;return j.message||j}
async function guard(){let d=await api('restaurant_ops.api.security_api.get_my_access'); if(!d||!d.is_admin){location.replace((d&&d.redirect_target)||'/agent-desk');return false}return true}
