function renderEmployees(){let rows=DATA.employees||[]; empRows.innerHTML=rows.map((e,i)=>'<tr><td><b>'+esc(e.employee||'')+'</b></td><td class="ltr">'+esc(e.extension||'')+'</td><td>'+esc(e.answered_calls||0)+'</td><td>'+esc(e.orders_calls||0)+'</td><td>'+esc(e.complaints_calls||0)+'</td><td>'+esc(e.morning_calls||0)+'</td><td>'+esc(e.evening_calls||0)+'</td><td>'+sec(e.avg_wait_seconds)+'</td><td>'+sec(e.wait_min)+'</td><td>'+sec(e.wait_max)+'</td><td>'+sec(e.avg_talk_seconds)+'</td><td>'+sec(e.talk_max)+'</td><td class="'+((e.ringnoanswer||0)>0?'danger':'ok')+'">'+esc(e.ringnoanswer||0)+'</td><td>'+presenceText(e)+'</td><td><button class="btn" onclick="showEmp('+i+')">تفاصيل</button><button class="btn orange" onclick="showLongest('+i+')">أطول مكالمة</button><button class="btn gray" onclick="showRandom('+i+')">مكالمة عشوائية</button></td></tr>').join('')||'<tr><td colspan="15" class="empty">لا توجد بيانات</td></tr>'}
function callsTable(rows){return '<div class="scroll"><table class="tbl"><thead><tr><th>الوقت</th><th>النوع</th><th>الرقم الموحد</th><th>الرقم الخام</th><th>سرعة الرد</th><th>مدة المكالمة</th><th>الشيفت</th><th>التسجيل</th></tr></thead><tbody>'+(rows||[]).map(callRow).join('')+'</tbody></table></div>'}
function callRow(c){let rec=c.recording_url?'<a href="'+esc(c.recording_url)+'" target="_blank">🎧 سماع</a>':'-';return '<tr><td>'+esc(c.enter_time)+'</td><td>'+esc(c.queue_label||c.queue)+'</td><td class="ltr">'+esc(c.caller)+'</td><td>'+esc(c.caller_raw||'')+'</td><td>'+sec(c.wait_seconds)+'</td><td>'+sec(c.talk_seconds)+'</td><td>'+esc(c.shift)+'</td><td>'+rec+'</td></tr>'}
function showEmp(i){let e=(DATA.employees||[])[i]||{}; let html='<div class="note"><b>'+esc(e.employee)+'</b> — تحويلة '+esc(e.extension)+'<br>إجمالي الردود: '+esc(e.answered_calls||0)+' | محاولات رن بدون رد: '+esc(e.ringnoanswer||0)+'</div><br>'+callsTable(e.calls||[]); openModal('تفاصيل مكالمات الموظف',html)}
