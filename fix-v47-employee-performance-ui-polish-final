async function init(){if(!await guard())return; let av=await api('restaurant_ops.api.employee_performance_api.get_available_dates'); dateSel.innerHTML=(av.dates||[]).map(d=>'<option value="'+esc(d)+'">'+esc(d)+'</option>').join(''); if(!(av.dates||[]).length){msg.textContent='لا توجد تقارير محفوظة حتى الآن';return} await load();}
async function load(){msg.textContent='جاري التحميل...'; DATA=await api('restaurant_ops.api.employee_performance_api.get_dashboard',{target_date:dateSel.value}); if(!DATA.success){msg.textContent=DATA.message||'لا توجد بيانات';return} let s=DATA.summary||{}; msg.textContent='آخر تحديث للتقرير: '+(DATA.generated_at||''); cEmployees.textContent=s.employees_count||0; cAnswered.textContent=s.answered_calls||0; cAvgWait.textContent=sec(s.avg_wait_seconds); cSlowest.textContent=sec((s.slowest_answer||{}).wait_seconds); cNew.textContent=s.new_customers||0; cRing.textContent=s.ringnoanswer_attempts||0; cMorning.textContent=((s.morning||{}).peak_online_extensions ?? (s.morning||{}).active_extensions_estimated ?? 0); cEvening.textContent=((s.evening||{}).peak_online_extensions ?? (s.evening||{}).active_extensions_estimated ?? 0); cMorningHint.textContent=(s.morning&&s.morning.peak_online_extensions!=null)?'من قراءات التواجد':'تقدير من نشاط المكالمات'; cEveningHint.textContent=(s.evening&&s.evening.peak_online_extensions!=null)?'من قراءات التواجد':'تقدير من نشاط المكالمات'; renderEmployees();}
