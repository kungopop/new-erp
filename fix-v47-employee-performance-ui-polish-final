function showRandom(i){let e=(DATA.employees||[])[i]||{}; let a=e.calls||[]; if(!a.length){openModal('مكالمة عشوائية','<div class="empty">لا توجد مكالمات لهذا الموظف</div>');return} let c=a[Math.floor(Math.random()*a.length)]; openModal('مكالمة عشوائية — '+(e.employee||''),callsTable([c]))}
function showNewCustomers(){if(!DATA){return} let rows=DATA.new_customers||[]; let html='<div class="note">الأرقام هنا موحدة، والعميل يظهر كجديد فقط إذا لم يكن له مكالمات مجابة قبل هذا اليوم التشغيلي.</div><br>'; html += rows.length ? callsTable(rows) : '<div class="empty">لا يوجد عملاء جدد مؤكدين في هذا التقرير</div>'; openModal('العملاء الجدد المؤكدين',html)}
function exportCsv(){if(!DATA)return; let h=['employee','extension','answered','orders','complaints','morning','evening','avg_wait','max_wait','avg_talk','no_answer_ring','new_customers']; let lines=[h.join(',')].concat((DATA.employees||[]).map(e=>[e.employee,e.extension,e.answered_calls,e.orders_calls,e.complaints_calls,e.morning_calls,e.evening_calls,e.avg_wait_seconds,e.wait_max,e.avg_talk_seconds,e.ringnoanswer,e.new_customers].map(x=>'"'+String(x??'').replace(/"/g,'""')+'"').join(','))); let blob=new Blob(['\ufeff'+lines.join('\n')],{type:'text/csv;charset=utf-8'}); let a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='employee-performance-'+(DATA.target_date||'')+'.csv';a.click()}
