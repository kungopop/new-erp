#!/usr/bin/env bash
set -Eeuo pipefail

# fix-quality-desk-form-save
# Explains/fixes the current issue in Frappe Desk form:
# - The screenshot is /app/call-center-complaint (Frappe Desk), not the custom /quality-desk modal.
# - We add a dedicated Desk custom button "حفظ مراجعة الجودة" that calls the safe API directly.
# - We also clean Quality permissions and re-apply only permlevel 0/1 (no level 2 row).
# - This makes Desk usable without relying on Frappe's normal Save validation.
# - Does NOT touch Call Report/CDR/Elastix logic except health checks.

ROOT="/opt/frappe_crm"
SITE="crm.local"
APP_HOST="$ROOT/apps/restaurant_ops"
APP_DIR="$APP_HOST/restaurant_ops"
DOCTYPE_JS="$APP_DIR/restaurant_operations/doctype/call_center_complaint/call_center_complaint.js"
TS="$(date +%Y%m%d_%H%M%S)"
BACKUP_DIR="$ROOT/backups/FIX_QUALITY_DESK_FORM_SAVE_BEFORE_$TS"

say(){ echo -e "\n============================================================\n$1\n============================================================"; }

if [[ "${EUID:-$(id -u)}" -ne 0 ]]; then
  echo "❌ شغّل كـ root: sudo -i ثم ./fix-quality-desk-form-save"
  exit 1
fi

say "1) Backup قبل إصلاح حفظ الجودة من Frappe Desk"
cd "$ROOT"
BACKEND="$(docker compose ps -q backend || true)"
if [[ -z "$BACKEND" ]]; then
  echo "❌ لم أجد backend container. شغّل: cd /opt/frappe_crm && docker compose up -d"
  exit 1
fi
mkdir -p "$BACKUP_DIR"
cp -a "$APP_HOST" "$BACKUP_DIR/restaurant_ops"
[[ -f "$ROOT/docker-compose.yml" ]] && cp -a "$ROOT/docker-compose.yml" "$BACKUP_DIR/docker-compose.yml"
echo "✅ Backup: $BACKUP_DIR"

say "2) تنظيف وإصلاح permissions مباشرة"
mkdir -p "$APP_DIR/scripts" "$APP_DIR/api" "$(dirname "$DOCTYPE_JS")"
cat > "$APP_DIR/scripts/fix_quality_desk_form_perms.py" <<'PY'
import frappe


def ensure_role(role):
    if not frappe.db.exists('Role', role):
        frappe.get_doc({'doctype':'Role','role_name':role,'desk_access':1}).insert(ignore_permissions=True)
    else:
        doc=frappe.get_doc('Role', role)
        if not doc.desk_access:
            doc.desk_access=1
            doc.save(ignore_permissions=True)


def append_perm(doc, role, permlevel, read=0, write=0, create=0, delete=0, report=0, export=0, select=0, print_=0):
    doc.append('permissions', {
        'role': role,
        'permlevel': int(permlevel),
        'select': int(select),
        'read': int(read),
        'write': int(write),
        'create': int(create),
        'delete': int(delete),
        'submit': 0,
        'cancel': 0,
        'amend': 0,
        'report': int(report),
        'export': int(export),
        'import': 0,
        'share': 0,
        'print': int(print_ or read),
        'email': 0,
    })


def run():
    ensure_role('Complaint_Quality_User')
    dt='Call Center Complaint'
    if frappe.db.exists('DocType', dt):
        # Hard remove any old/bad quality rows first, including invalid permlevel 2 zero row.
        frappe.db.sql('delete from `tabDocPerm` where parent=%s and role=%s', (dt, 'Complaint_Quality_User'))
        frappe.db.commit()
        doc=frappe.get_doc('DocType', dt)
        doc.permissions=[p for p in doc.permissions if p.role!='Complaint_Quality_User']
        append_perm(doc, 'Complaint_Quality_User', 0, select=1, read=1, write=1, create=0, delete=0, report=1, export=1, print_=1)
        append_perm(doc, 'Complaint_Quality_User', 1, select=1, read=1, write=1, create=0, delete=0, report=1, export=1, print_=1)
        # No permlevel 2 for quality.
        doc.save(ignore_permissions=True)
        frappe.clear_cache(doctype=dt)
    # Ensure all quality users are real desk users.
    users=frappe.get_all('Has Role', filters={'role':'Complaint_Quality_User','parenttype':'User'}, pluck='parent')
    for u in users:
        if u in ('Administrator','Guest'):
            continue
        try:
            usr=frappe.get_doc('User', u)
            usr.enabled=1
            usr.user_type='System User'
            usr.save(ignore_permissions=True)
            if not frappe.db.exists('Has Role', {'parent':u,'parenttype':'User','role':'Desk User'}):
                usr.add_roles('Desk User')
        except Exception as e:
            print('user skip', u, e)
    frappe.db.commit()
    return {'success': True}
PY
chmod 644 "$APP_DIR/scripts/fix_quality_desk_form_perms.py"

say "3) API override آمن للحفظ المباشر"
cat >> "$APP_DIR/api/quality_api.py" <<'PY'

# ===== ROSHDY QUALITY DESK FORM SAVE FINAL START =====
def _qdesk_roles():
    try:
        return set(frappe.get_roles(frappe.session.user))
    except Exception:
        return set()


def _qdesk_allowed():
    user = frappe.session.user
    return user == 'Administrator' or bool(_qdesk_roles() & {'Complaint_Quality_User', 'Call Center Admin', 'System Manager'})


def _qdesk_meta_fields():
    try:
        return {df.fieldname for df in frappe.get_meta('Call Center Complaint').fields}
    except Exception:
        return set()


def _qdesk_status(status):
    s = str(status or '').strip()
    mapping = {
        'مسودة': 'Draft', 'Draft': 'Draft',
        'مفتوح': 'Open', 'مفتوحة': 'Open', 'Open': 'Open',
        'قيد المراجعة': 'Under Review', 'قيد مراجعه': 'Under Review', 'Under Review': 'Under Review',
        'تم الحل': 'Resolved', 'محلولة': 'Resolved', 'Resolved': 'Resolved',
        'مغلق': 'Closed', 'مغلقة': 'Closed', 'Closed': 'Closed',
    }
    return mapping.get(s, s if s in {'Draft','Open','Under Review','Resolved','Closed'} else 'Under Review')


@frappe.whitelist(allow_guest=False)
def update_quality_review(name, assigned_quality_inspector=None, investigation_analysis='', corrective_action='', status='', closing_notes=''):
    """Final safe update for Quality fields, usable from custom page and Frappe Desk button."""
    if not _qdesk_allowed():
        return {'success': False, 'message': 'Permission denied'}
    if not name or not frappe.db.exists('Call Center Complaint', name):
        return {'success': False, 'message': 'Complaint not found'}
    meta = _qdesk_meta_fields()
    values = {}
    if 'assigned_quality_inspector' in meta:
        values['assigned_quality_inspector'] = assigned_quality_inspector or frappe.session.user
    if 'investigation_analysis' in meta:
        values['investigation_analysis'] = investigation_analysis or ''
    if 'corrective_action' in meta:
        values['corrective_action'] = corrective_action or ''
    if 'closing_notes' in meta:
        values['closing_notes'] = closing_notes or ''
    st = _qdesk_status(status)
    if 'status' in meta:
        values['status'] = st
        if st in {'Resolved', 'Closed'}:
            if 'resolved_by' in meta:
                values['resolved_by'] = frappe.session.user
            if 'resolved_at' in meta:
                values['resolved_at'] = now_datetime()
    frappe.db.set_value('Call Center Complaint', name, values, update_modified=True)
    frappe.db.commit()
    out = frappe.db.get_value('Call Center Complaint', name, ['name','status','assigned_quality_inspector','investigation_analysis','corrective_action','closing_notes'], as_dict=True)
    return {'success': True, 'message': 'تم حفظ مراجعة الجودة', 'name': name, 'updated': values, 'complaint': out, 'status': out.get('status') if out else st}
# ===== ROSHDY QUALITY DESK FORM SAVE FINAL END =====
PY
chmod 644 "$APP_DIR/api/quality_api.py"

say "4) إضافة زر حفظ جودة داخل Frappe Desk نفسه"
cat >> "$DOCTYPE_JS" <<'JS'

// ===== ROSHDY QUALITY DESK FORM SAVE BUTTON START =====
(function(){
  function has_quality_role(){
    const roles = frappe.user_roles || [];
    return roles.includes('Complaint_Quality_User') || roles.includes('Call Center Admin') || roles.includes('System Manager') || roles.includes('Administrator');
  }
  function norm_status(s){
    s = String(s || '').trim();
    const map = {
      'مسودة':'Draft', 'Draft':'Draft',
      'مفتوح':'Open', 'مفتوحة':'Open', 'Open':'Open',
      'قيد المراجعة':'Under Review', 'قيد مراجعه':'Under Review', 'Under Review':'Under Review',
      'تم الحل':'Resolved', 'محلولة':'Resolved', 'Resolved':'Resolved',
      'مغلق':'Closed', 'مغلقة':'Closed', 'Closed':'Closed'
    };
    return map[s] || s || 'Under Review';
  }
  frappe.ui.form.on('Call Center Complaint', {
    refresh: function(frm){
      if(!has_quality_role() || frm.is_new()) return;
      ['assigned_quality_inspector','investigation_analysis','corrective_action','status','closing_notes'].forEach(function(f){
        if(frm.fields_dict[f]) frm.set_df_property(f, 'read_only', 0);
      });
      frm.add_custom_button(__('حفظ مراجعة الجودة'), function(){
        frappe.call({
          method: 'restaurant_ops.api.quality_api.update_quality_review',
          args: {
            name: frm.doc.name,
            assigned_quality_inspector: frm.doc.assigned_quality_inspector || frappe.session.user,
            investigation_analysis: frm.doc.investigation_analysis || '',
            corrective_action: frm.doc.corrective_action || '',
            status: norm_status(frm.doc.status || 'Under Review'),
            closing_notes: frm.doc.closing_notes || ''
          },
          freeze: true,
          freeze_message: __('جاري حفظ مراجعة الجودة...'),
          callback: function(r){
            if(r && r.message && r.message.success){
              frappe.show_alert({message: __('تم حفظ مراجعة الجودة بنجاح'), indicator: 'green'});
              frm.reload_doc();
            } else {
              frappe.msgprint((r && r.message && r.message.message) || __('فشل حفظ مراجعة الجودة'));
              console.log('Quality save response', r);
            }
          },
          error: function(r){
            frappe.msgprint(__('حصل خطأ أثناء حفظ مراجعة الجودة. افتح Console أو ابعتلي الخطأ.'));
            console.error(r);
          }
        });
      }).addClass('btn-primary');
      frm.add_custom_button(__('فتح Quality Desk'), function(){
        window.open('/quality-desk', '_blank');
      });
    },
    before_save: function(frm){
      if(frm.doc.status) frm.set_value('status', norm_status(frm.doc.status));
    }
  });
})();
// ===== ROSHDY QUALITY DESK FORM SAVE BUTTON END =====
JS
chmod 644 "$DOCTYPE_JS"

say "5) تنفيذ + build + restart"
docker exec "$BACKEND" bash -lc "find /home/frappe/frappe-bench/apps/restaurant_ops -name '*.pyc' -delete; find /home/frappe/frappe-bench/apps/restaurant_ops -name '__pycache__' -type d -exec rm -rf {} + 2>/dev/null || true"
docker exec "$BACKEND" bench --site "$SITE" execute restaurant_ops.scripts.fix_quality_desk_form_perms.run
docker exec "$BACKEND" bench --site "$SITE" migrate
# Build to ensure DocType JS is refreshed for Desk.
docker exec "$BACKEND" bench build --app restaurant_ops || true
docker exec "$BACKEND" bench --site "$SITE" clear-cache || true
docker exec "$BACKEND" bench --site "$SITE" clear-website-cache || true
docker compose restart backend frontend websocket queue-short queue-long scheduler
sleep 12
BACKEND="$(docker compose ps -q backend)"

say "6) Validation"
echo "--- API smoke ---"
docker exec "$BACKEND" bench --site "$SITE" execute frappe.get_attr --args '["restaurant_ops.api.quality_api.update_quality_review"]' >/dev/null && echo "update_quality_review OK" || true

echo "--- permissions check ---"
docker exec "$BACKEND" bench --site "$SITE" execute frappe.db.sql --args '["select role, permlevel, `select`, `read`, `write`, `create`, `delete`, report, export from `tabDocPerm` where parent=\"Call Center Complaint\" and role=\"Complaint_Quality_User\" order by permlevel"]' || true

echo "--- bad level 2 check ---"
docker exec "$BACKEND" bench --site "$SITE" execute frappe.db.sql --args '["select name, role, permlevel from `tabDocPerm` where parent=\"Call Center Complaint\" and role=\"Complaint_Quality_User\" and permlevel=2"]' || true

echo "--- Page HTTP status ---"
for page in quality-desk quality-complaint app/call-center-complaint call-report admin-desk; do
  code="$(curl -s -o /dev/null -w '%{http_code}' "http://127.0.0.1/$page" || true)"
  echo "$page => $code"
done

say "7) Health Check مهم: Elastix/CDR/AMI + Queue + Call Report"
echo "--- Asterisk/Elastix diagnostics ---"
docker exec "$BACKEND" bench --site "$SITE" execute restaurant_ops.api.asterisk_bridge.run_full_system_diagnostics || true

echo "--- Queue status ---"
docker exec "$BACKEND" bench --site "$SITE" execute restaurant_ops.api.queue_api.get_queue_status || true

echo "--- Calls report admin sample ---"
docker exec "$BACKEND" bench --site "$SITE" execute restaurant_ops.api.report_api.get_calls_report --kwargs '{"page":1,"page_size":5,"view_mode":"admin"}' || true

say "✅ Quality Desk/Form Save fixed يا زعيم"
echo "افتح الشكوى في Desk واعمل Ctrl+F5. هتلاقي زر أزرق: حفظ مراجعة الجودة. استخدمه بدل Save العادي لو Save بتاع Frappe متعب."
echo "Backup: $BACKUP_DIR"
