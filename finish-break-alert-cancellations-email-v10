#!/usr/bin/env bash
set -Eeuo pipefail

# Roshdy V10 Finish:
# 1) Employee full-screen alert when admin ends a break (agent-desk polling + backend ack).
# 2) Full page for cancellation report: /order-cancellations-report
# 3) Branch dropdown from real system branches for cancellations.
# 4) Link cancellation report page from the rebuilt /admin-desk.
# 5) Validate cancellations are included in Upper Management email preview.
# Safety: backup first; does NOT touch report_api.py / Elastix / CDR / AMI config.

ROOT="${ROOT:-/opt/frappe_crm}"
SITE="${SITE:-crm.local}"
APP="restaurant_ops"

cd "$ROOT"

if docker compose version >/dev/null 2>&1; then
  COMPOSE=(docker compose)
elif command -v docker-compose >/dev/null 2>&1; then
  COMPOSE=(docker-compose)
else
  echo "❌ docker compose/docker-compose مش موجود"
  exit 1
fi

APP_DIR="$ROOT/apps/$APP"
PKG_DIR="$APP_DIR/$APP"
WWW_DIR="$PKG_DIR/www"
API_DIR="$PKG_DIR/api"
ADMIN_HTML="$WWW_DIR/admin-desk.html"
AGENT_HTML="$WWW_DIR/agent-desk.html"
BREAK_API="$API_DIR/break_api.py"
UPPER_API="$API_DIR/upper_management_email_api.py"
CANCEL_HTML="$WWW_DIR/order-cancellations-report.html"
CANCEL_PY="$WWW_DIR/order-cancellations-report.py"
TS="$(date +%Y%m%d_%H%M%S)"
BACKUP_DIR="$ROOT/backups/FINISH_BREAK_ALERT_CANCEL_EMAIL_V10_BEFORE_$TS"
mkdir -p "$BACKUP_DIR"

BACKEND="$(${COMPOSE[@]} ps -q backend || true)"
if [[ -z "$BACKEND" ]]; then
  echo "❌ backend container مش شغال أو مش لاقيه"
  exit 1
fi

bench_exec() {
  "${COMPOSE[@]}" exec -T backend bench --site "$SITE" "$@"
}

echo "============================================================"
echo "✅ Roshdy V10 Finish: Break alert + cancellations page + email verify"
echo "📦 Backup: $BACKUP_DIR"
echo "============================================================"

echo "🧯 Backup files + bench backup"
for f in "$ADMIN_HTML" "$AGENT_HTML" "$BREAK_API" "$UPPER_API" "$CANCEL_HTML" "$CANCEL_PY"; do
  [[ -f "$f" ]] && cp -a "$f" "$BACKUP_DIR/$(basename "$f").before"
done
bench_exec backup --with-files | tee "$BACKUP_DIR/bench_backup_output.txt"

echo "🧩 Patch backend APIs"
export BREAK_API UPPER_API
python3 - <<'PY'
