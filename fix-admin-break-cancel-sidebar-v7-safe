#!/usr/bin/env bash
set -Eeuo pipefail

# Roshdy Admin UI / Breaks / Cancellations V7 Safe Fix
# Fixes:
# - Admin bell should open notifications, not navigate to HR Ops.
# - Extra break/bell floating collisions are removed.
# - Cancellations are visible as cards/panel and save directly to backend.
# - Right sidebar can collapse/show and works better on smaller screens.
# - Break-admin active breaks panel uses robust backend active-break logic and shows End action.
# - Active break counters are computed from server, not browser clock.
# - Upper report employee missed logic remains strict: only explicit staff_missed/employee_missed, not generic busy/declined.
# Safety:
# - Backup first.
# - Wrap injected HTML/CSS/JS in Jinja raw to avoid 417.
# - If admin-desk returns non-200 after injection, auto-restore admin/break pages and stop.
# - Does NOT touch report_api.py / Elastix / CDR / AMI config.

ROOT="${ROOT:-/opt/frappe_crm}"
SITE="${SITE:-crm.local}"
APP="restaurant_ops"

cd "$ROOT"

if docker compose version >/dev/null 2>&1; then
  COMPOSE=(docker compose)
elif command -v docker-compose >/dev/null 2>&1; then
  COMPOSE=(docker-compose)
else
  echo "❌ docker compose/docker-compose مش موجود"
  exit 1
fi

APP_DIR="$ROOT/apps/$APP"
PKG_DIR="$APP_DIR/$APP"
WWW_DIR="$PKG_DIR/www"
API_DIR="$PKG_DIR/api"
ADMIN_HTML="$WWW_DIR/admin-desk.html"
BREAK_ADMIN_HTML="$WWW_DIR/break-admin.html"
BREAK_NOTIF="$API_DIR/break_notifications.py"
BREAK_API="$API_DIR/break_api.py"
UPPER_API="$API_DIR/upper_management_email_api.py"
TS="$(date +%Y%m%d_%H%M%S)"
BACKUP_DIR="$ROOT/backups/FIX_ADMIN_BREAK_CANCEL_SIDEBAR_V7_BEFORE_$TS"
mkdir -p "$BACKUP_DIR"

BACKEND="$(${COMPOSE[@]} ps -q backend || true)"
if [[ -z "$BACKEND" ]]; then
  echo "❌ backend container مش شغال أو مش لاقيه"
  exit 1
fi

bench_exec() {
  "${COMPOSE[@]}" exec -T backend bench --site "$SITE" "$@"
}

echo "============================================================"
echo "🔧 Roshdy V7 Safe Admin/Break/Cancellation UI Fix"
echo "📦 Backup: $BACKUP_DIR"
echo "============================================================"

for f in "$ADMIN_HTML" "$BREAK_ADMIN_HTML" "$BREAK_NOTIF" "$BREAK_API" "$UPPER_API"; do
  [[ -f "$f" ]] && cp -a "$f" "$BACKUP_DIR/$(basename "$f").before"
done

export ADMIN_HTML BREAK_ADMIN_HTML BREAK_NOTIF BREAK_API UPPER_API BACKUP_DIR
