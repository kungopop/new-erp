def _r5_clean_emails(values):
    def walk(x):
        out = []
        if x is None:
            return out
        if isinstance(x, (list, tuple, set)):
            for y in x:
                out.extend(walk(y))
            return out
        if isinstance(x, dict):
            for y in x.values():
                out.extend(walk(y))
            return out
        text = cstr(x)
        st = text.strip()
        if st.startswith("{") or st.startswith("["):
            try:
                out.extend(walk(_r5_json.loads(st)))
            except Exception:
                pass
        try:
            out.extend(_r5_re.findall(r"[A-Za-z0-9._%+\-]+@[A-Za-z0-9.\-]+\.[A-Za-z]{2,}", text))
        except Exception:
            pass
        return out
    seen, cleaned = set(), []
    for e in walk(values):
        e = cstr(e).strip().strip(",; ")
        if not e:
            continue
        k = e.lower()
        if k in seen:
            continue
        if k.endswith("@local.local") or k.endswith("@example.com"):
            continue
        seen.add(k)
        cleaned.append(e)
    return cleaned


def _r5_explicit_recipients(kwargs=None, direct=None):
