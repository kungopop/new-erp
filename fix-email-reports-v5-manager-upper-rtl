        "upper_management_emails", "upper_management_email", "upper_management_recipients",
        "management_emails", "management_recipients", "executive_emails", "executive_recipients"
    )
    for k in keys:
        if k in kwargs and kwargs.get(k) not in (None, ""):
            candidates.append(kwargs.get(k))
    return _r5_clean_emails(candidates)


def _r5_score_email_setting(doctype, field, value):
    hay = f"{doctype or ''} {field or ''}".lower()
    val = cstr(value or "").lower()
    hard_excludes = (
        "smtp", "mail_server", "email_server", "host", "server", "password", "secret", "token", "api_key",
        "sender", "from_email", "from", "login", "username", "user_name", "owner",
        "center_manager", "centre_manager", "call_center_manager", "customer_service_manager",
        "center_emails", "centre_emails", "service_manager", "مدير السنتر", "مدير خدمة العملاء"
    )
    if any(x in hay for x in hard_excludes):
        return -9999
    score = 0
    if "upper_management" in hay or "upper-management" in hay:
        score += 200
    if "upper" in hay:
        score += 160
    if "executive" in hay or "top_management" in hay:
        score += 130
    if "management" in hay and "upper" not in hay:
        score += 80
    if any(x in hay for x in ("recipient", "recipients", "emails", "email_to", "send_to", "to_email", "mail_to")):
        score += 40
    if "roshdy email builder" in hay:
        score += 20
    if any(x in val for x in ("upper_management", "upper management", "executive")):
        score += 25
    return score


def _r5_json_upper_path_emails(obj, path=""):
    """Extract emails only from JSON paths that clearly mean upper/executive management.
    This prevents a settings_json blob from mixing Center Manager recipients with Upper Management recipients.
    """
    emails = []
    path_l = path.lower()
    bad = any(x in path_l for x in ("center", "centre", "customer_service", "service_manager", "manager_center", "sender", "smtp", "host", "password"))
    good = any(x in path_l for x in ("upper", "upper_management", "executive", "top_management", "management_emails", "management_recipients"))
    if isinstance(obj, dict):
        for k, v in obj.items():
            emails.extend(_r5_json_upper_path_emails(v, f"{path}.{k}" if path else cstr(k)))
    elif isinstance(obj, list):
        for i, v in enumerate(obj):
            emails.extend(_r5_json_upper_path_emails(v, f"{path}[{i}]"))
    else:
        if good and not bad:
            emails.extend(_r5_clean_emails(obj))
    return emails


def _r5_emails_from_setting_row(doctype, field, value, score):
    hay = f"{doctype or ''} {field or ''}".lower()
    text = cstr(value or "").strip()
    is_json = text.startswith("{") or text.startswith("[")
    if is_json:
        try:
            obj = _r5_json.loads(text)
            upper_only = _r5_clean_emails(_r5_json_upper_path_emails(obj))
            if upper_only:
                return upper_only
        except Exception:
            pass
        # Only for a clearly exact upper field, allow whole JSON as fallback.
        if "upper" in hay or "executive" in hay or "top_management" in hay:
            return _r5_clean_emails(value)
        return []
    return _r5_clean_emails(value)


def _r5_pick_saved_upper_recipients():
    candidates = []
    try:
        rows = frappe.db.sql("select doctype, field, value from `tabSingles` where value like '%%@%%'", as_dict=True)
    except Exception:
        rows = []
    for r in rows:
        score = _r5_score_email_setting(r.get("doctype"), r.get("field"), r.get("value"))
        if score <= 0:
            continue
        emails = _r5_emails_from_setting_row(r.get("doctype"), r.get("field"), r.get("value"), score)
        if not emails:
            continue
        candidates.append({"score": score, "doctype": r.get("doctype"), "field": r.get("field"), "emails": emails})
    if not candidates:
        return [], "not_found", []
    candidates.sort(key=lambda x: x["score"], reverse=True)
    best_score = candidates[0]["score"]
    best = [c for c in candidates if c["score"] == best_score]
    emails, sources = [], []
    for c in best:
        emails.extend(c["emails"])
        sources.append(f"{c.get('doctype')}.{c.get('field')} score={c.get('score')}")
    return _r5_clean_emails(emails), "exact_upper_setting", sources


def _r5_resolve_upper_recipients(direct=None, kwargs=None):
    explicit = _r5_explicit_recipients(kwargs=kwargs, direct=direct)
    if explicit:
        return explicit, "explicit_ui_or_api", ["kwargs/direct"]
    saved, source, sources = _r5_pick_saved_upper_recipients()
    if saved:
        return saved, source, sources
    return [], "not_found", []


def _r5_call_report(date_from=None, date_to=None, smart_category=None, page=1, page_size=5000):
    try:
        from restaurant_ops.api import report_api
    except Exception as e:
        return {"success": False, "error": f"cannot import report_api: {e}"}
    base = {"page": page, "page_size": page_size, "view_mode": "admin"}
    if smart_category:
        base["smart_category"] = smart_category
    variants = [
        {"date_from": cstr(date_from), "date_to": cstr(date_to)},
        {"from_date": cstr(date_from), "to_date": cstr(date_to)},
        {"start_date": cstr(date_from), "end_date": cstr(date_to)},
        {"date": cstr(date_from)},
        {},
    ]
    last = None
    for dv in variants:
        kw = dict(base); kw.update(dv)
        try:
            return _unwrap_result(report_api.get_calls_report(**kw))
        except TypeError as e:
            last = cstr(e); continue
        except Exception as e:
            last = cstr(e); continue
    return {"success": False, "error": last or "unknown report_api error"}


def _r5_rows(obj):
    return _find_rows(obj) or []


def _r5_report_all(start_date, end_date):
    first = _r5_call_report(start_date, end_date, page=1, page_size=5000)
    rows = list(_r5_rows(first))
    summary = first.get("summary") if isinstance(first, dict) and isinstance(first.get("summary"), dict) else {}
    pagination = first.get("pagination") if isinstance(first, dict) and isinstance(first.get("pagination"), dict) else {}
    try:
        total_pages = cint(pagination.get("total_pages") or 1)
    except Exception:
        total_pages = 1
    max_pages = min(max(total_pages, 1), 10)
    for page in range(2, max_pages + 1):
        res = _r5_call_report(start_date, end_date, page=page, page_size=5000)
        more = _r5_rows(res)
        if not more:
            break
        rows.extend(more)
    return {"first": first, "rows": rows, "summary": summary, "pagination": pagination}


def _r5_category_rows(start_date, end_date, categories):
    out, seen = [], set()
    for cat in categories:
        res = _r5_call_report(start_date, end_date, smart_category=cat, page=1, page_size=5000)
        rows = _r5_rows(res)
        for r in rows:
            uid = cstr(r.get("uniqueid") or r.get("name") or f"{r.get('calldate')}|{r.get('src')}|{r.get('actual_ext')}|{cat}")
            if uid in seen:
                continue
            seen.add(uid)
            out.append(r)
    return out


def _r5_queue_match(row, queue):
    qlist = _as_list(queue) or [DEFAULT_COMPLAINT_QUEUE]
    dst = cstr(row.get("dst") or "").strip()
    actual_ext = cstr(row.get("actual_ext") or "").strip()
    lastdata = cstr(row.get("lastdata") or "")
    rec = cstr(row.get("recordingfile") or row.get("recording_url") or "")
    agent_name = cstr(row.get("agent_name") or "")
    for q in qlist:
        q = cstr(q).strip()
        if not q:
            continue
        if dst == q:
            return True
        if actual_ext == q and "طابور" in agent_name:
            return True
        if lastdata.startswith(q + ",") or lastdata.startswith(q + "|"):
            return True
        if f"q-{q}-" in rec:
            return True
    return False


def _r5_employee_label(row):
    agent_name = cstr(row.get("agent_name") or "").strip()
    if agent_name:
        return agent_name
    ext = cstr(row.get("actual_ext") or row.get("extension") or "").strip()
    return _employee_name_from_extension(ext) or ext or "غير محدد"


def _r5_issue_row(row, action):
    ext = cstr(row.get("actual_ext") or row.get("extension") or "").strip()
