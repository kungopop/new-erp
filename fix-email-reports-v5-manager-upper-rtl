        "action": action,
        "duration": cstr(row.get("duration") or row.get("ring_seconds") or row.get("ringtime") or ""),
    }


def _r5_get_call_stats(start_date, end_date):
    data = _r5_report_all(start_date, end_date)
    summary = data.get("summary") or {}
    pagination = data.get("pagination") or {}
    rows = data.get("rows") or []
    total = summary.get("total") or pagination.get("total_records") or len(rows)
    answered = summary.get("answered")
    if answered is None:
        answered = 0
        for r in rows:
            if cstr(r.get("smart_category") or "").lower() == "answered" or cstr(r.get("disposition") or "").upper() == "ANSWERED" or "تم الرد" in cstr(r.get("category_label") or ""):
                answered += 1
    declined_count = cint(summary.get("declined") or 0)
    staff_missed_count = cint(summary.get("staff_missed") or summary.get("employee_missed") or 0)

    declined_rows_raw = _r5_category_rows(start_date, end_date, ["declined", "rejected", "busy"])
    missed_rows_raw = _r5_category_rows(start_date, end_date, ["staff_missed", "employee_missed", "agent_missed", "missed"])

    # Fallback scan if filters did not return rows but summary says there are cases.
    if declined_count and not declined_rows_raw:
        for r in rows:
            smart = cstr(r.get("smart_category") or "").lower()
            label = cstr(r.get("category_label") or "")
            disp = cstr(r.get("disposition") or "").upper()
            if smart in ("declined", "rejected", "busy") or disp in ("BUSY", "FAILED") or any(x in label for x in ("رفض", "كنسل", "مشغول")):
                declined_rows_raw.append(r)
    if staff_missed_count and not missed_rows_raw:
        for r in rows:
            smart = cstr(r.get("smart_category") or "").lower()
            label = cstr(r.get("category_label") or "")
            if smart in ("staff_missed", "employee_missed", "agent_missed", "missed") or "فائت" in label or "لم يرد" in label:
                missed_rows_raw.append(r)

    declined_rows = [_r5_issue_row(r, "تم رفض/كنسلة المكالمة") for r in declined_rows_raw]
    missed_rows = [_r5_issue_row(r, "سابها ترن حتى انتهت") for r in missed_rows_raw]
    employee_issue_rows = declined_rows + missed_rows

    if declined_count == 0 and declined_rows:
        declined_count = len(declined_rows)
    if staff_missed_count == 0 and missed_rows:
        staff_missed_count = len(missed_rows)

    complaint_q = DEFAULT_COMPLAINT_QUEUE
    try:
        complaint_q = _roshdy_conf_queue("complaint") if "_roshdy_conf_queue" in globals() else DEFAULT_COMPLAINT_QUEUE
    except Exception:
        complaint_q = DEFAULT_COMPLAINT_QUEUE
    complaint_queue_count = sum(1 for r in rows if _r5_queue_match(r, complaint_q))

    return {
        "total": cint(total or 0),
