# 1) Restore Customer Service Manager email behavior from pre-upper-management backup, only rename title to مدير خدمة العملاء.
# 2) Upper Management report: email-safe RTL/right alignment.
# 3) Upper Management report: complaints are TODAY only, with status/category classification.
# 4) Upper Management report: show employees/extensions who rejected/cancelled/missed calls when present.
# 5) Upper Management report: strict recipients only from UI/exact upper-management setting, no role fallback.
# 6) Verify active breaks still read from backend.
# Does NOT touch restaurant_ops.api.report_api / Elastix / CDR / AMI config.

ROOT="${ROOT:-/opt/frappe_crm}"
SITE="${SITE:-crm.local}"
APP="restaurant_ops"
RUN_EMAIL_SEND_TEST="${RUN_EMAIL_SEND_TEST:-0}"

cd "$ROOT"

if docker compose version >/dev/null 2>&1; then
