def _r5_pick_field(meta, candidates):
    try:
        for c in candidates:
            if meta.has_field(c):
                return c
    except Exception:
        pass
    return None


def _r5_complaint_stats(start_dt, end_dt):
    dt = "Call Center Complaint"
    out = {
        "exists": False,
        "registered_today": 0,
        "open_today": 0,
        "resolved_today": 0,
        "status_breakdown": [],
        "category_breakdown": [],
        "priority_breakdown": [],
        "today_rows": [],
        "status_field": None,
        "category_field": None,
        "priority_field": None,
    }
    if not _doctype_exists(dt):
        return out
    out["exists"] = True
    try:
        meta = frappe.get_meta(dt)
        status_field = _r5_pick_field(meta, ["status", "complaint_status", "workflow_state"])
        category_field = _r5_pick_field(meta, ["category", "complaint_category", "complaint_type", "type", "issue_type", "reason", "complaint_reason"])
        priority_field = _r5_pick_field(meta, ["priority", "complaint_priority", "urgency"])
        out["status_field"] = status_field
        out["category_field"] = category_field
        out["priority_field"] = priority_field

        fields = ["name", "creation", "modified"]
        for f in (status_field, category_field, priority_field, "customer_name", "customer_phone", "subject"):
            if f and f not in fields and (f in ("customer_name", "customer_phone", "subject") and meta.has_field(f) or f not in ("customer_name", "customer_phone", "subject")):
                fields.append(f)
        rows = frappe.get_all(dt, filters={"creation": ["between", [_iso(start_dt), _iso(end_dt)]]}, fields=fields, order_by="creation desc", limit_page_length=500)
        out["registered_today"] = len(rows)

        closed = set(_r5_closed_values())
        status_counts, category_counts, priority_counts = {}, {}, {}
        today_rows = []
        for r in rows:
            st = cstr(r.get(status_field) if status_field else "غير محدد") or "غير محدد"
            cat = cstr(r.get(category_field) if category_field else "غير محدد") or "غير محدد"
            pri = cstr(r.get(priority_field) if priority_field else "غير محدد") or "غير محدد"
            status_counts[st] = status_counts.get(st, 0) + 1
            category_counts[cat] = category_counts.get(cat, 0) + 1
            priority_counts[pri] = priority_counts.get(pri, 0) + 1
            if st in closed:
                out["resolved_today"] += 1
            else:
                out["open_today"] += 1
            today_rows.append({
                "name": r.get("name"),
                "creation": cstr(r.get("creation") or ""),
                "status": st,
                "category": cat,
                "priority": pri,
                "customer_name": r.get("customer_name") or "",
                "customer_phone": r.get("customer_phone") or "",
                "subject": r.get("subject") or "",
            })
        out["today_rows"] = today_rows
        out["status_breakdown"] = [{"label": k, "count": v} for k, v in sorted(status_counts.items(), key=lambda x: (-x[1], x[0]))]
        out["category_breakdown"] = [{"label": k, "count": v} for k, v in sorted(category_counts.items(), key=lambda x: (-x[1], x[0]))]
        out["priority_breakdown"] = [{"label": k, "count": v} for k, v in sorted(priority_counts.items(), key=lambda x: (-x[1], x[0]))]
    except Exception as e:
        out["error"] = cstr(e)
    return out


