def _fbc37_table(headers, rows, empty="لا توجد بيانات"):
    th = "".join("<th style='background:#111827;color:white;padding:8px;border:1px solid #e5e7eb;text-align:right'>%s</th>" % _fbc37_e(h) for h in headers)
    if rows:
        body = "".join("<tr>" + "".join("<td style='padding:8px;border:1px solid #e5e7eb;text-align:right;vertical-align:top'>%s</td>" % _fbc37_e(c) for c in r) + "</tr>" for r in rows)
    else:
        body = "<tr><td colspan='%s' style='padding:10px;text-align:center;color:#64748b;background:#f8fafc;border:1px solid #e5e7eb'>%s</td></tr>" % (len(headers), _fbc37_e(empty))
    return "<table dir='rtl' width='100%' cellpadding='0' cellspacing='0' style='border-collapse:collapse;width:100%;direction:rtl;text-align:right;margin-top:8px;font-family:Tahoma,Arial,sans-serif'>" + "<thead><tr>" + th + "</tr></thead><tbody>" + body + "</tbody></table>"


def _fbc37_section(date_from=None, date_to=None):
    try:
        from restaurant_ops.api.feedback_api import get_feedback_email_summary
        d = get_feedback_email_summary(date_from=date_from or today(), date_to=date_to or date_from or today())
    except Exception as e:
        return "<h3>📣 الفيدباك</h3><div class='note'>تعذر تحميل الفيدباك: %s</div>" % _fbc37_e(e)
    sat = d.get('satisfaction_counts') or {}
    by_agent = d.get('by_agent') or {}
    by_shift = d.get('by_shift') or {}
    sat_rows = [[k, v] for k, v in sat.items()]
    agent_rows = [[k, v] for k, v in by_agent.items()]
    shift_rows = [[k, v] for k, v in by_shift.items()]
    return f"""
    <!-- ROSHDY_FEEDBACK_EMAIL_SECTION_V37 -->
    <h3>📣 الفيدباك</h3>
    <table width="100%" dir="rtl" cellpadding="0" cellspacing="0" style="border-collapse:collapse;margin-bottom:10px;font-family:Tahoma,Arial,sans-serif">
      <tr>
        <td style="padding:8px;border:1px solid #e5e7eb;background:#f8fafc">إجمالي الأرقام</td><td style="padding:8px;border:1px solid #e5e7eb"><b>{_fbc37_e(d.get('total'))}</b></td>
        <td style="padding:8px;border:1px solid #e5e7eb;background:#f8fafc">تم الفيدباك</td><td style="padding:8px;border:1px solid #e5e7eb"><b>{_fbc37_e(d.get('completed'))}</b></td>
        <td style="padding:8px;border:1px solid #e5e7eb;background:#f8fafc">متبقي</td><td style="padding:8px;border:1px solid #e5e7eb"><b>{_fbc37_e(d.get('pending'))}</b></td>
        <td style="padding:8px;border:1px solid #e5e7eb;background:#f8fafc">متوسط التقييم</td><td style="padding:8px;border:1px solid #e5e7eb"><b>{_fbc37_e(d.get('avg_rating'))}</b></td>
      </tr>
