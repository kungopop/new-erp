def _fbc37_e(v):
    return _fbc37_html.escape(cstr(v) if v is not None else "")


def _fbc37_sanitize_email_html(html):
    h = cstr(html or "")
    patterns = [
        r"<script\b[\s\S]*?</script>", r"<button\b[\s\S]*?</button>", r"<form\b[\s\S]*?</form>", r"<iframe\b[\s\S]*?</iframe>", r"<select\b[\s\S]*?</select>", r"<textarea\b[\s\S]*?</textarea>", r"<input\b[^>]*>",
        r"&lt;script\b[\s\S]*?&lt;/script&gt;", r"&lt;button\b[\s\S]*?&lt;/button&gt;", r"&lt;form\b[\s\S]*?&lt;/form&gt;", r"&lt;iframe\b[\s\S]*?&lt;/iframe&gt;", r"&lt;select\b[\s\S]*?&lt;/select&gt;", r"&lt;textarea\b[\s\S]*?&lt;/textarea&gt;", r"&lt;input\b[\s\S]*?&gt;",
    ]
    for pat in patterns:
        h = _fbc37_re.sub(pat, "", h, flags=_fbc37_re.I)
    h = _fbc37_re.sub(r"&lt;div class=\"panel\"&gt;&lt;button[\s\S]*?async function loadBreakTypes\(\)", "", h, flags=_fbc37_re.I)
