    {_fbc37_table(['رقم الوردية','عدد الأرقام'], shift_rows, 'لا توجد ورديات')}
    """


def _fbc37_inject(html, date_from=None, date_to=None):
    html = _fbc37_sanitize_email_html(html)
    if "ROSHDY_FEEDBACK_EMAIL_SECTION_V37" in html:
        return html
    section = _fbc37_section(date_from, date_to)
    if "</body>" in html:
        html = html.replace("</body>", section + "</body>")
    else:
        html = html + section
    return _fbc37_sanitize_email_html(html)


def build_center_manager_report():
    html = _fbc37_prev_build_center_manager_report() if _fbc37_prev_build_center_manager_report else ""
    return _fbc37_inject(html, today(), today())


def _adv_render(report_type="center"):
    rendered = _fbc37_prev_adv_render(report_type) if _fbc37_prev_adv_render else ""
    if isinstance(rendered, dict):
        out = dict(rendered)
        if cstr(report_type).lower() in ("center", "manager", "customer_service", "مدير خدمة العملاء"):
            out["html"] = _fbc37_inject(out.get("html"), today(), today())
        elif out.get("html"):
            out["html"] = _fbc37_sanitize_email_html(out.get("html"))
        return out
    html = cstr(rendered or "")
    if cstr(report_type).lower() in ("center", "manager", "customer_service", "مدير خدمة العملاء"):
        html = _fbc37_inject(html, today(), today())
    else:
        html = _fbc37_sanitize_email_html(html)
    return {"success": True if html else False, "html": html}


@frappe.whitelist()
def preview_email_report(report_type="center"):
    rendered = _fbc37_prev_preview_email_report(report_type) if _fbc37_prev_preview_email_report else _adv_render(report_type)
    if isinstance(rendered, dict):
        out = dict(rendered)
        out["html"] = _fbc37_inject(out.get("html"), today(), today()) if cstr(report_type).lower() in ("center", "manager", "customer_service") else _fbc37_sanitize_email_html(out.get("html"))
        return out
    return {"success": True, "html": _fbc37_inject(rendered, today(), today())}


@frappe.whitelist()
def debug_center_feedback_email_section(date_from=None, date_to=None):
    from restaurant_ops.api.feedback_api import get_feedback_email_summary
    d = get_feedback_email_summary(date_from=date_from or today(), date_to=date_to or date_from or today())
    html = _fbc37_section(date_from or today(), date_to or date_from or today())
    clean = _fbc37_sanitize_email_html(html)
    return {"success": True, "summary": d, "html_has_feedback": "ROSHDY_FEEDBACK_EMAIL_SECTION_V37" in clean, "html_has_no_script": "<script" not in clean.lower() and "&lt;script" not in clean.lower(), "html_has_no_button": "<button" not in clean.lower() and "&lt;button" not in clean.lower()}
