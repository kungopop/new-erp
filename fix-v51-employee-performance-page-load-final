#!/usr/bin/env bash
set -Eeuo pipefail

# Roshdy V51 - Employee Performance page load/UI repair
# Fixes empty/stuck page caused by frontend JS/UI issue after V50.
# Also validates that the backend snapshot has data; if it is empty, it reruns yesterday generation.
# Safety: does NOT touch report_api.py, Elastix config, CDR/AMI config, queue_log, or any Elastix file.

ROOT="${ROOT:-/opt/frappe_crm}"
SITE="${SITE:-crm.local}"
APP="restaurant_ops"

cd "$ROOT"

if docker compose version >/dev/null 2>&1; then
  COMPOSE=(docker compose)
else
  COMPOSE=(docker-compose)
fi

BACKEND="$(${COMPOSE[@]} ps -q backend || true)"
if [[ -z "$BACKEND" ]]; then
  echo "❌ backend مش شغال"
  exit 1
fi
bench_exec(){ "${COMPOSE[@]}" exec -T backend bench --site "$SITE" "$@"; }

APP_DIR="$ROOT/apps/$APP"
WWW_DIR="$APP_DIR/$APP/www"
EMP_HTML="$WWW_DIR/employee-performance.html"
EMP_PY="$WWW_DIR/employee-performance.py"
EMP_SCRIPT="$ROOT/scripts/roshdy_employee_performance_generate_v46"
TS="$(date +%Y%m%d_%H%M%S)"
BACKUP_DIR="$ROOT/backups/FIX_V51_EMPLOYEE_PERF_PAGE_LOAD_BEFORE_$TS"
mkdir -p "$BACKUP_DIR/files" "$BACKUP_DIR/validation"

cat <<EOF
============================================================
🚑 Roshdy V51: Employee Performance Page Load/UI Repair
📦 Backup: $BACKUP_DIR
🛡️ report_api.py / Elastix / CDR / AMI untouched
============================================================
EOF

for f in "$EMP_HTML" "$EMP_PY"; do
  [[ -e "$f" ]] && cp -a "$f" "$BACKUP_DIR/files/$(basename "$f").before" || true
done

echo "🧩 Step 1: Rewrite /employee-performance clean UI"
