            {"fieldname": "agent_employee", "label": "Employee", "fieldtype": "Link", "options": "Employee"},
            {"fieldname": "agent_employee_name", "label": "اسم الموظف", "fieldtype": "Data", "read_only": 1},
            {"fieldname": "completed_at", "label": "وقت الإكمال", "fieldtype": "Datetime", "read_only": 1},
