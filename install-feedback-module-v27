            {"fieldname": "import_batch", "label": "دفعة الاستيراد", "fieldtype": "Data"},
            {"fieldname": "closed_by", "label": "أغلق الوردية بواسطة", "fieldtype": "Data"},
            {"fieldname": "closed_at", "label": "وقت إغلاق الوردية", "fieldtype": "Datetime"},
            {"fieldname": "raw_payload", "label": "Raw Payload", "fieldtype": "Small Text"},
        ],
        "permissions": perms,
    })
    doc.insert(ignore_permissions=True)
    frappe.db.commit()
    frappe.clear_cache(doctype=FEEDBACK_DT)
    return {"success": True, "doctype": FEEDBACK_DT, "created": True}


def _norm_phone(phone):
    phone = cstr(phone or "").strip()
    phone = phone.replace(" ", "").replace("-", "")
    return phone


def _looks_phone(s):
    s = cstr(s or "").strip()
    digits = re.sub(r"\D+", "", s)
    return len(digits) >= 7


def _duplicate_exists(phone, feedback_date, shift_number):
    try:
        return frappe.db.exists(FEEDBACK_DT, {"customer_phone": phone, "feedback_date": feedback_date, "shift_number": shift_number})
    except Exception:
        return None


def _insert_item(customer_name, customer_phone, feedback_date=None, shift_number=None, source="manual", import_batch=None, active=1, raw_payload=None, ignore_duplicate=True):
    ensure_feedback_doctype()
    if not _is_admin():
        frappe.throw("غير مسموح: إضافة أرقام الفيدباك للأدمن فقط")
    feedback_date = cstr(feedback_date or today())[:10]
    shift_number = cstr(shift_number or "").strip()
    phone = _norm_phone(customer_phone)
    name = cstr(customer_name or "").strip()
    if not shift_number:
        frappe.throw("رقم الوردية مطلوب")
    if not phone:
        frappe.throw("رقم العميل مطلوب")
    if ignore_duplicate and _duplicate_exists(phone, feedback_date, shift_number):
        return {"success": True, "skipped_duplicate": True, "phone": phone}
    doc = frappe.get_doc({
        "doctype": FEEDBACK_DT,
        "feedback_date": feedback_date,
        "shift_number": shift_number,
        "customer_name": name,
        "customer_phone": phone,
        "status": "Pending",
        "is_active": 1 if cint(active) else 0,
        "source": source,
        "import_batch": import_batch or "",
        "raw_payload": raw_payload or "",
    })
    doc.insert(ignore_permissions=True)
    return {"success": True, "name": doc.name, "phone": phone}


@frappe.whitelist()
def add_feedback_manual(customer_name=None, customer_phone=None, feedback_date=None, shift_number=None):
    res = _insert_item(customer_name, customer_phone, feedback_date, shift_number, source="manual")
    frappe.db.commit()
    return res


def _parse_bulk_text(text):
    rows = []
    for line in cstr(text or "").splitlines():
        line = line.strip()
        if not line:
            continue
        # Supports: name,phone  OR phone,name OR name: phone1, phone2 OR only comma-separated phones
        if ":" in line:
            name_part, rest = line.split(":", 1)
            tokens = [x.strip() for x in re.split(r"[,;\t]+", rest) if x.strip()]
            for t in tokens:
                if _looks_phone(t):
                    rows.append({"customer_name": name_part.strip(), "customer_phone": t})
            continue
        tokens = [x.strip() for x in re.split(r"[,;\t]+", line) if x.strip()]
        phones = [t for t in tokens if _looks_phone(t)]
        names = [t for t in tokens if not _looks_phone(t)]
        if not phones and _looks_phone(line):
            phones = [line]
        for idx, ph in enumerate(phones):
            nm = names[0] if names else ""
            rows.append({"customer_name": nm, "customer_phone": ph})
    return rows


@frappe.whitelist()
def add_feedback_bulk(text=None, feedback_date=None, shift_number=None):
    ensure_feedback_doctype()
    if not _is_admin():
        frappe.throw("غير مسموح")
    batch = "BULK-" + now_datetime().strftime("%Y%m%d%H%M%S")
    rows = _parse_bulk_text(text)
    created = skipped = 0
    errors = []
    for r in rows:
        try:
            res = _insert_item(r.get("customer_name"), r.get("customer_phone"), feedback_date, shift_number, source="bulk", import_batch=batch, raw_payload=json.dumps(r, ensure_ascii=False))
            if res.get("skipped_duplicate"):
                skipped += 1
            else:
                created += 1
        except Exception as e:
            errors.append(str(e))
    frappe.db.commit()
    return {"success": True, "batch": batch, "parsed": len(rows), "created": created, "skipped_duplicates": skipped, "errors": errors[:20]}


def _find_header_map(headers):
    hmap = {}
    for i, h in enumerate(headers):
        key = cstr(h or "").strip().lower()
        if not key:
            continue
        if any(x in key for x in ("phone", "mobile", "tel", "رقم", "موبايل", "تليفون", "هاتف")):
            hmap.setdefault("phone", i)
        elif any(x in key for x in ("name", "customer", "client", "اسم", "عميل")):
            hmap.setdefault("name", i)
    return hmap


def _parse_excel_bytes(content):
    rows = []
    # xlsx first
    try:
        from openpyxl import load_workbook
        wb = load_workbook(filename=io.BytesIO(content), read_only=True, data_only=True)
        ws = wb.active
        all_rows = list(ws.iter_rows(values_only=True))
        if not all_rows:
            return []
        headers = list(all_rows[0])
        hmap = _find_header_map(headers)
        data_rows = all_rows[1:] if hmap.get("phone") is not None else all_rows
        for row in data_rows:
            vals = list(row or [])
            if hmap.get("phone") is not None:
                phone = vals[hmap["phone"]] if hmap["phone"] < len(vals) else ""
                name = vals[hmap.get("name")] if hmap.get("name") is not None and hmap.get("name") < len(vals) else ""
            else:
                # no header: pick first phone-like cell and first non-phone as name
                phone = ""; name = ""
                for v in vals:
                    if _looks_phone(v) and not phone:
                        phone = v
                    elif cstr(v).strip() and not name:
                        name = v
            if _looks_phone(phone):
                rows.append({"customer_name": cstr(name or ""), "customer_phone": cstr(phone)})
        return rows
    except Exception:
        pass
    # csv fallback
    try:
        text = content.decode("utf-8-sig", errors="ignore")
        reader = csv.reader(io.StringIO(text))
        all_rows = list(reader)
        if not all_rows:
            return []
        hmap = _find_header_map(all_rows[0])
        data_rows = all_rows[1:] if hmap.get("phone") is not None else all_rows
        for row in data_rows:
            if hmap.get("phone") is not None:
                phone = row[hmap["phone"]] if hmap["phone"] < len(row) else ""
                name = row[hmap.get("name")] if hmap.get("name") is not None and hmap.get("name") < len(row) else ""
            else:
                phone = ""; name = ""
                for v in row:
                    if _looks_phone(v) and not phone:
                        phone = v
                    elif cstr(v).strip() and not name:
                        name = v
            if _looks_phone(phone):
                rows.append({"customer_name": cstr(name or ""), "customer_phone": cstr(phone)})
    except Exception:
        pass
    return rows


@frappe.whitelist()
def upload_feedback_excel(feedback_date=None, shift_number=None):
    ensure_feedback_doctype()
    if not _is_admin():
        frappe.throw("غير مسموح")
    f = None
    try:
        if frappe.request and frappe.request.files:
            f = frappe.request.files.get("file") or next(iter(frappe.request.files.values()))
    except Exception:
        f = None
    if not f:
        frappe.throw("ملف Excel مطلوب")
    content = f.read()
    rows = _parse_excel_bytes(content)
    batch = "EXCEL-" + now_datetime().strftime("%Y%m%d%H%M%S")
    created = skipped = 0
    errors = []
    for r in rows:
        try:
            res = _insert_item(r.get("customer_name"), r.get("customer_phone"), feedback_date, shift_number, source="excel", import_batch=batch, raw_payload=json.dumps(r, ensure_ascii=False))
            if res.get("skipped_duplicate"):
                skipped += 1
            else:
                created += 1
        except Exception as e:
            errors.append(str(e))
    frappe.db.commit()
    return {"success": True, "batch": batch, "parsed": len(rows), "created": created, "skipped_duplicates": skipped, "errors": errors[:20]}


@frappe.whitelist()
def list_feedback_tasks(feedback_date=None, shift_number=None, include_completed_by_me=1):
    ensure_feedback_doctype()
    if not _can_feedback():
        frappe.throw("غير مسموح")
    feedback_date = cstr(feedback_date or today())[:10]
    filters = {"feedback_date": feedback_date, "is_active": 1, "status": "Pending"}
    if shift_number:
        filters["shift_number"] = cstr(shift_number).strip()
    rows = frappe.get_all(FEEDBACK_DT, filters=filters, fields=["name", "customer_name", "customer_phone", "feedback_date", "shift_number", "status"], order_by="creation asc", limit_page_length=500)
    done = []
    if cint(include_completed_by_me or 0):
        done_filters = {"feedback_date": feedback_date, "status": "Completed", "agent_user": frappe.session.user}
        if shift_number:
            done_filters["shift_number"] = cstr(shift_number).strip()
        done = frappe.get_all(FEEDBACK_DT, filters=done_filters, fields=["name", "customer_name", "customer_phone", "feedback_date", "shift_number", "status", "rating", "satisfaction", "details", "notes", "completed_at"], order_by="completed_at desc", limit_page_length=100)
    return {"success": True, "pending": rows, "completed_by_me": done, "count": len(rows)}


@frappe.whitelist()
def submit_feedback(feedback_id=None, rating=None, satisfaction=None, details=None, notes=None):
    ensure_feedback_doctype()
    if not _can_feedback():
        frappe.throw("غير مسموح")
    if not feedback_id:
        frappe.throw("feedback_id مطلوب")
    if not frappe.db.exists(FEEDBACK_DT, feedback_id):
        frappe.throw("سجل الفيدباك غير موجود")
    rating = cint(rating)
    if rating < 1 or rating > 10:
        frappe.throw("التقييم يجب أن يكون من 1 إلى 10")
    satisfaction = cstr(satisfaction or "").strip()
    if satisfaction not in SATISFACTION_OPTIONS:
        frappe.throw("درجة الرضاء غير صحيحة")
    doc = frappe.get_doc(FEEDBACK_DT, feedback_id)
    if doc.status == "Completed":
        return {"success": False, "message": "تم تسجيل الفيدباك لهذا العميل بالفعل"}
    if not cint(doc.is_active or 0):
        return {"success": False, "message": "هذه الوردية غير متاحة للفيدباك حاليًا"}
    emp, emp_name = _employee_for_user()
    doc.rating = rating
    doc.satisfaction = satisfaction
    doc.details = cstr(details or "").strip()
    doc.notes = cstr(notes or "").strip()
    doc.agent_user = frappe.session.user
    doc.agent_employee = emp
    doc.agent_employee_name = emp_name
    doc.completed_at = now_datetime()
    doc.status = "Completed"
    doc.save(ignore_permissions=True)
    frappe.db.commit()
    return {"success": True, "message": "تم حفظ الفيدباك", "name": doc.name}


@frappe.whitelist()
def close_feedback_shift(feedback_date=None, shift_number=None):
    ensure_feedback_doctype()
    if not _is_admin():
        frappe.throw("غير مسموح")
    feedback_date = cstr(feedback_date or today())[:10]
    shift_number = cstr(shift_number or "").strip()
    if not shift_number:
        frappe.throw("رقم الوردية مطلوب")
    rows = frappe.get_all(FEEDBACK_DT, filters={"feedback_date": feedback_date, "shift_number": shift_number, "is_active": 1}, pluck="name", limit_page_length=5000)
    for name in rows:
        doc = frappe.get_doc(FEEDBACK_DT, name)
        doc.is_active = 0
        if doc.status == "Pending":
            doc.status = "Closed"
        doc.closed_by = frappe.session.user
        doc.closed_at = now_datetime()
        doc.save(ignore_permissions=True)
    frappe.db.commit()
    return {"success": True, "message": "تم إغلاق وردية الفيدباك وإخفاؤها من الموظفين", "updated": len(rows)}


@frappe.whitelist()
def reopen_feedback_shift(feedback_date=None, shift_number=None):
    ensure_feedback_doctype()
    if not _is_admin():
        frappe.throw("غير مسموح")
    feedback_date = cstr(feedback_date or today())[:10]
    shift_number = cstr(shift_number or "").strip()
    rows = frappe.get_all(FEEDBACK_DT, filters={"feedback_date": feedback_date, "shift_number": shift_number}, pluck="name", limit_page_length=5000)
    for name in rows:
        doc = frappe.get_doc(FEEDBACK_DT, name)
        doc.is_active = 1
        if doc.status == "Closed":
            doc.status = "Pending"
        doc.save(ignore_permissions=True)
    frappe.db.commit()
    return {"success": True, "message": "تم إعادة إتاحة وردية الفيدباك", "updated": len(rows)}


def _base_filters(date_from=None, date_to=None, shift_number=None, status=None, agent_user=None):
    date_from = cstr(date_from or today())[:10]
    date_to = cstr(date_to or date_from)[:10]
    filters = {"feedback_date": ["between", [date_from, date_to]]}
    if shift_number:
        filters["shift_number"] = cstr(shift_number).strip()
    if status and status not in ("All", "الكل"):
        filters["status"] = status
    if agent_user:
        filters["agent_user"] = agent_user
    return filters, date_from, date_to


@frappe.whitelist()
def get_feedback_admin_report(date_from=None, date_to=None, shift_number=None, status=None, agent_user=None, limit=1000):
    ensure_feedback_doctype()
    if not _is_admin():
        frappe.throw("غير مسموح")
    filters, df, dt = _base_filters(date_from, date_to, shift_number, status, agent_user)
    fields = ["name", "feedback_date", "shift_number", "customer_name", "customer_phone", "status", "is_active", "rating", "satisfaction", "details", "notes", "agent_user", "agent_employee_name", "completed_at", "source", "import_batch", "closed_by", "closed_at"]
    rows = frappe.get_all(FEEDBACK_DT, filters=filters, fields=fields, order_by="feedback_date desc, shift_number asc, creation asc", limit_page_length=cint(limit or 1000))
    total = len(rows)
    completed = [r for r in rows if r.get("status") == "Completed"]
    pending = [r for r in rows if r.get("status") == "Pending" and cint(r.get("is_active") or 0)]
    closed = [r for r in rows if r.get("status") == "Closed" or not cint(r.get("is_active") or 0)]
    ratings = [flt(r.get("rating") or 0) for r in completed if flt(r.get("rating") or 0) > 0]
    avg_rating = round(sum(ratings) / len(ratings), 2) if ratings else 0
    sat_counts = Counter([r.get("satisfaction") or "غير محدد" for r in completed])
    agent_counts = defaultdict(lambda: {"agent": "", "count": 0, "avg_rating": 0, "_ratings": []})
    for r in completed:
        ag = r.get("agent_employee_name") or r.get("agent_user") or "غير محدد"
        row = agent_counts[ag]
        row["agent"] = ag
        row["count"] += 1
        if flt(r.get("rating") or 0) > 0:
            row["_ratings"].append(flt(r.get("rating")))
    by_agent = []
    for row in agent_counts.values():
        rs = row.pop("_ratings")
        row["avg_rating"] = round(sum(rs) / len(rs), 2) if rs else 0
        by_agent.append(row)
    by_agent.sort(key=lambda x: x["count"], reverse=True)
