        "track_changes": 1,
        "fields": [
            {"fieldname": "feedback_date", "label": "تاريخ الفيدباك", "fieldtype": "Date", "reqd": 1, "in_list_view": 1},
            {"fieldname": "shift_number", "label": "رقم الوردية", "fieldtype": "Data", "reqd": 1, "in_list_view": 1},
            {"fieldname": "customer_name", "label": "اسم العميل", "fieldtype": "Data", "in_list_view": 1},
            {"fieldname": "customer_phone", "label": "رقم العميل", "fieldtype": "Data", "reqd": 1, "in_list_view": 1},
            {"fieldname": "status", "label": "الحالة", "fieldtype": "Select", "options": "Pending\nCompleted\nClosed", "default": "Pending", "in_list_view": 1},
