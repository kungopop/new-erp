#!/usr/bin/env bash
set -Eeuo pipefail

# Roshdy V27: Feedback module end-to-end
# ----------------------------------------------------------------------
# Adds:
# - Feedback DocType/API
# - Admin page: /feedback-admin (upload/manual/bulk/report/export/close shift)
# - Agent/Admin task page: /feedback (submit feedback)
# - Cards in admin-desk and agent-desk
# - Feedback sections in Upper Management and Customer Service Manager emails
#
# Safety:
# - Backup first.
# - Does NOT touch report_api.py / Elastix / CDR / AMI config.

ROOT="${ROOT:-/opt/frappe_crm}"
SITE="${SITE:-crm.local}"
APP="restaurant_ops"

cd "$ROOT"

if docker compose version >/dev/null 2>&1; then
  COMPOSE=(docker compose)
elif command -v docker-compose >/dev/null 2>&1; then
  COMPOSE=(docker-compose)
else
  echo "❌ docker compose/docker-compose مش موجود"
  exit 1
fi

APP_DIR="$ROOT/apps/$APP"
PKG_DIR="$APP_DIR/$APP"
API_DIR="$PKG_DIR/api"
WWW_DIR="$PKG_DIR/www"
FEEDBACK_API="$API_DIR/feedback_api.py"
UPPER_API="$API_DIR/upper_management_email_api.py"
EMAIL_REPORT="$API_DIR/email_report.py"
ADMIN_HTML="$WWW_DIR/admin-desk.html"
AGENT_HTML="$WWW_DIR/agent-desk.html"
FEEDBACK_HTML="$WWW_DIR/feedback.html"
FEEDBACK_PY="$WWW_DIR/feedback.py"
FEEDBACK_ADMIN_HTML="$WWW_DIR/feedback-admin.html"
FEEDBACK_ADMIN_PY="$WWW_DIR/feedback-admin.py"
TS="$(date +%Y%m%d_%H%M%S)"
BACKUP_DIR="$ROOT/backups/INSTALL_FEEDBACK_MODULE_V27_BEFORE_$TS"
mkdir -p "$BACKUP_DIR"

BACKEND="$(${COMPOSE[@]} ps -q backend || true)"
if [[ -z "$BACKEND" ]]; then
  echo "❌ backend container مش شغال أو مش لاقيه"
  exit 1
fi

bench_exec() {
  "${COMPOSE[@]}" exec -T backend bench --site "$SITE" "$@"
}

echo "============================================================"
echo "🚀 Roshdy V27: Feedback module"
echo "📦 Backup: $BACKUP_DIR"
echo "============================================================"

echo "🧯 Step 1: Backup files + bench backup"
for f in "$FEEDBACK_API" "$UPPER_API" "$EMAIL_REPORT" "$ADMIN_HTML" "$AGENT_HTML" "$FEEDBACK_HTML" "$FEEDBACK_PY" "$FEEDBACK_ADMIN_HTML" "$FEEDBACK_ADMIN_PY"; do
  [[ -e "$f" ]] && cp -a "$f" "$BACKUP_DIR/$(basename "$f").before" || true
done
bench_exec backup --with-files | tee "$BACKUP_DIR/bench_backup_output.txt"

echo "🧩 Step 2: Install feedback API"
cat > "$FEEDBACK_API" <<'PYAPI'
# -*- coding: utf-8 -*-
"""Roshdy Feedback API.
Admin uploads/creates customer feedback tasks by shift number.
Agents/admins complete feedback; admin reports/export; email summaries.
"""

import csv
import io
import json
import re
from collections import Counter, defaultdict

import frappe
from frappe.utils import today, now_datetime, getdate, get_datetime, cstr, cint, flt

FEEDBACK_DT = "Call Center Feedback"
SATISFACTION_OPTIONS = ["ممتاز", "جيد جدا", "جيد", "مقبول"]


def _module_name():
    for name in ("Restaurant Ops", "Restaurant", "Core"):
        try:
            if frappe.db.exists("Module Def", name):
                return name
        except Exception:
            pass
    return "Core"


def _is_admin():
    try:
        if frappe.session.user == "Administrator":
            return True
        roles = set(frappe.get_roles(frappe.session.user))
        return bool(roles.intersection({"System Manager", "Call Center Admin", "Restaurant Manager"}))
    except Exception:
        return False


def _can_feedback():
    try:
        if _is_admin():
            return True
        roles = set(frappe.get_roles(frappe.session.user))
        return "Restaurant Agent" in roles
    except Exception:
        return False


def _employee_for_user(user=None):
    user = user or frappe.session.user
    try:
        if frappe.db.exists("DocType", "Employee"):
            rows = frappe.get_all("Employee", filters={"user_id": user}, fields=["name", "employee_name"], limit_page_length=1)
            if rows:
                return rows[0].get("name"), rows[0].get("employee_name") or rows[0].get("name")
    except Exception:
        pass
    try:
        return "", frappe.db.get_value("User", user, "full_name") or user
    except Exception:
        return "", user


def _has_field(dt, fn):
    try:
        return frappe.get_meta(dt).has_field(fn)
    except Exception:
        return False


@frappe.whitelist()
