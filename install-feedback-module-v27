            {"fieldname": "satisfaction", "label": "درجة الرضاء", "fieldtype": "Select", "options": "\nممتاز\nجيد جدا\nجيد\nمقبول", "in_list_view": 1},
            {"fieldname": "details", "label": "التفاصيل", "fieldtype": "Small Text"},
