ing(x||'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}function fileHtml(f){let url=f.file_url||'';let name=f.file_name||url;let img=/\.(png|jpg|jpeg|gif|webp)$/i.test(url);return '<a href="'+esc(url)+'" target="_blank">'+(img?'<img src="'+esc(url)+'">':'📎')+'<br>'+esc(name)+'</a>'}async function load(){let name=new URLSearchParams(location.search).get('name');if(!name){content.textContent='No complaint name';return}let d=await api(M(['restaurant','_ops.api.quality','_api.get_complaint_full']),{name:name});if(!d||!d.success){content.textContent=(d&&d.message)||'تعذر التحميل';return}let c=d.complaint||{};let html='<h2>'+esc(c.name)+'</h2><div class="grid">';['customer_name','phone_number','complaint_source','complaint_category','complaint_priority','status','complaint_datetime','opened_by_agent','shift','shift_leader','assigned_quality_inspector','resolved_by','resolved_at'].forEach(k=>{if(c[k])html+='<div class="kv"><b>'+esc(k)+'</b><br>'+esc(c[k])+'</div>'});html+='</div><div class="card"><h3>تفاصيل الشكوى</h3><div style="white-space:pre-wrap">'+esc(c.complaint_details)+'</div></div><div class="card"><h3>تحليل الجودة</h3><b>تحليل التحقيق:</b><div style="white-space:pre-wrap">'+esc(c.investigation_analysis)+'</div><br><b>الإجراء التصحيحي:</b><div style="white-space:pre-wrap">'+esc(c.corrective_action)+'</div><br><b>ملاحظات الإغلاق:</b><div style="white-space:pre-wrap">'+esc(c.closing_notes)+'</div></div><div class="card"><h3>المرفقات</h3><div class="att">'+((d.attachments||[]).length?(d.attachments||[]).map(fileHtml).join(''):'لا توجد مرفقات')+'</div></div>';content.innerHTML=html}load();</script></body></html>
