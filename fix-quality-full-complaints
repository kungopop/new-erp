import json
from datetime import datetime, time

import frappe
from frappe.utils import now_datetime, getdate, add_days

QUALITY_ROLES = {'Complaint_Quality_User', 'Call Center Admin', 'System Manager'}
OPEN_STATUSES = {'Draft', 'Open'}
UNDER_REVIEW_STATUSES = {'Under Review'}
RESOLVED_STATUSES = {'Resolved', 'Closed'}
URGENT_PRIORITIES = {'High', 'Urgent'}
FINANCE_FIELDS = {'has_financial_impact', 'compensation_amount', 'finance_status'}


def _roles():
    try:
        return set(frappe.get_roles(frappe.session.user))
    except Exception:
        return set()


def _allowed():
    user = frappe.session.user
    return user == 'Administrator' or bool(_roles() & QUALITY_ROLES)


def _employee_name():
    try:
        emp = frappe.db.get_value('Employee', {'user_id': frappe.session.user}, 'employee_name')
        return emp or frappe.db.get_value('User', frappe.session.user, 'full_name') or frappe.session.user
    except Exception:
        return frappe.session.user


def _meta_fields():
    return {df.fieldname for df in frappe.get_meta('Call Center Complaint').fields}


def _pick_fields(candidates):
    available = _meta_fields()
    return [f for f in candidates if f in available]


def _default_dates(date_from=None, date_to=None):
    today = getdate()
    if not date_from:
        date_from = today.replace(day=1)
    else:
        date_from = getdate(date_from)
    if not date_to:
        date_to = today
    else:
        date_to = getdate(date_to)
    return date_from, date_to


def _dt_bounds(date_from=None, date_to=None):
    df, dt = _default_dates(date_from, date_to)
    start = datetime.combine(df, time.min)
    end = datetime.combine(add_days(dt, 1), time.min)
    return start, end, df, dt


def _where(date_from=None, date_to=None, status='All', priority='All', search='', assigned='All'):
    start, end, df, dt = _dt_bounds(date_from, date_to)
    date_expr = 'COALESCE(complaint_datetime, creation)' if 'complaint_datetime' in _meta_fields() else 'creation'
    where = [f'{date_expr} >= %s', f'{date_expr} < %s']
    vals = [start, end]
    if status and status != 'All':
        where.append('status=%s'); vals.append(status)
    if priority and priority != 'All':
        where.append('complaint_priority=%s'); vals.append(priority)
    if search:
        like = '%' + str(search).strip() + '%'
        parts = []
        for f in ['name','customer_name','phone_number','complaint_details','complaint_category']:
            if f == 'name' or f in _meta_fields():
                parts.append(f'{f} like %s'); vals.append(like)
        if parts:
            where.append('(' + ' or '.join(parts) + ')')
    if assigned == 'mine' and 'assigned_quality_inspector' in _meta_fields():
        where.append('assigned_quality_inspector=%s'); vals.append(frappe.session.user)
    elif assigned == 'unassigned' and 'assigned_quality_inspector' in _meta_fields():
        where.append("(assigned_quality_inspector is null or assigned_quality_inspector='')")
    return ' and '.join(where), vals, df, dt, date_expr


def _fetch_rows(date_from=None, date_to=None, status='All', priority='All', search='', assigned='All', limit=5000, offset=0):
    base_fields = ['name','customer_name','phone_number','complaint_source','complaint_category','complaint_priority','status','assigned_quality_inspector','investigation_analysis','corrective_action','complaint_details','complaint_datetime','creation','modified','closing_notes','resolved_by','resolved_at','opened_by_agent','shift','shift_leader','call_record_link']
    fields = ['name'] + _pick_fields([f for f in base_fields if f != 'name'])
    where, vals, df, dt, date_expr = _where(date_from, date_to, status, priority, search, assigned)
    limit=max(1,min(int(limit or 5000),10000)); offset=max(0,int(offset or 0))
    sql=f"select {', '.join(fields)} from `tabCall Center Complaint` where {where} order by {date_expr} desc limit {limit} offset {offset}"
    rows=frappe.db.sql(sql, vals, as_dict=True)
    for r in rows:
        r['dt']=str(r.get('complaint_datetime') or r.get('creation') or '')
        r['can_update_quality']=True
    return rows, df, dt


def _stats(rows):
    total=len(rows)
    resolved=sum(1 for r in rows if (r.get('status') or '') in RESOLVED_STATUSES)
    under_review=sum(1 for r in rows if (r.get('status') or '') in UNDER_REVIEW_STATUSES)
    open_count=sum(1 for r in rows if (r.get('status') or '') in OPEN_STATUSES)
    urgent=sum(1 for r in rows if (r.get('complaint_priority') or '') in URGENT_PRIORITIES and (r.get('status') or '') not in RESOLVED_STATUSES)
    reviewed=sum(1 for r in rows if (r.get('investigation_analysis') or r.get('corrective_action') or (r.get('status') or '') in RESOLVED_STATUSES))
    unassigned=sum(1 for r in rows if not r.get('assigned_quality_inspector'))
    mine=sum(1 for r in rows if r.get('assigned_quality_inspector') == frappe.session.user)
    by_status={}; by_priority={}; by_category={}
    for r in rows:
        by_status[r.get('status') or 'غير محدد']=by_status.get(r.get('status') or 'غير محدد',0)+1
        by_priority[r.get('complaint_priority') or 'غير محدد']=by_priority.get(r.get('complaint_priority') or 'غير محدد',0)+1
        by_category[r.get('complaint_category') or 'غير محدد']=by_category.get(r.get('complaint_category') or 'غير محدد',0)+1
    return {'total':total,'open':open_count,'under_review':under_review,'resolved':resolved,'urgent':urgent,'reviewed':reviewed,'unassigned':unassigned,'mine':mine,'by_status':by_status,'by_priority':by_priority,'by_category':by_category}


@frappe.whitelist(allow_guest=False)
def get_quality_dashboard(date_from=None, date_to=None, status='All', priority='All', search='', assigned='All', page=1, page_size=200):
    if not _allowed(): return {'success':False,'message':'Permission denied'}
    rows_all, df, dt = _fetch_rows(date_from,date_to,status,priority,search,assigned,limit=10000)
    page=max(1,int(page or 1)); page_size=max(10,min(int(page_size or 200),500))
    start=(page-1)*page_size; rows=rows_all[start:start+page_size]
    return {'success':True,'employee_name':_employee_name(),'user':frappe.session.user,'date_from':str(df),'date_to':str(dt),'stats':_stats(rows_all),'rows':rows,'total_rows':len(rows_all),'page':page,'page_size':page_size,'total_complaints':len(rows_all),'my_count':len(rows),'my_complaints':rows}


@frappe.whitelist(allow_guest=False)
def get_quality_stats(date_from=None, date_to=None):
    d=get_quality_dashboard(date_from=date_from,date_to=date_to,page_size=5000)
    if not d.get('success'): return d
    st=d.get('stats') or {}
    return {'success':True,'employee_name':d.get('employee_name'),'total_complaints':st.get('total',0),'resolved_complaints':st.get('resolved',0),'open_complaints':st.get('open',0)+st.get('under_review',0),'urgent_complaints':st.get('urgent',0),'stats':st,'date_from':d.get('date_from'),'date_to':d.get('date_to')}


def _file_rows(name):
    try:
        return frappe.get_all('File', filters={'attached_to_doctype':'Call Center Complaint','attached_to_name':name}, fields=['name','file_name','file_url','is_private','file_size','creation','owner'], order_by='creation asc', limit_page_length=200)
    except Exception:
        return []


def _comment_rows(name):
    try:
        return frappe.get_all('Comment', filters={'reference_doctype':'Call Center Complaint','reference_name':name}, fields=['name','comment_type','content','owner','creation'], order_by='creation asc', limit_page_length=200)
    except Exception:
        return []


@frappe.whitelist(allow_guest=False)
def get_complaint_full(name):
    if not _allowed(): return {'success':False,'message':'Permission denied'}
    if not frappe.db.exists('Call Center Complaint', name): return {'success':False,'message':'Complaint not found'}
    doc=frappe.get_doc('Call Center Complaint', name)
    data=doc.as_dict()
    # Hide finance fields from pure quality users unless admin roles.
    roles=_roles()
    if frappe.session.user!='Administrator' and not (roles & {'System Manager','Call Center Admin','Complaint_Finance_User'}):
        for f in FINANCE_FIELDS:
            data.pop(f, None)
    return {'success':True,'complaint':data,'attachments':_file_rows(name),'comments':_comment_rows(name)}


@frappe.whitelist(allow_guest=False)
def get_complaint(name):
    return get_complaint_full(name)


@frappe.whitelist(allow_guest=False)
def update_quality_review(name, assigned_quality_inspector=None, investigation_analysis='', corrective_action='', status='', closing_notes=''):
    if not _allowed(): return {'success':False,'message':'Permission denied'}
    if not frappe.db.exists('Call Center Complaint', name): return {'success':False,'message':'Complaint not found'}
    doc=frappe.get_doc('Call Center Complaint', name)
    meta=_meta_fields()
    if 'assigned_quality_inspector' in meta and assigned_quality_inspector is not None:
        doc.assigned_quality_inspector=assigned_quality_inspector or frappe.session.user
    if 'investigation_analysis' in meta and investigation_analysis is not None:
        doc.investigation_analysis=investigation_analysis or ''
    if 'corrective_action' in meta and corrective_action is not None:
        doc.corrective_action=corrective_action or ''
    if status:
        if status not in {'Draft','Open','Under Review','Closed','Resolved'}: return {'success':False,'message':'Invalid status'}
        doc.status=status
        if status in RESOLVED_STATUSES:
            if 'resolved_by' in meta: doc.resolved_by=frappe.session.user
            if 'resolved_at' in meta: doc.resolved_at=now_datetime()
    if 'closing_notes' in meta and closing_notes is not None:
        doc.closing_notes=closing_notes or ''
    doc.save(ignore_permissions=True)
    frappe.db.commit()
    return {'success':True,'message':'تم حفظ مراجعة الجودة','name':doc.name,'status':doc.status}


