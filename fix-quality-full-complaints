<!DOCTYPE html><html lang="ar" dir="rtl"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Quality Desk</title><style>*{box-sizing:border-box;font-family:'Segoe UI',Tahoma,Arial}body{margin:0;background:#eef2f7;color:#111827;direction:rtl}.top{background:#20262d;color:#fff;padding:14px 22px;display:flex;justify-content:space-between;align-items:center;border-bottom:4px solid #6f42c1}.top a,.top button{color:#fff;text-decoration:none;border:1px solid #64748b;border-radius:10px;padding:8px 12px;margin:2px;background:#1F4E79;cursor:pointer}.wrap{padding:22px;max-width:1600px;margin:auto}.title{text-align:center;color:#1F4E79;margin:12px 0 22px}.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:12px;margin-bottom:16px}.stat{background:#fff;border:1px solid #d8dee9;border-right:5px solid #6f42c1;border-radius:14px;padding:14px;box-shadow:0 6px 18px #0001}.stat .lbl{color:#64748b;font-weight:800;font-size:13px}.stat .num{font-size:30px;font-weight:900;color:#1F4E79}.panel{background:#fff;border:1px solid #d8dee9;border-radius:16px;box-shadow:0 10px 28px #0001;margin-bottom:16px;overflow:hidden}.head{padding:14px 16px;border-bottom:1px solid #e5e7eb;display:flex;justify-content:space-between;gap:10px;align-items:center}.body{padding:16px}.grid{display:grid;grid-template-columns:repeat(6,1fr);gap:10px}label{font-weight:800;color:#475569;font-size:12px}input,select,textarea{width:100%;border:1px solid #d1d5db;border-radius:11px;padding:9px}.btn{border:0;border-radius:11px;padding:10px 13px;background:#1F4E79;color:white;font-weight:800;cursor:pointer;text-decoration:none}.btn.green{background:#16a34a}.btn.orange{background:#f97316}.btn.red{background:#dc2626}.btn.light{background:white;color:#111827;border:1px solid #d1d5db}.tablewrap{overflow:auto}.table{width:100%;border-collapse:collapse;min-width:1100px}.table th{background:#111827;color:#fff;padding:10px;text-align:right}.table td{border:1px solid #e5e7eb;padding:9px;font-size:13px}.tag{border-radius:999px;padding:3px 8px;font-size:12px;font-weight:800}.open{background:#fee2e2;color:#991b1b}.review{background:#fef3c7;color:#92400e}.done{background:#dcfce7;color:#166534}.muted{color:#64748b;font-size:12px}.modal{display:none;position:fixed;inset:0;background:#0008;z-index:99999;align-items:center;justify-content:center;padding:20px}.modal.show{display:flex}.modalbox{background:#fff;border-radius:18px;max-width:1100px;width:100%;max-height:94vh;overflow:auto}.modalhead{padding:14px 18px;background:#20262d;color:#fff;display:flex;justify-content:space-between}.modalbody{padding:18px}.cols{display:grid;grid-template-columns:1fr 1fr;gap:12px}.info{border:1px solid #e5e7eb;background:#f8fafc;border-radius:12px;padding:12px;margin:8px 0}.att{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:8px}.att a{display:block;border:1px solid #ddd;border-radius:10px;padding:8px;text-decoration:none;color:#1F4E79;background:#fff}.att img{max-width:100%;max-height:120px;display:block;margin:auto}@media(max-width:1000px){.grid{grid-template-columns:1fr 1fr}.cols{grid-template-columns:1fr}.top{display:block}}</style></head><body><div class="top"><b>⭐ ديسك الجودة ومتابعة الشكاوى</b><div><a href="/roshdy-logout">خروج</a></div></div><div class="wrap"><h2 class="title" id="welcome">جاري التحميل...</h2><div class="stats"><div class="stat"><div class="lbl">إجمالي الفترة</div><div class="num" id="st_total">0</div></div><div class="stat"><div class="lbl">مفتوحة</div><div class="num" id="st_open">0</div></div><div class="stat"><div class="lbl">قيد المراجعة</div><div class="num" id="st_review">0</div></div><div class="stat"><div class="lbl">تم حلها/إغلاقها</div><div class="num" id="st_resolved">0</div></div><div class="stat"><div class="lbl">عاجلة/High</div><div class="num" id="st_urgent">0</div></div><div class="stat"><div class="lbl">تمت مراجعتها</div><div class="num" id="st_reviewed">0</div></div></div><div class="panel"><div class="head"><b>فلاتر التقرير</b><button class="btn light" onclick="thisMonth()">الشهر الحالي</button></div><div class="body"><div class="grid"><div><label>من تاريخ</label><input type="date" id="date_from"></div><div><label>إلى تاريخ</label><input type="date" id="date_to"></div><div><label>الحالة</label><select id="status"><option>All</option><option>Draft</option><option>Open</option><option>Under Review</option><option>Resolved</option><option>Closed</option></select></div><div><label>الأولوية</label><select id="priority"><option>All</option><option>Low</option><option>Medium</option><option>High</option><option>Urgent</option></select></div><div><label>بحث</label><input id="search" placeholder="رقم/عميل/تفاصيل"></div><div><label>الإسناد</label><select id="assigned"><option value="All">الكل</option><option value="mine">المسند لي</option><option value="unassigned">غير مسند</option></select></div></div><br><button class="btn green" onclick="load()">تحديث</button> <button class="btn orange" onclick="printReport()">طباعة / PDF</button></div></div><div class="panel"><div class="head"><b>الشكاوى</b><span class="muted" id="rowsInfo"></span></div><div class="body tablewrap"><table class="table"><thead><tr><th>رقم</th><th>التاريخ</th><th>العميل</th><th>الهاتف</th><th>الفئة</th><th>الأولوية</th><th>الحالة</th><th>المفتش</th><th>فتح</th></tr></thead><tbody id="tb"><tr><td colspan="9">جاري التحميل...</td></tr></tbody></table></div></div></div><div class="modal" id="modal"><div class="modalbox"><div class="modalhead"><b id="m_title">شكوى</b><button class="btn red" onclick="closeModal()">X</button></div><div class="modalbody"><div id="m_info" class="info"></div><div id="m_attach" class="info"></div><br><div class="cols"><div><label>الحالة</label><select id="m_status"><option>Draft</option><option>Open</option><option>Under Review</option><option>Resolved</option><option>Closed</option></select></div><div><label>مسؤول الجودة</label><input id="m_assigned" placeholder="email أو اتركها للمستخدم الحالي"></div></div><br><label>تحليل التحقيق</label><textarea id="m_analysis" rows="5"></textarea><br><label>الإجراء التصحيحي</label><textarea id="m_action" rows="3"></textarea><br><label>ملاحظات الإغلاق</label><textarea id="m_closing" rows="3"></textarea><br><button class="btn green" onclick="saveComplaint()">حفظ مراجعة الجودة</button> <button class="btn light" onclick="openFullPage()">فتح صفحة كاملة</button> <button class="btn orange" onclick="printComplaint()">طباعة الشكوى PDF</button><pre id="m_debug" class="muted"></pre></div></div></div><script>let current=null;function M(a){return a.join('')}async function api(method,args){let qs=new URLSearchParams();args=args||{};Object.keys(args).forEach(k=>{if(args[k]!==undefined&&args[k]!==null)qs.append(k,args[k])});let r=await fetch('/api/method/'+method+(qs.toString()?'?'+qs.toString():''),{credentials:'same-origin',cache:'no-store'});let j=await r.json();return j.message}function esc(x){return String(x||'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}function todayISO(d){return d.toISOString().slice(0,10)}function thisMonth(){let d=new Date();date_from.value=todayISO(new Date(d.getFullYear(),d.getMonth(),1));date_to.value=todayISO(d);load()}function tagStatus(s){let cls=(s==='Resolved'||s==='Closed')?'done':(s==='Under Review'?'review':'open');return '<span class="tag '+cls+'">'+esc(s||'')+'</span>'}async function load(){let d=await api(M(['restaurant','_ops.api.quality','_api.get_quality_dashboard']),{date_from:date_from.value,date_to:date_to.value,status:status.value,priority:priority.value,search:search.value,assigned:assigned.value,page_size:500});if(!d||!d.success){tb.innerHTML='<tr><td colspan="9">'+esc((d&&d.message)||'تعذر التحميل')+'</td></tr>';return}welcome.textContent='⭐ ديسك الجودة — أهلاً '+(d.employee_name||'');let s=d.stats||{};st_total.textContent=s.total||0;st_open.textContent=s.open||0;st_review.textContent=s.under_review||0;st_resolved.textContent=s.resolved||0;st_urgent.textContent=s.urgent||0;st_reviewed.textContent=s.reviewed||0;rowsInfo.textContent='الفترة '+d.date_from+' إلى '+d.date_to+' — عدد '+(d.total_rows||0);let rows=d.rows||[];tb.innerHTML=rows.length?rows.map(r=>'<tr><td>'+esc(r.name)+'</td><td>'+esc(r.dt)+'</td><td>'+esc(r.customer_name)+'</td><td>'+esc(r.phone_number)+'</td><td>'+esc(r.complaint_category)+'</td><td>'+esc(r.complaint_priority)+'</td><td>'+tagStatus(r.status)+'</td><td>'+esc(r.assigned_quality_inspector)+'</td><td><button class="btn" onclick="openComplaint(\''+esc(r.name)+'\')">فتح/مراجعة</button></td></tr>').join(''):'<tr><td colspan="9">لا توجد شكاوى في الفترة</td></tr>'}function fileHtml(f){let url=f.file_url||'';let name=f.file_name||url;let img=/\.(png|jpg|jpeg|gif|webp)$/i.test(url);return '<a href="'+esc(url)+'" target="_blank">'+(img?'<img src="'+esc(url)+'">':'📎')+'<br>'+esc(name)+'</a>'}async function openComplaint(name){let d=await api(M(['restaurant','_ops.api.quality','_api.get_complaint_full']),{name:name});if(!d||!d.success){alert((d&&d.message)||'تعذر الفتح');return}current=d.complaint;m_title.textContent='شكوى '+current.name;m_info.innerHTML='<b>العميل:</b> '+esc(current.customer_name)+' — <b>الهاتف:</b> '+esc(current.phone_number)+'<br><b>الفئة:</b> '+esc(current.complaint_category)+' — <b>الأولوية:</b> '+esc(current.complaint_priority)+' — <b>الحالة:</b> '+esc(current.status)+'<br><b>المصدر:</b> '+esc(current.complaint_source)+' — <b>التاريخ:</b> '+esc(current.complaint_datetime||current.creation)+'<br><b>التفاصيل:</b><br><div style="white-space:pre-wrap">'+esc(current.complaint_details)+'</div>';let files=d.attachments||[];m_attach.innerHTML='<b>المرفقات والصور:</b><div class="att">'+(files.length?files.map(fileHtml).join(''):'<span class="muted">لا توجد مرفقات</span>')+'</div>';m_status.value=current.status||'Open';m_assigned.value=current.assigned_quality_inspector||'';m_analysis.value=current.investigation_analysis||'';m_action.value=current.corrective_action||'';m_closing.value=current.closing_notes||'';m_debug.textContent='';modal.classList.add('show')}function closeModal(){modal.classList.remove('show')}async function saveComplaint(){if(!current)return;let d=await api(M(['restaurant','_ops.api.quality','_api.update_quality_review']),{name:current.name,assigned_quality_inspector:m_assigned.value,investigation_analysis:m_analysis.value,corrective_action:m_action.value,status:m_status.value,closing_notes:m_closing.value});m_debug.textContent=JSON.stringify(d,null,2);if(d&&d.success){await load();}}function openFullPage(){if(current)window.open('/quality-complaint?name='+encodeURIComponent(current.name),'_blank')}async function printComplaint(){if(!current)return;let d=await api(M(['restaurant','_ops.api.quality','_api.export_complaint_html']),{name:current.name});if(d&&d.success){let w=window.open('','_blank');w.document.write(d.html);w.document.close()}else alert((d&&d.message)||'تعذر الطباعة')}async function printReport(){let d=await api(M(['restaurant','_ops.api.quality','_api.export_quality_report_html']),{date_from:date_from.value,date_to:date_to.value,status:status.value,priority:priority.value,search:search.value,assigned:assigned.value});if(d&&d.success){let w=window.open('','_blank');w.document.write(d.html);w.document.close()}else alert((d&&d.message)||'تعذر الطباعة')}thisMonth();</script></body></html>
