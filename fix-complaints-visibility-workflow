import frappe

ROLES = [
    'Restaurant Agent', 'Call Center Admin', 'Complaint_Quality_User', 'Complaint_Finance_User',
    'Social Inbox Admin', 'Social Inbox Supervisor', 'Social Inbox Agent', 'Desk User'
]


def ensure_role(role):
    if not frappe.db.exists('Role', role):
        frappe.get_doc({'doctype':'Role','role_name':role,'desk_access':1}).insert(ignore_permissions=True)
    else:
        r = frappe.get_doc('Role', role)
        if role != 'Guest' and not r.desk_access:
            r.desk_access = 1
            r.save(ignore_permissions=True)


def append_perm(doc, role, level, read=1, write=0, create=0, delete=0, report=1, export=1, select=1, print_=1):
    doc.append('permissions', {
        'role': role, 'permlevel': int(level), 'select': int(select), 'read': int(read), 'write': int(write),
        'create': int(create), 'delete': int(delete), 'submit': 0, 'cancel': 0, 'amend': 0,
        'report': int(report), 'export': int(export), 'import': 0, 'share': 0, 'print': int(print_), 'email': 0,
        'if_owner': 0,
    })


def fix_doctype():
    dt = 'Call Center Complaint'
    if not frappe.db.exists('DocType', dt):
        print('⚠️ Missing doctype', dt); return
    # Hard delete all old rows for operational roles to eliminate if_owner/bad rows.
    roles = ['Restaurant Agent','Call Center Admin','Complaint_Quality_User','Complaint_Finance_User','Social Inbox Admin','Social Inbox Supervisor','Social Inbox Agent']
    frappe.db.sql('delete from `tabDocPerm` where parent=%s and role in %s', (dt, tuple(roles)))
    frappe.db.commit()

    doc = frappe.get_doc('DocType', dt)
    doc.permissions = [p for p in doc.permissions if p.role not in roles]

    append_perm(doc, 'Call Center Admin', 0, read=1, write=1, create=1, delete=1, report=1, export=1)
    append_perm(doc, 'Call Center Admin', 1, read=1, write=1, create=0, delete=0, report=1, export=1)
    append_perm(doc, 'Call Center Admin', 2, read=1, write=1, create=0, delete=0, report=1, export=1)

    append_perm(doc, 'Restaurant Agent', 0, read=1, write=1, create=1, delete=0, report=1, export=0)

    append_perm(doc, 'Complaint_Quality_User', 0, read=1, write=1, create=0, delete=0, report=1, export=1)
    append_perm(doc, 'Complaint_Quality_User', 1, read=1, write=1, create=0, delete=0, report=1, export=1)

    append_perm(doc, 'Complaint_Finance_User', 0, read=1, write=1, create=0, delete=0, report=1, export=1)
    append_perm(doc, 'Complaint_Finance_User', 2, read=1, write=1, create=0, delete=0, report=1, export=1)

    append_perm(doc, 'Social Inbox Agent', 0, read=1, write=0, create=0, delete=0, report=1, export=0)
    append_perm(doc, 'Social Inbox Supervisor', 0, read=1, write=1, create=1, delete=0, report=1, export=1)
    append_perm(doc, 'Social Inbox Admin', 0, read=1, write=1, create=1, delete=1, report=1, export=1)

    # Turn off user-permission filtering on all Link fields in this doctype.
    for df in doc.fields:
        if df.fieldtype == 'Link':
            df.ignore_user_permissions = 1

    doc.save(ignore_permissions=True)
    frappe.clear_cache(doctype=dt)
    print('✅ DocPerm fixed for global complaint visibility')


def ensure_operational_users_are_desk():
    # Any user with operational roles should be System User + Desk User, so /app list can open.
    op_roles = ['Restaurant Agent','Call Center Admin','Complaint_Quality_User','Complaint_Finance_User','Social Inbox Agent','Social Inbox Supervisor','Social Inbox Admin']
    users = set()
    for role in op_roles:
        users.update(frappe.get_all('Has Role', filters={'role': role, 'parenttype':'User'}, pluck='parent'))
    for u in users:
        if u in ('Administrator','Guest'):
            continue
        try:
            user = frappe.get_doc('User', u)
            user.enabled = 1
            user.user_type = 'System User'
            user.save(ignore_permissions=True)
            if not frappe.db.exists('Has Role', {'parent':u, 'parenttype':'User', 'role':'Desk User'}):
                user.add_roles('Desk User')
            print('✅ Desk access for', u)
        except Exception as e:
            print('⚠️ user skip', u, e)


def run():
    for r in ROLES:
        ensure_role(r)
    frappe.db.commit()
    fix_doctype()
    ensure_operational_users_are_desk()
    frappe.clear_cache()
    frappe.db.commit()
    return {'success': True}
