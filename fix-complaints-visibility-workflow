import frappe

# Roles that can see the global complaint register. Quality Desk may still filter assigned complaints separately.
VISIBLE_ROLES = {
    'System Manager', 'Administrator', 'Call Center Admin', 'Restaurant Agent',
    'Complaint_Quality_User', 'Complaint_Finance_User',
    'Social Inbox Admin', 'Social Inbox Supervisor', 'Social Inbox Agent',
}
WRITE_ROLES = {
    'System Manager', 'Administrator', 'Call Center Admin', 'Restaurant Agent',
    'Complaint_Quality_User', 'Complaint_Finance_User', 'Social Inbox Admin', 'Social Inbox Supervisor',
}
CREATE_ROLES = {'System Manager', 'Administrator', 'Call Center Admin', 'Restaurant Agent', 'Social Inbox Admin', 'Social Inbox Supervisor'}
DELETE_ROLES = {'System Manager', 'Administrator', 'Call Center Admin', 'Social Inbox Admin'}


def _roles(user=None):
    try:
        return set(frappe.get_roles(user or frappe.session.user))
    except Exception:
        return set()


def _ok(user=None, perm='read'):
    user = user or frappe.session.user
    if user == 'Administrator':
        return True
    roles = _roles(user)
    if perm in ('read', 'select', 'report', 'export', 'print'):
        return bool(roles & VISIBLE_ROLES)
    if perm == 'create':
        return bool(roles & CREATE_ROLES)
    if perm == 'delete':
        return bool(roles & DELETE_ROLES)
    if perm in ('write', 'submit', 'cancel', 'amend'):
        return bool(roles & WRITE_ROLES)
    return bool(roles & VISIBLE_ROLES)


def get_permission_query_conditions(user=None):
    # Returning empty string means no row-level restriction for allowed roles.
    if _ok(user, 'read'):
        return ''
    return "`tabCall Center Complaint`.`name` = '__no_access__'"


def has_permission(doc, user=None, permission_type=None):
    return _ok(user, permission_type or 'read')
