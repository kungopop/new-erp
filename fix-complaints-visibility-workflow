cat >> "$APP_DIR/api/quality_api.py" <<'PY'

# ===== ROSHDY QUALITY ASSIGNMENT WORKFLOW FINAL START =====
QUALITY_SUPERVISOR_USERS = {'quality.test@roshdy.com'}


def _qflow_roles():
    try:
        return set(frappe.get_roles(frappe.session.user))
    except Exception:
        return set()


def _qflow_is_manager():
    user = frappe.session.user
    roles = _qflow_roles()
    return user == 'Administrator' or user in QUALITY_SUPERVISOR_USERS or bool(roles & {'System Manager', 'Call Center Admin'})


def _qflow_is_quality_user():
    return 'Complaint_Quality_User' in _qflow_roles()


def _qflow_allowed():
    return _qflow_is_manager() or _qflow_is_quality_user()


def _qflow_status_en(v):
    m = {'مسودة':'Draft','مفتوح':'Open','مفتوحة':'Open','قيد المراجعة':'Under Review','قيد مراجعه':'Under Review','تم الحل':'Resolved','محلولة':'Resolved','مغلق':'Closed','مغلقة':'Closed'}
    s = str(v or '').strip()
    return m.get(s, s)


def _qflow_priority_en(v):
    m = {'منخفضة':'Low','منخفض':'Low','متوسطة':'Medium','متوسط':'Medium','عالية':'High','عالي':'High','عاجلة':'Urgent','عاجل':'Urgent'}
    s = str(v or '').strip()
    return m.get(s, s)


def _qflow_meta_fields():
    try:
        return {df.fieldname for df in frappe.get_meta('Call Center Complaint').fields}
    except Exception:
        return set()


def _qflow_rows(date_from=None, date_to=None, search='', assigned='All'):
    from datetime import datetime, time
    from frappe.utils import getdate, add_days
    meta = _qflow_meta_fields()
    today = getdate()
    df = getdate(date_from) if date_from else today.replace(day=1)
    dt = getdate(date_to) if date_to else today
    start = datetime.combine(df, time.min)
    end = datetime.combine(add_days(dt, 1), time.min)
    date_expr = 'COALESCE(complaint_datetime, creation)' if 'complaint_datetime' in meta else 'creation'
    fields = ['name'] + [f for f in ['customer_name','phone_number','complaint_source','complaint_category','complaint_priority','status','assigned_quality_inspector','investigation_analysis','corrective_action','complaint_details','complaint_datetime','creation','modified','closing_notes','resolved_by','resolved_at','opened_by_agent','shift','shift_leader','call_record_link'] if f in meta]
    where = [f'{date_expr} >= %s', f'{date_expr} < %s']
    vals = [start, end]
    if search:
        like = '%' + str(search).strip() + '%'
        parts=[]
        for f in ['name','customer_name','phone_number','complaint_details','complaint_category']:
            if f == 'name' or f in meta:
                parts.append(f'{f} like %s'); vals.append(like)
        if parts:
            where.append('(' + ' or '.join(parts) + ')')
    # Quality Desk routing: managers/supervisor see all. Pure quality sees only assigned to them.
    if not _qflow_is_manager() and _qflow_is_quality_user() and 'assigned_quality_inspector' in meta:
        where.append('assigned_quality_inspector=%s')
        vals.append(frappe.session.user)
    elif assigned == 'mine' and 'assigned_quality_inspector' in meta:
        where.append('assigned_quality_inspector=%s')
        vals.append(frappe.session.user)
    elif assigned == 'unassigned' and 'assigned_quality_inspector' in meta:
        where.append("(assigned_quality_inspector is null or assigned_quality_inspector='')")
    sql = f"select {', '.join(fields)} from `tabCall Center Complaint` where {' and '.join(where)} order by {date_expr} desc limit 10000"
    rows = frappe.db.sql(sql, vals, as_dict=True)
    for r in rows:
        r['dt'] = str(r.get('complaint_datetime') or r.get('creation') or '')
        r['can_update_quality'] = True
    return rows, df, dt


def _qflow_filter(rows, status='All', priority='All'):
    if status and status != 'All':
        rows = [r for r in rows if _qflow_status_en(r.get('status')) == _qflow_status_en(status)]
    if priority and priority != 'All':
        rows = [r for r in rows if _qflow_priority_en(r.get('complaint_priority')) == _qflow_priority_en(priority)]
    return rows


def _qflow_stats(rows):
    total=len(rows)
    resolved=sum(1 for r in rows if _qflow_status_en(r.get('status')) in {'Resolved','Closed'})
    under=sum(1 for r in rows if _qflow_status_en(r.get('status')) == 'Under Review')
    open_count=sum(1 for r in rows if _qflow_status_en(r.get('status')) in {'Draft','Open'})
    urgent=sum(1 for r in rows if _qflow_priority_en(r.get('complaint_priority')) in {'High','Urgent'} and _qflow_status_en(r.get('status')) not in {'Resolved','Closed'})
    reviewed=sum(1 for r in rows if r.get('investigation_analysis') or r.get('corrective_action') or _qflow_status_en(r.get('status')) in {'Resolved','Closed'})
    unassigned=sum(1 for r in rows if not r.get('assigned_quality_inspector'))
    mine=sum(1 for r in rows if r.get('assigned_quality_inspector') == frappe.session.user)
    return {'total':total,'open':open_count,'under_review':under,'resolved':resolved,'urgent':urgent,'reviewed':reviewed,'unassigned':unassigned,'mine':mine}


@frappe.whitelist(allow_guest=False)
def get_quality_dashboard(date_from=None, date_to=None, status='All', priority='All', search='', assigned='All', page=1, page_size=200):
    if not _qflow_allowed():
        return {'success': False, 'message': 'Permission denied'}
    rows, df, dt = _qflow_rows(date_from, date_to, search, assigned)
    rows = _qflow_filter(rows, status, priority)
    page=max(1,int(page or 1)); page_size=max(10,min(int(page_size or 200),500))
    start=(page-1)*page_size
    try:
        emp = frappe.db.get_value('Employee', {'user_id': frappe.session.user}, 'employee_name') or frappe.db.get_value('User', frappe.session.user, 'full_name') or frappe.session.user
    except Exception:
        emp = frappe.session.user
    return {'success': True, 'employee_name': emp, 'user': frappe.session.user, 'quality_manager_view': _qflow_is_manager(), 'date_from': str(df), 'date_to': str(dt), 'stats': _qflow_stats(rows), 'rows': rows[start:start+page_size], 'total_rows': len(rows), 'page': page, 'page_size': page_size, 'total_complaints': len(rows), 'my_count': len(rows[start:start+page_size]), 'my_complaints': rows[start:start+page_size]}
# ===== ROSHDY QUALITY ASSIGNMENT WORKFLOW FINAL END =====
