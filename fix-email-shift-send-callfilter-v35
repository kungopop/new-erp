def _u35_window(date_from=None):
    ss,se=_u35_shift_times()
    d=getdate(date_from or today())
    sh,sm=[int(x) for x in ss.split(":")]
    eh,em=[int(x) for x in se.split(":")]
    start=datetime.combine(d,time(sh,sm)); end=datetime.combine(d,time(eh,em))
    if end <= start: end += timedelta(days=1)
    return start,end,ss,se


def _u35_call_rows(date_from=None):
    start,end,ss,se=_u35_window(date_from)
    from restaurant_ops.api import report_api
    rows=[]
    for page in range(1,21):
        try:
            res=report_api.get_calls_report(page=page,page_size=1000,view_mode="admin",date_from=start.date().isoformat(),date_to=end.date().isoformat())
        except TypeError:
            res=report_api.get_calls_report(page=page,page_size=1000,view_mode="admin")
        if isinstance(res,dict) and isinstance(res.get("message"),dict): res=res.get("message")
        if not isinstance(res,dict): break
        part=res.get("calls") or res.get("rows") or []
        if not part: break
        rows.extend(part)
        pag=res.get("pagination") or {}
        if page >= cint(pag.get("total_pages") or page): break
    out=[]
    for r in rows:
        try: cd=get_datetime(r.get("calldate") or r.get("call_time") or r.get("time"))
        except Exception: continue
        if start <= cd <= end: out.append(r)
    return out,{"start_dt":start.strftime('%Y-%m-%d %H:%M:%S'),"end_dt":end.strftime('%Y-%m-%d %H:%M:%S'),"shift_start":ss,"shift_end":se}


def _u35_summary(rows):
