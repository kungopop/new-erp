#!/usr/bin/env bash
set -Eeuo pipefail

# Roshdy V35: Fix email shift window + robust test send + call-report employee filter
# ------------------------------------------------------------------------------
# Fixes:
# 1) Email call metrics were counting from 00:00 instead of shift hours.
#    Uses Call Center Settings shift_start_hour / shift_end_hour (e.g. 10 -> 05) when builder shift is default.
# 2) Test email sending can send BOTH reports robustly:
#    - Center Manager report through email_report center renderer
#    - Upper Management report through upper_management_email_api
# 3) Call Report page gets employee/extension filter without editing report_api.py.
#
# Safety:
# - Backup first.
# - Does NOT edit report_api.py.
# - Does NOT touch Elastix/CDR/AMI config.

ROOT="${ROOT:-/opt/frappe_crm}"
SITE="${SITE:-crm.local}"
APP="restaurant_ops"

cd "$ROOT"

if docker compose version >/dev/null 2>&1; then
  COMPOSE=(docker compose)
elif command -v docker-compose >/dev/null 2>&1; then
  COMPOSE=(docker-compose)
else
  echo "❌ docker compose/docker-compose مش موجود"
  exit 1
fi

APP_DIR="$ROOT/apps/$APP"
PKG_DIR="$APP_DIR/$APP"
API_DIR="$PKG_DIR/api"
WWW_DIR="$PKG_DIR/www"
EMAIL_REPORT="$API_DIR/email_report.py"
UPPER_API="$API_DIR/upper_management_email_api.py"
CALL_FILTER_API="$API_DIR/call_filter_api.py"
CALL_REPORT_HTML="$WWW_DIR/call-report.html"
TS="$(date +%Y%m%d_%H%M%S)"
BACKUP_DIR="$ROOT/backups/FIX_EMAIL_SHIFT_SEND_CALLFILTER_V35_BEFORE_$TS"
mkdir -p "$BACKUP_DIR/files"

BACKEND="$(${COMPOSE[@]} ps -q backend || true)"
if [[ -z "$BACKEND" ]]; then
  echo "❌ backend container مش شغال أو مش لاقيه"
  exit 1
fi

bench_exec() { "${COMPOSE[@]}" exec -T backend bench --site "$SITE" "$@"; }

echo "============================================================"
echo "🔧 Roshdy V35: email shift + test send + call employee filter"
echo "📦 Backup: $BACKUP_DIR"
echo "============================================================"

echo "🧯 Step 1: Backup files + bench backup"
for f in "$EMAIL_REPORT" "$UPPER_API" "$CALL_FILTER_API" "$CALL_REPORT_HTML"; do
  [[ -e "$f" ]] && cp -a "$f" "$BACKUP_DIR/files/$(basename "$f").before" || true
done
bench_exec backup --with-files | tee "$BACKUP_DIR/bench_backup_output.txt"

