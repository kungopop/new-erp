    for r in rows:
        if cstr(r.get("smart_category") or "").lower()=="answered" or cstr(r.get("disposition") or "").upper()=="ANSWERED" or "تم الرد" in cstr(r.get("category_label") or ""):
            ans+=1
    return {"total":len(rows),"answered":ans}


@frappe.whitelist()
def get_upper_management_report_data(date_from=None, date_to=None):
    data=_v35_prev_upper_data(date_from=date_from,date_to=date_to) if _v35_prev_upper_data else {"success":True}
    try:
        period=data.get("period") or {}
        df=date_from or period.get("from") or today()
        rows,info=_u35_call_rows(df)
        sm=_u35_summary(rows)
        calls=data.setdefault("calls",{})
        calls["total"]=sm["total"]
        calls["answered"]=sm["answered"]
        calls["shift_window"]=info
        # complaint queue count in same shift
        cq=0
        for r in rows:
            dst=cstr(r.get("dst") or "").strip(); actual=cstr(r.get("actual_ext") or "").strip(); agent=cstr(r.get("agent_name") or "")
            if dst=="123" or (actual=="123" and "طابور" in agent) or cstr(r.get("lastdata") or "").startswith("123,"):
                cq+=1
        data.setdefault("complaint_queue",{})["count"]=cq
        data["shift_window"] = info
    except Exception as e:
        data.setdefault("calls",{})["shift_error"]=cstr(e)
    return data

