# BEGIN ROSHDY EMAIL SHIFT SEND FINAL V35
try:
    import frappe
    from frappe.utils import today, getdate, get_datetime, now_datetime, cstr, cint
    from datetime import datetime, time, timedelta
except Exception:
    pass


def _v35_parse_time_value(v, default="00:00"):
    s = cstr(v if v is not None else "").strip()
    if not s:
        s = default
    # Numeric hour such as 10 or 5.
    try:
        if s.isdigit():
            h = int(s)
            if 0 <= h <= 23:
                return "%02d:00" % h
    except Exception:
        pass
    import re
    m = re.search(r"(\d{1,2}):(\d{2})", s)
    if m:
        h, mm = int(m.group(1)), int(m.group(2))
        if 0 <= h <= 23 and 0 <= mm <= 59:
            return "%02d:%02d" % (h, mm)
    return default


def _v35_call_center_shift_times(st=None):
    # Prefer builder settings if they are explicitly not default.
    ss = cstr((st or {}).get("shift_start") if isinstance(st, dict) else "").strip()
    se = cstr((st or {}).get("shift_end") if isinstance(st, dict) else "").strip()
    if ss and se and not (ss in ("00:00", "0", "") and se in ("23:59", "", "0")):
        return _v35_parse_time_value(ss, "00:00"), _v35_parse_time_value(se, "23:59")
    # Then Call Center Settings numeric fields.
    try:
        start_hour = frappe.db.get_single_value("Call Center Settings", "shift_start_hour")
        end_hour = frappe.db.get_single_value("Call Center Settings", "shift_end_hour")
        if start_hour not in (None, "") and end_hour not in (None, ""):
            return _v35_parse_time_value(start_hour, "00:00"), _v35_parse_time_value(end_hour, "23:59")
    except Exception:
        pass
    return "00:00", "23:59"


def _v35_shift_window(date_from=None, date_to=None, st=None):
    ss, se = _v35_call_center_shift_times(st)
    df = getdate(date_from or today())
    # date_to is ignored for crossing shift; one shift starts on df.
    sh, sm = [int(x) for x in ss.split(":")[:2]]
    eh, em = [int(x) for x in se.split(":")[:2]]
    start_dt = datetime.combine(df, time(sh, sm))
    end_dt = datetime.combine(df, time(eh, em))
    if end_dt <= start_dt:
        end_dt += timedelta(days=1)
    return start_dt, end_dt, ss, se


def _v35_calls_rows_for_shift(date_from=None, date_to=None, st=None):
    start_dt, end_dt, ss, se = _v35_shift_window(date_from, date_to, st)
    from restaurant_ops.api import report_api
    # Ask report_api for the date span covering the shift, then filter in-memory.
    df = start_dt.date().isoformat()
    dt = end_dt.date().isoformat()
    all_rows = []
    first_summary = {}
    for page in range(1, 21):
        try:
            res = report_api.get_calls_report(page=page, page_size=1000, view_mode="admin", date_from=df, date_to=dt)
        except TypeError:
            res = report_api.get_calls_report(page=page, page_size=1000, view_mode="admin")
        if isinstance(res, dict) and isinstance(res.get("message"), dict):
            res = res.get("message")
        if not isinstance(res, dict):
            break
        if page == 1:
            first_summary = res.get("summary") or {}
        rows = res.get("calls") or res.get("rows") or []
        if not rows:
            break
        all_rows.extend(rows)
        pag = res.get("pagination") or {}
        if page >= cint(pag.get("total_pages") or page):
            break
    filtered = []
    for r in all_rows:
        cd = r.get("calldate") or r.get("call_time") or r.get("time")
        if not cd:
            continue
        try:
            cdt = get_datetime(cd)
        except Exception:
            continue
        if start_dt <= cdt <= end_dt:
            filtered.append(r)
    return filtered, {"start_dt": start_dt.strftime("%Y-%m-%d %H:%M:%S"), "end_dt": end_dt.strftime("%Y-%m-%d %H:%M:%S"), "shift_start": ss, "shift_end": se, "asked_date_from": df, "asked_date_to": dt, "raw_summary": first_summary}


def _v35_summarize_rows(rows):
    summary = {"raw_total": len(rows), "total": len(rows), "queue_total": len(rows), "answered": 0, "queue_answered": 0, "declined": 0, "abandoned": 0, "staff_missed": 0}
    for r in rows:
        smart = cstr(r.get("smart_category") or "").lower()
        disp = cstr(r.get("disposition") or "").upper()
        label = cstr(r.get("category_label") or "")
        if smart == "answered" or disp == "ANSWERED" or "تم الرد" in label:
            summary["answered"] += 1
            summary["queue_answered"] += 1
        elif smart in ("busy", "declined") or disp in ("BUSY", "FAILED"):
            summary["declined"] += 1
        elif smart == "abandoned":
            summary["abandoned"] += 1
        elif smart in ("staff_missed", "employee_missed"):
            summary["staff_missed"] += 1
    qt = summary["queue_total"] or 0
    raw = summary["raw_total"] or 0
    summary["answer_rate_of_queue"] = round(summary["queue_answered"] * 100 / qt, 2) if qt else 0
    summary["queue_reach_rate_of_all"] = round(qt * 100 / raw, 2) if raw else 0
    return summary


# Override old simple metrics used by legacy center report.
def _metrics(mode="admin"):
    rows, info = _v35_calls_rows_for_shift(today(), today())
    sm = _v35_summarize_rows(rows)
    sm["shift_window"] = info
    return sm


# Override customizer period args.
def _er_period_args(st=None):
    st = st or _er_get_customizer()
    dt = today()
    ss, se = _v35_call_center_shift_times(st)
    return dt, dt, ss, se


# Override advanced builder period args.
def _adv_period(st):
    dt = today()
    ss, se = _v35_call_center_shift_times(st)
    return dt, dt, ss, se


try:
    _v35_previous_send_report_now = send_report_now
except Exception:
    _v35_previous_send_report_now = None


@frappe.whitelist()
def send_report_now(report_type="both", **kwargs):
    """Robust send from email customizer.
    both => sends center + upper independently and returns both statuses.
    """
    rt = cstr(report_type or kwargs.get("report_type") or "both").lower()
    settings = frappe.get_single("Call Center Settings")
    center = None
    upper = None
    if rt in ("center", "service", "manager", "customer_service"):
        if 'send_center_manager_report' in globals():
            return send_center_manager_report(settings)
        return _v35_previous_send_report_now(report_type="center")
    if rt in ("upper", "management", "upper_management"):
        from restaurant_ops.api.upper_management_email_api import send_upper_management_report
        return send_upper_management_report(**kwargs)
    # both
    try:
        if 'send_center_manager_report' in globals():
            center = send_center_manager_report(settings)
        else:
            center = _v35_previous_send_report_now(report_type="center") if _v35_previous_send_report_now else {"success": False, "message": "center sender missing"}
    except Exception as e:
        center = {"success": False, "message": cstr(e)}
    try:
        from restaurant_ops.api.upper_management_email_api import send_upper_management_report
        upper = send_upper_management_report(**kwargs)
    except Exception as e:
        upper = {"success": False, "message": cstr(e)}
    ok = bool(center and center.get("success")) and bool(upper and upper.get("success"))
    return {"success": ok, "message": "Center: %s | Upper: %s" % ((center or {}).get("message"), (upper or {}).get("message")), "center": center, "upper": upper}


@frappe.whitelist()
def debug_email_shift_window_v35(date_from=None, date_to=None):
    rows, info = _v35_calls_rows_for_shift(date_from or today(), date_to or date_from or today())
    return {"success": True, "shift_window": info, "rows_count": len(rows), "summary": _v35_summarize_rows(rows), "sample": rows[:5]}
