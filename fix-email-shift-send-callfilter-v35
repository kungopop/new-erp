# -*- coding: utf-8 -*-
import re
import frappe
from frappe.utils import cstr, today


def _admin_allowed():
    try:
        if frappe.session.user == "Administrator":
            return True
        roles = set(frappe.get_roles(frappe.session.user))
        return bool(roles.intersection({"System Manager", "Call Center Admin", "Restaurant Manager"}))
    except Exception:
        return False


def _table_cols(table):
    try:
        rows = frappe.db.sql("describe `%s`" % table, as_dict=True)
        return [r.get("Field") for r in rows]
    except Exception:
        return []


def _ext_from_text(text):
    text = cstr(text or "")
    for pat in (r"\((\d{3,6})\)", r"تحويلة\s*(\d{3,6})", r"(?:Local|SIP|PJSIP)/(\d{3,6})", r"\b(\d{3,6})\b"):
        m = re.search(pat, text, re.I)
        if m and m.group(1) not in ("123", "1234"):
            return m.group(1)
    return ""


def _add_option(opts, value, label, source=""):
    value = cstr(value or "").strip()
    if not value:
        return
    if value in ("123", "1234"):
        return
    if not re.match(r"^\d{3,6}$", value):
        return
    if value not in opts:
        opts[value] = {"value": value, "label": label or ("تحويلة " + value), "source": source}


@frappe.whitelist()
def list_call_filter_options(date_from=None, date_to=None):
    if not _admin_allowed():
        frappe.throw("غير مسموح")
    opts = {}

    # 1) Employee extension fields from real DB columns (avoid stale meta columns).
    try:
        cols = _table_cols("tabEmployee")
        ext_cols = [c for c in cols if c and any(x in c.lower() for x in ("extension", "ext", "sip"))]
        select_cols = ["name"]
        if "employee_name" in cols:
            select_cols.append("employee_name")
        if "status" in cols:
            select_cols.append("status")
        select_cols += [c for c in ext_cols if c not in select_cols]
        rows = frappe.db.sql("select %s from `tabEmployee`" % ",".join("`%s`" % c for c in select_cols), as_dict=True)
        for r in rows:
            emp_name = r.get("employee_name") or r.get("name") or ""
            status = r.get("status") or ""
            for c in ext_cols:
                ext = cstr(r.get(c) or "").strip()
                if ext:
                    label = "%s (%s)%s" % (emp_name, ext, "" if status in ("", "Active") else " - " + status)
                    _add_option(opts, ext, label, "Employee." + c)
    except Exception:
        pass

    # 2) Active Extension Sessions.
    try:
        if frappe.db.exists("DocType", "Extension Session"):
            rows = frappe.get_all("Extension Session", filters={"session_status": "active"}, fields=["user", "employee", "extension"], limit_page_length=1000)
            for r in rows:
                ext = cstr(r.get("extension") or "").strip()
                label = cstr(r.get("employee") or r.get("user") or "تحويلة") + " (" + ext + ")"
                _add_option(opts, ext, label, "Extension Session")
    except Exception:
        pass

    # 3) Recent Call Report actual_ext values so unmapped extensions still appear.
    try:
        from restaurant_ops.api import report_api
        res = report_api.get_calls_report(page=1, page_size=1000, view_mode="admin", date_from=date_from or today(), date_to=date_to or date_from or today())
        if isinstance(res, dict) and isinstance(res.get("message"), dict):
            res = res.get("message")
        rows = []
        if isinstance(res, dict):
            rows = res.get("calls") or res.get("rows") or []
        for r in rows:
            ext = cstr(r.get("actual_ext") or "").strip() or _ext_from_text(" ".join([cstr(r.get("agent_name") or ""), cstr(r.get("dstchannel") or "")]))
            if ext:
                agent = cstr(r.get("agent_name") or "").strip()
                label = agent if agent else "تحويلة " + ext
                _add_option(opts, ext, label, "Call Report")
    except Exception:
        pass

    options = sorted(opts.values(), key=lambda x: x.get("label") or x.get("value"))
    return {"success": True, "options": options, "count": len(options)}
PYAPI

