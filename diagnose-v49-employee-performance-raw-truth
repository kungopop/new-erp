    answer_summary.append({'key':key,'label':a.get('label'),'extensions':sorted([x for x in a['extensions'] if x]),'answered_calls':a['answered_calls'],'session_mapped_calls':a['mapped_calls'],'orders':a['orders'],'complaints':a['complaints'],'avg_customer_wait_seconds':avg(a['customer_wait_values']),'max_customer_wait_seconds':max(a['customer_wait_values']) if a['customer_wait_values'] else None,'avg_agent_pickup_seconds':avg(a['agent_pickup_values']),'max_agent_pickup_seconds':max(a['agent_pickup_values']) if a['agent_pickup_values'] else None,'avg_talk_seconds':avg(a['talk_values']),'max_talk_seconds':max(a['talk_values']) if a['talk_values'] else None,'fair_no_answer_calls_active_session_dedup':ring_active_dedup_by.get(key,0),'raw_no_answer_attempts_active_session':ring_active_by.get(key,0)})
answer_summary.sort(key=lambda x:(-x['answered_calls'], -x['fair_no_answer_calls_active_session_dedup'], x['label'] or ''))

# Existing snapshot, if any
existing=None; existing_error=''
try:
    snap_path=frappe.get_site_path('private','files','employee_performance',f'employee_performance_{target_date}.json')
    if os.path.exists(snap_path):
        with open(snap_path,encoding='utf-8') as f: existing=json.load(f)
except Exception as e:
    existing_error=cstr(e)

# Find suspicious differences
problems=[]
if existing:
    problems.append('Existing production snapshot exists; compare existing.employees against fair_candidate.answer_summary.')
if ring_raw_by_ext:
    top_ext, top_cnt=ring_raw_by_ext.most_common(1)[0]
    ded=ring_dedup_by_ext.get(top_ext,0)
    problems.append(f'Raw no-answer attempts top extension {top_ext} = {top_cnt}; dedup by call/ext = {ded}. Raw attempts are not equal to missed customer calls.')
unmapped=sum(1 for r in connect_rows if not r.get('has_session_mapping'))
if unmapped:
    problems.append(f'{unmapped} answered CONNECT rows have no exact employee session mapping; they should not be attributed to an employee without a verified session.')

out={'success':True,'generated_at':fmt(datetime.now()),'target_date':target_date,'window':{'start':fmt(start),'split':fmt(split),'end':fmt(end)},'definitions':{'customer_wait_to_answer_seconds':'وقت انتظار العميل من دخول الطابور حتى الرد CONNECT. ده مؤشر خدمة وليس تقييم موظف وحده.','agent_pickup_seconds':'وقت رن التحويلة التي ردت فعليًا قبل ما الموظف يلتقط المكالمة. ده هو الأنسب لسرعة رد الموظف.','talk_seconds':'مدة الكلام من COMPLETE event أو CDR billsec عند الحاجة.','raw_no_answer_attempts':'عدد أحداث RINGNOANSWER الخام. قد تتكرر لنفس المكالمة ونفس التحويلة، وليست عدد عملاء ضاعوا.','fair_no_answer_calls_active_session_dedup':'عدد مكالمات فريدة رنت على تحويلة مربوطة بموظف وقتها ولم يتم الرد من هذه الرنة. ده الأقرب للعد العادل.'},'queue_log':{'events_loaded':len(events),'calls_seen':len(by_call),'event_counts':dict(event_counts),'queue_counts':dict(queue_counts)},'cdr':{'rows':len(cdr_rows),'error':cdr_error},'sessions':{'rows_used':len(session_debug),'error':session_error,'sample':session_debug[:80]},'phone_normalization_examples':{x:normalize_phone(x) for x in ['01028567017','+201028567017','201028567017','0502727789','+20502727789','20502727789']},'raw_no_answer_by_extension':dict(ring_raw_by_ext.most_common()),'dedup_no_answer_by_extension_call':dict(ring_dedup_by_ext.most_common()),'fair_candidate_employee_summary':answer_summary,'connect_rows_sample':connect_rows[:200],'ring_rows_sample':ring_rows[:200],'existing_snapshot':{'found':bool(existing),'version':(existing or {}).get('version') if existing else None,'generated_at':(existing or {}).get('generated_at') if existing else None,'summary':(existing or {}).get('summary') if existing else None,'employees_sample':(existing or {}).get('employees',[])[:30] if existing else [],'error':existing_error},'problems_detected':problems}
