#!/usr/bin/env bash
set -Eeuo pipefail

# fix-quality-desk
# Fixes Quality Desk issues:
# - Quality users can't open/use complaints reliably from Desk -> adds modal-based Quality Desk and fixes DocType perms.
# - Adds date/month filters, status/priority filters, comprehensive stats.
# - Adds printable/PDF report for quality.
# - Does NOT touch Call Report / Elastix logic except final health checks.

ROOT="/opt/frappe_crm"
SITE="crm.local"
APP_HOST="$ROOT/apps/restaurant_ops"
APP_DIR="$APP_HOST/restaurant_ops"
WWW_DIR="$APP_DIR/www"
TS="$(date +%Y%m%d_%H%M%S)"
BACKUP_DIR="$ROOT/backups/FIX_QUALITY_DESK_BEFORE_$TS"

say(){ echo -e "\n============================================================\n$1\n============================================================"; }

if [[ "${EUID:-$(id -u)}" -ne 0 ]]; then
  echo "❌ شغّل كـ root: sudo -i ثم ./fix-quality-desk"
  exit 1
fi

say "1) Backup قبل إصلاح Quality Desk"
cd "$ROOT"
BACKEND="$(docker compose ps -q backend || true)"
if [[ -z "$BACKEND" ]]; then
  echo "❌ لم أجد backend container. شغّل: cd /opt/frappe_crm && docker compose up -d"
  exit 1
fi
mkdir -p "$BACKUP_DIR"
cp -a "$APP_HOST" "$BACKUP_DIR/restaurant_ops"
[[ -f "$ROOT/docker-compose.yml" ]] && cp -a "$ROOT/docker-compose.yml" "$BACKUP_DIR/docker-compose.yml"
echo "✅ Backup: $BACKUP_DIR"

say "2) Fix permissions for Quality role on Call Center Complaint"
mkdir -p "$APP_DIR/scripts" "$APP_DIR/api" "$WWW_DIR"
cat > "$APP_DIR/scripts/fix_quality_permissions.py" <<'PY'
import frappe


def ensure_role(role):
    if not frappe.db.exists("Role", role):
        frappe.get_doc({"doctype": "Role", "role_name": role, "desk_access": 1}).insert(ignore_permissions=True)
        print("✅ created role", role)
    else:
        doc = frappe.get_doc("Role", role)
        if not doc.desk_access:
            doc.desk_access = 1
            doc.save(ignore_permissions=True)
            print("✅ enabled desk_access", role)


def set_perm(dt, role, permlevel, read=0, write=0, create=0, delete=0, report=0, export=0):
    doc = frappe.get_doc("DocType", dt)
    # remove existing same role+permlevel to avoid duplicates/confusion
    doc.permissions = [p for p in doc.permissions if not (p.role == role and int(p.permlevel or 0) == int(permlevel))]
    doc.append("permissions", {
        "role": role,
        "permlevel": int(permlevel),
        "read": int(read),
        "write": int(write),
        "create": int(create),
        "delete": int(delete),
        "report": int(report),
        "export": int(export),
    })
    doc.save(ignore_permissions=True)
    frappe.clear_cache(doctype=dt)


def run():
    ensure_role("Complaint_Quality_User")
    if frappe.db.exists("DocType", "Call Center Complaint"):
        # Quality must be able to open complaint and update quality section.
        set_perm("Call Center Complaint", "Complaint_Quality_User", 0, read=1, write=1, create=0, delete=0, report=1, export=1)
        set_perm("Call Center Complaint", "Complaint_Quality_User", 1, read=1, write=1, create=0, delete=0, report=1, export=1)
        # no finance access by default
        set_perm("Call Center Complaint", "Complaint_Quality_User", 2, read=0, write=0, create=0, delete=0, report=0, export=0)
        print("✅ Call Center Complaint permissions fixed for Complaint_Quality_User")
    else:
        print("⚠️ Call Center Complaint doctype not found")
    if frappe.db.exists("DocType", "Call Record"):
        try:
            set_perm("Call Record", "Complaint_Quality_User", 0, read=1, write=0, create=0, delete=0, report=1, export=0)
            print("✅ Call Record read permission for quality")
        except Exception as e:
            print("⚠️ Call Record perm skip", e)
    frappe.db.commit()
    return {"success": True}
PY
chmod 644 "$APP_DIR/scripts/fix_quality_permissions.py"

