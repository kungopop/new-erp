import json
from datetime import datetime, date, time, timedelta

import frappe
from frappe.utils import now_datetime, getdate, add_days

QUALITY_ROLES = {"Complaint_Quality_User", "Call Center Admin", "System Manager"}
OPEN_STATUSES = {"Draft", "Open"}
UNDER_REVIEW_STATUSES = {"Under Review"}
RESOLVED_STATUSES = {"Resolved", "Closed"}
URGENT_PRIORITIES = {"High", "Urgent"}


def _roles():
    try:
        return set(frappe.get_roles(frappe.session.user))
    except Exception:
        return set()


def _allowed():
    user = frappe.session.user
    return user == "Administrator" or bool(_roles() & QUALITY_ROLES)


def _quality_only():
    roles = _roles()
    return "Complaint_Quality_User" in roles and not (roles & {"System Manager", "Call Center Admin"}) and frappe.session.user != "Administrator"


def _employee_name():
    try:
        emp = frappe.db.get_value("Employee", {"user_id": frappe.session.user}, "employee_name")
        return emp or frappe.db.get_value("User", frappe.session.user, "full_name") or frappe.session.user
    except Exception:
        return frappe.session.user


def _default_dates(date_from=None, date_to=None):
    today = getdate()
    if not date_from:
        date_from = today.replace(day=1)
    else:
        date_from = getdate(date_from)
    if not date_to:
        date_to = today
    else:
        date_to = getdate(date_to)
    return date_from, date_to


def _dt_bounds(date_from=None, date_to=None):
    df, dt = _default_dates(date_from, date_to)
    start = datetime.combine(df, time.min)
    end = datetime.combine(add_days(dt, 1), time.min)
    return start, end, df, dt


def _where(params, date_from=None, date_to=None, status="", priority="", search="", assigned=""):
    start, end, df, dt = _dt_bounds(date_from, date_to)
    where = ["COALESCE(complaint_datetime, creation) >= %s", "COALESCE(complaint_datetime, creation) < %s"]
    vals = [start, end]
    if status and status != "All":
        where.append("status=%s"); vals.append(status)
    if priority and priority != "All":
        where.append("complaint_priority=%s"); vals.append(priority)
    if search:
        like = "%" + str(search).strip() + "%"
        where.append("(name like %s or customer_name like %s or phone_number like %s or complaint_details like %s)")
        vals += [like, like, like, like]
    if assigned == "mine":
        where.append("assigned_quality_inspector=%s"); vals.append(frappe.session.user)
    elif assigned == "unassigned":
        where.append("(assigned_quality_inspector is null or assigned_quality_inspector='')")
    return " and ".join(where), vals, df, dt


def _fetch_rows(date_from=None, date_to=None, status="", priority="", search="", assigned="", limit=500, offset=0):
    where, vals, df, dt = _where({}, date_from, date_to, status, priority, search, assigned)
    limit = max(1, min(int(limit or 200), 1000))
    offset = max(0, int(offset or 0))
    sql = f"""
        select
            name, customer_name, phone_number, complaint_source, complaint_category, complaint_priority,
            status, assigned_quality_inspector, investigation_analysis, corrective_action,
            complaint_details, complaint_datetime, creation, modified, closing_notes, resolved_by, resolved_at,
            call_record_link
        from `tabCall Center Complaint`
        where {where}
        order by COALESCE(complaint_datetime, creation) desc
        limit {limit} offset {offset}
    """
    rows = frappe.db.sql(sql, vals, as_dict=True)
    for r in rows:
        r["dt"] = str(r.get("complaint_datetime") or r.get("creation") or "")
        r["can_update_quality"] = True
    return rows, df, dt


def _stats(rows):
    total = len(rows)
    resolved = sum(1 for r in rows if (r.status or "") in RESOLVED_STATUSES)
    under_review = sum(1 for r in rows if (r.status or "") in UNDER_REVIEW_STATUSES)
    open_count = sum(1 for r in rows if (r.status or "") in OPEN_STATUSES)
    urgent = sum(1 for r in rows if (r.complaint_priority or "") in URGENT_PRIORITIES and (r.status or "") not in RESOLVED_STATUSES)
    reviewed = sum(1 for r in rows if (r.investigation_analysis or r.corrective_action or (r.status or "") in RESOLVED_STATUSES))
    unassigned = sum(1 for r in rows if not r.assigned_quality_inspector)
    mine = sum(1 for r in rows if r.assigned_quality_inspector == frappe.session.user)
    by_status = {}
    by_priority = {}
    by_category = {}
    for r in rows:
        by_status[r.status or "غير محدد"] = by_status.get(r.status or "غير محدد", 0) + 1
        by_priority[r.complaint_priority or "غير محدد"] = by_priority.get(r.complaint_priority or "غير محدد", 0) + 1
        by_category[r.complaint_category or "غير محدد"] = by_category.get(r.complaint_category or "غير محدد", 0) + 1
    return {
        "total": total,
        "open": open_count,
        "under_review": under_review,
        "resolved": resolved,
        "urgent": urgent,
        "reviewed": reviewed,
        "unassigned": unassigned,
        "mine": mine,
        "by_status": by_status,
        "by_priority": by_priority,
        "by_category": by_category,
    }


@frappe.whitelist(allow_guest=False)
def get_quality_dashboard(date_from=None, date_to=None, status="All", priority="All", search="", assigned="All", page=1, page_size=200):
    if not _allowed():
        return {"success": False, "message": "Permission denied"}
    rows_all, df, dt = _fetch_rows(date_from, date_to, status, priority, search, assigned, limit=5000)
    page = max(1, int(page or 1)); page_size = max(10, min(int(page_size or 200), 500))
    start = (page-1) * page_size
    rows = rows_all[start:start+page_size]
    return {
        "success": True,
        "employee_name": _employee_name(),
        "user": frappe.session.user,
        "date_from": str(df),
        "date_to": str(dt),
        "stats": _stats(rows_all),
        "rows": rows,
        "total_rows": len(rows_all),
        "page": page,
        "page_size": page_size,
        # backwards compatibility for old page
        "total_complaints": len(rows_all),
        "my_count": len(rows),
        "my_complaints": rows,
    }


@frappe.whitelist(allow_guest=False)
def get_quality_stats(date_from=None, date_to=None):
    d = get_quality_dashboard(date_from=date_from, date_to=date_to, page_size=5000)
    if not d.get("success"):
        return d
    st = d.get("stats") or {}
    return {
        "success": True,
        "employee_name": d.get("employee_name"),
        "total_complaints": st.get("total", 0),
        "resolved_complaints": st.get("resolved", 0),
        "open_complaints": st.get("open", 0) + st.get("under_review", 0),
        "urgent_complaints": st.get("urgent", 0),
        "stats": st,
        "date_from": d.get("date_from"),
        "date_to": d.get("date_to"),
    }


@frappe.whitelist(allow_guest=False)
def get_complaint(name):
    if not _allowed():
        return {"success": False, "message": "Permission denied"}
    if not frappe.db.exists("Call Center Complaint", name):
        return {"success": False, "message": "Complaint not found"}
    fields = ["name", "customer_name", "phone_number", "complaint_source", "complaint_category", "complaint_priority", "status", "assigned_quality_inspector", "investigation_analysis", "corrective_action", "complaint_details", "complaint_datetime", "creation", "modified", "closing_notes", "resolved_by", "resolved_at", "call_record_link", "opened_by_agent", "shift", "shift_leader"]
    data = frappe.db.get_value("Call Center Complaint", name, fields, as_dict=True)
    return {"success": True, "complaint": data}


@frappe.whitelist(allow_guest=False)
def update_quality_review(name, assigned_quality_inspector=None, investigation_analysis="", corrective_action="", status="", closing_notes=""):
    if not _allowed():
        return {"success": False, "message": "Permission denied"}
    if not frappe.db.exists("Call Center Complaint", name):
        return {"success": False, "message": "Complaint not found"}
    doc = frappe.get_doc("Call Center Complaint", name)
    if assigned_quality_inspector is not None:
        doc.assigned_quality_inspector = assigned_quality_inspector or frappe.session.user
    if investigation_analysis is not None:
        doc.investigation_analysis = investigation_analysis or ""
    if corrective_action is not None:
        doc.corrective_action = corrective_action or ""
    if status:
        allowed_statuses = {"Draft", "Open", "Under Review", "Closed", "Resolved"}
        if status not in allowed_statuses:
            return {"success": False, "message": "Invalid status"}
        doc.status = status
        if status in RESOLVED_STATUSES:
            doc.resolved_by = frappe.session.user
            doc.resolved_at = now_datetime()
    if closing_notes is not None:
        doc.closing_notes = closing_notes or ""
    doc.save(ignore_permissions=True)
    frappe.db.commit()
    return {"success": True, "message": "تم حفظ مراجعة الجودة", "name": doc.name, "status": doc.status}


def _esc(x):
    import html
    return html.escape(str(x if x is not None else ""))


@frappe.whitelist(allow_guest=False)
def export_quality_report_html(date_from=None, date_to=None, status="All", priority="All", search="", assigned="All"):
    if not _allowed():
