    html = f"""<!doctype html><html lang='ar' dir='rtl'><head><meta charset='utf-8'><title>تقرير الجودة</title><style>body{{font-family:Tahoma,Arial;padding:25px;direction:rtl}}h1{{color:#1F4E79}}.cards{{display:grid;grid-template-columns:repeat(5,1fr);gap:8px;margin:15px 0}}.card{{border:1px solid #ddd;border-radius:10px;padding:10px;text-align:center}}.num{{font-size:24px;font-weight:bold;color:#1F4E79}}table{{width:100%;border-collapse:collapse;margin-top:15px}}th{{background:#111827;color:#fff}}td,th{{border:1px solid #ddd;padding:7px;text-align:right;font-size:12px}}@media print{{button{{display:none}}}}</style></head><body><button onclick='window.print()'>طباعة / حفظ PDF</button><h1>تقرير الجودة ومتابعة الشكاوى</h1><p>الفترة من {_esc(d.get('date_from'))} إلى {_esc(d.get('date_to'))} — المستخدم: {_esc(frappe.session.user)}</p><div class='cards'><div class='card'>الإجمالي<div class='num'>{st.get('total',0)}</div></div><div class='card'>مفتوحة<div class='num'>{st.get('open',0)}</div></div><div class='card'>قيد المراجعة<div class='num'>{st.get('under_review',0)}</div></div><div class='card'>تم حلها<div class='num'>{st.get('resolved',0)}</div></div><div class='card'>عاجلة<div class='num'>{st.get('urgent',0)}</div></div></div><h3>تفاصيل الشكاوى</h3><table><thead><tr><th>رقم</th><th>التاريخ</th><th>العميل</th><th>الهاتف</th><th>الفئة</th><th>الأولوية</th><th>الحالة</th></tr></thead><tbody>{tr}</tbody></table><script>window.print()</script></body></html>"""
    return {"success": True, "html": html}
