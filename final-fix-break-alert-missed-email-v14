def _v14_duration_minutes(start_time, end_time=None):
    if not start_time:
        return 0.0
    try:
        st = get_datetime(start_time)
        en = get_datetime(end_time) if end_time else now_datetime()
        return round(max((en - st).total_seconds(), 0) / 60.0, 1)
    except Exception:
