    # 2) active extension session on extension_at_start
    ext = cstr(doc.get("extension_at_start") or "").strip()
    if ext:
        try:
            u = frappe.db.get_value("Extension Session", {"extension": ext, "session_status": "active"}, "user")
            if u:
                return u
        except Exception:
            pass
    # 3) owner if it is an agent/user, not admin
    owner = doc.get("owner")
    if owner and owner not in ("Administrator", "Guest"):
        return owner
