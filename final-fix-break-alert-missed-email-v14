            "start_time": cstr(r.get("start_time") or ""),
            "duration_minutes": dur,
            "limit_minutes": limit,
            "overdue": overdue,
            "overdue_minutes": round(max(dur - limit, 0), 1),
            "extension": r.get("extension_at_start") or "",
            "notes": r.get("notes") or "",
        })
