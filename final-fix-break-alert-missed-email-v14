          )
        order by coalesce(start_time, creation) asc
        limit 500
    """, as_dict=True)
    now = now_datetime()
    out = []
    overdue_count = 0
    for r in rows:
        dur = _v14_duration_minutes(r.get("start_time"))
        limit = _v14_break_limit_minutes(r.get("break_type"))
        overdue = dur >= limit
        if overdue:
            overdue_count += 1
        out.append({
            "name": r.get("name"),
            "employee": r.get("employee"),
            "employee_name": _v14_employee_name(r.get("employee")),
