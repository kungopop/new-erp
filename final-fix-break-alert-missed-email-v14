  echo "❌ backend container مش شغال أو مش لاقيه"
  exit 1
fi

bench_exec() {
  "${COMPOSE[@]}" exec -T backend bench --site "$SITE" "$@"
}

echo "============================================================"
echo "🚀 Roshdy FINAL V14: break alert + missed employees + email recipients"
echo "📦 Backup: $BACKUP_DIR"
echo "============================================================"

echo "🧯 Step 1: Backup files + bench backup"
for f in "$BREAK_API" "$UPPER_API" "$EMAIL_REPORT" "$MY_BREAK_HTML" "$AGENT_HTML"; do
