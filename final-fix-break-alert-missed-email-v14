        return {"success": False, "active_count": 0, "overdue_count": 0, "rows": [], "error": "Employee Break Log not found"}
    rows = frappe.db.sql("""
        select name, employee, break_type, break_date, status, start_time, end_time,
               duration_seconds, duration_minutes, extension_at_start, notes, creation, owner,
               closed_by, closure_type
        from `tabEmployee Break Log`
        where ifnull(docstatus,0) < 2
          and (
                lower(ifnull(status,'')) in ('active','نشط')
                or (
                    (end_time is null or end_time='')
                    and lower(ifnull(status,'')) not in ('finished','closed','ended','cancelled','canceled','completed','منتهي','مغلق','ملغي')
