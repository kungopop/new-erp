        clauses.append("admin_close_target_user=%s")
        params.append(user)
    clauses.append("owner=%s")
    params.append(user)
    if employees:
        clauses.append("employee in (" + ",".join(["%s"] * len(employees)) + ")")
        params.extend(employees)
    if exts and _v14_meta_has(dt, "extension_at_start"):
        clauses.append("extension_at_start in (" + ",".join(["%s"] * len(exts)) + ")")
        params.extend(exts)
