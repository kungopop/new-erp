# - Does NOT edit restaurant_ops.api.report_api.
# - Does NOT touch Elastix/CDR/AMI config.

ROOT="${ROOT:-/opt/frappe_crm}"
SITE="${SITE:-crm.local}"
APP="restaurant_ops"
