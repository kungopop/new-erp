        from `tabEmployee Break Log`
        where ifnull(docstatus,0)<2
          and (lower(ifnull(status,'')) in ('active','نشط') or (end_time is null and lower(ifnull(status,'')) not in ('finished','closed','ended','cancelled','canceled','completed','منتهي','مغلق','ملغي')))
          and ({' or '.join(clauses)})
        order by coalesce(start_time, creation) desc
        limit 1
    """
    rows = frappe.db.sql(sql, params, as_dict=True)
    if not rows:
        return {"success": False, "message": "لا يوجد بريك نشط لإنهائه"}
    r = rows[0]
    now = now_datetime()
    dur_seconds = 0
    if r.get("start_time"):
