                if any(x in fn for x in ("extension", "ext", "sip")):
                    for emp in emps:
                        v = frappe.db.get_value("Employee", emp, df.fieldname)
                        if v:
                            out.append(cstr(v))
    except Exception:
        pass
    ded = []
    for x in out:
        if x and x not in ded:
            ded.append(x)
