import re
import frappe
BLOCKED = {"admin@roshdy.com", "el.alfy@roshdy.com", "administrator@roshdy.com"}

def _clean(v):
    if not isinstance(v, str) or "@" not in v:
        return v, []
    out = v
    removed = []
    for e in BLOCKED:
        if e.lower() in out.lower():
            out = re.sub(re.escape(e), "", out, flags=re.I)
            removed.append(e)
    out = re.sub(r"[,;]\s*[,;]+", ",", out)
    out = re.sub(r"(^\s*[,;]+|[,;]+\s*$)", "", out).strip()
    out = out.replace("\n\n", "\n").strip()
    return out, removed

def execute():
    rows = frappe.db.sql("select doctype, field, value from `tabSingles` where value like '%%@roshdy.com%%'", as_dict=True)
    changed=[]
    for r in rows:
        new, removed = _clean(r.value or "")
        if removed and new != r.value:
            frappe.db.set_value(r.doctype, None, r.field, new)
            changed.append({"doctype": r.doctype, "field": r.field, "removed": removed})
    frappe.db.commit()
    return {"success": True, "changed": changed, "blocked_in_sendmail_filter": sorted(BLOCKED), "note": "User emails are not deleted; report sendmail filter blocks the non-deliverable ones."}
