        "status": "finished",
        "end_time": now,
        "duration_seconds": dur_seconds,
        "duration_minutes": round(dur_seconds / 60.0, 2),
        "closed_by": user,
        "closure_type": "employee",
    }
    if _v14_meta_has(dt, "admin_close_acknowledged"):
        updates["admin_close_acknowledged"] = 1
    frappe.db.set_value(dt, r.get("name"), updates, update_modified=True)
