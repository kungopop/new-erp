# ===== ROSHDY BROWSER CONNECTOR INGEST START =====
def _browser_secret():
    try:
        return frappe.conf.get("browser_connector_secret") or ""
    except Exception:
        return ""


def _browser_account(channel_type):
    channel_type = channel_type if channel_type in ("Facebook", "Instagram", "TikTok") else "Facebook"
    name = frappe.db.get_value("Social Channel Account", {"channel_type": channel_type, "provider": "Browser Connector"}, "name")
    if name:
        doc = frappe.get_doc("Social Channel Account", name)
    else:
        doc = frappe.get_doc({
            "doctype": "Social Channel Account",
            "account_label": channel_type + " Browser Connector",
            "channel_type": channel_type,
            "provider": "Browser Connector",
            "device_id": "browser-" + channel_type.lower(),
            "phone_label": channel_type,
            "status": "Connected via Browser Connector",
            "active": 1,
            "admin_only_start_chat": 1,
            "allowed_roles": "Social Inbox Admin\nSocial Inbox Supervisor\nSocial Inbox Agent\nCall Center Admin",
        }).insert(ignore_permissions=True)
        frappe.db.commit()
    return doc


def _browser_hash(*parts):
    import hashlib
    raw = "|".join([str(p or "") for p in parts])
    return hashlib.sha256(raw.encode("utf-8", "ignore")).hexdigest()


@frappe.whitelist(allow_guest=True, methods=["POST"])
def browser_connector_ingest():
    """Receive scraped active chat snapshot from the isolated Browser Connector."""
    secret = frappe.get_request_header("X-Roshdy-Connector-Secret") or ""
    expected = _browser_secret()
    if not expected or secret != expected:
        return {"success": False, "message": "Invalid connector secret"}
    import json
    try:
        data = json.loads((frappe.request.get_data() or b"{}").decode("utf-8", "replace"))
    except Exception as e:
        return {"success": False, "message": "Invalid JSON", "error": str(e)}

    channel = data.get("channel_type") or data.get("platform") or "Facebook"
    if str(channel).lower().startswith("insta"):
        channel = "Instagram"
    elif str(channel).lower().startswith("tiktok"):
        channel = "TikTok"
    else:
        channel = "Facebook"

    account = _browser_account(channel)
    customer_name = data.get("customer_name") or "Unknown"
    external_chat_id = data.get("external_chat_id") or data.get("profile_url") or _browser_hash(channel, customer_name)[:18]
    profile_url = data.get("profile_url") or ""

    conv_name = frappe.db.get_value("Social Conversation", {"channel_account": account.name, "external_chat_id": external_chat_id}, "name")
    if conv_name:
        conv = frappe.get_doc("Social Conversation", conv_name)
    else:
        conv = frappe.get_doc({
            "doctype": "Social Conversation",
            "channel_account": account.name,
            "channel_type": channel,
            "external_chat_id": external_chat_id,
            "customer_name": customer_name,
            "customer_phone": "",
            "normalized_phone": "",
            "status": "Open",
            "unread_count": 0,
            "tags": "browser_connector" + ("\nprofile_url=" + profile_url if profile_url else ""),
        }).insert(ignore_permissions=True)

    stored = 0
    messages = data.get("messages") or []
    for m in messages:
        body = (m.get("body") or "").strip()
        if not body:
            continue
        direction = m.get("direction") or "inbound"
        msg_id = m.get("id") or _browser_hash(channel, external_chat_id, direction, body, m.get("created_time") or "")
        if frappe.db.exists("Social Message", {"channel_account": account.name, "external_message_id": msg_id}):
            continue
        msg = frappe.get_doc({
            "doctype": "Social Message",
            "conversation": conv.name,
            "channel_account": account.name,
            "external_message_id": msg_id,
            "event_type": "browser.scrape",
            "direction": direction,
            "sender_id": m.get("sender_id") or external_chat_id,
            "sender_name": m.get("sender_name") or (customer_name if direction == "inbound" else "Page/Admin"),
            "message_type": m.get("message_type") or "text",
            "body": body,
            "message_time": m.get("created_time") or now_datetime(),
            "raw_payload": json.dumps(m, ensure_ascii=False)[:50000],
        }).insert(ignore_permissions=True)
        stored += 1
        conv.last_message = body[:500]
        conv.last_message_at = msg.message_time
        if direction == "inbound":
            conv.unread_count = int(conv.unread_count or 0) + 1

    if customer_name and conv.customer_name != customer_name:
        conv.customer_name = customer_name
    conv.status = "Open"
    conv.save(ignore_permissions=True)
    account.status = "Synced via Browser Connector"
    account.save(ignore_permissions=True)
    frappe.db.commit()
    return {"success": True, "account": account.name, "conversation": conv.name, "stored_messages": stored, "customer_name": customer_name, "external_chat_id": external_chat_id}
# ===== ROSHDY BROWSER CONNECTOR INGEST END =====
PY
