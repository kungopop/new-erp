#!/usr/bin/env bash
set -Eeuo pipefail

# fix-quality-desk-resume
# Resume/fix after error:
# Complaint_Quality_User at permlevel 2 had a DocPerm row with all permissions = 0.
# Frappe rejects any DocPerm row with no basic permissions.
# Correct fix: remove Quality permlevel 2 row entirely, keep level 0 read/write and level 1 read/write.

ROOT="/opt/frappe_crm"
SITE="crm.local"
APP_HOST="$ROOT/apps/restaurant_ops"
APP_DIR="$APP_HOST/restaurant_ops"
TS="$(date +%Y%m%d_%H%M%S)"
BACKUP_DIR="$ROOT/backups/FIX_QUALITY_DESK_RESUME_BEFORE_$TS"

say(){ echo -e "\n============================================================\n$1\n============================================================"; }

if [[ "${EUID:-$(id -u)}" -ne 0 ]]; then
  echo "❌ شغّل كـ root: sudo -i ثم ./fix-quality-desk-resume"
  exit 1
fi

say "1) Backup قبل استكمال إصلاح Quality Desk"
cd "$ROOT"
BACKEND="$(docker compose ps -q backend || true)"
if [[ -z "$BACKEND" ]]; then
  echo "❌ لم أجد backend container. شغّل: cd /opt/frappe_crm && docker compose up -d"
  exit 1
fi
mkdir -p "$BACKUP_DIR"
cp -a "$APP_HOST" "$BACKUP_DIR/restaurant_ops"
[[ -f "$ROOT/docker-compose.yml" ]] && cp -a "$ROOT/docker-compose.yml" "$BACKUP_DIR/docker-compose.yml"
echo "✅ Backup: $BACKUP_DIR"

say "2) كتابة سكريبت صلاحيات مصحح — بدون permlevel 2 للـ Quality"
mkdir -p "$APP_DIR/scripts"
cat > "$APP_DIR/scripts/fix_quality_permissions_v2.py" <<'PY'
import frappe


def ensure_role(role):
    if not frappe.db.exists("Role", role):
        frappe.get_doc({"doctype": "Role", "role_name": role, "desk_access": 1}).insert(ignore_permissions=True)
        print("✅ created role", role)
    else:
        doc = frappe.get_doc("Role", role)
        if not doc.desk_access:
            doc.desk_access = 1
            doc.save(ignore_permissions=True)
            print("✅ enabled desk_access", role)


def append_perm(doc, role, permlevel, read=0, write=0, create=0, delete=0, report=0, export=0, select=0):
    doc.append("permissions", {
        "role": role,
        "permlevel": int(permlevel),
        "select": int(select),
        "read": int(read),
        "write": int(write),
        "create": int(create),
        "delete": int(delete),
        "submit": 0,
        "cancel": 0,
        "amend": 0,
        "report": int(report),
        "export": int(export),
        "import": 0,
        "share": 0,
        "print": int(read),
        "email": 0,
    })


def fix_call_center_complaint():
    dt = "Call Center Complaint"
    if not frappe.db.exists("DocType", dt):
        print("⚠️ Call Center Complaint doctype not found")
        return

    doc = frappe.get_doc("DocType", dt)

    # Remove ALL old Quality permission rows including the bad level 2 row with zero perms.
    doc.permissions = [p for p in doc.permissions if p.role != "Complaint_Quality_User"]

    # Quality can open/read base complaint and save via Desk if needed.
    # Also API uses ignore_permissions after validating role, so this is safe.
    append_perm(doc, "Complaint_Quality_User", 0, select=1, read=1, write=1, create=0, delete=0, report=1, export=1)

    # Quality can read/write only the quality section fields (permlevel 1).
    append_perm(doc, "Complaint_Quality_User", 1, select=1, read=1, write=1, create=0, delete=0, report=1, export=1)

    # IMPORTANT: no permlevel 2 row for Quality. Finance fields stay hidden/not accessible.

    doc.save(ignore_permissions=True)
    frappe.clear_cache(doctype=dt)
    print("✅ Call Center Complaint permissions fixed: Quality level 0/1 only, no level 2")


def fix_call_record():
    dt = "Call Record"
    if not frappe.db.exists("DocType", dt):
        return
    doc = frappe.get_doc("DocType", dt)
    doc.permissions = [p for p in doc.permissions if not (p.role == "Complaint_Quality_User" and int(p.permlevel or 0) == 0)]
    append_perm(doc, "Complaint_Quality_User", 0, select=1, read=1, write=0, create=0, delete=0, report=1, export=0)
    doc.save(ignore_permissions=True)
    frappe.clear_cache(doctype=dt)
    print("✅ Call Record read permission for Quality")


def run():
    ensure_role("Complaint_Quality_User")
    fix_call_center_complaint()
    try:
        fix_call_record()
    except Exception as e:
        print("⚠️ Call Record permission skipped", e)
    frappe.db.commit()
    return {"success": True}
PY
chmod 644 "$APP_DIR/scripts/fix_quality_permissions_v2.py"

say "3) تنفيذ إصلاح الصلاحيات ثم migrate"
docker exec "$BACKEND" bash -lc "find /home/frappe/frappe-bench/apps/restaurant_ops -name '*.pyc' -delete; find /home/frappe/frappe-bench/apps/restaurant_ops -name '__pycache__' -type d -exec rm -rf {} + 2>/dev/null || true"
docker exec "$BACKEND" bench --site "$SITE" execute restaurant_ops.scripts.fix_quality_permissions_v2.run

docker exec "$BACKEND" bench --site "$SITE" migrate

say "4) Clear cache + Restart"
docker exec "$BACKEND" bench --site "$SITE" clear-cache || true
docker exec "$BACKEND" bench --site "$SITE" clear-website-cache || true
docker compose restart backend frontend websocket queue-short queue-long scheduler
sleep 10
BACKEND="$(docker compose ps -q backend)"

say "5) Validation Quality"
echo "--- quality dashboard api ---"
docker exec "$BACKEND" bench --site "$SITE" execute restaurant_ops.api.quality_api.get_quality_dashboard --kwargs '{"page_size":5}' || true

echo "--- permissions check: Complaint_Quality_User on Call Center Complaint ---"
docker exec "$BACKEND" bench --site "$SITE" execute frappe.db.sql --args '["select role, permlevel, `select`, `read`, `write`, `create`, `delete`, report, export from `tabDocPerm` where parent=\"Call Center Complaint\" and role=\"Complaint_Quality_User\" order by permlevel"]' || true

echo "--- ensure no bad level 2 quality row ---"
docker exec "$BACKEND" bench --site "$SITE" execute frappe.db.sql --args '["select name, role, permlevel, `read`, `write`, `create`, `delete` from `tabDocPerm` where parent=\"Call Center Complaint\" and role=\"Complaint_Quality_User\" and permlevel=2"]' || true

echo "--- Page HTTP status ---"
for page in quality-desk call-report admin-desk; do
  code="$(curl -s -o /dev/null -w '%{http_code}' "http://127.0.0.1/$page" || true)"
  echo "$page => $code"
done

say "6) Health Check مهم: Elastix/CDR/AMI + Queue + Call Report"
echo "--- Asterisk/Elastix diagnostics ---"
docker exec "$BACKEND" bench --site "$SITE" execute restaurant_ops.api.asterisk_bridge.run_full_system_diagnostics || true

echo "--- Queue status ---"
docker exec "$BACKEND" bench --site "$SITE" execute restaurant_ops.api.queue_api.get_queue_status || true

echo "--- Calls report admin sample ---"
docker exec "$BACKEND" bench --site "$SITE" execute restaurant_ops.api.report_api.get_calls_report --kwargs '{"page":1,"page_size":5,"view_mode":"admin"}' || true

say "✅ Quality Desk resume fixed يا زعيم"
echo "افتح: http://$(hostname -I | awk '{print $1}')/quality-desk"
echo "سبب العطل كان إن Frappe بيرفض Permission row كلها أصفار في level 2. شلنا level 2 للجودة وخليّنا level 0/1 بس."
echo "Backup: $BACKUP_DIR"
