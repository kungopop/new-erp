# ===== ROSHDY SOCIAL FINAL FIX OVERRIDES =====
def _conf_value(key, default=""):
    try:
        return frappe.conf.get(key) or default
    except Exception:
        return default


def _clean_social_url(url):
    import re
    url = str(url or "").strip()
    m = re.search(r'https?://[^\]\)\s]+', url)
    return (m.group(0) if m else url).rstrip('/')


def _password(doc, field):
    # For canonical GOWA account, site_config is the final source of truth.
    try:
        if doc and getattr(doc, "provider", "") == "GOWA WhatsApp Web" and getattr(doc, "channel_type", "") == "WhatsApp":
            if field == "api_password":
                v = _conf_value("social_gowa_password")
                if v:
                    return v
            if field == "webhook_secret":
                v = _conf_value("social_gowa_webhook_secret")
                if v:
                    return v
    except Exception:
        pass
    try:
        v = doc.get_password(field)
        if v:
            return v
    except Exception:
        pass
    try:
        from frappe.utils.password import get_decrypted_password
        v = get_decrypted_password(doc.doctype, doc.name, field, raise_exception=False)
        if v:
            return v
    except Exception:
        pass
    try:
        v = frappe.db.get_value(doc.doctype, doc.name, field)
        if v and str(v).strip() and str(v).strip() != "*****":
            return v
    except Exception:
        pass
    return ""


def _set_password(doc, fieldname, value):
    if value is None or value == "":
        return
    try:
        if hasattr(doc, "set_password"):
            doc.set_password(fieldname, value)
            return
    except Exception:
        pass
    try:
        from frappe.utils.password import set_encrypted_password
        set_encrypted_password(doc.doctype, doc.name, value, fieldname)
        return
    except Exception:
        pass
    try:
        frappe.db.set_value(doc.doctype, doc.name, fieldname, value, update_modified=False)
    except TypeError:
        frappe.db.set_value(doc.doctype, doc.name, fieldname, value)


def _is_gowa(doc):
    return bool(doc and doc.channel_type == "WhatsApp" and doc.provider == "GOWA WhatsApp Web")


def _social_first_account():
    return (
        frappe.db.get_value("Social Channel Account", {"provider": "GOWA WhatsApp Web", "channel_type": "WhatsApp", "active": 1}, "name")
        or frappe.db.get_value("Social Channel Account", {"provider": "GOWA WhatsApp Web", "channel_type": "WhatsApp"}, "name")
    )


def _social_account(account_name=None):
    name = account_name or _social_first_account()
    return frappe.get_doc("Social Channel Account", name) if name and frappe.db.exists("Social Channel Account", name) else None


def _require_gowa(account):
    if not account:
        return False, {"success": False, "message": "لا يوجد حساب WhatsApp/GOWA محفوظ"}
    if not _is_gowa(account):
        return False, {"success": False, "message": "هذا الحساب ليس WhatsApp GOWA. فيسبوك/إنستجرام/تيك توك يحتاج Browser Connector منفصل."}
    if not account.api_base_url:
        account.api_base_url = _conf_value("social_gowa_base_url")
    if not account.api_username:
        account.api_username = _conf_value("social_gowa_username", "roshdy_admin")
    if not account.device_id:
        account.device_id = _conf_value("social_gowa_device_id", "orders_wa_1")
    if not account.api_base_url:
        return False, {"success": False, "message": "API Base URL missing للحساب المختار"}
    if not account.api_username or not _password(account, "api_password"):
        return False, {"success": False, "message": "GOWA username/password غير متاحين حتى من site_config"}
    return True, None


@frappe.whitelist(allow_guest=False)
def debug_gowa_auth(account_name=None):
    if not _is_admin():
        return _deny("للأدمن فقط")
    account = _social_account(account_name)
    if not account:
        return {"success": False, "message": "No GOWA account"}
    _require_gowa(account)
    pwd = _password(account, "api_password")
    secret = _password(account, "webhook_secret")
    return {
        "success": True,
        "account": account.name,
        "provider": account.provider,
        "api_base_url": account.api_base_url,
        "api_username": account.api_username,
        "password_present": bool(pwd),
        "password_length": len(pwd or ""),
        "password_source": "site_config_for_gowa",
        "secret_present": bool(secret),
        "secret_length": len(secret or ""),
        "device_id": account.device_id,
    }


@frappe.whitelist(allow_guest=False)
def list_accounts():
    if not _has_access():
        return _deny()
    rows = frappe.get_all(
        "Social Channel Account",
        fields=["name", "account_label", "channel_type", "provider", "device_id", "phone_label", "status", "active", "api_base_url", "api_username", "admin_only_start_chat", "allowed_roles", "allowed_users"],
        order_by="active desc, channel_type asc, provider desc, modified desc",
        limit_page_length=300,
    )
    return {"success": True, "accounts": rows, "is_admin": _is_admin()}


@frappe.whitelist(allow_guest=False)
def test_account(account_name):
    if not _has_access():
        return _deny()
    doc = _social_account(account_name)
    ok, err = _require_gowa(doc)
    if not ok:
        return err
    health = _http_request("GET", _clean_social_url(doc.api_base_url) + "/health", account=doc)
    status = _http_request("GET", _clean_social_url(doc.api_base_url) + "/app/status", account=doc, headers={"X-Device-Id": doc.device_id or ""}) if doc.device_id else None
    try:
        res = status.get("data", {}).get("results") if isinstance(status, dict) and isinstance(status.get("data"), dict) else None
        if isinstance(res, dict):
            doc.status = "Logged In" if res.get("is_logged_in") else ("Connected" if res.get("is_connected") else "Disconnected")
            doc.save(ignore_permissions=True)
            frappe.db.commit()
    except Exception:
        pass
    return {"success": True, "health": health, "status": status}


def _join_url(base, path):
    return _clean_social_url(base) + "/" + path.lstrip("/")


def _gowa_paths(path):
    path = "/" + path.lstrip("/")
    return [path, "/api" + path] if not path.startswith("/api/") else [path, path[4:]]


def _gowa_call(account, method, path, json_body=None, headers=None, timeout=25):
    ok, err = _require_gowa(account)
    if not ok:
        return {"ok": False, "status_code": 0, "data": err, "text": err.get("message"), "path_used": path}
    last = None
    for p in _gowa_paths(path):
        res = _http_request(method, _join_url(account.api_base_url, p), account=account, headers=headers or {}, json_body=json_body, timeout=timeout)
        res["path_used"] = p
        last = res
        txt = str(res.get("text") or res.get("data") or "")[:120].lower()
        if res.get("status_code") != 404 and "cannot" not in txt:
            return res
    return last or {"ok": False, "status_code": 0, "data": None, "text": "No response", "path_used": path}


@frappe.whitelist(allow_guest=False)
def gowa_devices(account_name=None):
    if not _is_admin():
        return _deny("إدارة أجهزة واتساب للأدمن فقط")
    account = _social_account(account_name)
