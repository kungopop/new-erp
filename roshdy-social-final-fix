    device_id = (device_id or account.device_id or _conf_value("social_gowa_device_id", "orders_wa_1")).strip()
    res = _gowa_call(account, "POST", "/devices", json_body={"device_id": device_id})
    account.device_id = device_id
    if account_label:
        account.account_label = account_label
    account.phone_label = account.phone_label or device_id
    account.save(ignore_permissions=True)
    frappe.db.commit()
    return {"success": True, "device_id": device_id, "response": res}


@frappe.whitelist(allow_guest=False)
def gowa_status(account_name=None, device_id=None):
