from pathlib import Path
import re
p = Path('/opt/frappe_crm/apps/restaurant_ops/restaurant_ops/www/admin-desk.html')
if not p.exists():
    print('⚠️ admin-desk.html missing')
    raise SystemExit
s = p.read_text(errors='ignore')
patterns = [
    r'<!-- ROSHDY_SOCIAL_INBOX_ADMIN_LINK_START -->[\s\S]*?<!-- ROSHDY_SOCIAL_INBOX_ADMIN_LINK_END -->',
    r'<style[^>]*id=["\']roshdy-social-admin-style["\'][\s\S]*?</style>\s*',
    r'<div[^>]*id=["\']roshdySocialAdminDock["\'][\s\S]*?</div>\s*',
]
for pat in patterns:
    s = re.sub(pat, '', s, flags=re.I)
s = s.replace('{#', '{ #')
block = '''
<!-- ROSHDY_SOCIAL_INBOX_ADMIN_LINK_START -->
<div id="roshdySocialAdminDock" style="position:fixed;left:18px;top:86px;z-index:99999;display:flex;flex-direction:column;gap:8px;direction:rtl;font-family:Tahoma,Arial">
  <a href="/social-inbox" style="background:#10b981;color:#fff;text-decoration:none;border-radius:14px;padding:10px 13px;box-shadow:0 8px 24px rgba(0,0,0,.14);font-weight:800">💬 Social Inbox</a>
  <a href="/social-settings" style="background:#1F4E79;color:#fff;text-decoration:none;border-radius:14px;padding:10px 13px;box-shadow:0 8px 24px rgba(0,0,0,.14);font-weight:800">⚙️ Social Settings</a>
</div>
<!-- ROSHDY_SOCIAL_INBOX_ADMIN_LINK_END -->
'''
if '<body' in s.lower():
    s = re.sub(r'(<body[^>]*>)', r'\1\n' + block, s, count=1, flags=re.I)
