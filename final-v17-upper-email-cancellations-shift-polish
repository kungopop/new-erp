#   restaurant_ops.api.report_api.get_staff_missed_attempts(date_from,date_to,15)
# - No misleading conflict: answered calls are shown as answered; missed employee attempts are shown as attempts inside queue.
# - Removes technical wording: Busy/Declined / Call Report / staff_missed labels from the management email.
# - Open complaints are highlighted first.
# - Complaint queue wording is human-friendly, no "Queue 123".
# - Cancellation reason is management-friendly.
# - Adds "رقم الوردية" to cancellation DocType/API/full page/admin desk/email.
# - Does NOT edit report_api.py / Elastix / CDR / AMI config.

ROOT="${ROOT:-/opt/frappe_crm}"
SITE="${SITE:-crm.local}"
APP="restaurant_ops"

cd "$ROOT"

if docker compose version >/dev/null 2>&1; then
  COMPOSE=(docker compose)
elif command -v docker-compose >/dev/null 2>&1; then
  COMPOSE=(docker-compose)
else
  echo "❌ docker compose/docker-compose مش موجود"
  exit 1
fi

APP_DIR="$ROOT/apps/$APP"
PKG_DIR="$APP_DIR/$APP"
WWW_DIR="$PKG_DIR/www"
API_DIR="$PKG_DIR/api"
SCRIPTS_DIR="$PKG_DIR/scripts"
UPPER_API="$API_DIR/upper_management_email_api.py"
ADMIN_HTML="$WWW_DIR/admin-desk.html"
CANCEL_HTML="$WWW_DIR/order-cancellations-report.html"
TS="$(date +%Y%m%d_%H%M%S)"
BACKUP_DIR="$ROOT/backups/FINAL_V17_UPPER_EMAIL_CANCEL_SHIFT_BEFORE_$TS"
mkdir -p "$BACKUP_DIR" "$SCRIPTS_DIR"

BACKEND="$(${COMPOSE[@]} ps -q backend || true)"
if [[ -z "$BACKEND" ]]; then
  echo "❌ backend container مش شغال أو مش لاقيه"
  exit 1
fi

bench_exec() {
  "${COMPOSE[@]}" exec -T backend bench --site "$SITE" "$@"
}

echo "============================================================"
echo "🚀 Roshdy FINAL V17: upper email + missed attempts + shift number"
echo "📦 Backup: $BACKUP_DIR"
echo "============================================================"

echo "🧯 Step 1: Backup files + bench backup"
for f in "$UPPER_API" "$ADMIN_HTML" "$CANCEL_HTML"; do
  [[ -f "$f" ]] && cp -a "$f" "$BACKUP_DIR/$(basename "$f").before"
done
bench_exec backup --with-files | tee "$BACKUP_DIR/bench_backup_output.txt"

APP_OWNER="$(stat -c '%u:%g' "$APP_DIR" 2>/dev/null || echo '')"

echo "🧱 Step 2: Ensure cancellation shift_number field"
cat > "$SCRIPTS_DIR/setup_cancellation_shift_number_v17.py" <<'PY'
