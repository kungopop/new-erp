[[ -n "$APP_OWNER" ]] && chown "$APP_OWNER" "$SCRIPTS_DIR/setup_cancellation_shift_number_v17.py" 2>/dev/null || true
bench_exec execute restaurant_ops.scripts.setup_cancellation_shift_number_v17.execute | tee "$BACKUP_DIR/setup_cancellation_shift_number_v17.txt"

