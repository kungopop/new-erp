import sys,json,re,os,datetime
full_path, peers_path, sw_base, ep_base, old_status_raw = sys.argv[1:6]
now=datetime.datetime.now(); cutoff60=now-datetime.timedelta(minutes=60); cutoff15=now-datetime.timedelta(minutes=15)
try: old=json.loads(old_status_raw)
except Exception: old={}
trunk_names=['SIP_TRUNK_TEdata','trunk_to_cisco','trunk_to_yeastar']
trunks={t:{'reachable':0,'lagged':0,'unreachable':0,'last_state':'UNKNOWN','last_event_time':''} for t in trunk_names}
missing_audio={'custom/roshdy_cairo_welcome':0,'no-valid-responce-transfering':0,'wav_roshdy_waiting':0}
retrans60=0; retrans15=0; broken_pipe=0; cdr_warnings=0; lines60=0
rx_dt=re.compile(r'^\[(\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2})\]')
rx_peer=re.compile(r"Peer '([^']+)' is now (Reachable|UNREACHABLE|Lagged)", re.I)
try:
    with open(full_path,'r',errors='ignore') as f:
        for line in f:
            m=rx_dt.search(line)
            if not m: continue
            try: dt=datetime.datetime.strptime(m.group(1),'%Y-%m-%d %H:%M:%S')
            except Exception: continue
            if dt < cutoff60: continue
            lines60 += 1
            pm=rx_peer.search(line)
            if pm and pm.group(1) in trunks:
                t=pm.group(1); st=pm.group(2).upper()
                if st=='REACHABLE': trunks[t]['reachable'] += 1; trunks[t]['last_state']='OK'
                elif st=='UNREACHABLE': trunks[t]['unreachable'] += 1; trunks[t]['last_state']='CRITICAL'
                elif st=='LAGGED': trunks[t]['lagged'] += 1; trunks[t]['last_state']='WARNING'
                trunks[t]['last_event_time']=dt.strftime('%Y-%m-%d %H:%M:%S')
            if 'Retransmission timeout reached' in line:
                retrans60 += 1
                if dt >= cutoff15: retrans15 += 1
            for k in list(missing_audio):
                if k in line: missing_audio[k] += 1
            if 'Broken pipe' in line: broken_pipe += 1
            if 'res_odbc' in line or 'cdr_mysql' in line or 'asteriskcdrdb' in line:
                if 'WARNING' in line or 'ERROR' in line: cdr_warnings += 1
