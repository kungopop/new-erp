# -*- coding: utf-8 -*-
"""Roshdy hidden system watchdog V46.
Reads snapshots generated by host script every 5 minutes.
System Manager only.
"""

import json
import os
from datetime import datetime

import frappe
from frappe.utils import cstr

BASE_DIR = ("private", "files", "system_watchdog")


def _is_system_manager():
    try:
        return frappe.session.user == "Administrator" or "System Manager" in set(frappe.get_roles(frappe.session.user))
    except Exception:
        return False


def _ensure_system_manager():
    if not _is_system_manager():
        frappe.throw("System Manager فقط", frappe.PermissionError)


def _base(*parts):
    return frappe.get_site_path(*BASE_DIR, *parts)


@frappe.whitelist()
def get_access():
    return {"success": True, "is_system_manager": _is_system_manager(), "user": frappe.session.user}


@frappe.whitelist()
def get_dashboard(limit=60):
    _ensure_system_manager()
    latest_path = _base("latest.json")
    if not os.path.exists(latest_path):
        return {"success": False, "message": "لا توجد قراءة Watchdog V46 بعد. انتظر أول تشغيل للكرون أو شغل السكريبت يدويًا."}
    with open(latest_path, "r", encoding="utf-8") as f:
        latest = json.load(f)
    history = []
    hist_dir = _base("history")
    try:
        if os.path.isdir(hist_dir):
            files = sorted([x for x in os.listdir(hist_dir) if x.endswith(".jsonl")], reverse=True)[:3]
            for fn in files:
                p = os.path.join(hist_dir, fn)
                with open(p, "r", encoding="utf-8", errors="ignore") as hf:
                    lines = hf.readlines()[-int(limit or 60):]
                for line in lines:
                    try:
                        history.append(json.loads(line))
                    except Exception:
                        pass
            history = sorted(history, key=lambda x: cstr(x.get("generated_at") or x.get("timestamp") or ""), reverse=True)[:int(limit or 60)]
    except Exception as e:
        latest["history_error"] = cstr(e)
    latest.update({"success": True, "history": history})
    return latest
