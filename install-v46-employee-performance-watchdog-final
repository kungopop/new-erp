#!/usr/bin/env bash
set -Eeuo pipefail

# Roshdy V46 FINAL - Employee Performance + Hidden Watchdog
# Safety:
# - Backup first.
# - Does NOT edit report_api.py.
# - Does NOT write to Elastix. Reads Elastix logs/AMI only via SSH/AMI.
# - Does NOT delete/compress/rotate Elastix logs.
# - Stores snapshots/caches under ERP site private files only.

ROOT="${ROOT:-/opt/frappe_crm}"
SITE="${SITE:-crm.local}"
APP="restaurant_ops"

cd "$ROOT"

if docker compose version >/dev/null 2>&1; then
  COMPOSE=(docker compose)
else
  COMPOSE=(docker-compose)
fi

BACKEND="$(${COMPOSE[@]} ps -q backend || true)"
if [[ -z "$BACKEND" ]]; then
  echo "❌ backend مش شغال"
  exit 1
fi

bench_exec(){ "${COMPOSE[@]}" exec -T backend bench --site "$SITE" "$@"; }

APP_DIR="$ROOT/apps/$APP"
PKG_DIR="$APP_DIR/$APP"
API_DIR="$PKG_DIR/api"
WWW_DIR="$PKG_DIR/www"
SCRIPTS_DIR="$ROOT/scripts"
SITE_PRIVATE="$ROOT/sites/$SITE/private/files"
CONTAINER_SITE_PRIVATE="/home/frappe/frappe-bench/sites/$SITE/private/files"

EMP_API="$API_DIR/employee_performance_api.py"
WATCHDOG_API="$API_DIR/system_watchdog_api.py"
EMP_HTML="$WWW_DIR/employee-performance.html"
EMP_PY="$WWW_DIR/employee-performance.py"
WATCHDOG_HTML="$WWW_DIR/watchdog.html"
WATCHDOG_PY="$WWW_DIR/watchdog.py"
ADMIN_HTML="$WWW_DIR/admin-desk.html"
EMP_SCRIPT="$SCRIPTS_DIR/roshdy_employee_performance_generate_v46"
WATCHDOG_SCRIPT="$SCRIPTS_DIR/roshdy_system_watchdog_collect_v46"
CRON_EMP="/etc/cron.d/roshdy_employee_performance_v46"
CRON_WATCHDOG="/etc/cron.d/roshdy_system_watchdog_v46"

TS="$(date +%Y%m%d_%H%M%S)"
BACKUP_DIR="$ROOT/backups/FIX_V46_EMPLOYEE_PERF_WATCHDOG_BEFORE_$TS"
mkdir -p "$BACKUP_DIR/files" "$SCRIPTS_DIR" "$SITE_PRIVATE/employee_performance" "$SITE_PRIVATE/system_watchdog"

cat <<EOF
============================================================
🚀 Roshdy V46: Employee Performance + Hidden Watchdog
📦 Backup: $BACKUP_DIR
🛡️ report_api.py / Elastix config / CDR config / AMI config: untouched
============================================================
EOF

echo "🧯 Step 1: Backup files + bench backup"
for f in "$EMP_API" "$WATCHDOG_API" "$EMP_HTML" "$EMP_PY" "$WATCHDOG_HTML" "$WATCHDOG_PY" "$ADMIN_HTML" "$EMP_SCRIPT" "$WATCHDOG_SCRIPT" "$CRON_EMP" "$CRON_WATCHDOG"; do
  [[ -e "$f" ]] && cp -a "$f" "$BACKUP_DIR/files/$(basename "$f").before" || true
done
bench_exec backup --with-files | tee "$BACKUP_DIR/bench_backup_output.txt"

# -----------------------------------------------------------------------------
# Employee Performance API
# -----------------------------------------------------------------------------
echo "🧩 Step 2: Install employee_performance_api.py"
cat > "$EMP_API" <<'PYEMP'
# -*- coding: utf-8 -*-
"""Roshdy Employee Performance V46.

Reads daily snapshots generated after the operational day ends.
No same-day live heavy calculation is exposed to the page.
Does not edit/touch report_api.py, Elastix, CDR or AMI config.
"""

import json
import os
import re
from collections import Counter, defaultdict
from datetime import datetime, date, time, timedelta

import frappe
from frappe.utils import cstr, cint, flt, get_datetime, now_datetime

QUEUES = {"1234": "طلبات", "123": "شكاوى"}
BASE_DIR = ("private", "files", "employee_performance")


def _is_admin():
    try:
        if frappe.session.user == "Administrator":
            return True
        return bool(set(frappe.get_roles(frappe.session.user)).intersection({"System Manager", "Call Center Admin", "Restaurant Manager"}))
    except Exception:
        return False


def _ensure_admin():
    if not _is_admin():
        frappe.throw("غير مسموح", frappe.PermissionError)


def _base_path(*parts):
    p = frappe.get_site_path(*BASE_DIR, *parts)
    os.makedirs(os.path.dirname(p) if os.path.splitext(p)[1] else p, exist_ok=True)
    return p


def _html_escape(s):
    return cstr(s).replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;").replace('"', "&quot;").replace("'", "&#39;")


def normalize_phone(phone):
    """Normalize Egyptian mobile/landline variants.

    Examples:
    01028567017, +201028567017, 201028567017 -> 01028567017
    0502727789, +20502727789, 20502727789 -> 0502727789
    """
    s = re.sub(r"\D+", "", cstr(phone or ""))
    if not s:
        return ""
    if s.startswith("00"):
        s = s[2:]
    if s.startswith("20") and len(s) >= 11:
        s = "0" + s[2:]
    if len(s) == 10 and s[:2] in ("10", "11", "12", "15"):
        s = "0" + s
    # Most Egyptian landline local forms are 0 + area code + number.
    if len(s) == 9 and s[:2] in ("50", "55", "57", "48", "45", "40", "47", "46", "64", "66", "68", "82", "84", "86", "88", "92", "93", "95", "96", "97"):
        s = "0" + s
    return s


def _phone_variants(norm):
    norm = normalize_phone(norm)
    if not norm:
        return []
    digits = re.sub(r"\D+", "", norm)
    variants = {norm, digits}
    if digits.startswith("0") and len(digits) >= 9:
        variants.add("20" + digits[1:])
        variants.add("+20" + digits[1:])
        variants.add("0020" + digits[1:])
    return sorted(v for v in variants if v)


def _parse_dt(v):
    try:
        if not v:
            return None
        if isinstance(v, datetime):
            return v
        return get_datetime(v)
    except Exception:
        return None


def _fmt_dt(v):
    d = _parse_dt(v)
    return d.strftime("%Y-%m-%d %H:%M:%S") if d else ""


def _seconds_text(sec):
    try:
        sec = int(round(float(sec or 0)))
    except Exception:
        sec = 0
    if sec < 60:
        return f"{sec} ث"
    m, s = divmod(sec, 60)
    if m < 60:
        return f"{m} د {s} ث" if s else f"{m} د"
    h, m = divmod(m, 60)
    return f"{h} س {m} د"


def _operational_bounds(target_date):
    d = target_date if isinstance(target_date, date) else datetime.strptime(cstr(target_date)[:10], "%Y-%m-%d").date()
    start = datetime.combine(d, time(10, 0, 0))
    split = datetime.combine(d, time(20, 0, 0))
    end = datetime.combine(d + timedelta(days=1), time(5, 0, 0))
    return d, start, split, end


def _last_complete_date():
    now = now_datetime()
    today = now.date()
    if now.time() < time(5, 0, 0):
        return today - timedelta(days=2)
    return today - timedelta(days=1)


def _shift_name(dt, target_date):
    if not dt:
        return "غير محدد"
    d, start, split, end = _operational_bounds(target_date)
    return "صباحي" if start <= dt < split else "مسائي"


def _agent_label(ext, event_time=None):
    ext = cstr(ext or "").strip()
    if not ext:
        return "غير محدد"
    emp = _employee_by_extension(ext, event_time)
    return emp or ("تحويلة " + ext)


def _table_columns(table):
    try:
        rows = frappe.db.sql("describe `%s`" % table, as_dict=True)
        return [r.get("Field") for r in rows]
    except Exception:
        return []


def _employee_by_extension(ext, event_time=None):
    ext = cstr(ext or "").strip()
    if not ext:
        return ""
    # Active Extension Session at call time.
    try:
        if frappe.db.exists("DocType", "Extension Session"):
            cols = _table_columns("tabExtension Session")
            if "extension" in cols:
                if event_time:
                    rows = frappe.db.sql("""
                        select coalesce(e.employee_name, s.employee, s.user) employee_name
                        from `tabExtension Session` s
                        left join `tabEmployee` e on e.name=s.employee or e.user_id=s.user
                        where s.extension=%s
                          and (s.started_at is null or s.started_at <= %s)
                          and (s.released_at is null or s.released_at >= %s)
                        order by s.started_at desc
                        limit 1
                    """, (ext, event_time, event_time), as_dict=True)
                    if rows and rows[0].get("employee_name"):
                        return rows[0].get("employee_name")
                rows = frappe.db.sql("""
                    select coalesce(e.employee_name, s.employee, s.user) employee_name
                    from `tabExtension Session` s
                    left join `tabEmployee` e on e.name=s.employee or e.user_id=s.user
                    where s.extension=%s
                    order by coalesce(s.released_at, s.modified, s.creation) desc
                    limit 1
                """, (ext,), as_dict=True)
                if rows and rows[0].get("employee_name"):
                    return rows[0].get("employee_name")
    except Exception:
        pass
    # Direct custom field on Employee.
    try:
        cols = _table_columns("tabEmployee")
        name_col = "employee_name" if "employee_name" in cols else "name"
        for col in [c for c in cols if c and any(x in c.lower() for x in ("extension", "ext", "sip"))]:
            rows = frappe.db.sql("select `%s` as emp from `tabEmployee` where `%s`=%%s limit 1" % (name_col, col), (ext,), as_dict=True)
            if rows and rows[0].get("emp"):
                return rows[0].get("emp")
    except Exception:
        pass
    return ""


def _ext_from_agent(agent):
    agent = cstr(agent or "")
    for pat in (r"(?:Local|SIP|PJSIP|Agent)/(\d{3,6})", r"^(\d{3,6})$", r"\b(\d{3,6})\b"):
        m = re.search(pat, agent, re.I)
        if m and m.group(1) not in ("123", "1234"):
            return m.group(1)
    return ""


def _actual_ext_from_cdr(row):
    for key in ("actual_ext", "dstchannel", "dst", "lastdata"):
        val = cstr(row.get(key) or "")
        m = re.search(r"Local/(\d{3,6})@from-queue", val)
        if m:
            return m.group(1)
        if key in ("actual_ext", "dst") and re.fullmatch(r"\d{3,6}", val) and val not in ("123", "1234"):
            return val
    return ""


def _read_events(rel_path):
    if not rel_path:
        return []
    rel_path = rel_path.lstrip("/")
    p = frappe.get_site_path("private", "files", rel_path)
    if not os.path.exists(p):
        return []
    with open(p, "r", encoding="utf-8") as f:
        data = json.load(f)
    if isinstance(data, dict):
        return data.get("events") or []
    if isinstance(data, list):
        return data
    return []


def _sql_quote(s):
    return "'" + cstr(s).replace("\\", "\\\\").replace("'", "''") + "'"


def _cdr_rows(start_dt, end_dt):
    try:
        from restaurant_ops.api.asterisk_bridge import query_asterisk_cdr, build_recording_url
    except Exception:
        return [], None
    sql = """
        SELECT calldate, src, cnum, clid, dst, dcontext, channel, dstchannel,
               lastapp, lastdata, duration, billsec, disposition, uniqueid, recordingfile
        FROM cdr
        WHERE calldate >= {start} AND calldate < {end}
          AND lastapp='Queue'
          AND dst IN ('123','1234')
        ORDER BY calldate ASC
    """.format(start=_sql_quote(start_dt), end=_sql_quote(end_dt))
    rows = query_asterisk_cdr(sql) or []
    for r in rows:
        try:
            r["recording_url"] = build_recording_url(r.get("recordingfile")) if r.get("recordingfile") else ""
        except Exception:
            r["recording_url"] = ""
    return rows, None


def _historical_seen_map(phones, start_dt):
    phones = sorted({normalize_phone(p) for p in phones if normalize_phone(p)})
    out = {p: {"seen_before": False, "first_seen": "", "previous_count": 0} for p in phones}
    if not phones:
        return out
    variants = []
    variant_to_norm = {}
    for p in phones:
        for v in _phone_variants(p):
            variants.append(v)
            variant_to_norm[v] = p
    variants = sorted(set(variants))
    if not variants:
        return out
    try:
        from restaurant_ops.api.asterisk_bridge import query_asterisk_cdr
        chunks = [variants[i:i+700] for i in range(0, len(variants), 700)]
        for ch in chunks:
            in_list = ",".join(_sql_quote(x) for x in ch)
            sql = """
                SELECT src, cnum, MIN(calldate) first_seen, COUNT(*) cnt
                FROM cdr
                WHERE calldate < {start}
                  AND disposition='ANSWERED'
                  AND (src IN ({vals}) OR cnum IN ({vals}))
                GROUP BY src, cnum
                LIMIT 50000
            """.format(start=_sql_quote(start_dt), vals=in_list)
            for r in (query_asterisk_cdr(sql) or []):
                for raw in (r.get("src"), r.get("cnum")):
                    n = normalize_phone(raw)
                    if n in out:
                        out[n]["seen_before"] = True
                        out[n]["previous_count"] += cint(r.get("cnt") or 0)
                        fs = cstr(r.get("first_seen") or "")
                        if fs and (not out[n]["first_seen"] or fs < out[n]["first_seen"]):
                            out[n]["first_seen"] = fs
    except Exception as e:
        for p in out:
            out[p]["history_error"] = cstr(e)
    return out


def _load_presence(target_date, start_dt, split_dt, end_dt):
    base = frappe.get_site_path(*BASE_DIR, "presence")
    out = {
        "available": False,
        "peak_online_morning": None,
        "peak_online_evening": None,
        "by_extension": {},
        "samples": 0,
    }
    if not os.path.isdir(base):
        return out
    start = _parse_dt(start_dt); split = _parse_dt(split_dt); end = _parse_dt(end_dt)
    files = [os.path.join(base, cstr(target_date)[:10] + ".jsonl")]
    try:
        nd = (datetime.strptime(cstr(target_date)[:10], "%Y-%m-%d").date() + timedelta(days=1)).isoformat()
        files.append(os.path.join(base, nd + ".jsonl"))
    except Exception:
        pass
    by_ext = defaultdict(lambda: {"online_samples": 0, "offline_samples": 0, "online_minutes_est": 0, "offline_minutes_est": 0})
    peak_m = 0; peak_e = 0; samples = 0
    for fp in files:
        if not os.path.exists(fp):
            continue
        with open(fp, "r", encoding="utf-8", errors="ignore") as f:
            for line in f:
                line = line.strip()
                if not line:
                    continue
                try:
                    j = json.loads(line)
                except Exception:
                    continue
                ts = _parse_dt(j.get("timestamp"))
                if not ts or not (start <= ts < end):
                    continue
                exts = j.get("extensions") or {}
                online = set(j.get("online") or [])
                samples += 1
                if start <= ts < split:
                    peak_m = max(peak_m, len(online))
                else:
                    peak_e = max(peak_e, len(online))
                for ext, st in exts.items():
                    if cstr(ext) in online or "OK" in cstr(st).upper():
                        by_ext[cstr(ext)]["online_samples"] += 1
                    else:
                        by_ext[cstr(ext)]["offline_samples"] += 1
    if samples:
        out["available"] = True
        out["peak_online_morning"] = peak_m
        out["peak_online_evening"] = peak_e
        out["samples"] = samples
        for ext, v in by_ext.items():
            v["online_minutes_est"] = v["online_samples"] * 5
            v["offline_minutes_est"] = v["offline_samples"] * 5
            out["by_extension"][ext] = dict(v)
    return out


def _save_snapshot(data, target_date):
    base = frappe.get_site_path(*BASE_DIR)
    os.makedirs(base, exist_ok=True)
    path = os.path.join(base, f"employee_performance_{target_date}.json")
    latest = os.path.join(base, "latest.json")
    with open(path, "w", encoding="utf-8") as f:
        json.dump(data, f, ensure_ascii=False, indent=2, default=str)
    with open(latest, "w", encoding="utf-8") as f:
        json.dump(data, f, ensure_ascii=False, indent=2, default=str)
    return path


@frappe.whitelist()
def build_snapshot_from_queue_events(target_date=None, events_rel_path=None):
    """Build one operational-day snapshot.

    Intended to be called by the host cron script after 05:00.
    events_rel_path is relative to site private/files.
    """
    target_date = cstr(target_date or _last_complete_date().isoformat())[:10]
    d, start, split, end = _operational_bounds(target_date)
    start_s = start.strftime("%Y-%m-%d %H:%M:%S")
    split_s = split.strftime("%Y-%m-%d %H:%M:%S")
    end_s = end.strftime("%Y-%m-%d %H:%M:%S")

    events = _read_events(events_rel_path)
    by_call = defaultdict(list)
    event_counts = Counter()
    queue_counts = Counter()
    for e in events:
        event_counts[cstr(e.get("event"))] += 1
        queue_counts[cstr(e.get("queue"))] += 1
        cid = cstr(e.get("callid") or "")
        if cid:
            by_call[cid].append(e)
    for cid in by_call:
        by_call[cid].sort(key=lambda x: flt(x.get("time_epoch") or 0))

    cdr_rows, cdr_error = _cdr_rows(start_s, end_s)
    cdr_by_uid = {cstr(r.get("uniqueid")): r for r in cdr_rows if r.get("uniqueid")}

    calls = {}
    # First: from queue_log events.
    for cid, evs in by_call.items():
        phone = ""; did = ""; queue = ""; enter_time = None
        for e in evs:
            if not queue and e.get("queue"):
                queue = cstr(e.get("queue"))
            if e.get("event") == "DID" and e.get("data"):
                did = cstr((e.get("data") or [""])[0])
            if e.get("event") == "ENTERQUEUE":
                enter_time = _parse_dt(e.get("time_text")) or enter_time
                for x in (e.get("data") or []):
                    if re.search(r"\d{5,}", cstr(x)):
                        phone = cstr(x); break
        connects = [e for e in evs if e.get("event") == "CONNECT"]
        completes = [e for e in evs if e.get("event") in ("COMPLETEAGENT", "COMPLETECALLER")]
        abandons = [e for e in evs if e.get("event") == "ABANDON"]
        ring_misses = [e for e in evs if e.get("event") in ("RINGNOANSWER", "RINGCANCELED", "AGENTDUMP")]
        outcome = "answered" if connects else ("abandoned" if abandons else "unknown")
        ans = connects[0] if connects else None
        answer_time = _parse_dt(ans.get("time_text")) if ans else None
        ans_ext = cstr(ans.get("agent_ext") or _ext_from_agent(ans.get("agent"))) if ans else ""
        wait_seconds = None
        if ans:
            try:
                wait_seconds = int(float((ans.get("data") or [0])[0] or 0))
            except Exception:
                wait_seconds = int((answer_time - enter_time).total_seconds()) if answer_time and enter_time else 0
        talk_seconds = 0
        if completes:
            comp = completes[-1]
            try:
                talk_seconds = int(float((comp.get("data") or [0, 0])[1] or 0))
            except Exception:
                talk_seconds = 0
        cdr = cdr_by_uid.get(cid) or {}
        if not phone:
            phone = cstr(cdr.get("src") or cdr.get("cnum") or "")
        if not queue:
            queue = cstr(cdr.get("dst") or "")
        if not ans_ext:
            ans_ext = _actual_ext_from_cdr(cdr)
        if not talk_seconds:
            talk_seconds = cint(cdr.get("billsec") or cdr.get("duration") or 0)
        if not enter_time:
            enter_time = _parse_dt(cdr.get("calldate"))
        shift = _shift_name(enter_time or answer_time, target_date)
        calls[cid] = {
            "callid": cid,
            "queue": queue,
            "queue_label": QUEUES.get(queue, queue),
            "did": did or cstr(cdr.get("did") or ""),
            "caller_raw": phone,
            "caller": normalize_phone(phone),
            "enter_time": _fmt_dt(enter_time),
            "answer_time": _fmt_dt(answer_time),
            "answered_extension": ans_ext,
            "answered_employee": _agent_label(ans_ext, _fmt_dt(answer_time or enter_time)) if ans_ext else "",
            "wait_seconds": wait_seconds if wait_seconds is not None else 0,
            "talk_seconds": talk_seconds,
            "duration_seconds": cint(cdr.get("duration") or 0) or (int(((_parse_dt(completes[-1].get("time_text")) if completes else answer_time) - enter_time).total_seconds()) if enter_time and (completes or answer_time) else talk_seconds),
            "outcome": outcome,
            "shift": shift,
            "recording_url": cstr(cdr.get("recording_url") or ""),
            "recordingfile": cstr(cdr.get("recordingfile") or ""),
            "ring_misses": [
                {
                    "time": _fmt_dt(x.get("time_text")),
                    "extension": cstr(x.get("agent_ext") or _ext_from_agent(x.get("agent"))),
                    "employee": _agent_label(cstr(x.get("agent_ext") or _ext_from_agent(x.get("agent"))), x.get("time_text")),
                    "ring_seconds": round(flt(((x.get("data") or [0])[0] or 0)) / 1000.0, 1) if flt(((x.get("data") or [0])[0] or 0)) > 100 else flt(((x.get("data") or [0])[0] or 0)),
                }
                for x in ring_misses
            ],
            "cdr_found": bool(cdr),
        }

    # Add CDR answered queue rows missed by queue_log cache.
    for r in cdr_rows:
        cid = cstr(r.get("uniqueid") or "")
        if not cid or cid in calls:
            continue
        ext = _actual_ext_from_cdr(r)
        if not ext:
            continue
        dt = _parse_dt(r.get("calldate"))
        phone = cstr(r.get("src") or r.get("cnum") or "")
        calls[cid] = {
            "callid": cid,
            "queue": cstr(r.get("dst") or ""),
            "queue_label": QUEUES.get(cstr(r.get("dst") or ""), cstr(r.get("dst") or "")),
            "did": "",
            "caller_raw": phone,
            "caller": normalize_phone(phone),
            "enter_time": _fmt_dt(dt),
            "answer_time": _fmt_dt(dt),
            "answered_extension": ext,
            "answered_employee": _agent_label(ext, _fmt_dt(dt)),
            "wait_seconds": 0,
            "talk_seconds": cint(r.get("billsec") or r.get("duration") or 0),
            "duration_seconds": cint(r.get("duration") or r.get("billsec") or 0),
            "outcome": "answered" if cstr(r.get("disposition")).upper() == "ANSWERED" else "other",
            "shift": _shift_name(dt, target_date),
            "recording_url": cstr(r.get("recording_url") or ""),
            "recordingfile": cstr(r.get("recordingfile") or ""),
            "ring_misses": [],
            "cdr_found": True,
        }

    answered_calls = [c for c in calls.values() if c.get("outcome") == "answered" and c.get("answered_extension")]
    phones = sorted({c.get("caller") for c in answered_calls if c.get("caller")})
    seen_map = _historical_seen_map(phones, start_s)
    for c in answered_calls:
        h = seen_map.get(c.get("caller") or "") or {}
        c["new_customer"] = bool(c.get("caller") and not h.get("seen_before"))
        c["customer_first_seen_before"] = h.get("first_seen") or ""
        c["customer_previous_count"] = h.get("previous_count") or 0

    by_ext = defaultdict(lambda: {
        "extension": "", "employee": "", "answered_calls": 0,
        "orders_calls": 0, "complaints_calls": 0,
        "morning_calls": 0, "evening_calls": 0,
        "wait_total": 0, "wait_min": None, "wait_max": 0,
        "talk_total": 0, "talk_max": 0,
        "ringnoanswer": 0,
        "new_customers": 0,
        "calls": [],
    })
    for c in answered_calls:
        ext = c.get("answered_extension") or ""
        be = by_ext[ext]
        be["extension"] = ext
        be["employee"] = c.get("answered_employee") or _agent_label(ext, c.get("answer_time") or c.get("enter_time"))
        be["answered_calls"] += 1
        if c.get("queue") == "1234":
            be["orders_calls"] += 1
        elif c.get("queue") == "123":
            be["complaints_calls"] += 1
        if c.get("shift") == "صباحي":
            be["morning_calls"] += 1
        elif c.get("shift") == "مسائي":
            be["evening_calls"] += 1
        w = cint(c.get("wait_seconds") or 0); t = cint(c.get("talk_seconds") or 0)
        be["wait_total"] += w
        be["wait_min"] = w if be["wait_min"] is None else min(be["wait_min"], w)
        be["wait_max"] = max(be["wait_max"], w)
        be["talk_total"] += t
        be["talk_max"] = max(be["talk_max"], t)
        if c.get("new_customer"):
            be["new_customers"] += 1
        be["calls"].append(c)
    for c in calls.values():
        for m in c.get("ring_misses") or []:
            ext = m.get("extension") or ""
            if not ext:
                continue
            be = by_ext[ext]
            be["extension"] = ext
            if not be["employee"]:
                be["employee"] = m.get("employee") or _agent_label(ext, m.get("time"))
            be["ringnoanswer"] += 1

    presence = _load_presence(target_date, start_s, split_s, end_s)
    for ext, p in (presence.get("by_extension") or {}).items():
        if ext in by_ext:
            by_ext[ext].update(p)
        else:
            by_ext[ext].update({"extension": ext, "employee": _agent_label(ext)})
            by_ext[ext].update(p)

    employees = []
    for ext, be in by_ext.items():
        n = cint(be.get("answered_calls") or 0)
        be["avg_wait_seconds"] = round(flt(be.get("wait_total") or 0) / n, 2) if n else 0
        be["avg_talk_seconds"] = round(flt(be.get("talk_total") or 0) / n, 2) if n else 0
        be["wait_min"] = be["wait_min"] if be["wait_min"] is not None else 0
        be["longest_call"] = max(be.get("calls") or [], key=lambda x: cint(x.get("talk_seconds") or 0), default=None)
        be["calls"] = sorted(be.get("calls") or [], key=lambda x: cstr(x.get("enter_time") or ""), reverse=True)
        be["grade_note"] = ""
        employees.append(dict(be))
    employees.sort(key=lambda x: (-(cint(x.get("answered_calls") or 0)), -(cint(x.get("ringnoanswer") or 0)), cstr(x.get("extension"))))

    morning_exts = {c.get("answered_extension") for c in answered_calls if c.get("shift") == "صباحي" and c.get("answered_extension")}
    evening_exts = {c.get("answered_extension") for c in answered_calls if c.get("shift") == "مسائي" and c.get("answered_extension")}
    new_customer_calls = [c for c in answered_calls if c.get("new_customer")]
    total_wait = sum(cint(c.get("wait_seconds") or 0) for c in answered_calls)
    total_talk = sum(cint(c.get("talk_seconds") or 0) for c in answered_calls)
    slowest = max(answered_calls, key=lambda x: cint(x.get("wait_seconds") or 0), default=None)
    fastest = min(answered_calls, key=lambda x: cint(x.get("wait_seconds") or 999999), default=None)
    longest = max(answered_calls, key=lambda x: cint(x.get("talk_seconds") or 0), default=None)
    abandoned_count = len([c for c in calls.values() if c.get("outcome") == "abandoned"])
    ring_total = sum(len(c.get("ring_misses") or []) for c in calls.values())

    snapshot = {
        "success": True,
        "version": "V46",
        "generated_at": now_datetime().strftime("%Y-%m-%d %H:%M:%S"),
        "target_date": target_date,
        "start_dt": start_s,
        "split_dt": split_s,
        "end_dt": end_s,
        "source": {
            "events_rel_path": events_rel_path,
            "events_loaded": len(events),
            "event_counts": dict(event_counts),
            "queue_event_counts": dict(queue_counts),
            "cdr_rows": len(cdr_rows),
            "cdr_error": cdr_error,
            "presence_available": presence.get("available"),
            "presence_samples": presence.get("samples"),
        },
        "summary": {
            "employees_count": len([e for e in employees if cint(e.get("answered_calls") or 0) or cint(e.get("ringnoanswer") or 0)]),
            "answered_calls": len(answered_calls),
            "orders_calls": len([c for c in answered_calls if c.get("queue") == "1234"]),
            "complaints_calls": len([c for c in answered_calls if c.get("queue") == "123"]),
            "abandoned_calls": abandoned_count,
            "ringnoanswer_attempts": ring_total,
            "new_customers": len(new_customer_calls),
            "avg_wait_seconds": round(total_wait / len(answered_calls), 2) if answered_calls else 0,
            "avg_talk_seconds": round(total_talk / len(answered_calls), 2) if answered_calls else 0,
            "fastest_answer": fastest,
            "slowest_answer": slowest,
            "longest_call": longest,
            "morning": {
                "from": start_s,
                "to": split_s,
                "answered_calls": len([c for c in answered_calls if c.get("shift") == "صباحي"]),
                "active_extensions_estimated": len(morning_exts),
                "peak_online_extensions": presence.get("peak_online_morning"),
            },
            "evening": {
                "from": split_s,
                "to": end_s,
                "answered_calls": len([c for c in answered_calls if c.get("shift") == "مسائي"]),
                "active_extensions_estimated": len(evening_exts),
                "peak_online_extensions": presence.get("peak_online_evening"),
            },
        },
        "employees": employees,
        "new_customers": sorted(new_customer_calls, key=lambda x: cstr(x.get("enter_time") or "")),
        "calls": sorted(answered_calls, key=lambda x: cstr(x.get("enter_time") or ""), reverse=True),
    }
    path = _save_snapshot(snapshot, target_date)
    frappe.db.commit()
    return {"success": True, "target_date": target_date, "path": path, "summary": snapshot["summary"]}


