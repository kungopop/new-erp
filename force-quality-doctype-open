#!/usr/bin/env bash
set -Eeuo pipefail

# force-quality-doctype-open
# Goal: Quality users MUST be able to open and edit the actual Frappe Desk DocType form:
#   /app/call-center-complaint/COMP-...
# without breaking the normal login redirect to /quality-desk.
# Fixes:
# - Clean DocPerm for Complaint_Quality_User (level 0/1 only, no bad level 2 row).
# - Ensure quality users are System User + Desk User.
# - Patch Desk redirect JS so it does NOT redirect away from /app/call-center-complaint/*.
# - Patch Call Center Complaint form JS so normal Save and a blue "حفظ مراجعة الجودة" button work with Arabic/English Select values.
# - Build assets + restart + health checks.

ROOT="/opt/frappe_crm"
SITE="crm.local"
APP_HOST="$ROOT/apps/restaurant_ops"
APP_DIR="$APP_HOST/restaurant_ops"
DOCTYPE_DIR="$APP_DIR/restaurant_operations/doctype/call_center_complaint"
