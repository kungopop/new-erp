from pathlib import Path
import re
p = Path('/opt/frappe_crm/apps/restaurant_ops/restaurant_ops/restaurant_operations/doctype/call_center_complaint/call_center_complaint.js')
old = p.read_text(errors='ignore') if p.exists() else ''
# remove previous custom blocks to avoid conflicting before_save mappings
patterns = [
    r'// ===== ROSHDY QUALITY DESK FORM SAVE BUTTON START =====[\s\S]*?// ===== ROSHDY QUALITY DESK FORM SAVE BUTTON END =====\n?',
    r'// ===== ROSHDY FORCE QUALITY DOCTYPE OPEN START =====[\s\S]*?// ===== ROSHDY FORCE QUALITY DOCTYPE OPEN END =====\n?',
]
s = old
for pat in patterns:
    s = re.sub(pat, '', s)
block = r'''
// ===== ROSHDY FORCE QUALITY DOCTYPE OPEN START =====
(function(){
  function has_quality_role(){
    const roles = frappe.user_roles || [];
    return roles.includes('Complaint_Quality_User') || roles.includes('Call Center Admin') || roles.includes('System Manager') || roles.includes('Administrator');
  }
  function field_options(frm, field){
    try { return String((frm.fields_dict[field] && frm.fields_dict[field].df && frm.fields_dict[field].df.options) || '').split('\n').map(x => x.trim()).filter(Boolean); }
    catch(e){ return []; }
  }
  function normalize_to_available(frm, field, value){
    value = String(value || '').trim();
    const statusPairs = {
      'Draft':'مسودة', 'مسودة':'Draft',
      'Open':'مفتوحة', 'مفتوح':'Open', 'مفتوحة':'Open',
      'Under Review':'قيد المراجعة', 'قيد المراجعة':'Under Review', 'قيد مراجعه':'Under Review',
      'Resolved':'تم الحل', 'تم الحل':'Resolved', 'محلولة':'Resolved',
      'Closed':'مغلقة', 'مغلق':'Closed', 'مغلقة':'Closed'
    };
    const opts = field_options(frm, field);
    if (!opts.length) return value;
    if (opts.includes(value)) return value;
    const alt = statusPairs[value];
    if (alt && opts.includes(alt)) return alt;
    return value;
  }
  function unlock_quality_fields(frm){
    ['assigned_quality_inspector','investigation_analysis','corrective_action','status','closing_notes'].forEach(function(f){
      if (frm.fields_dict[f]) frm.set_df_property(f, 'read_only', 0);
    });
  }
  frappe.ui.form.on('Call Center Complaint', {
    refresh: function(frm){
      if(!has_quality_role()) return;
      unlock_quality_fields(frm);
      if(frm.is_new()) return;
      frm.add_custom_button(__('حفظ مراجعة الجودة'), function(){
        const statusValue = normalize_to_available(frm, 'status', frm.doc.status || 'Under Review');
        frappe.call({
          method: 'restaurant_ops.api.quality_api.update_quality_review',
          args: {
            name: frm.doc.name,
            assigned_quality_inspector: frm.doc.assigned_quality_inspector || frappe.session.user,
            investigation_analysis: frm.doc.investigation_analysis || '',
            corrective_action: frm.doc.corrective_action || '',
            status: statusValue,
            closing_notes: frm.doc.closing_notes || ''
          },
          freeze: true,
          freeze_message: __('جاري حفظ مراجعة الجودة...'),
          callback: function(r){
            if(r && r.message && r.message.success){
              frappe.show_alert({message: __('تم حفظ مراجعة الجودة بنجاح'), indicator: 'green'});
              frm.reload_doc();
            } else {
              frappe.msgprint((r && r.message && r.message.message) || __('فشل حفظ مراجعة الجودة'));
              console.log('Quality save response', r);
            }
          },
          error: function(r){
            frappe.msgprint(__('حصل خطأ أثناء حفظ مراجعة الجودة. ابعتلي الخطأ من Console.'));
            console.error(r);
          }
        });
      }).addClass('btn-primary');
      frm.add_custom_button(__('فتح Quality Desk'), function(){ window.open('/quality-desk', '_blank'); });
    },
    before_save: function(frm){
      if(!has_quality_role()) return;
      // Only change status if current value is not one of the current DocType options.
      if(frm.doc.status && frm.fields_dict.status){
        const fixed = normalize_to_available(frm, 'status', frm.doc.status);
        if(fixed && fixed !== frm.doc.status) frm.set_value('status', fixed);
      }
    }
  });
})();
// ===== ROSHDY FORCE QUALITY DOCTYPE OPEN END =====
'''
p.parent.mkdir(parents=True, exist_ok=True)
p.write_text(s.rstrip() + '\n\n' + block + '\n')
print('✅ call_center_complaint.js patched')
