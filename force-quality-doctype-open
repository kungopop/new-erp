from pathlib import Path
root = Path('/opt/frappe_crm/apps/restaurant_ops/restaurant_ops/public/js')
root.mkdir(parents=True, exist_ok=True)
files = list(root.glob('*redirect*.js'))
if not files:
    files = [root / 'desk_redirect_final.js']
safe_js = r'''
// ROSHDY SAFE DESK REDIRECT
// Keeps normal login redirect behavior, but never redirects away from real Desk forms like Call Center Complaint.
(function(){
  function allowedDeskRoute(){
    var p = window.location.pathname || '';
    return p.indexOf('/app/call-center-complaint') === 0 ||
           p.indexOf('/app/file') === 0 ||
           p.indexOf('/app/comment') === 0 ||
           p.indexOf('/app/communication') === 0;
  }
  if (allowedDeskRoute()) return;
  function shouldRedirectFromThisDeskPage(){
    var p = window.location.pathname || '';
    return p === '/app' || p === '/app/' || p === '/app/home' || p.indexOf('/app/workspace') === 0;
  }
  function go(){
    if (!shouldRedirectFromThisDeskPage()) return;
    if (!window.frappe || !frappe.call) return;
    frappe.call({
      method: 'restaurant_ops.api.login_redirect.get_user_redirect',
      callback: function(r){
        var t = r && r.message && r.message.redirect;
        if (!t || t === '/app') return;
        if ((window.location.pathname || '') !== t) window.location.replace(t);
      }
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', function(){ setTimeout(go, 300); });
  else setTimeout(go, 300);
})();
'''
for p in files:
    try:
        p.write_text(safe_js)
        print('✅ safe redirect written:', p)
    except Exception as e:
        print('⚠️ redirect patch skip', p, e)
