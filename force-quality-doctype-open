DOCTYPE_JSON="$DOCTYPE_DIR/call_center_complaint.json"
PUBLIC_JS_DIR="$APP_DIR/public/js"
TS="$(date +%Y%m%d_%H%M%S)"
BACKUP_DIR="$ROOT/backups/FORCE_QUALITY_DOCTYPE_OPEN_BEFORE_$TS"

say(){ echo -e "\n============================================================\n$1\n============================================================"; }

if [[ "${EUID:-$(id -u)}" -ne 0 ]]; then
  echo "❌ شغّل كـ root: sudo -i ثم ./force-quality-doctype-open"
  exit 1
fi

say "1) Backup قبل إجبار فتح Doctype للجودة"
cd "$ROOT"
BACKEND="$(docker compose ps -q backend || true)"
if [[ -z "$BACKEND" ]]; then
  echo "❌ لم أجد backend container. شغّل: cd /opt/frappe_crm && docker compose up -d"
  exit 1
fi
mkdir -p "$BACKUP_DIR"
cp -a "$APP_HOST" "$BACKUP_DIR/restaurant_ops"
[[ -f "$ROOT/docker-compose.yml" ]] && cp -a "$ROOT/docker-compose.yml" "$BACKUP_DIR/docker-compose.yml"
