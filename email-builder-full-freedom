def table(headers, rows):
    h = "".join([f"<th>{esc(x)}</th>" for x in headers])
    body = ""
    for row in rows:
        body += "<tr>" + "".join([f"<td>{esc(x)}</td>" for x in row]) + "</tr>"
    if not rows:
        body = f"<tr><td colspan='{len(headers)}' style='text-align:center;color:#777'>لا توجد بيانات</td></tr>"
    return f"<table><thead><tr>{h}</tr></thead><tbody>{body}</tbody></table>"


def col_label(col):
    return COLUMN_LABELS.get(col, col)


def period(st):
    dt = today()
    return dt, dt, st.get("shift_start") or "00:00", st.get("shift_end") or "23:59"


def metric_percent(key, val, summary):
    try:
        if key == "queue_answered": return str(summary.get("answer_rate_of_queue", 0)) + "%"
        if key == "queue_total": return str(summary.get("queue_reach_rate_of_all", 0)) + "%"
        if key in ("raw_total", "answer_rate_of_queue", "queue_reach_rate_of_all", "avg_duration", "avg_queue_duration"): return ""
        raw = float(summary.get("raw_total") or 0)
        return (str(round(float(val or 0) * 100 / raw, 2)) + "%") if raw else ""
    except Exception:
        return ""


def calls_section(st):
    from restaurant_ops.api.ops_reports_api import get_owner_call_summary
    df,dt,ss,se = period(st)
    calls = get_owner_call_summary(df, dt, ss, se)
    sm = calls.get("summary", {})
    cols = st.get("call_columns") or ["label","count","percent","note"]
    rows = []
    for m in st.get("call_metrics") or []:
        if not int(m.get("show") or 0): continue
        key=m.get("key"); val=sm.get(key, "")
        row_map={"label":m.get("label") or key,"count":val,"percent":metric_percent(key,val,sm),"note":m.get("note") or ""}
        rows.append([row_map.get(c, "") for c in cols])
    return "<h3>%s</h3>" % esc(st.get("section_titles",{}).get("calls", "ملخص المكالمات الإداري")) + table([col_label(c) for c in cols], rows)


def call_kpi_section(st):
    from restaurant_ops.api.ops_reports_api import get_owner_call_summary
    df,dt,ss,se=period(st); sm=get_owner_call_summary(df,dt,ss,se).get("summary",{})
    html="<h3>%s</h3>" % esc(st.get("section_titles",{}).get("call_kpi","مؤشرات مختصرة"))
    for label,key in [("كل الأحداث","raw_total"),("وصل للطوابير","queue_total"),("تم الرد","queue_answered"),("نسبة وصول للطابور","queue_reach_rate_of_all"),("نسبة رد داخل الطابور","answer_rate_of_queue")]:
        val=sm.get(key,0)
        if "rate" in key: val=str(val)+"%"
        html += f"<span class='kpi'>{esc(label)}: {esc(val)}</span>"
    return html


def break_section(st):
    from restaurant_ops.api.ops_reports_api import get_break_report
    df,dt,ss,se=period(st); data=get_break_report(df,dt,ss,se)
    cols=st.get("break_columns") or ["employee_name","count","minutes"]
    rows=[[x.get(c,"") for c in cols] for x in data.get("by_employee",[])]
    return "<h3>%s</h3>" % esc(st.get("section_titles",{}).get("breaks","البريكات")) + table([col_label(c) for c in cols], rows)


def sales_data(st):
    from restaurant_ops.api.ops_reports_api import get_sales_report
    df,dt,ss,se=period(st); return get_sales_report(df,dt,ss,se)


def sales_agent_section(st):
    data=sales_data(st); cols=st.get("sales_agent_columns") or ["employee_name","orders","quantity"]
    rows=[[x.get(c,"") for c in cols] for x in data.get("by_agent",[])]
    return "<h3>%s</h3>" % esc(st.get("section_titles",{}).get("sales_agent","المبيعات حسب الموظف")) + table([col_label(c) for c in cols], rows)


def sales_item_section(st):
    data=sales_data(st); cols=st.get("sales_item_columns") or ["item_name","orders","quantity"]
    rows=[[x.get(c,"") for c in cols] for x in data.get("by_item",[])]
    return "<h3>%s</h3>" % esc(st.get("section_titles",{}).get("sales_item","المبيعات حسب الصنف")) + table([col_label(c) for c in cols], rows)


def sales_detail_section(st):
    data=sales_data(st); cols=st.get("sales_detail_columns") or ["name","sale_date_text","employee_name","item_name","quantity","customer_name","customer_phone","notes"]
    rows=[[x.get(c,"") for c in cols] for x in data.get("rows",[])[:200]]
    return "<h3>%s</h3>" % esc(st.get("section_titles",{}).get("sales_detail","تفاصيل عمليات البيع")) + table([col_label(c) for c in cols], rows)


def complaints_section(st):
    df,dt,_,_=period(st)
    try:
        rows=frappe.db.sql("""
            SELECT status, complaint_category category, complaint_priority priority, COUNT(*) count
            FROM `tabCall Center Complaint`
            WHERE COALESCE(complaint_datetime, creation) BETWEEN %s AND %s
            GROUP BY status, complaint_category, complaint_priority ORDER BY count DESC
        """, (f"{df} 00:00:00", f"{dt} 23:59:59"), as_dict=True)
    except Exception:
        rows=[]
    cols=st.get("complaint_columns") or ["status","category","priority","count"]
    return "<h3>%s</h3>" % esc(st.get("section_titles",{}).get("complaints","الشكاوى")) + table([col_label(c) for c in cols], [[x.get(c,"") for c in cols] for x in rows])


def staff_missed_section(st):
    rows=[]
    try:
        from restaurant_ops.api.report_api import get_staff_missed_attempts
        df,dt,_,_=period(st); d=get_staff_missed_attempts(df,dt,15)
        for x in d.get("grouped",[])[:50]: rows.append([x.get("agent_name") or x.get("actual_ext") or "", x.get("count") or 0, x.get("total_duration") or ""])
    except Exception:
        pass
    return "<h3>%s</h3>" % esc(st.get("section_titles",{}).get("staff_missed","محاولات فائتة")) + table(["الموظف/التحويلة","العدد","المدة"], rows)


def permissions_section(st):
    try:
        month=today()[:7]
        rows=frappe.db.sql("SELECT e.employee_name, COALESCE(SUM(p.hours),0) hours FROM `tabEmployee Permission Log` p LEFT JOIN `tabEmployee` e ON p.employee=e.name WHERE p.month=%s GROUP BY e.employee_name ORDER BY hours DESC", (month,), as_dict=True)
    except Exception: rows=[]
    return "<h3>%s</h3>" % esc(st.get("section_titles",{}).get("permissions","الأذونات")) + table(["الموظف","الساعات"], [[r.employee_name or '', r.hours or 0] for r in rows])


def charges_section(st):
    try:
        month=today()[:7]
        rows=frappe.db.sql("SELECT e.employee_name, COUNT(c.name) count, COALESCE(SUM(c.amount),0) amount FROM `tabEmployee Charge Log` c LEFT JOIN `tabEmployee` e ON c.employee=e.name WHERE c.month=%s GROUP BY e.employee_name ORDER BY amount DESC", (month,), as_dict=True)
    except Exception: rows=[]
    return "<h3>%s</h3>" % esc(st.get("section_titles",{}).get("charges","الجزاءات / الخصومات")) + table(["الموظف","العدد","المبلغ"], [[r.employee_name or '', r.count or 0, r.amount or 0] for r in rows])

SECTION_FUNCS={"calls":calls_section,"call_kpi":call_kpi_section,"breaks":break_section,"sales_agent":sales_agent_section,"sales_item":sales_item_section,"sales_detail":sales_detail_section,"complaints":complaints_section,"staff_missed":staff_missed_section,"permissions":permissions_section,"charges":charges_section}


def replace_vars(tpl, ctx):
    for k,v in ctx.items(): tpl=tpl.replace("{{"+k+"}}", str(v if v is not None else ""))
    return tpl


def render_report(report_type="center"):
    st=get_settings_dict(); df,dt,ss,se=period(st)
    sec_cfg=st.get("center_sections") if report_type=="center" else st.get("upper_sections")
    order=st.get("center_order") if report_type=="center" else st.get("upper_order")
    sections=[]
    for sec in order:
        if int(sec_cfg.get(sec) or 0): sections.append(SECTION_FUNCS.get(sec, lambda x: "")(st))
    ctx={
        "style_block": style_block(st), "sections":"".join(sections), "place_name":st.get("place_name"),
        "generated_at":str(now_datetime()), "period_start":f"{df} {ss}", "period_end":f"{dt} {se}",
        "center_title":st.get("center_title"), "upper_title":st.get("upper_title"),
        "center_intro_block": f"<div class='note'>{esc(st.get('center_intro'))}</div>" if st.get('center_intro') else "",
        "center_footer_block": f"<div class='note'>{esc(st.get('center_footer'))}</div>" if st.get('center_footer') else "",
        "upper_intro_block": f"<div class='note'>{esc(st.get('upper_intro'))}</div>" if st.get('upper_intro') else "",
        "upper_footer_block": f"<div class='note'>{esc(st.get('upper_footer'))}</div>" if st.get('upper_footer') else "",
    }
    tpl=st.get("center_template") if report_type=="center" else st.get("upper_template")
    return {"success":True,"html":replace_vars(tpl or default_template(report_type), ctx),"settings":st}


@frappe.whitelist(allow_guest=False)
def get_email_builder_schema():
    if not _is_sys(): return _deny()
