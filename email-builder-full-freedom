@frappe.whitelist(allow_guest=True)
def save_email_builder_settings(settings_json=None):
    if frappe.session.user == "Guest" or not _is_sys(): return _deny()
    if not settings_json:
        try:
            body = frappe.request.get_json() or {}
            settings_json = body.get("settings_json") or body.get("settings")
        except Exception:
            settings_json = None
    try:
        data = json.loads(settings_json or "{}") if isinstance(settings_json, str) else (settings_json or {})
    except Exception as e:
        return {"success":False,"message":"Invalid JSON: "+str(e)}
    base=get_settings_dict(); base.update(data); save_settings_dict(base)
    return {"success":True,"settings":base}


