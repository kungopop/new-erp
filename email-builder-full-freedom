#!/usr/bin/env bash
set -Eeuo pipefail

# email-builder-full-freedom
# Full email report builder:
# - Uses a real Single DocType to save settings, not URL query params.
# - Lets System Manager edit complete HTML templates + CSS.
# - Lets System Manager add/reorder call metrics with dropdown keys and custom labels/notes.
# - Lets System Manager choose/reorder sections and table columns.
# - Actual send_report_now and daily report use this builder.
# - Does NOT touch report_api.py core.

ROOT="/opt/frappe_crm"
SITE="crm.local"
APP_HOST="$ROOT/apps/restaurant_ops"
APP_DIR="$APP_HOST/restaurant_ops"
API_DIR="$APP_DIR/api"
WWW_DIR="$APP_DIR/www"
SCRIPTS_DIR="$APP_DIR/scripts"
TS="$(date +%Y%m%d_%H%M%S)"
BACKUP_DIR="$ROOT/backups/EMAIL_BUILDER_FULL_FREEDOM_BEFORE_$TS"

say(){ echo -e "\n============================================================\n$1\n============================================================"; }

if [[ "${EUID:-$(id -u)}" -ne 0 ]]; then
  echo "❌ شغّل كـ root: sudo -i ثم ./email-builder-full-freedom"
  exit 1
fi

say "1) Backup قبل Email Builder الكامل"
cd "$ROOT"
BACKEND="$(docker compose ps -q backend || true)"
if [[ -z "$BACKEND" ]]; then
  echo "❌ لم أجد backend container. شغّل: cd /opt/frappe_crm && docker compose up -d"
  exit 1
fi
mkdir -p "$BACKUP_DIR"
cp -a "$APP_HOST" "$BACKUP_DIR/restaurant_ops"
[[ -f "$ROOT/docker-compose.yml" ]] && cp -a "$ROOT/docker-compose.yml" "$BACKUP_DIR/docker-compose.yml"
echo "✅ Backup: $BACKUP_DIR"

say "2) Setup Single DocType for Email Builder settings"
mkdir -p "$SCRIPTS_DIR" "$API_DIR" "$WWW_DIR"
cat > "$SCRIPTS_DIR/email_builder_setup.py" <<'PY'
import frappe

MODULE = "Restaurant Operations"


def run():
    dt = "Roshdy Email Builder Settings"
    if not frappe.db.exists("DocType", dt):
        frappe.get_doc({
            "doctype": "DocType",
            "name": dt,
            "module": MODULE,
            "custom": 0,
            "issingle": 1,
            "track_changes": 1,
            "fields": [
                {"fieldname": "settings_json", "label": "Settings JSON", "fieldtype": "Long Text"},
                {"fieldname": "last_updated_by", "label": "Last Updated By", "fieldtype": "Data", "read_only": 1},
                {"fieldname": "last_updated_at", "label": "Last Updated At", "fieldtype": "Datetime", "read_only": 1},
            ],
            "permissions": [
                {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 0},
            ],
        }).insert(ignore_permissions=True)
        print("✅ Created", dt)
    else:
        print("⏭️ exists", dt)
    frappe.db.commit()
    return {"success": True}
PY
chmod 644 "$SCRIPTS_DIR/email_builder_setup.py"

docker exec "$BACKEND" bench --site "$SITE" execute restaurant_ops.scripts.email_builder_setup.run

say "3) Write email_builder_api.py"
cat > "$API_DIR/email_builder_api.py" <<'PY'
