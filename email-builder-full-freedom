def _read_raw():
    raw = "{}"
    try:
        if frappe.db.exists("DocType", SETTINGS_DT):
            raw = frappe.db.get_single_value(SETTINGS_DT, "settings_json") or "{}"
    except Exception:
        raw = "{}"
    if not raw or raw == "{}":
        try:
            raw = frappe.db.get_default("roshdy_email_builder_v5") or frappe.db.get_default("roshdy_email_customizer_v4") or "{}"
        except Exception:
            raw = "{}"
    return raw or "{}"


def get_settings_dict():
    try:
        saved = json.loads(_read_raw() or "{}")
    except Exception:
        saved = {}
    d = defaults()
    for k, v in (saved or {}).items():
        if isinstance(v, dict) and isinstance(d.get(k), dict):
            d[k].update(v)
        else:
            d[k] = v
    if not isinstance(d.get("call_metrics"), list):
        d["call_metrics"] = default_call_metrics()
    return d


def save_settings_dict(data):
    if not frappe.db.exists("DocType", SETTINGS_DT):
        frappe.db.set_default("roshdy_email_builder_v5", json.dumps(data, ensure_ascii=False))
    else:
        doc = frappe.get_single(SETTINGS_DT)
        doc.settings_json = json.dumps(data, ensure_ascii=False)
        doc.last_updated_by = frappe.session.user
        doc.last_updated_at = now_datetime()
        doc.save(ignore_permissions=True)
    frappe.db.set_default("roshdy_email_builder_v5", json.dumps(data, ensure_ascii=False))
    frappe.db.commit()
    return data


