#!/usr/bin/env bash
set -Eeuo pipefail

# Python 2.7 compatible local Elastix/Asterisk queue_log journey parser - READ ONLY
# Run this ON the Elastix server.
# It reads /var/log/asterisk/queue_log and creates JSON/CSV/TXT summaries under /tmp.
# No changes to Elastix, Asterisk, CDR, or ERP.
#
# Usage:
#   chmod +x parse-elastix-queue-journey-local-py2
#   DATE_FROM=2026-08-08 DATE_TO=2026-08-08 QUEUES=1234,123 MAX_LINES=300000 ./parse-elastix-queue-journey-local-py2
#
# Optional:
#   EXT_MAP='1005=Omar Elboghdady,1013=Employee 1013,1008=Employee 1008' ./parse-elastix-queue-journey-local-py2
#   MASK_PHONES=1 ./parse-elastix-queue-journey-local-py2

QUEUE_LOG="${QUEUE_LOG:-/var/log/asterisk/queue_log}"
DATE_FROM="${DATE_FROM:-$(date +%F)}"
DATE_TO="${DATE_TO:-$DATE_FROM}"
QUEUES="${QUEUES:-1234,123}"
OUT_DIR="${OUT_DIR:-/tmp/ROSHDY_QUEUE_JOURNEY_PY2_$(date +%Y%m%d_%H%M%S)}"
MAX_LINES="${MAX_LINES:-0}"   # 0 = full file for selected date; use 300000 for fast test
EXT_MAP="${EXT_MAP:-}"
MASK_PHONES="${MASK_PHONES:-0}"
PYBIN="${PYBIN:-python}"

mkdir -p "$OUT_DIR"

echo "============================================================"
echo "🔎 Roshdy Queue Journey Parser PY2 - READ ONLY"
echo "📄 queue_log: $QUEUE_LOG"
echo "📅 Date: $DATE_FROM to $DATE_TO"
echo "☎️ Queues: $QUEUES"
echo "📁 Output: $OUT_DIR"
echo "🐍 Python: $($PYBIN --version 2>&1 || true)"
echo "============================================================"

if [[ ! -f "$QUEUE_LOG" ]]; then
  echo "❌ queue_log not found: $QUEUE_LOG"
  exit 1
fi

if ! command -v "$PYBIN" >/dev/null 2>&1; then
  echo "❌ Python command not found: $PYBIN"
  echo "Try: PYBIN=python2 ./parse-elastix-queue-journey-local-py2"
  exit 1
fi

"$PYBIN" - "$QUEUE_LOG" "$DATE_FROM" "$DATE_TO" "$QUEUES" "$OUT_DIR" "$MAX_LINES" "$EXT_MAP" "$MASK_PHONES" <<'PY'
# -*- coding: utf-8 -*-
from __future__ import print_function
import sys, os, re, json, datetime, time, codecs
from collections import defaultdict, Counter, deque

try:
    unicode
except NameError:
    unicode = str

qfile, date_from, date_to, queues_s, out_dir, max_lines_s, ext_map_s, mask_s = sys.argv[1:9]
queues = set([q.strip() for q in queues_s.split(',') if q.strip()])
max_lines = int(max_lines_s or 0)
mask_phones = str(mask_s) == '1'

def u(x):
    if x is None:
        return u''
    if isinstance(x, unicode):
        return x
    try:
        return str(x).decode('utf-8', 'ignore')
    except Exception:
        try:
            return unicode(x)
        except Exception:
            return u''

def b(x):
    return u(x).encode('utf-8')

ext_map = {}
for part in (ext_map_s or '').split(','):
    if '=' in part:
        k, v = part.split('=', 1)
        ext_map[k.strip()] = u(v.strip())

start_dt = datetime.datetime.strptime(date_from + ' 00:00:00', '%Y-%m-%d %H:%M:%S')
end_dt = datetime.datetime.strptime(date_to + ' 23:59:59', '%Y-%m-%d %H:%M:%S')
start = int(time.mktime(start_dt.timetuple()))
end = int(time.mktime(end_dt.timetuple()))

interesting = set([
    'DID','ENTERQUEUE','RINGNOANSWER','RINGCANCELED','AGENTDUMP',
    'CONNECT','COMPLETECALLER','COMPLETEAGENT','ABANDON','EXITWITHTIMEOUT','EXITEMPTY','EXITWITHKEY','TRANSFER'
])

def mask_phone(x):
    x = u(x)
    if not mask_phones:
        return x
    digits = re.sub(r'\D+', '', x)
    if len(digits) <= 4:
        return x
    return x[:3] + u'****' + x[-4:]

def ext_from_agent(agent):
    agent = u(agent)
    pats = [r'(?:Local|SIP|PJSIP|Agent)/(\d{3,6})', r'^(\d{3,6})$', r'\b(\d{3,6})\b']
    for pat in pats:
        m = re.search(pat, agent, re.I)
        if m and m.group(1) not in ('123','1234'):
            return m.group(1)
    return ''

def ts_text(t):
    return datetime.datetime.fromtimestamp(int(t)).strftime('%Y-%m-%d %H:%M:%S')

def employee(ext):
    ext = u(ext).strip()
    if not ext:
        return u'Unknown'
    return ext_map.get(ext) or (u'Extension ' + ext)

def csv_cell(v):
    s = u(v).replace(u'"', u'""')
    return u'"' + s + u'"'

# Read lines: either full file or last MAX_LINES lines.
if max_lines > 0:
    f = open(qfile, 'r')
    try:
        source_lines = deque(f, maxlen=max_lines)
    finally:
        f.close()
else:
    source_lines = open(qfile, 'r')

rows = []
counts = Counter()
by_queue = defaultdict(Counter)
line_count = 0

for line in source_lines:
    line_count += 1
    line = line.rstrip('\n')
    if not line:
        continue
    parts = line.split('|')
    if len(parts) < 5:
        continue
    try:
        t = int(float(parts[0]))
    except Exception:
        continue
    if not (start <= t <= end):
        continue
    callid, queue, agent, event = parts[1], parts[2], parts[3], parts[4]
    if queues and queue not in queues:
        continue
    counts[event] += 1
    by_queue[queue][event] += 1
    if event not in interesting:
        continue
    rows.append({
        'time_epoch': t,
        'time_text': ts_text(t),
        'callid': callid,
        'queue': queue,
        'agent': agent,
        'agent_ext': ext_from_agent(agent),
        'event': event,
        'data': parts[5:],
        'raw': line,
    })

try:
    if max_lines <= 0:
        source_lines.close()
except Exception:
    pass

by_call = defaultdict(list)
for r in rows:
    by_call[r['callid']].append(r)
for cid in by_call:
    by_call[cid].sort(key=lambda x: x['time_epoch'])

def caller_from(evs):
    for e in evs:
        if e['event'] == 'ENTERQUEUE':
            for d in e.get('data') or []:
                if re.search(r'\d{5,}', d or ''):
                    return d
    return ''

attempts = []
call_summaries = []

for cid, evs in by_call.items():
    caller = caller_from(evs)
    connects = [e for e in evs if e['event'] == 'CONNECT']
    abandons = [e for e in evs if e['event'] == 'ABANDON']
    completes = [e for e in evs if e['event'] in ('COMPLETECALLER','COMPLETEAGENT')]

    if connects:
        final = 'answered'
        final_ext = connects[-1].get('agent_ext') or ''
    elif abandons:
        final = 'customer_abandoned_before_answer'
        final_ext = ''
    elif completes:
        final = 'completed_but_connect_missing'
        final_ext = ''
    else:
        final = 'unknown_or_still_in_queue'
        final_ext = ''

    call_summaries.append({
        'callid': cid,
        'caller': mask_phone(caller),
        'queue': evs[0]['queue'] if evs else '',
        'events_count': len(evs),
        'events': [e['event'] for e in evs],
        'final_outcome': final,
        'final_extension': final_ext,
        'final_employee': employee(final_ext) if final_ext else '',
    })

    for i, e in enumerate(evs):
        if e['event'] not in ('RINGNOANSWER','RINGCANCELED','AGENTDUMP'):
            continue
        missed_ext = e.get('agent_ext') or ''
        if not missed_ext:
            continue
        later = evs[i+1:]
        later_connect = None
        later_abandon = None
        later_timeout_only = None
        later_complete = None
        for x in later:
            if later_connect is None and x['event'] == 'CONNECT':
                later_connect = x
            if later_abandon is None and x['event'] == 'ABANDON':
                later_abandon = x
            if later_timeout_only is None and x['event'] in ('EXITWITHTIMEOUT','EXITEMPTY','EXITWITHKEY'):
                later_timeout_only = x
            if later_complete is None and x['event'] in ('COMPLETECALLER','COMPLETEAGENT'):
                later_complete = x

        if later_connect:
            fate = 'answered_later'
            answered_ext = later_connect.get('agent_ext') or ''
            answered_time = later_connect['time_text']
        elif later_abandon:
            fate = 'customer_abandoned_after_attempt'
            answered_ext = ''
            answered_time = later_abandon['time_text']
        elif later_complete:
            fate = 'completed_after_attempt_connect_missing'
            answered_ext = ''
            answered_time = later_complete['time_text']
        elif later_timeout_only:
            # EXITWITHTIMEOUT is not necessarily final. Your sample shows timeout cycles before CONNECT.
            fate = 'timeout_after_attempt_no_final_connect_seen'
            answered_ext = ''
            answered_time = later_timeout_only['time_text']
        else:
            fate = 'unknown_after_attempt'
            answered_ext = ''
            answered_time = ''

        raw_data = e.get('data') or []
        raw_ring = raw_data[0] if raw_data else ''
        try:
            n = int(float(raw_ring or 0))
            ring_seconds = round(n/1000.0, 1) if n > 1000 else n
        except Exception:
            ring_seconds = raw_ring

        attempts.append({
            'attempt_time': e['time_text'],
            'callid': cid,
            'queue': e['queue'],
            'caller': mask_phone(caller),
            'missed_extension': missed_ext,
            'missed_employee': employee(missed_ext),
            'missed_event': e['event'],
            'ring_seconds': ring_seconds,
            'fate': fate,
            'fate_time': answered_time,
            'answered_extension': answered_ext,
            'answered_employee': employee(answered_ext) if answered_ext else '',
            'final_outcome_for_call': final,
            'raw_data': raw_data,
        })

by_ext = defaultdict(lambda: {'extension':'','employee':'','attempts':0,'answered_later':0,'customer_abandoned_after_attempt':0,'timeout_no_final_connect':0,'unknown':0})
for a in attempts:
    ext = a['missed_extension']
    row = by_ext[ext]
    row['extension'] = ext
    row['employee'] = a['missed_employee']
    row['attempts'] += 1
    if a['fate'] == 'answered_later':
        row['answered_later'] += 1
    elif a['fate'] == 'customer_abandoned_after_attempt':
        row['customer_abandoned_after_attempt'] += 1
    elif a['fate'] == 'timeout_after_attempt_no_final_connect_seen':
        row['timeout_no_final_connect'] += 1
    else:
        row['unknown'] += 1

summary = {
    'success': True,
    'queue_log_file': qfile,
    'date_from': date_from,
    'date_to': date_to,
    'queues': sorted(list(queues)),
    'max_lines': max_lines,
    'events_loaded': len(rows),
    'event_counts': dict(counts),
    'event_counts_by_queue': dict((q, dict(c)) for q, c in by_queue.items()),
    'calls_seen': len(by_call),
    'attempts_total': len(attempts),
    'attempts_by_fate': dict(Counter([a['fate'] for a in attempts])),
    'attempts_by_missed_extension': sorted(by_ext.values(), key=lambda x: x['attempts'], reverse=True),
    'attempt_rows_sample': attempts[:300],
    'call_journey_samples': call_summaries[:200],
    'can_determine_journey': len(attempts) > 0,
}

json_path = os.path.join(out_dir, 'queue_journey_result.json')
with open(json_path, 'wb') as f:
    f.write(json.dumps(summary, ensure_ascii=False, indent=2).encode('utf-8'))

csv_path = os.path.join(out_dir, 'queue_journey_attempts.csv')
headers = ['attempt_time','queue','caller','missed_extension','missed_employee','ring_seconds','fate','answered_extension','answered_employee','fate_time','callid','final_outcome_for_call']
with open(csv_path, 'wb') as f:
    f.write(codecs.BOM_UTF8)
    f.write((u','.join([csv_cell(h) for h in headers]) + u'\n').encode('utf-8'))
    for a in attempts:
        f.write((u','.join([csv_cell(a.get(h,'')) for h in headers]) + u'\n').encode('utf-8'))

sum_path = os.path.join(out_dir, 'queue_journey_summary.txt')
with open(sum_path, 'wb') as f:
    def w(line):
        f.write((u(line) + u'\n').encode('utf-8'))
    w('Date: %s to %s' % (date_from, date_to))
    w('Queues: %s' % ','.join(sorted(list(queues))))
    w('Events loaded: %s' % len(rows))
    w('Event counts: %s' % dict(counts))
    w('Calls seen: %s' % len(by_call))
    w('Attempts total: %s' % len(attempts))
    w('Attempts by fate: %s' % dict(Counter([a['fate'] for a in attempts])))
    w('')
    w('By missed extension:')
    for row in summary['attempts_by_missed_extension'][:50]:
        w(row)
    w('')
    w('First 30 attempts:')
    for a in attempts[:30]:
        w(a)

print('JSON:', json_path)
print('CSV:', csv_path)
print('SUMMARY:', sum_path)
print('\n--- SUMMARY ---')
print(open(sum_path, 'rb').read().decode('utf-8', 'ignore'))
PY

echo "============================================================"
echo "✅ Done"
echo "📁 Output folder: $OUT_DIR"
echo "📄 Summary: $OUT_DIR/queue_journey_summary.txt"
echo "📄 JSON:    $OUT_DIR/queue_journey_result.json"
echo "📄 CSV:     $OUT_DIR/queue_journey_attempts.csv"
echo "============================================================"
