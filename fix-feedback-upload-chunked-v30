<!-- BEGIN ROSHDY FEEDBACK CHUNKED UPLOAD V30 -->
<script>
(function(){
  if(window.RoshdyFeedbackChunkedUploadV30) return;
  window.RoshdyFeedbackChunkedUploadV30 = true;

  function getEl(id){ return document.getElementById(id); }
  function msg(text){
    try { if(typeof toast === 'function') toast(text); else alert(text); }
    catch(e){ alert(text); }
  }
  function qs(o){
    var p = new URLSearchParams();
    Object.keys(o||{}).forEach(function(k){ var v=o[k]; if(v!==undefined && v!==null && v!=='') p.append(k,v); });
    return p.toString();
  }
  async function getApi(method,args){
    var q = qs(args||{});
    var r = await fetch('/api/method/'+method+(q?'?'+q:''), {method:'GET', credentials:'same-origin', cache:'no-store'});
    var j = await r.json();
    if(j.exc) throw j;
    return j.message || j;
  }
  function requireShiftV30(){
    var sh = getEl('add_shift');
    if(!sh || !sh.value.trim()){
      msg('رقم الوردية مطلوب قبل رفع الملف');
      if(sh) sh.focus();
      return false;
    }
    return true;
  }
  function readFileAsBase64(file){
    return new Promise(function(resolve,reject){
      var reader = new FileReader();
      reader.onload = function(){
        var s = String(reader.result||'');
        resolve(s.indexOf(',')>=0 ? s.split(',',2)[1] : s);
      };
      reader.onerror = reject;
      reader.readAsDataURL(file);
    });
  }

  window.uploadExcel = async function(){
    if(!requireShiftV30()) return;
    var fileInput = getEl('file');
    var file = fileInput && fileInput.files && fileInput.files[0];
    if(!file){ msg('اختار ملف Excel/CSV'); return; }
    var btn = getEl('uploadBtn');
    var out = getEl('uploadResult');
    if(btn){ btn.disabled=true; btn.textContent='جاري الرفع...'; }
    if(out) out.textContent='جاري قراءة الملف...';
    try{
      var b64 = await readFileAsBase64(file);
      var start = await getApi('restaurant_ops.api.feedback_api.feedback_upload_start', {filename:file.name});
      if(!start || !start.success) throw new Error('فشل بدء جلسة الرفع');
      var uploadId = start.upload_id;
      var chunkSize = 1800; // safe URL size for old/proxy setups
      var total = Math.ceil(b64.length / chunkSize);
      for(var i=0;i<total;i++){
        var chunk = b64.slice(i*chunkSize, (i+1)*chunkSize);
        if(out) out.textContent='رفع الملف: جزء '+(i+1)+' من '+total;
        await getApi('restaurant_ops.api.feedback_api.feedback_upload_chunk', {upload_id:uploadId, idx:i, data:chunk});
      }
      if(out) out.textContent='جاري تحليل الملف وحفظ البيانات...';
      var res = await getApi('restaurant_ops.api.feedback_api.feedback_upload_commit', {
        upload_id: uploadId,
        total_chunks: total,
        feedback_date: (getEl('add_date')||{}).value || '',
        shift_number: (getEl('add_shift')||{}).value || '',
        filename: file.name
      });
      if(!res.success){
        msg(res.message || 'فشل رفع الملف');
        if(out) out.textContent=res.message || 'فشل رفع الملف';
        return;
      }
      var text='تم قراءة '+(res.parsed||0)+' صف — تم إضافة '+(res.created||0)+' — مكرر '+(res.skipped_duplicates||0);
      msg(text);
      if(out) out.textContent=text + (res.sample ? ' | عينة: '+JSON.stringify(res.sample) : '');
      try{ if(typeof load === 'function') load(); }catch(e){}
    }catch(e){
      console.error(e);
      msg('فشل رفع الملف: '+(e.message || 'راجع Console'));
      if(out) out.textContent='فشل رفع الملف: '+(e.message || 'Error');
    }finally{
      if(btn){ btn.disabled=false; btn.textContent='رفع الملف'; }
    }
  };
})();
</script>
<!-- END ROSHDY FEEDBACK CHUNKED UPLOAD V30 -->
