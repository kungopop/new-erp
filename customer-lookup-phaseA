say "5) Patch admin-desk safe link to Customer Lookup for System Manager"
python3 - <<'PY'
from pathlib import Path
import re
p=Path('/opt/frappe_crm/apps/restaurant_ops/restaurant_ops/www/admin-desk.html')
if p.exists():
    s=p.read_text(errors='ignore')
    s=re.sub(r'<!-- ROSHDY_CUSTOMER_LOOKUP_LINK_START -->[\s\S]*?<!-- ROSHDY_CUSTOMER_LOOKUP_LINK_END -->','',s)
    block='''\n<!-- ROSHDY_CUSTOMER_LOOKUP_LINK_START -->\n<a href="/customer-lookup-settings" style="position:fixed;left:18px;top:180px;z-index:99999;background:#7c3aed;color:#fff;text-decoration:none;border-radius:14px;padding:10px 13px;box-shadow:0 8px 24px rgba(0,0,0,.14);font-weight:800;font-family:Tahoma,Arial">🔐 Customer Lookup</a>\n<!-- ROSHDY_CUSTOMER_LOOKUP_LINK_END -->\n'''
    if '<body' in s.lower():
        s=re.sub(r'(<body[^>]*>)', r'\1\n'+block, s, count=1, flags=re.I)
    else:
        s=block+s
    s=s.replace('{#','{ #')
    p.write_text(s)
    print('✅ admin link patched')
