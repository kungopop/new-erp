import json
import re
import html
from datetime import timedelta

import frappe
from frappe.utils import now_datetime, add_to_date

DENY_SQL_WORDS = [
    "insert", "update", "delete", "drop", "alter", "truncate", "create", "replace", "grant", "revoke", "execute", "call", "load_file", "outfile", "dumpfile", ";"
]


def _sys_only():
    user = frappe.session.user
    roles = set(frappe.get_roles(user))
    return user == "Administrator" or "System Manager" in roles


def _deny():
    return {"success": False, "message": "System Manager only"}


def _check():
    if not _sys_only():
        frappe.throw("System Manager only", frappe.PermissionError)


def normalize_phone(value):
    s = str(value or "")
    s = s.split("@")[0]
    digits = re.sub(r"\D+", "", s)
    if digits.startswith("00"):
        digits = digits[2:]
    if digits.startswith("2") and len(digits) == 12:
        phone_20 = digits
    elif digits.startswith("0") and len(digits) == 11:
        phone_20 = "20" + digits[1:]
    elif digits.startswith("1") and len(digits) == 10:
        phone_20 = "20" + digits
    else:
        phone_20 = digits
    phone_local = "0" + phone_20[2:] if phone_20.startswith("20") and len(phone_20) == 12 else digits
    phone_no_country = phone_20[2:] if phone_20.startswith("20") else digits[-10:]
    return {
        "phone_raw": str(value or ""),
        "phone_digits": digits,
        "phone_20": phone_20,
        "phone_plus": "+" + phone_20 if phone_20 else "",
        "phone_local": phone_local,
        "phone_no_country": phone_no_country,
        "phone_like": "%" + phone_no_country + "%" if phone_no_country else "%%",
    }


def _source_password(doc):
    try:
        v = doc.get_password("db_password")
        if v:
            return v
    except Exception:
        pass
    try:
        from frappe.utils.password import get_decrypted_password
        return get_decrypted_password(doc.doctype, doc.name, "db_password", raise_exception=False) or ""
    except Exception:
        return ""


def _set_source_password(doc, value):
    if not value:
        return
    try:
        if hasattr(doc, "set_password"):
            doc.set_password("db_password", value)
            return
    except Exception:
        pass
    try:
        from frappe.utils.password import set_encrypted_password
        set_encrypted_password(doc.doctype, doc.name, value, "db_password")
        return
    except Exception:
        pass
    frappe.db.set_value(doc.doctype, doc.name, "db_password", value)


def _clean_url_template(tpl):
    return str(tpl or "").strip()


def _render_template(tpl, vars):
    out = _clean_url_template(tpl)
    for k, v in vars.items():
        out = out.replace("{" + k + "}", str(v or ""))
    return out


def _safe_sql(sql):
    s = str(sql or "").strip()
    low = re.sub(r"\s+", " ", s.lower())
    if not (low.startswith("select ") or low.startswith("with ")):
        return False, "Only SELECT/WITH queries are allowed"
    for w in DENY_SQL_WORDS:
        if w == ";":
            if ";" in low:
                return False, "Multiple statements are not allowed"
        elif re.search(r"\b" + re.escape(w) + r"\b", low):
            return False, "Forbidden SQL keyword: " + w
    return True, "OK"


def _mysql_connect(source):
    import pymysql
    return pymysql.connect(
        host=source.db_host,
        port=int(source.db_port or 3306),
        user=source.db_user,
        password=_source_password(source),
        database=source.db_name,
        connect_timeout=5,
        read_timeout=10,
        write_timeout=10,
        charset="utf8mb4",
        cursorclass=pymysql.cursors.DictCursor,
        autocommit=True,
    )


def _rows_to_display(rows):
    if not rows:
        return "لا توجد بيانات"
    lines = []
    for i, row in enumerate(rows, 1):
        if len(rows) > 1:
            lines.append(f"--- Row {i} ---")
        for k, v in row.items():
            lines.append(f"{k}: {v if v is not None else ''}")
    return "\n".join(lines)


def _parse_http_response(text, response_type):
    rt = (response_type or "JSON").lower()
    if rt == "json":
        data = json.loads(text or "{}")
        if isinstance(data, list):
            rows = data
        elif isinstance(data, dict):
            rows = data.get("rows") if isinstance(data.get("rows"), list) else [data]
        else:
            rows = [{"value": data}]
        return {"rows": rows, "raw": data, "display": _rows_to_display(rows)}
    if rt == "html":
        # Keep raw text for admin preview; also make stripped text.
        stripped = re.sub(r"<[^>]+>", " ", text or "")
        stripped = html.unescape(re.sub(r"\s+", " ", stripped)).strip()
        return {"rows": [{"HTML/Text": stripped}], "raw_html": text, "display": stripped}
    return {"rows": [{"Text": text or ""}], "raw_text": text or "", "display": text or ""}


@frappe.whitelist(allow_guest=False)
def list_sources():
    if not _sys_only(): return _deny()
    rows = frappe.get_all("Customer Lookup Source", fields=["name", "source_name", "source_type", "active", "cache_ttl_minutes", "http_url_template", "http_response_type", "db_host", "db_port", "db_name", "db_user", "notes"], order_by="modified desc", limit_page_length=200)
    return {"success": True, "sources": rows}


@frappe.whitelist(allow_guest=False)
def save_source(name=None, source_name=None, source_type="HTTP Bridge", active=1, cache_ttl_minutes=5, http_url_template="", http_response_type="JSON", db_host="", db_port=3306, db_name="", db_user="", db_password="", notes=""):
    if not _sys_only(): return _deny()
    doc = frappe.get_doc("Customer Lookup Source", name) if name and frappe.db.exists("Customer Lookup Source", name) else frappe.get_doc({"doctype":"Customer Lookup Source"})
    doc.source_name = source_name or doc.source_name or "Customer Source"
    doc.source_type = source_type or "HTTP Bridge"
    doc.active = int(active or 0)
    doc.cache_ttl_minutes = int(cache_ttl_minutes or 5)
    doc.http_url_template = http_url_template or ""
    doc.http_method = "GET"
    doc.http_response_type = http_response_type or "JSON"
    doc.db_host = db_host or ""
    doc.db_port = int(db_port or 3306)
    doc.db_name = db_name or ""
    doc.db_user = db_user or ""
    doc.notes = notes or ""
    if doc.is_new(): doc.insert(ignore_permissions=True)
    else: doc.save(ignore_permissions=True)
    if db_password:
        _set_source_password(doc, db_password)
    frappe.db.commit()
    return {"success": True, "message": "تم حفظ مصدر البيانات", "name": doc.name}


@frappe.whitelist(allow_guest=False)
def test_source(source_name, test_phone="01000000000"):
    if not _sys_only(): return _deny()
    source = frappe.get_doc("Customer Lookup Source", source_name)
    if source.source_type == "HTTP Bridge":
        return run_http_source(source.name, test_phone, no_cache=1)
    if source.source_type == "MySQL/MariaDB":
        try:
            con = _mysql_connect(source)
            with con.cursor() as cur:
                cur.execute("select 1 as ok")
                row = cur.fetchone()
            con.close()
            return {"success": True, "message": "DB connection OK", "result": row}
        except Exception as e:
            return {"success": False, "message": str(e)}
    return {"success": False, "message": "هذا النوع لسه غير مفعل في Phase A"}


@frappe.whitelist(allow_guest=False)
def list_tables(source_name):
    if not _sys_only(): return _deny()
    source = frappe.get_doc("Customer Lookup Source", source_name)
    if source.source_type != "MySQL/MariaDB":
        return {"success": False, "message": "List tables متاح حالياً لـ MySQL/MariaDB فقط"}
    try:
        con = _mysql_connect(source)
        with con.cursor() as cur:
            cur.execute("select table_name from information_schema.tables where table_schema=%s order by table_name", (source.db_name,))
            rows = cur.fetchall()
        con.close()
        return {"success": True, "tables": [r["table_name"] for r in rows]}
    except Exception as e:
        return {"success": False, "message": str(e)}


@frappe.whitelist(allow_guest=False)
def list_columns(source_name, table_name):
    if not _sys_only(): return _deny()
    if not re.match(r"^[A-Za-z0-9_]+$", table_name or ""):
        return {"success": False, "message": "Invalid table name"}
    source = frappe.get_doc("Customer Lookup Source", source_name)
    try:
        con = _mysql_connect(source)
        with con.cursor() as cur:
            cur.execute("select column_name, data_type from information_schema.columns where table_schema=%s and table_name=%s order by ordinal_position", (source.db_name, table_name))
            rows = cur.fetchall()
        con.close()
        return {"success": True, "columns": rows}
    except Exception as e:
        return {"success": False, "message": str(e)}


@frappe.whitelist(allow_guest=False)
def sample_rows(source_name, table_name, limit=5):
    if not _sys_only(): return _deny()
    if not re.match(r"^[A-Za-z0-9_]+$", table_name or ""):
        return {"success": False, "message": "Invalid table name"}
    limit = max(1, min(int(limit or 5), 20))
    source = frappe.get_doc("Customer Lookup Source", source_name)
    try:
        con = _mysql_connect(source)
        with con.cursor() as cur:
            cur.execute(f"select * from `{table_name}` limit {limit}")
            rows = cur.fetchall()
        con.close()
        return {"success": True, "rows": rows}
    except Exception as e:
        return {"success": False, "message": str(e)}


@frappe.whitelist(allow_guest=False)
def list_queries():
    if not _sys_only(): return _deny()
    rows = frappe.get_all("Customer Lookup Query", fields=["name", "query_name", "source", "active", "lookup_mode", "sql_query", "max_rows", "cache_ttl_minutes", "result_note"], order_by="modified desc", limit_page_length=200)
    return {"success": True, "queries": rows}


@frappe.whitelist(allow_guest=False)
def save_query(name=None, query_name=None, source=None, active=1, lookup_mode="Use Source Default", sql_query="", max_rows=5, cache_ttl_minutes=0, result_note=""):
    if not _sys_only(): return _deny()
    if not source:
        return {"success": False, "message": "Source مطلوب"}
    doc = frappe.get_doc("Customer Lookup Query", name) if name and frappe.db.exists("Customer Lookup Query", name) else frappe.get_doc({"doctype":"Customer Lookup Query"})
    doc.query_name = query_name or doc.query_name or "Customer Query"
    doc.source = source
    doc.active = int(active or 0)
    doc.lookup_mode = lookup_mode or "Use Source Default"
    doc.sql_query = sql_query or ""
    doc.max_rows = int(max_rows or 5)
    doc.cache_ttl_minutes = int(cache_ttl_minutes or 0)
    doc.result_note = result_note or ""
    if doc.sql_query:
        ok, msg = _safe_sql(doc.sql_query)
        if not ok:
            return {"success": False, "message": msg}
    if doc.is_new(): doc.insert(ignore_permissions=True)
    else: doc.save(ignore_permissions=True)
    frappe.db.commit()
    return {"success": True, "message": "تم حفظ الكويري", "name": doc.name}


def _cache_key(phone_norm, query_name):
    return frappe.db.get_value("Customer Lookup Cache", {"phone_normalized": phone_norm, "query": query_name}, "name")


def _get_cache(phone_norm, query_name):
    name = _cache_key(phone_norm, query_name)
    if not name: return None
    doc = frappe.get_doc("Customer Lookup Cache", name)
    try:
        if doc.expires_at and doc.expires_at > now_datetime():
            return doc
    except Exception:
        pass
    return None


def _save_cache(phone_norm, query_name, source_name, result, ttl):
    name = _cache_key(phone_norm, query_name)
    doc = frappe.get_doc("Customer Lookup Cache", name) if name else frappe.get_doc({"doctype":"Customer Lookup Cache"})
    doc.phone_normalized = phone_norm
    doc.query = query_name
    doc.source = source_name
    doc.status = "OK" if result.get("rows") else "Not Found"
    doc.last_lookup_at = now_datetime()
    doc.expires_at = add_to_date(now_datetime(), minutes=int(ttl or 5))
    doc.result_json = json.dumps(result, ensure_ascii=False, default=str)[:50000]
    doc.display_text = (result.get("display") or _rows_to_display(result.get("rows") or []))[:50000]
    doc.error_message = ""
    if doc.is_new(): doc.insert(ignore_permissions=True)
    else: doc.save(ignore_permissions=True)
    frappe.db.commit()
    return doc


@frappe.whitelist(allow_guest=False)
def variables_for_phone(phone):
    if not _sys_only(): return _deny()
    return {"success": True, "variables": normalize_phone(phone)}


@frappe.whitelist(allow_guest=False)
def run_http_source(source_name, phone, no_cache=0):
    if not _sys_only(): return _deny()
    source = frappe.get_doc("Customer Lookup Source", source_name)
    vars = normalize_phone(phone)
    url = _render_template(source.http_url_template, vars)
    try:
        import requests
        r = requests.get(url, timeout=10)
        parsed = _parse_http_response(r.text, source.http_response_type)
        return {"success": r.ok, "url": url, "status_code": r.status_code, "result": parsed, "preview": parsed.get("display")}
    except Exception as e:
        return {"success": False, "url": url, "message": str(e)}


@frappe.whitelist(allow_guest=False)
def run_lookup(query_name, phone, force=0):
    if not _sys_only(): return _deny()
    query = frappe.get_doc("Customer Lookup Query", query_name)
    source = frappe.get_doc("Customer Lookup Source", query.source)
    vars = normalize_phone(phone)
    phone_norm = vars.get("phone_20") or vars.get("phone_digits")
    ttl = int(query.cache_ttl_minutes or source.cache_ttl_minutes or 5)
    if not int(force or 0):
        cached = _get_cache(phone_norm, query.name)
        if cached:
            return {"success": True, "cached": True, "phone": phone_norm, "result": json.loads(cached.result_json or "{}"), "display": cached.display_text, "expires_at": str(cached.expires_at)}
    mode = query.lookup_mode
    if mode == "Use Source Default":
        mode = "HTTP URL" if source.source_type == "HTTP Bridge" else "SQL Query"
    if mode == "HTTP URL":
        res = run_http_source(source.name, phone, no_cache=1)
        result = res.get("result") or {"rows": [], "display": res.get("message") or ""}
        cache = _save_cache(phone_norm, query.name, source.name, result, ttl)
        return {"success": res.get("success"), "cached": False, "phone": phone_norm, "result": result, "display": cache.display_text, "http": {"url": res.get("url"), "status_code": res.get("status_code")}}
    # SQL Query
    ok, msg = _safe_sql(query.sql_query)
    if not ok:
        return {"success": False, "message": msg}
    max_rows = max(1, min(int(query.max_rows or 5), 50))
    sql = query.sql_query.strip()
    if not re.search(r"\blimit\b", sql, flags=re.I):
        sql += f" limit {max_rows}"
    try:
        con = _mysql_connect(source)
        with con.cursor() as cur:
            cur.execute(sql, vars)
            rows = cur.fetchall()
        con.close()
        result = {"rows": rows, "summary": rows[0] if rows else {}, "display": _rows_to_display(rows), "variables": vars}
        cache = _save_cache(phone_norm, query.name, source.name, result, ttl)
        return {"success": True, "cached": False, "phone": phone_norm, "result": result, "display": cache.display_text, "expires_at": str(cache.expires_at)}
    except Exception as e:
        return {"success": False, "message": str(e), "variables": vars}
PY
