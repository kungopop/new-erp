td><button class="btn light" onclick="editQuery(\''+x.name+'\')">تعديل</button></td></tr>').join('')||'<tr><td colspan="5">لا توجد Queries</td></tr>'}function clearSource(){src_name.value='';source_name.value='Orders HTTP Bridge';source_type.value='HTTP Bridge';cache_ttl.value='5';http_url.value='http://10.11.1.19/caller.php?phone={phone_local}';http_response_type.value='JSON';db_host.value='';db_port.value='3306';db_name.value='';db_user.value='';db_password.value='';notes.value=''}function editSource(n){let x=sources.find(a=>a.name===n);if(!x)return;src_name.value=x.name;source_name.value=x.source_name;source_type.value=x.source_type;cache_ttl.value=x.cache_ttl_minutes||5;http_url.value=x.http_url_template||'';http_response_type.value=x.http_response_type||'JSON';db_host.value=x.db_host||'';db_port.value=x.db_port||3306;db_name.value=x.db_name||'';db_user.value=x.db_user||'';db_password.value='';notes.value=x.notes||''}async function saveSource(){let d=await api(M(['restaurant','_ops.api.customer_lookup','_api.save_source']),{name:src_name.value,source_name:source_name.value,source_type:source_type.value,active:1,cache_ttl_minutes:cache_ttl.value,http_url_template:http_url.value,http_response_type:http_response_type.value,db_host:db_host.value,db_port:db_port.value,db_name:db_name.value,db_user:db_user.value,db_password:db_password.value,notes:notes.value});show(sourceOut,d);await load()}async function testSource(){let d=await api(M(['restaurant','_ops.api.customer_lookup','_api.test_source']),{source_name:src_name.value||query_source.value,test_phone:test_phone.value});show(sourceOut,d)}async function tables(){let d=await api(M(['restaurant','_ops.api.customer_lookup','_api.list_tables']),{source_name:src_name.value||query_source.value});show(sourceOut,d)}function clearQuery(){qry_name.value='';query_name.value='آخر بيانات العميل';lookup_mode.value='Use Source Default';max_rows.value='5';query_ttl.value='0';sql_query.value=''}function editQuery(n){let x=queries.f