from pathlib import Path
import re
p=Path('/opt/frappe_crm/apps/restaurant_ops/restaurant_ops/www/quality-desk.html')
if not p.exists():
    raise SystemExit('quality-desk.html not found')
s=p.read_text(errors='ignore')
s=re.sub(r'<!-- ROSHDY_QUALITY_SAVE_FINAL_JS_START -->[\s\S]*?<!-- ROSHDY_QUALITY_SAVE_FINAL_JS_END -->','',s,flags=re.I)
block=r'''
<!-- ROSHDY_QUALITY_SAVE_FINAL_JS_START -->
<script id="quality-save-final-js">
(function(){
function M(a){return a.join('')}
function esc(x){return String(x==null?'':x).replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]})}
function normStatus(s){s=String(s||'').trim();var m={'مسودة':'Draft','Draft':'Draft','مفتوح':'Open','مفتوحة':'Open','Open':'Open','قيد المراجعة':'Under Review','قيد مراجعه':'Under Review','Under Review':'Under Review','تم الحل':'Resolved','محلولة':'Resolved','Resolved':'Resolved','مغلق':'Closed','مغلقة':'Closed','Closed':'Closed'};return m[s]||s||'Under Review'}
async function api(method,args){
  args=args||{};
  try{
    var r=await fetch('/api/method/'+method,{method:'POST',credentials:'same-origin',headers:{'Content-Type':'application/json','Accept':'application/json','X-Frappe-CSRF-Token':(window.csrf_token||'')},body:JSON.stringify(args)});
    var j=await r.json();
    if(j&&j.message) return j.message;
  }catch(e){}
  var qs=new URLSearchParams();Object.keys(args).forEach(function(k){if(args[k]!==undefined&&args[k]!==null)qs.append(k,args[k])});
  var r2=await fetch('/api/method/'+method+'?'+qs.toString(),{credentials:'same-origin',cache:'no-store'});var j2=await r2.json();return j2.message;
}
function fixStatusSelect(){
  var sel=document.getElementById('m_status'); if(!sel)return;
  sel.innerHTML='<option value="Draft">مسودة</option><option value="Open">مفتوحة</option><option value="Under Review">قيد المراجعة</option><option value="Resolved">تم الحل</option><option value="Closed">مغلقة</option>';
  try{ if(window.current&&window.current.status) sel.value=normStatus(window.current.status); }catch(e){}
  if(!sel.value) sel.value='Under Review';
}
var oldOpen=window.openComplaint;
if(typeof oldOpen==='function'){
  window.openComplaint=async function(name){ await oldOpen(name); setTimeout(fixStatusSelect,120); };
}
window.saveComplaint=async function(){
  var cur=window.current;
  if(!cur||!cur.name){alert('مفيش شكوى مفتوحة');return;}
  var btns=Array.from(document.querySelectorAll('button'));
  var btn=btns.find(function(b){return (b.textContent||'').indexOf('حفظ مراجعة الجودة')>=0});
  if(btn){btn.disabled=true;btn.textContent='جاري الحفظ...';}
  var dbg=document.getElementById('m_debug'); if(dbg)dbg.textContent='Saving...';
  var args={name:cur.name,assigned_quality_inspector:(document.getElementById('m_assigned')||{}).value||'',investigation_analysis:(document.getElementById('m_analysis')||{}).value||'',corrective_action:(document.getElementById('m_action')||{}).value||'',status:normStatus((document.getElementById('m_status')||{}).value||cur.status||'Under Review'),closing_notes:(document.getElementById('m_closing')||{}).value||''};
  try{
    var d=await api(M(['restaurant','_ops.api.quality','_api.update_quality_review']),args);
    if(dbg)dbg.textContent=JSON.stringify(d,null,2);
    if(d&&d.success){alert('تم حفظ مراجعة الجودة بنجاح'); if(typeof window.load==='function') await window.load(); cur.status=d.status||args.status;}
    else alert((d&&d.message)||'فشل الحفظ');
  }catch(e){ if(dbg)dbg.textContent=String(e.stack||e); alert('Error: '+(e.message||e)); }
  finally{ if(btn){btn.disabled=false;btn.textContent='حفظ مراجعة الجودة';} }
};
document.addEventListener('click',function(ev){var b=ev.target&&ev.target.closest?ev.target.closest('button'):null;if(!b)return;if((b.textContent||'').indexOf('حفظ مراجعة الجودة')>=0){ev.preventDefault();ev.stopPropagation();window.saveComplaint();}},true);
setTimeout(fixStatusSelect,500);
})();
</script>
<!-- ROSHDY_QUALITY_SAVE_FINAL_JS_END -->
'''
if '</body>' in s:
    s=s.replace('</body>',block+'\n</body>',1)
else:
    s+='\n'+block
p.write_text(s)
print('✅ quality desk JS save handler injected')
PY

