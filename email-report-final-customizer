" rows="2"></textarea><label>نص ختامي</label><textarea id="upper_footer" rows="2"></textarea></div><div class="panel"><h3>CSS متقدم اختياري</h3><textarea id="custom_css" rows="4" placeholder="اختياري"></textarea><br><button class="btn green" onclick="save()">حفظ التخصيص</button><button class="btn orange" onclick="preview()">Preview</button><button class="btn" onclick="sendTest()">إرسال تجريبي حسب النوع</button><pre id="out"></pre></div><div class="panel"><iframe id="frame"></iframe></div></div><script>function M(a){return a.join('')}async function api(m,args){let qs=new URLSearchParams();args=args||{};Object.keys(args).forEach(k=>{if(args[k]!==undefined&&args[k]!==null)qs.append(k,args[k])});let r=await fetch('/api/method/'+m+'?'+qs.toString(),{credentials:'same-origin',cache:'no-store'});let j=await r.json();return j.message}function id(x){return document.getElementById(x)}function val(x){return id(x).value}function chk(x){return id(x).checked?1:0}function setv(x,v){id(x).value=v==null?'':v}function setc(x,v){id(x).checked=!!Number(v)}function collect(){let data={};['place_name','primary_color','center_title','upper_title','shift_start','shift_end','center_recipients_override','upper_recipients_override','center_intro','center_footer','upper_intro','upper_footer','custom_css'].forEach(k=>data[k]=val(k));['show_call_explanation','show_breaks_center','show_sales_center','show_complaints_center','show_staff_missed_center','show_permissions_center','show_charges_center','show_call_explanation_upper','show_raw_summary_upper','show_sales_upper','show_complaints_upper','show_staff_missed_upper','show_breaks_upper'].forEach(k=>data[k]=chk(k));return data}async function load(){let d=await api(M(['restaurant','_ops.api.email','_report.get_email_customizer_settings']));let s=(d&&d.settings)||{};Object.keys(s).forEach(k=>{if(id(k)){if(id(k).type==='checkbox')setc(k,s[k]);else setv(k,s[k])}});out.textContent=JSON.stringify(d,null,2)}async function save(){let d=await api(M(['restaurant','_ops.api.email','_report.save_email_customizer_settings']),{settings_json:JSON.stringify(collect())});out.textContent=JSON.stringify(d,null,2);alert(d&&d.success?'تم الحفظ':'فشل')}async function preview(){await save();let rt=val('report_type');if(rt==='both')rt='center';let d=await api(M(['restaurant','_ops.api.email','_report.preview_email_report']),{report_type:rt});out.textContent=JSON.stringify({success:d&&d.success,settings:d&&d.settings},null,2);if(d&&d.success)frame.srcdoc=d.html;else alert((d&&d.message)||'Error')}async function sendTest(){await save();let rt=val('report_type');let d=await api(M(['restaurant','_ops.api.email','_report.send_report_now']),{report_type:rt});out.textContent=JSON.stringify(d,null,2);alert((d&&d.success)?'تم الإرسال/الجدولة':'فشل الإرسال')}load();</script></body></html>
