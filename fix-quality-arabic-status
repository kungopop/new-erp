from pathlib import Path
import re
p=Path('/opt/frappe_crm/apps/restaurant_ops/restaurant_ops/www/quality-desk.html')
if not p.exists():
    print('⚠️ quality-desk.html not found')
    raise SystemExit
s=p.read_text(errors='ignore')
s=re.sub(r'<!-- ROSHDY_QUALITY_ARABIC_STATUS_JS_START -->[\s\S]*?<!-- ROSHDY_QUALITY_ARABIC_STATUS_JS_END -->','',s,flags=re.I)
block=r'''
<!-- ROSHDY_QUALITY_ARABIC_STATUS_JS_START -->
<script id="quality-arabic-status-js">
(function(){
function statusEn(s){s=String(s||'').trim();var m={'مسودة':'Draft','Draft':'Draft','مفتوح':'Open','مفتوحة':'Open','Open':'Open','قيد المراجعة':'Under Review','قيد مراجعه':'Under Review','Under Review':'Under Review','تم الحل':'Resolved','محلولة':'Resolved','Resolved':'Resolved','مغلق':'Closed','مغلقة':'Closed','Closed':'Closed'};return m[s]||s||'Under Review'}
function priorityEn(s){s=String(s||'').trim();var m={'منخفضة':'Low','منخفض':'Low','Low':'Low','متوسطة':'Medium','متوسط':'Medium','Medium':'Medium','عالية':'High','عالي':'High','High':'High','عاجلة':'Urgent','عاجل':'Urgent','Urgent':'Urgent'};return m[s]||s}
function fixMainFilters(){var st=document.getElementById('status');if(st){st.innerHTML='<option value="All">الكل</option><option value="Draft">مسودة</option><option value="Open">مفتوحة</option><option value="Under Review">قيد المراجعة</option><option value="Resolved">تم الحل</option><option value="Closed">مغلقة</option>'}var pr=document.getElementById('priority');if(pr){pr.innerHTML='<option value="All">الكل</option><option value="Low">منخفضة</option><option value="Medium">متوسطة</option><option value="High">عالية</option><option value="Urgent">عاجلة</option>'}}
