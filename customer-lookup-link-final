            doc.query = query.name
            doc.source = source.name
            doc.status = "Error"
            doc.last_lookup_at = now_datetime()
            doc.expires_at = add_to_date(now_datetime(), minutes=1)
            doc.result_json = "{}"
            doc.display_text = ""
            doc.error_message = str(e)
            if doc.is_new(): doc.insert(ignore_permissions=True)
            else: doc.save(ignore_permissions=True)
            frappe.db.commit()
        except Exception:
            pass
        return {"success": False, "message": str(e), "phone": phone_norm, "rows": [], "display": ""}


def _extract_customer_name_from_result(result):
    """Pick customer name from Arabic/English query result keys."""
    rows = []
    if isinstance(result, dict):
        rows = result.get("rows") or []
        if not rows and isinstance(result.get("summary"), dict):
            rows = [result.get("summary")]
    if not rows:
        return ""
    row = rows[0] or {}
    preferred = [
        "اسم العميل", "العميل", "اسم", "Customer Name", "customer_name", "client_name", "name", "Name", "cust_name", "customer",
    ]
    for k in preferred:
        v = row.get(k)
        if v:
            return str(v)
    # Fallback: first non-phone-ish text field
    for k, v in row.items():
        if v is None:
            continue
        sv = str(v).strip()
        if not sv:
            continue
        if re.fullmatch(r"[+0-9\s\-]{7,}", sv):
            continue
        return sv[:80]
    return ""


def get_customer_name_internal(phone, force=0):
