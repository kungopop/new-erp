    mode = query.lookup_mode
    if mode == "Use Source Default":
        mode = "HTTP URL" if source.source_type == "HTTP Bridge" else "SQL Query"
    try:
        if mode == "HTTP URL":
            url = _render_template(source.http_url_template, vars)
