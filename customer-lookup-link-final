    if res.get("success"):
        res["customer_name"] = _extract_customer_name_from_result(res.get("result") or {})
    return res


@frappe.whitelist(allow_guest=False)
def get_customer_lookup_for_conversation(conversation, force=0):
    if not _can_view_lookup():
        return _deny()
    try:
        conv = frappe.get_doc("Social Conversation", conversation)
