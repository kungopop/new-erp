# 2) Ensure queue_journey_api exists and is robust
# -----------------------------------------------------------------------------
echo "🧩 Step 2: Install/refresh queue_journey_api.py"
cat > "$QUEUE_JOURNEY_API" <<'PYAPI'
# -*- coding: utf-8 -*-
"""Queue Journey API for Roshdy reports.
Reads parsed queue journey JSON from private/files/queue_journey.
Falls back to report_api.get_staff_missed_attempts if JSON is missing.
"""

import json
import os
import re
from collections import Counter, defaultdict

import frappe
from frappe.utils import today, cstr, cint, flt


def _period(date_from=None, date_to=None):
    df = cstr(date_from or today())[:10]
    dt = cstr(date_to or df)[:10]
    return df, dt


def _journey_dir():
    return frappe.get_site_path("private", "files", "queue_journey")


def _journey_file(date_from=None, date_to=None):
    df, dt = _period(date_from, date_to)
    exact = os.path.join(_journey_dir(), f"queue_journey_{df}_{dt}.json")
    latest = os.path.join(_journey_dir(), "latest.json")
    if os.path.exists(exact):
        return exact, "exact"
    if os.path.exists(latest):
        return latest, "latest_fallback"
    return exact, "missing"


def _load_json(date_from=None, date_to=None):
    path, source = _journey_file(date_from, date_to)
    if not os.path.exists(path):
        return None, path, source
    with open(path, "r", encoding="utf-8") as f:
        return json.load(f), path, source


def _mask_phone(phone):
    phone = cstr(phone or "")
    digits = re.sub(r"\D+", "", phone)
    if len(digits) <= 4:
        return phone
    return phone[:3] + "****" + phone[-4:]


def _employee_by_extension(ext, event_time=None):
    ext = cstr(ext or "").strip()
    if not ext:
        return ""
    # Employee direct extension-like fields.
    try:
        if frappe.db.exists("DocType", "Employee"):
            meta = frappe.get_meta("Employee")
            fields = []
            for df in meta.fields:
                fn = cstr(df.fieldname).lower()
                if any(x in fn for x in ("extension", "ext", "sip")):
                    fields.append(df.fieldname)
            for fn in fields:
                val = frappe.db.get_value("Employee", {fn: ext}, "employee_name")
                if val:
                    return val
    except Exception:
        pass
    # Extension Session around event time.
    try:
        if event_time and frappe.db.exists("DocType", "Extension Session"):
            rows = frappe.db.sql("""
                select coalesce(e.employee_name, s.employee, s.user) employee_name
                from `tabExtension Session` s
                left join `tabEmployee` e on e.name=s.employee
                where s.extension=%s
                  and (s.started_at is null or s.started_at <= %s)
                  and (s.released_at is null or s.released_at >= %s)
                order by s.started_at desc
                limit 1
            """, (ext, event_time, event_time), as_dict=True)
            if rows and rows[0].get("employee_name"):
                return rows[0].get("employee_name")
    except Exception:
        pass
    return ""


def _public_employee_label(ext, event_time=None):
    emp = _employee_by_extension(ext, event_time)
    if emp:
        return emp
    if ext:
        return f"غير محدد (تحويلة {ext})"
    return "غير محدد"


def _fate_label(fate, answered_ext=None, answered_employee=None):
    if fate == "answered_later_same_extension":
        return "تم الرد لاحقًا من نفس التحويلة"
    if fate == "answered_later_other_extension":
        if answered_employee:
            return f"تم الرد لاحقًا بواسطة {answered_employee}"
        if answered_ext:
            return f"تم الرد لاحقًا بواسطة تحويلة {answered_ext}"
        return "تم الرد لاحقًا"
    if fate == "customer_abandoned_after_attempt":
        return "العميل أغلق بعد المحاولة"
    if fate == "completed_after_attempt_connect_missing":
        return "اكتملت لاحقًا لكن حدث الرد غير ظاهر"
    if fate == "timeout_after_attempt_no_final_connect_seen":
        return "غير محدد بعد انتهاء دورة انتظار"
    if fate == "journey_unavailable":
        return "مصير المكالمة غير متاح من ملف الرحلة"
    return "غير محدد"


def _fallback_cdr(date_from=None, date_to=None, threshold=15, mask_phones=False):
    try:
        from restaurant_ops.api.report_api import get_staff_missed_attempts
        d = get_staff_missed_attempts(date_from or today(), date_to or date_from or today(), threshold) or {}
    except Exception as e:
        d = {"success": False, "error": cstr(e), "details": [], "grouped": [], "total_attempts": 0}
    rows = []
    for r in (d.get("details") or [])[:500]:
        ext = cstr(r.get("extension") or "")
        emp = r.get("employee_name")
        if not emp or emp == "غير مربوط وقت المكالمة":
            emp = _public_employee_label(ext, r.get("calldate"))
        rows.append({
            "attempt_time": cstr(r.get("calldate") or ""),
            "queue": "",
            "caller": _mask_phone(r.get("src")) if mask_phones else cstr(r.get("src") or ""),
            "missed_extension": ext,
            "missed_employee": emp,
            "ring_seconds": r.get("duration") or 0,
            "fate": "journey_unavailable",
            "fate_label": "مصير المكالمة غير متاح من ملف الرحلة",
            "answered_extension": "",
            "answered_employee": "",
            "fate_time": "",
            "callid": cstr(r.get("uniqueid") or ""),
        })
    total = cint(d.get("total_attempts") or len(rows) or 0)
    return {
        "success": True,
        "journey_available": False,
        "source": "cdr_fallback_get_staff_missed_attempts",
        "summary": {
            "attempts_total": total,
            "answered_later_total": None,
            "customer_abandoned_after_attempt": None,
            "unknown_or_timeout": total,
            "attempts_by_fate": {"journey_unavailable": total},
            "attempts_by_missed_extension": [],
        },
        "rows": rows,
        "grouped": d.get("grouped") or [],
        "raw": d,
    }


@frappe.whitelist()
def get_queue_journey_report(date_from=None, date_to=None, threshold=15, queues=None, mask_phones=0, limit_rows=500):
    df, dt = _period(date_from, date_to)
    mask_phones = bool(cint(mask_phones or 0))
    threshold = flt(threshold or 15)
    data, path, source = _load_json(df, dt)
    if not data:
        out = _fallback_cdr(df, dt, threshold=threshold, mask_phones=mask_phones)
        out.update({"date_from": df, "date_to": dt, "cache_path": path, "cache_source": source})
        return out

    raw_rows = data.get("attempts") or data.get("attempt_rows_sample") or []
    rows = []
    qset = {x.strip() for x in cstr(queues or "").split(",") if x.strip()}
    for r in raw_rows:
        ring = flt(r.get("ring_seconds") or 0)
        if ring < threshold:
            continue
        if qset and cstr(r.get("queue")) not in qset:
            continue
        missed_ext = cstr(r.get("missed_extension") or "")
        answered_ext = cstr(r.get("answered_extension") or "")
        missed_emp = _public_employee_label(missed_ext, r.get("attempt_time"))
        answered_emp = _employee_by_extension(answered_ext, r.get("fate_time")) if answered_ext else ""
        if answered_ext and not answered_emp:
            answered_emp = f"غير محدد (تحويلة {answered_ext})"
        fate = cstr(r.get("fate") or "unknown_after_attempt")
        rows.append({
            "attempt_time": cstr(r.get("attempt_time") or ""),
            "queue": cstr(r.get("queue") or ""),
            "caller": _mask_phone(r.get("caller")) if mask_phones else cstr(r.get("caller") or ""),
            "missed_extension": missed_ext,
            "missed_employee": missed_emp,
            "ring_seconds": ring,
            "fate": fate,
            "fate_label": _fate_label(fate, answered_ext, answered_emp),
            "answered_extension": answered_ext,
            "answered_employee": answered_emp,
            "fate_time": cstr(r.get("fate_time") or ""),
            "callid": cstr(r.get("callid") or ""),
            "final_outcome_for_call": cstr(r.get("final_outcome_for_call") or ""),
        })

    by_fate = Counter([r["fate"] for r in rows])
    answered_later = sum(v for k, v in by_fate.items() if k.startswith("answered_later"))
    abandoned = by_fate.get("customer_abandoned_after_attempt", 0)
    unknown = len(rows) - answered_later - abandoned
    by_ext = defaultdict(lambda: {"extension": "", "employee": "", "attempts": 0, "answered_later": 0, "customer_abandoned_after_attempt": 0, "unknown_or_timeout": 0})
    for r in rows:
        ext = r["missed_extension"] or "غير محدد"
        be = by_ext[ext]
        be["extension"] = ext
        be["employee"] = r["missed_employee"]
        be["attempts"] += 1
        if r["fate"].startswith("answered_later"):
            be["answered_later"] += 1
        elif r["fate"] == "customer_abandoned_after_attempt":
            be["customer_abandoned_after_attempt"] += 1
        else:
            be["unknown_or_timeout"] += 1

    return {
        "success": True,
        "journey_available": True,
        "source": "elastix_queue_log_cache",
        "date_from": df,
        "date_to": dt,
        "threshold_seconds": threshold,
        "cache_path": path,
        "cache_source": source,
        "generated_at": data.get("generated_at"),
        "summary": {
            "attempts_total": len(rows),
            "answered_later_total": answered_later,
            "customer_abandoned_after_attempt": abandoned,
            "unknown_or_timeout": unknown,
            "attempts_by_fate": dict(by_fate),
            "attempts_by_missed_extension": sorted(by_ext.values(), key=lambda x: x["attempts"], reverse=True),
        },
        "rows": rows[:cint(limit_rows or 500)],
        "raw_event_counts": data.get("event_counts"),
    }


@frappe.whitelist()
def debug_queue_journey_status(date_from=None, date_to=None):
    df, dt = _period(date_from, date_to)
    path, source = _journey_file(df, dt)
    return {
        "success": True,
        "date_from": df,
        "date_to": dt,
        "journey_dir": _journey_dir(),
        "selected_path": path,
        "selected_source": source,
        "exists": os.path.exists(path),
        "files": sorted(os.listdir(_journey_dir())) if os.path.exists(_journey_dir()) else [],
    }
PYAPI

