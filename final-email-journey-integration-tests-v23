  echo "❌ backend container مش شغال أو مش لاقيه"
  exit 1
fi

bench_exec() {
  "${COMPOSE[@]}" exec -T backend bench --site "$SITE" "$@"
}

echo "============================================================"
echo "🚀 Roshdy V23: Journey integration into BOTH email reports"
echo "📦 Backup: $BACKUP_DIR"
echo "📅 Period: $DATE_FROM to $DATE_TO"
echo "☎️ Queues: $QUEUES"
echo "⏱️ Threshold: $THRESHOLD seconds"
echo "============================================================"

