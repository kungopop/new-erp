  chown -R "$APP_OWNER" "$WWW_DIR" "$API_DIR" 2>/dev/null || true
fi

echo "🧹 Clear cache + restart app services"
bench_exec clear-cache || true
"${COMPOSE[@]}" restart backend frontend websocket queue-short queue-long scheduler >/dev/null
sleep 8
bench_exec clear-cache || true

echo "🧪 Page smoke checks"
set +e
for p in admin-desk agent-desk break-admin order-cancellations-report call-report sales-report email-report-customizer quality-desk; do
  code="$(curl -k -s -o /dev/null -w '%{http_code}' "http://127.0.0.1/$p" 2>/dev/null || echo 000)"
  echo "$p => $code" | tee -a "$BACKUP_DIR/page_smoke_checks_v11.txt"
done
set -e

if ! grep -q "admin-desk => 200" "$BACKUP_DIR/page_smoke_checks_v11.txt" || ! grep -q "order-cancellations-report => 200" "$BACKUP_DIR/page_smoke_checks_v11.txt"; then
  echo "❌ Critical page failed. Restore manually from $BACKUP_DIR if needed."
  exit 1
fi

echo "🧪 Backend validation"
set +e
bench_exec execute restaurant_ops.api.admin_api.get_admin_dashboard_stats | tee "$BACKUP_DIR/admin_stats_v11.txt"
V1=${PIPESTATUS[0]}
bench_exec execute restaurant_ops.api.upper_management_email_api.get_upper_management_report_data | tee "$BACKUP_DIR/upper_data_v11.txt"
V2=${PIPESTATUS[0]}
bench_exec execute restaurant_ops.api.upper_management_email_api.verify_cancellations_in_upper_email | tee "$BACKUP_DIR/email_verify_v11.txt"
V3=${PIPESTATUS[0]}
bench_exec execute restaurant_ops.api.upper_management_email_api.list_cancellation_branches | tee "$BACKUP_DIR/branches_v11.txt"
V4=${PIPESTATUS[0]}
set -e

if [[ $V1 -ne 0 || $V2 -ne 0 || $V3 -ne 0 || $V4 -ne 0 ]]; then
  echo "❌ Backend validation failed. راجع: $BACKUP_DIR"
  exit 1
fi

echo "🏥 Health Check - Elastix/CDR/AMI + Queue + Call Report"
set +e
bench_exec execute restaurant_ops.api.asterisk_bridge.run_full_system_diagnostics | tee "$BACKUP_DIR/health_asterisk_bridge.txt"
H1=${PIPESTATUS[0]}
bench_exec execute restaurant_ops.api.queue_api.get_queue_status | tee "$BACKUP_DIR/health_queue_status.txt"
H2=${PIPESTATUS[0]}
bench_exec execute restaurant_ops.api.report_api.get_calls_report --kwargs '{"page":1,"page_size":5,"view_mode":"admin"}' | tee "$BACKUP_DIR/health_call_report.txt"
H3=${PIPESTATUS[0]}
set -e

if [[ $H1 -ne 0 || $H2 -ne 0 || $H3 -ne 0 ]]; then
  echo "⚠️ Health returned non-zero. راجع: $BACKUP_DIR"
else
  echo "✅ Health checks OK"
fi

echo "============================================================"
echo "✅ DONE V11"
echo "📦 Backup folder: $BACKUP_DIR"
echo "📋 Open complaints now = all unresolved complaints"
echo "👤 Staff missed calls details use explicit staff_missed only + best extension extraction"
echo "↩️ Full cancellation report page enhanced: cards + branch dropdown + CSV + print/PDF"
echo "📞 Global queue widget injected on operational pages except Quality Desk"
echo "📧 Upper email includes open complaints, staff missed, cancellations verification"
echo "🛡️ report_api.py لم يتم لمسه"
echo "============================================================"
