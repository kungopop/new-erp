#!/usr/bin/env bash
set -Eeuo pipefail

# Roshdy V11 Final Polish
# - Admin stats: open complaints = all unresolved complaints, not only today's/resolved.
# - Upper email: open complaints all-time + today's complaints classification + staff missed details only when explicit.
# - Staff missed details: best effort extension/employee extraction from Call Report rows.
# - Full cancellation report page with cards + branch dropdown + CSV + Print/PDF.
# - Global waiting calls widget on all operational pages except Quality Desk.
# Safety: backup first; does NOT touch restaurant_ops.api.report_api / Elastix / CDR / AMI config.

ROOT="${ROOT:-/opt/frappe_crm}"
SITE="${SITE:-crm.local}"
APP="restaurant_ops"

cd "$ROOT"

if docker compose version >/dev/null 2>&1; then
  COMPOSE=(docker compose)
elif command -v docker-compose >/dev/null 2>&1; then
  COMPOSE=(docker-compose)
else
  echo "❌ docker compose/docker-compose مش موجود"
  exit 1
fi

APP_DIR="$ROOT/apps/$APP"
PKG_DIR="$APP_DIR/$APP"
WWW_DIR="$PKG_DIR/www"
API_DIR="$PKG_DIR/api"
ADMIN_API="$API_DIR/admin_api.py"
UPPER_API="$API_DIR/upper_management_email_api.py"
CANCEL_HTML="$WWW_DIR/order-cancellations-report.html"
CANCEL_PY="$WWW_DIR/order-cancellations-report.py"
TS="$(date +%Y%m%d_%H%M%S)"
BACKUP_DIR="$ROOT/backups/V11_COMPLAINTS_MISSED_CANCEL_WIDGET_EMAIL_BEFORE_$TS"
mkdir -p "$BACKUP_DIR"

BACKEND="$(${COMPOSE[@]} ps -q backend || true)"
if [[ -z "$BACKEND" ]]; then
  echo "❌ backend container مش شغال أو مش لاقيه"
  exit 1
fi

bench_exec() {
  "${COMPOSE[@]}" exec -T backend bench --site "$SITE" "$@"
}

echo "============================================================"
echo "🔧 Roshdy V11: complaints + missed calls + cancellations page + global widget + email"
echo "📦 Backup: $BACKUP_DIR"
echo "============================================================"

echo "🧯 Backup files + bench backup"
mkdir -p "$BACKUP_DIR/www" "$BACKUP_DIR/api"
[[ -d "$WWW_DIR" ]] && tar -czf "$BACKUP_DIR/www_before.tar.gz" -C "$PKG_DIR" www
for f in "$ADMIN_API" "$UPPER_API" "$CANCEL_HTML" "$CANCEL_PY"; do
  [[ -f "$f" ]] && cp -a "$f" "$BACKUP_DIR/$(basename "$f").before"
done
bench_exec backup --with-files | tee "$BACKUP_DIR/bench_backup_output.txt"

echo "🧩 Patch backend APIs and pages"
export ADMIN_API UPPER_API WWW_DIR CANCEL_HTML CANCEL_PY
python3 - <<'PY'
# -*- coding: utf-8 -*-
from pathlib import Path
import os, re

admin_api = Path(os.environ["ADMIN_API"])
upper_api = Path(os.environ["UPPER_API"])
www_dir = Path(os.environ["WWW_DIR"])
cancel_html = Path(os.environ["CANCEL_HTML"])
cancel_py = Path(os.environ["CANCEL_PY"])

# ------------------------------------------------------------------
# 1) Admin API stats: open complaints all unresolved, not only today.
# ------------------------------------------------------------------
if admin_api.exists():
    s = admin_api.read_text(encoding="utf-8", errors="ignore")
else:
    s = "# -*- coding: utf-8 -*-\n"
start = "# BEGIN ROSHDY ADMIN API V11 OPEN COMPLAINTS ALL"
end = "# END ROSHDY ADMIN API V11 OPEN COMPLAINTS ALL"
patch = r'''
# BEGIN ROSHDY ADMIN API V11 OPEN COMPLAINTS ALL
try:
    import frappe
    from frappe.utils import today, now_datetime, cstr, cint
except Exception:
    frappe = None


def _v11_closed_status_values():
