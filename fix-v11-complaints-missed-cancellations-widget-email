'''
if start in s and end in s:
    i=s.index(start); j=s.index(end,i)+len(end); s=s[:i]+patch.strip()+s[j:]
else:
    s=s.rstrip()+"\n\n"+patch.strip()+"\n"
compile(s, str(admin_api), "exec")
admin_api.write_text(s, encoding="utf-8")

# ------------------------------------------------------------------
# 2) Upper Management report: all open complaints + staff missed details.
# ------------------------------------------------------------------
if upper_api.exists():
    s = upper_api.read_text(encoding="utf-8", errors="ignore")
else:
    s = "# -*- coding: utf-8 -*-\n"
start = "# BEGIN ROSHDY UPPER EMAIL V11 COMPLAINTS MISSED DETAILS"
end = "# END ROSHDY UPPER EMAIL V11 COMPLAINTS MISSED DETAILS"
patch = r'''
# BEGIN ROSHDY UPPER EMAIL V11 COMPLAINTS MISSED DETAILS
try:
    import frappe
    from frappe.utils import today, now_datetime, getdate, get_datetime, cstr, cint, flt
    import html as _v11_html
    import re as _v11_re
except Exception:
    pass


def _v11_e(v):
    return _v11_html.escape(cstr(v) if v is not None else "")


def _v11_n(v):
    try:
        if v is None:
            return "0"
        f = flt(v)
        return f"{int(f):,}" if float(f).is_integer() else f"{f:,.1f}"
    except Exception:
        return cstr(v)


def _v11_period(date_from=None, date_to=None):
    if not date_from:
        date_from = today()
    if not date_to:
        date_to = date_from
    sd, ed = getdate(date_from), getdate(date_to)
    return sd, ed, cstr(sd) + " 00:00:00", cstr(ed) + " 23:59:59"


def _v11_closed_values():
    return ["Closed", "Resolved", "Done", "مغلقة", "تم الحل", "محلولة", "مغلقة/محلولة", "مقفولة", "ملغي", "Cancelled", "Canceled"]


def _v11_call_report(date_from=None, date_to=None, smart_category=None, page=1, page_size=5000):
    try:
        from restaurant_ops.api import report_api
    except Exception as e:
        return {"success": False, "error": f"cannot import report_api: {e}"}
    base = {"page": page, "page_size": page_size, "view_mode": "admin"}
    if smart_category:
        base["smart_category"] = smart_category
    variants = [
        {"date_from": cstr(date_from), "date_to": cstr(date_to)},
        {"from_date": cstr(date_from), "to_date": cstr(date_to)},
        {"start_date": cstr(date_from), "end_date": cstr(date_to)},
        {"date": cstr(date_from)},
        {},
    ]
    last = None
    for dv in variants:
        kw = dict(base); kw.update(dv)
        try:
            res = report_api.get_calls_report(**kw)
            return res.get("message") if isinstance(res, dict) and isinstance(res.get("message"), dict) else res
        except TypeError as e:
            last = cstr(e); continue
        except Exception as e:
            last = cstr(e); continue
    return {"success": False, "error": last or "unknown report_api error"}


def _v11_rows(obj):
    if isinstance(obj, dict):
        for k in ("calls", "rows", "data", "records", "items", "result"):
            v = obj.get(k)
            if isinstance(v, list):
                return v
    return []


def _v11_all_report_rows(sd, ed):
    first = _v11_call_report(sd, ed, page=1, page_size=5000)
    rows = list(_v11_rows(first))
    summary = first.get("summary") if isinstance(first, dict) and isinstance(first.get("summary"), dict) else {}
    pagination = first.get("pagination") if isinstance(first, dict) and isinstance(first.get("pagination"), dict) else {}
    try:
        pages = min(max(cint(pagination.get("total_pages") or 1), 1), 10)
    except Exception:
        pages = 1
    for p in range(2, pages + 1):
        res = _v11_call_report(sd, ed, page=p, page_size=5000)
        more = _v11_rows(res)
        if not more:
            break
        rows.extend(more)
    return first, summary, pagination, rows


def _v11_parse_ext(text):
    text = cstr(text)
    pats = [r"(?:Local|SIP|PJSIP|IAX2|DAHDI)/(\d{3,6})", r"تحويلة\s*(\d{3,6})", r"\((\d{3,6})\)", r"\b(\d{3,6})\b"]
    for pat in pats:
        m = _v11_re.search(pat, text, _v11_re.I)
        if m:
            return m.group(1)
    return ""


def _v11_extension_from_row(r):
    for k in ("actual_ext", "extension", "agent_extension", "dst"):
        v = cstr(r.get(k) or "").strip()
        if v and v not in ("123", "1234") and _v11_re.match(r"^\d{3,6}$", v):
            return v
    blob = " ".join(cstr(r.get(k) or "") for k in ("agent_name", "dstchannel", "channel", "lastdata", "clid", "dst"))
    ext = _v11_parse_ext(blob)
    if ext in ("123", "1234"):
        return ""
    return ext


def _v11_employee_from_extension(ext):
    if not ext or not frappe.db.exists("DocType", "Employee"):
        return ""
    try:
        meta = frappe.get_meta("Employee")
        fields = []
        for df in meta.fields:
            fn = cstr(df.fieldname).lower()
            if any(x in fn for x in ("extension", "ext", "sip")):
                fields.append(df.fieldname)
        for fn in fields:
            val = frappe.db.get_value("Employee", {fn: ext}, "employee_name")
            if val:
                return val
    except Exception:
        pass
    return ""


def _v11_staff_missed_details(sd, ed, all_rows, summary):
    cats = ["staff_missed", "employee_missed", "agent_missed", "missed_by_employee"]
    raw = []
    for cat in cats:
        res = _v11_call_report(sd, ed, smart_category=cat, page=1, page_size=5000)
        raw.extend(_v11_rows(res))
    # Also scan all rows for explicit staff_missed only, never generic busy/declined.
    for r in all_rows:
        smart = cstr(r.get("smart_category") or r.get("category") or "").lower()
        label = cstr(r.get("category_label") or r.get("status_label") or "")
        if smart in cats or any(x in label for x in ("فائتة من الموظف", "فاتت من موظف", "لم يرد الموظف")):
            raw.append(r)
    seen = set(); rows = []
    for r in raw:
        smart = cstr(r.get("smart_category") or r.get("category") or "").lower()
        label = cstr(r.get("category_label") or r.get("status_label") or "")
        if smart not in cats and not any(x in label for x in ("فائتة من الموظف", "فاتت من موظف", "لم يرد الموظف")):
            continue
        uid = cstr(r.get("uniqueid") or r.get("name") or f"{r.get('calldate')}|{r.get('src')}|{r.get('actual_ext')}")
        if uid in seen:
            continue
        seen.add(uid)
        ext = _v11_extension_from_row(r)
        emp = _v11_employee_from_extension(ext)
        agent_name = cstr(r.get("agent_name") or "")
        if not emp:
            if agent_name and "طابور" not in agent_name:
                emp = agent_name
            elif ext:
                emp = "تحويلة " + ext
            else:
                emp = "غير محدد من بيانات السنترال"
        rows.append({
            "time": cstr(r.get("calldate") or r.get("call_time") or r.get("time") or ""),
            "employee": emp,
            "extension": ext or "غير محدد",
            "caller": cstr(r.get("src") or r.get("cnum") or r.get("caller") or ""),
            "action": "وصلت لموظف ولم يتم الرد عليها",
            "duration": cstr(r.get("duration") or r.get("ring_seconds") or r.get("ringtime") or ""),
        })
    count = cint(summary.get("staff_missed") or summary.get("employee_missed") or len(rows) or 0)
    return count, rows


def _v11_queue_match(row, queue="123"):
    q = cstr(queue or "123")
    dst = cstr(row.get("dst") or "").strip()
    actual_ext = cstr(row.get("actual_ext") or "").strip()
    agent_name = cstr(row.get("agent_name") or "")
    lastdata = cstr(row.get("lastdata") or "")
    rec = cstr(row.get("recordingfile") or row.get("recording_url") or "")
    return dst == q or (actual_ext == q and "طابور" in agent_name) or lastdata.startswith(q + ",") or f"q-{q}-" in rec


def _v11_complaints(start_dt, end_dt):
    dt = "Call Center Complaint"
    out = {"exists": False, "registered_today": 0, "open_all": 0, "resolved_today": 0, "today_rows": [], "open_rows": [], "status_breakdown_today": [], "category_breakdown_today": []}
    if not frappe.db.exists("DocType", dt):
        return out
    out["exists"] = True
    try:
        meta = frappe.get_meta(dt)
        sf = "status" if meta.has_field("status") else ("workflow_state" if meta.has_field("workflow_state") else None)
        cf = None
        for f in ("category", "complaint_category", "complaint_type", "type", "issue_type", "reason", "complaint_reason"):
            if meta.has_field(f): cf = f; break
        pf = "priority" if meta.has_field("priority") else None
        fields = ["name", "creation", "modified"]
        for f in (sf, cf, pf, "customer_name", "customer_phone", "subject"):
            if f and f not in fields and (f in ("customer_name", "customer_phone", "subject") and meta.has_field(f) or f not in ("customer_name", "customer_phone", "subject")):
                fields.append(f)
        today_rows_raw = frappe.get_all(dt, filters={"creation": ["between", [start_dt, end_dt]]}, fields=fields, order_by="creation desc", limit_page_length=500)
        open_filters = {sf: ["not in", _v11_closed_values()]} if sf else {}
        open_rows_raw = frappe.get_all(dt, filters=open_filters, fields=fields, order_by="modified desc", limit_page_length=500)
        out["registered_today"] = len(today_rows_raw)
        out["open_all"] = len(open_rows_raw)
        st_counts, cat_counts = {}, {}
        for r in today_rows_raw:
            st = cstr(r.get(sf) if sf else "غير محدد") or "غير محدد"
            cat = cstr(r.get(cf) if cf else "غير محدد") or "غير محدد"
            st_counts[st] = st_counts.get(st, 0) + 1
            cat_counts[cat] = cat_counts.get(cat, 0) + 1
            if st in _v11_closed_values():
                out["resolved_today"] += 1
        def pack(r):
            return {"name": r.get("name"), "creation": cstr(r.get("creation") or ""), "status": cstr(r.get(sf) if sf else "غير محدد") or "غير محدد", "category": cstr(r.get(cf) if cf else "غير محدد") or "غير محدد", "priority": cstr(r.get(pf) if pf else "") or "", "customer_name": r.get("customer_name") or "", "customer_phone": r.get("customer_phone") or "", "subject": r.get("subject") or ""}
        out["today_rows"] = [pack(r) for r in today_rows_raw]
        out["open_rows"] = [pack(r) for r in open_rows_raw]
        out["status_breakdown_today"] = [{"label": k, "count": v} for k, v in sorted(st_counts.items(), key=lambda x: (-x[1], x[0]))]
        out["category_breakdown_today"] = [{"label": k, "count": v} for k, v in sorted(cat_counts.items(), key=lambda x: (-x[1], x[0]))]
    except Exception as e:
        out["error"] = cstr(e)
    return out


def _v11_cancellations(start_dt, end_dt):
    try:
        ensure_order_cancellation_doctype()
        rows = frappe.get_all(CANCELLATION_DOCTYPE, filters={"cancellation_time": ["between", [start_dt, end_dt]]}, fields=["name", "order_no", "cancellation_time", "shift", "branch", "customer_name", "customer_phone", "reason", "notes", "logged_by"], order_by="cancellation_time desc, creation desc", limit_page_length=500)
        return {"count": len(rows), "rows": rows}
    except Exception as e:
        return {"count": 0, "rows": [], "error": cstr(e)}


def _v11_target_items(start_dt, end_dt):
    try:
        return _get_target_items(start_dt, end_dt)
    except Exception:
        return {"total_qty": 0, "total_entries": 0, "rows": []}


@frappe.whitelist()
def get_upper_management_report_data(date_from=None, date_to=None):
    sd, ed, start_dt, end_dt = _v11_period(date_from, date_to)
    first, summary, pagination, all_rows = _v11_all_report_rows(sd, ed)
    total = cint(summary.get("total") or pagination.get("total_records") or len(all_rows) or 0)
    answered = cint(summary.get("answered") or 0)
    if not answered and all_rows:
        answered = sum(1 for r in all_rows if cstr(r.get("smart_category") or "").lower() == "answered" or cstr(r.get("disposition") or "").upper() == "ANSWERED")
    staff_missed_count, staff_rows = _v11_staff_missed_details(sd, ed, all_rows, summary)
    complaint_queue_count = sum(1 for r in all_rows if _v11_queue_match(r, "123"))
    complaints = _v11_complaints(start_dt, end_dt)
    cancellations = _v11_cancellations(start_dt, end_dt)
    target = _v11_target_items(start_dt, end_dt)
    followups = []
    if staff_missed_count:
        followups.append("مراجعة المكالمات التي وصلت لموظفين ولم يتم الرد عليها.")
    if complaints.get("open_all"):
        followups.append("مراجعة الشكاوى المفتوحة حاليًا حتى لو لم تكن مسجلة اليوم.")
    if cancellations.get("count"):
        followups.append("مراجعة أسباب الإلغاءات المسجلة اليوم.")
    if flt(target.get("total_qty") or 0) <= 1:
        followups.append("محتاجين نركز أكتر على عرض الصنف المطلوب أثناء المكالمات.")
    return {"success": True, "period": {"from": cstr(sd), "to": cstr(ed), "label": cstr(sd) if cstr(sd)==cstr(ed) else f"{sd} إلى {ed}"}, "generated_at": now_datetime().strftime("%Y-%m-%d %H:%M:%S"), "calls": {"total": total, "answered": answered, "staff_missed_count": staff_missed_count, "employee_issue_count": staff_missed_count, "employee_issue_rows": staff_rows, "source": "report_api_staff_missed_only_v11", "note": "Only explicit staff_missed/employee_missed is counted. Generic busy/declined is excluded."}, "complaint_queue": {"count": complaint_queue_count, "queue": "123", "source": "report_api"}, "complaints": complaints, "cancellations": cancellations, "target_items": target, "followups": followups, "status_label": "يوجد نقاط تحتاج متابعة" if followups else "لا توجد مشكلة ظاهرة في بيانات خدمة العملاء"}


def _v11_td(v, strong=False):
    return f"<td style='padding:8px;border:1px solid #e5e7eb;text-align:right;direction:rtl;font-size:12px'>{'<b>'+_v11_e(v)+'</b>' if strong else _v11_e(v)}</td>"


def _v11_empty(cols, text):
    return f"<tr><td colspan='{cols}' style='padding:12px;border:1px solid #e5e7eb;text-align:center;color:#64748b;background:#f8fafc'>{_v11_e(text)}</td></tr>"


def _v11_table(headers, rows):
    th = "".join(f"<th style='background:#111827;color:white;padding:9px;border:1px solid #e5e7eb;text-align:right;direction:rtl;font-size:12px'>{_v11_e(h)}</th>" for h in headers)
    return f"<table dir='rtl' width='100%' cellpadding='0' cellspacing='0' style='border-collapse:collapse;width:100%;direction:rtl;text-align:right;margin-top:8px;font-family:Tahoma,Arial,sans-serif'><thead><tr>{th}</tr></thead><tbody>{rows}</tbody></table>"


def _v11_card(title, value, note, color="#1F4E79"):
    return f"<td style='width:25%;padding:6px;vertical-align:top'><div style='background:#fff;border:1px solid #e5e7eb;border-right:5px solid {color};border-radius:14px;padding:13px;min-height:98px;text-align:right;direction:rtl'><div style='font-size:13px;color:#475569;font-weight:bold'>{_v11_e(title)}</div><div style='font-size:28px;font-weight:900;color:{color};margin-top:5px'>{_v11_e(value)}</div><div style='font-size:12px;color:#64748b;margin-top:4px'>{note}</div></div></td>"


@frappe.whitelist()
def render_upper_management_report_html(date_from=None, date_to=None):
    d = get_upper_management_report_data(date_from, date_to)
    calls, comps, cancels, target = d["calls"], d["complaints"], d["cancellations"], d["target_items"]
