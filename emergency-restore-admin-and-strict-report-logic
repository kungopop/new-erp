def inject_before_body(path, block):
    if not path.exists():
        return
    s = path.read_text(encoding="utf-8", errors="ignore")
    s = remove_blocks_text(s)
    low = s.lower()
    if "</body>" in low:
        i = low.rindex("</body>")
        s = s[:i] + "\n" + block + "\n" + s[i:]
    else:
        s = s.rstrip() + "\n" + block + "\n"
    path.write_text(s, encoding="utf-8")

