    return False


def _r5_get_call_stats(start_date, end_date):
    data = _strict_report_all_staff_only(start_date, end_date)
    rows = data.get("rows") or []
    summary = data.get("summary") or {}
    pagination = data.get("pagination") or {}

    total = summary.get("total") or pagination.get("total_records") or len(rows)
    answered = summary.get("answered")
    if answered is None:
        answered = 0
        for r in rows:
            if cstr(r.get("smart_category") or "").lower() == "answered" or cstr(r.get("disposition") or "").upper() == "ANSWERED" or "تم الرد" in cstr(r.get("category_label") or ""):
                answered += 1

    # Staff missed count from explicit summary/category only.
    staff_missed_count = cint(summary.get("staff_missed") or summary.get("employee_missed") or 0)

    missed_filter_rows = []
    for cat in ("staff_missed", "employee_missed", "agent_missed", "missed_by_employee"):
        res = _strict_call_report_page_staff_only(start_date, end_date, smart_category=cat, page=1, page_size=5000)
        missed_filter_rows.extend(_strict_rows_staff_only(res))

    # Deduplicate and verify each row is explicit employee missed.
    seen, missed_rows = set(), []
    for r in missed_filter_rows + rows:
        if not _strict_is_employee_missed(r):
            continue
        uid = cstr(r.get("uniqueid") or r.get("name") or f"{r.get('calldate')}|{r.get('src')}|{r.get('actual_ext')}")
        if uid in seen:
            continue
        seen.add(uid)
        missed_rows.append(_strict_issue_row(r))

    if staff_missed_count == 0 and missed_rows:
        staff_missed_count = len(missed_rows)

    try:
        complaint_q = _roshdy_conf_queue("complaint") if "_roshdy_conf_queue" in globals() else DEFAULT_COMPLAINT_QUEUE
    except Exception:
        complaint_q = DEFAULT_COMPLAINT_QUEUE
    complaint_queue_count = sum(1 for r in rows if _strict_queue_match(r, complaint_q))

    return {
        "total": cint(total or 0),
        "answered": cint(answered or 0),
        "declined_count": 0,
        "staff_missed_count": staff_missed_count,
        "employee_issue_count": staff_missed_count,
        "employee_issue_rows": missed_rows,
        "complaint_queue_count": complaint_queue_count,
        "complaint_queue": complaint_q,
        "source": "report_api_staff_missed_only",
        "report_api_error": data.get("first", {}).get("error") if isinstance(data.get("first"), dict) else None,
        "note": "Generic declined/busy calls are excluded from employee blame. Only explicit staff_missed/employee_missed counts here.",
    }
# END ROSHDY STRICT STAFF MISSED ONLY AFTER FALSE POSITIVE
'''
    if start in s and end in s:
        i = s.index(start)
        j = s.index(end, i) + len(end)
        s = s[:i] + patch.strip() + s[j:]
    else:
        s = s.rstrip() + "\n\n" + patch.strip() + "\n"

    # Text polish in the current renderer so the report does not imply generic declined/busy are employee cancellations.
    replacements = {
        "مكالمات تحتاج مراجعة": "مكالمات فاتت من موظفين",
