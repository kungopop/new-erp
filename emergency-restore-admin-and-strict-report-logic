    try:
        total_pages = cint(pagination.get("total_pages") or 1)
    except Exception:
        total_pages = 1
    for page in range(2, min(max(total_pages, 1), 10) + 1):
        res = _strict_call_report_page_staff_only(start_date, end_date, page=page, page_size=5000)
        more = _strict_rows_staff_only(res)
        if not more:
            break
        rows.extend(more)
    return {"first": first, "rows": rows, "summary": summary, "pagination": pagination}


def _strict_is_employee_missed(row):
