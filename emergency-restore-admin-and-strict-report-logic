def latest_backup_file(name):
    patterns = [
        str(root / "backups" / "FIX_EMAIL_REPORTS_V5_BEFORE_*" / "ui_v6" / f"{name}.before_v6"),
        str(root / "backups" / "UPPER_MGMT_CANCEL_BREAK_BEFORE_*" / "files" / "apps" / "restaurant_ops" / "restaurant_ops" / "www" / name),
