        {"start_date": cstr(date_from), "end_date": cstr(date_to)},
        {"date": cstr(date_from)},
        {},
    ]
    last = None
    for dv in variants:
        kw = dict(base); kw.update(dv)
        try:
            return _unwrap_result(report_api.get_calls_report(**kw))
        except TypeError as e:
            last = cstr(e); continue
        except Exception as e:
            last = cstr(e); continue
    return {"success": False, "error": last or "unknown report_api error"}


def _strict_rows_staff_only(obj):
