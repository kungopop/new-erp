        return _find_rows(obj) or []
    except Exception:
        return []


def _strict_report_all_staff_only(start_date, end_date):
    first = _strict_call_report_page_staff_only(start_date, end_date, page=1, page_size=5000)
    rows = list(_strict_rows_staff_only(first))
    summary = first.get("summary") if isinstance(first, dict) and isinstance(first.get("summary"), dict) else {}
