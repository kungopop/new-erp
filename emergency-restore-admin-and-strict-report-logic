def _strict_queue_match(row, queue):
    qlist = _as_list(queue) or [DEFAULT_COMPLAINT_QUEUE]
    dst = cstr(row.get("dst") or "").strip()
    actual_ext = cstr(row.get("actual_ext") or "").strip()
