pen{background:#fee2e2;color:#991b1b}.review{background:#fef3c7;color:#92400e}.done{background:#dcfce7;color:#166534}.muted{color:#64748b;font-size:12px}.modal{display:none;position:fixed;inset:0;background:#0008;z-index:99999;align-items:center;justify-content:center;padding:20px}.modal.show{display:flex}.modalbox{background:#fff;border-radius:18px;max-width:1120px;width:100%;max-height:94vh;overflow:auto}.modalhead{padding:14px 18px;background:#20262d;color:#fff;display:flex;justify-content:space-between;align-items:center}.modalbody{padding:18px}.cols{display:grid;grid-template-columns:1fr 1fr;gap:12px}.info{border:1px solid #e5e7eb;background:#f8fafc;border-radius:12px;padding:12px;margin:8px 0}.att{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:8px}.att a{display:block;border:1px solid #ddd;border-radius:10px;padding:8px;text-decoration:none;color:#1F4E79;background:#fff}.att img{max-width:100%;max-height:120px;display:block;margin:auto}.debug{background:#0f172a;color:#dcfce7;padding:10px;border-radius:10px;white-space:pre-wrap;direction:ltr;text-align:left;max-height:220px;overflow:auto}@media(max-width:1000px){.grid{grid-template-columns:1fr 1fr}.cols{grid-template-columns:1fr}.top{display:block}.table{min-width:900px}}
