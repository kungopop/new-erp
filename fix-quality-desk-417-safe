<div class="panel"><div class="head"><b>فلاتر التقرير</b><button class="btn light" onclick="setThisMonth()">الشهر الحالي</button></div><div class="body"><div class="grid"><div><label>من تاريخ</label><input type="date" id="date_from"></div><div><label>إلى تاريخ</label><input type="date" id="date_to"></div><div><label>الحالة</label><select id="status"><option value="All">الكل</option><option value="Draft">مسودة</option><option value="Open">مفتوحة</option><option value="Under Review">قيد المراجعة</option><option value="Resolved">تم الحل</option><option value="Closed">مغلقة</option></select></div><div><label>الأولوية</label><select id="priority"><option value="All">الكل</option><option value="Low">منخفضة</option><option value="Medium">متوسطة</option><option value="High">عالية</option><option value="Urgent">عاجلة</option></select></div><div><label>بحث</label><input id="search" placeholder="رقم/عميل/تفاصيل"></div><div><label>الإسناد</label><select id="assigned"><option value="All">الكل</option><option value="mine">المسند لي</option><option value="unassigned">غير مسند</option></select></div></div><br><button class="btn green" onclick="loadData()">تحديث</button> <button class="btn orange" onclick="printReport()">طباعة / PDF</button></div></div>
