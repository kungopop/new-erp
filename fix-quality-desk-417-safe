#!/usr/bin/env bash
set -Eeuo pipefail

# fix-quality-desk-417-safe
# Emergency fix for /quality-desk 417 after JS injection.
# Rewrites quality-desk as a pure static safe page with no Jinja expressions.
# Keeps: filters, stats, full complaint details, attachments, save quality review, print/PDF, open Desk list/form.
# Does NOT touch CDR/report_api/Elastix except health checks.

ROOT="/opt/frappe_crm"
SITE="crm.local"
APP_HOST="$ROOT/apps/restaurant_ops"
APP_DIR="$APP_HOST/restaurant_ops"
WWW_DIR="$APP_DIR/www"
TS="$(date +%Y%m%d_%H%M%S)"
BACKUP_DIR="$ROOT/backups/FIX_QUALITY_DESK_417_SAFE_BEFORE_$TS"

say(){ echo -e "\n============================================================\n$1\n============================================================"; }

if [[ "${EUID:-$(id -u)}" -ne 0 ]]; then
  echo "❌ شغّل كـ root: sudo -i ثم ./fix-quality-desk-417-safe"
  exit 1
fi

say "1) Backup قبل إصلاح 417 في Quality Desk"
cd "$ROOT"
BACKEND="$(docker compose ps -q backend || true)"
if [[ -z "$BACKEND" ]]; then
  echo "❌ لم أجد backend container. شغّل: cd /opt/frappe_crm && docker compose up -d"
  exit 1
fi
mkdir -p "$BACKUP_DIR"
cp -a "$APP_HOST" "$BACKUP_DIR/restaurant_ops"
[[ -f "$ROOT/docker-compose.yml" ]] && cp -a "$ROOT/docker-compose.yml" "$BACKUP_DIR/docker-compose.yml"
echo "✅ Backup: $BACKUP_DIR"

say "2) Rewrite quality-desk.py safe"
mkdir -p "$WWW_DIR"
cat > "$WWW_DIR/quality-desk.py" <<'PY'
import frappe
no_cache = 1

def get_context(context):
    if frappe.session.user == "Guest":
        frappe.local.flags.redirect_location = "/login?redirect-to=/quality-desk"
        raise frappe.Redirect
    roles = frappe.get_roles(frappe.session.user)
    allowed = {"Complaint_Quality_User", "Call Center Admin", "System Manager"}
    if frappe.session.user != "Administrator" and not (set(roles) & allowed):
        frappe.throw("Not permitted", frappe.PermissionError)
    return context
PY
chmod 644 "$WWW_DIR/quality-desk.py"

say "3) Rewrite quality-desk.html static بدون Jinja"
cat > "$WWW_DIR/quality-desk.html" <<'HTML'
