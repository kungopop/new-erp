<script>
var currentComplaint=null;
function method(parts){return parts.join('')}
function esc(x){return String(x==null?'':x).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;')}
async function api(methodName,args){args=args||{};try{var r=await fetch('/api/method/'+methodName,{method:'POST',credentials:'same-origin',headers:{'Content-Type':'application/json','Accept':'application/json','X-Frappe-CSRF-Token':window.csrf_token||''},body:JSON.stringify(args)});var j=await r.json();if(j&&j.message)return j.message}catch(e){}var qs=new URLSearchParams();Object.keys(args).forEach(function(k){if(args[k]!==undefined&&args[k]!==null)qs.append(k,args[k])});var r2=await fetch('/api/method/'+methodName+'?'+qs.toString(),{credentials:'same-origin',cache:'no-store'});var j2=await r2.json();return j2.message}
function iso(d){return d.toISOString().slice(0,10)}
function setThisMonth(){var d=new Date();date_from.value=iso(new Date(d.getFullYear(),d.getMonth(),1));date_to.value=iso(d);loadData()}
function statusClass(s){s=String(s||'');if(['Resolved','Closed','تم الحل','مغلقة'].indexOf(s)>=0)return'done';if(['Under Review','قيد المراجعة'].indexOf(s)>=0)return'review';return'open'}
function tagStatus(s){return '<span class="tag '+statusClass(s)+'">'+esc(s||'')+'</span>'}
function fileHtml(f){var url=f.file_url||'';var name=f.file_name||url;var img=/\.(png|jpg|jpeg|gif|webp)$/i.test(url);return '<a href="'+esc(url)+'" target="_blank">'+(img?'<img src="'+esc(url)+'">':'📎')+'<br>'+esc(name)+'</a>'}
async function loadData(){var d=await api(method(['restaurant','_ops.api.quality','_api.get_quality_dashboard']),{date_from:date_from.value,date_to:date_to.value,status:status.value,priority:priority.value,search:search.value,assigned:assigned.value,page_size:500});if(!d||!d.success){tb.innerHTML='<tr><td colspan="9">'+esc((d&&d.message)||'تعذر التحميل')+'</td></tr>';return}welcome.textContent='⭐ ديسك الجودة — أهلاً '+(d.employee_name||'');var s=d.stats||{};st_total.textContent=s.total||0;st_open.textContent=s.open||0;st_review.textContent=s.under_review||0;st_resolved.textContent=s.resolved||0;st_urgent.textContent=s.urgent||0;st_reviewed.textContent=s.reviewed||0;rowsInfo.textContent='الفترة '+d.date_from+' إلى '+d.date_to+' — عدد '+(d.total_rows||0);var rows=d.rows||[];tb.innerHTML=rows.length?rows.map(function(r){return '<tr><td>'+esc(r.name)+'</td><td>'+esc(r.dt)+'</td><td>'+esc(r.customer_name)+'</td><td>'+esc(r.phone_number)+'</td><td>'+esc(r.complaint_category)+'</td><td>'+esc(r.complaint_priority)+'</td><td>'+tagStatus(r.status)+'</td><td>'+esc(r.assigned_quality_inspector)+'</td><td><button class="btn" onclick="openComplaint(\''+esc(r.name)+'\')">فتح/مراجعة</button></td></tr>'}).join(''):'<tr><td colspan="9">لا توجد شكاوى في الفترة</td></tr>'}
async function openComplaint(name){var d=await api(method(['restaurant','_ops.api.quality','_api.get_complaint_full']),{name:name});if(!d||!d.success){alert((d&&d.message)||'تعذر الفتح');return}currentComplaint=d.complaint;m_title.textContent='شكوى '+currentComplaint.name;m_info.innerHTML='<b>العميل:</b> '+esc(currentComplaint.customer_name)+' — <b>الهاتف:</b> '+esc(currentComplaint.phone_number)+'<br><b>الفئة:</b> '+esc(currentComplaint.complaint_category)+' — <b>الأولوية:</b> '+esc(currentComplaint.complaint_priority)+' — <b>الحالة:</b> '+esc(currentComplaint.status)+'<br><b>المصدر:</b> '+esc(currentComplaint.complaint_source)+' — <b>التاريخ:</b> '+esc(currentComplaint.complaint_datetime||currentComplaint.creation)+'<br><b>التفاصيل:</b><br><div style="white-space:pre-wrap">'+esc(currentComplaint.complaint_details)+'</div>';var files=d.attachments||[];m_attach.innerHTML='<b>المرفقات والصور:</b><div class="att">'+(files.length?files.map(fileHtml).join(''):'<span class="muted">لا توجد مرفقات</span>')+'</div>';m_status.value=statusValue(currentComplaint.status);m_assigned.value=currentComplaint.assigned_quality_inspector||'';m_analysis.value=currentComplaint.investigation_analysis||'';m_action.value=currentComplaint.corrective_action||'';m_closing.value=currentComplaint.closing_notes||'';m_debug.textContent='';modal.classList.add('show')}
function statusValue(s){var m={'مسودة':'Draft','Draft':'Draft','مفتوحة':'Open','مفتوح':'Open','Open':'Open','قيد المراجعة':'Under Review','Under Review':'Under Review','تم الحل':'Resolved','Resolved':'Resolved','مغلقة':'Closed','مغلق':'Closed','Closed':'Closed'};return m[String(s||'').trim()]||'Under Review'}
function closeModal(){modal.classList.remove('show')}
async function saveComplaint(){if(!currentComplaint){alert('اختار شكوى الأول');return}saveBtn.disabled=true;saveBtn.textContent='جاري الحفظ...';m_debug.textContent='Saving...';var args={name:currentComplaint.name,assigned_quality_inspector:m_assigned.value||'',investigation_analysis:m_analysis.value||'',corrective_action:m_action.value||'',status:m_status.value||'Under Review',closing_notes:m_closing.value||''};try{var d=await api(method(['restaurant','_ops.api.quality','_api.update_quality_review']),args);m_debug.textContent=JSON.stringify(d,null,2);if(d&&d.success){alert('تم حفظ مراجعة الجودة بنجاح');await loadData();currentComplaint.status=d.status||args.status}else alert((d&&d.message)||'فشل الحفظ')}catch(e){m_debug.textContent=String(e.stack||e);alert('Error: '+(e.message||e))}finally{saveBtn.disabled=false;saveBtn.textContent='حفظ مراجعة الجودة'}}
function openDeskComplaint(){if(!currentComplaint){alert('اختار شكوى الأول');return}window.open('/app/call-center-complaint/'+encodeURIComponent(currentComplaint.name),'_blank')}
async function printComplaint(){if(!currentComplaint)return;var d=await api(method(['restaurant','_ops.api.quality','_api.export_complaint_html']),{name:currentComplaint.name});if(d&&d.success){var w=window.open('','_blank');w.document.write(d.html);w.document.close()}else alert((d&&d.message)||'تعذر الطباعة')}
async function printReport(){var d=await api(method(['restaurant','_ops.api.quality','_api.export_quality_report_html']),{date_from:date_from.value,date_to:date_to.value,status:status.value,priority:priority.value,search:search.value,assigned:assigned.value});if(d&&d.success){var w=window.open('','_blank');w.document.write(d.html);w.document.close()}else alert((d&&d.message)||'تعذر الطباعة')}
setThisMonth();
</script>
