#!/usr/bin/env bash
set -Eeuo pipefail

# Roshdy V40: Queue Journey time columns and wording polish
# ----------------------------------------------------------------------
# User feedback:
# - The time differences are confusing.
# - Rename "وقت المصير" to a clearer "وقت الرد اللاحق".
# - Add approximate ring start and response delay.
# - Apply to /queue-journey-report and both email reports.
#
# Fix:
# - Queue Journey API enriches rows with:
#   ring_start_time, ring_end_time, response_time, response_after_seconds, response_after_text
# - Queue Journey page uses clear columns:
#   بداية الرن التقريبية / انتهاء الرن بدون رد / وقت الرد اللاحق / المدة حتى الرد
# - Upper Management email uses the same clear columns.
# - Customer Service Manager email journey section uses the same clear columns.
#
# Safety:
# - Backup first.
# - Does NOT edit report_api.py.
# - Does NOT touch Elastix / CDR / AMI config.

ROOT="${ROOT:-/opt/frappe_crm}"
SITE="${SITE:-crm.local}"
APP="restaurant_ops"

cd "$ROOT"

if docker compose version >/dev/null 2>&1; then
  COMPOSE=(docker compose)
elif command -v docker-compose >/dev/null 2>&1; then
  COMPOSE=(docker-compose)
else
  echo "❌ docker compose/docker-compose مش موجود"
  exit 1
fi

APP_DIR="$ROOT/apps/$APP"
PKG_DIR="$APP_DIR/$APP"
API_DIR="$PKG_DIR/api"
WWW_DIR="$PKG_DIR/www"
QUEUE_API="$API_DIR/queue_journey_api.py"
UPPER_API="$API_DIR/upper_management_email_api.py"
EMAIL_REPORT="$API_DIR/email_report.py"
PAGE_HTML="$WWW_DIR/queue-journey-report.html"
TS="$(date +%Y%m%d_%H%M%S)"
BACKUP_DIR="$ROOT/backups/FIX_QUEUE_JOURNEY_TIME_COLUMNS_V40_BEFORE_$TS"
mkdir -p "$BACKUP_DIR/files"

BACKEND="$(${COMPOSE[@]} ps -q backend || true)"
if [[ -z "$BACKEND" ]]; then
  echo "❌ backend container مش شغال أو مش لاقيه"
  exit 1
fi

bench_exec() { "${COMPOSE[@]}" exec -T backend bench --site "$SITE" "$@"; }

echo "============================================================"
echo "🔧 Roshdy V40: Queue Journey time columns polish"
echo "📦 Backup: $BACKUP_DIR"
echo "============================================================"

echo "🧯 Step 1: Backup files + bench backup"
for f in "$QUEUE_API" "$UPPER_API" "$EMAIL_REPORT" "$PAGE_HTML"; do
  [[ -e "$f" ]] && cp -a "$f" "$BACKUP_DIR/files/$(basename "$f").before" || true
done
bench_exec backup --with-files | tee "$BACKUP_DIR/bench_backup_output.txt"

