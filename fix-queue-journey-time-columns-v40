# BEGIN ROSHDY QUEUE JOURNEY TIME COLUMNS V40
try:
    import frappe
    from frappe.utils import cstr, flt, get_datetime, today
    from datetime import timedelta
except Exception:
    pass

try:
    _qj40_prev_get_queue_journey_report = get_queue_journey_report
except Exception:
    _qj40_prev_get_queue_journey_report = None


def _qj40_fmt_dt(dt):
    try:
        return dt.strftime("%Y-%m-%d %H:%M:%S")
    except Exception:
        return ""


def _qj40_parse_dt(v):
    try:
        if not v:
            return None
        return get_datetime(v)
    except Exception:
        return None


def _qj40_duration_text(seconds):
    try:
        seconds = int(round(float(seconds or 0)))
    except Exception:
        return ""
    if seconds < 0:
        seconds = 0
    if seconds < 60:
        return f"بعد {seconds} ثانية"
    m = seconds // 60
    s = seconds % 60
    if s:
        return f"بعد {m} دقيقة و {s} ثانية"
    return f"بعد {m} دقيقة"


def _qj40_enrich_row(row):
    row = dict(row or {})
    ring_end = _qj40_parse_dt(row.get("attempt_time"))
    ring_seconds = flt(row.get("ring_seconds") or 0)
    ring_start = ring_end - timedelta(seconds=ring_seconds) if ring_end else None
    fate = cstr(row.get("fate") or "")
    fate_time = _qj40_parse_dt(row.get("fate_time"))
    answered = fate.startswith("answered_later")
    row["ring_start_time"] = _qj40_fmt_dt(ring_start)
    row["ring_end_time"] = _qj40_fmt_dt(ring_end) or cstr(row.get("attempt_time") or "")
    row["response_time"] = _qj40_fmt_dt(fate_time) if answered else ""
    row["response_after_seconds"] = int(max((fate_time - ring_end).total_seconds(), 0)) if answered and fate_time and ring_end else None
    row["response_after_text"] = _qj40_duration_text(row.get("response_after_seconds")) if answered and row.get("response_after_seconds") is not None else ""
    # Business wording for any old labels.
    if row.get("fate_label") == "لم يظهر رد أو إغلاق بعد هذه المحاولة":
        row["fate_label"] = "مصير المحاولة غير محسوم"
    return row


@frappe.whitelist()
def get_queue_journey_report(date_from=None, date_to=None, threshold=15, queues=None, mask_phones=0, limit_rows=500):
    if not _qj40_prev_get_queue_journey_report:
        return {"success": False, "message": "Base queue journey report is missing"}
    data = _qj40_prev_get_queue_journey_report(date_from=date_from, date_to=date_to, threshold=threshold, queues=queues, mask_phones=mask_phones, limit_rows=limit_rows)
    try:
        rows = [_qj40_enrich_row(r) for r in (data.get("rows") or [])]
        data["rows"] = rows
        # Also enrich sample if present under another key.
        if data.get("attempt_rows_sample"):
            data["attempt_rows_sample"] = [_qj40_enrich_row(r) for r in data.get("attempt_rows_sample")]
    except Exception as e:
        data["enrich_error"] = cstr(e)
    return data


@frappe.whitelist()
def debug_queue_journey_time_columns_v40(date_from=None, date_to=None):
    d = get_queue_journey_report(date_from=date_from or today(), date_to=date_to or date_from or today(), threshold=15, limit_rows=20)
    return {"success": True, "summary": d.get("summary"), "rows_sample": d.get("rows", [])[:5]}
# END ROSHDY QUEUE JOURNEY TIME COLUMNS V40
PYAPI

