#!/usr/bin/env bash
set -Eeuo pipefail

# Roshdy V41: Queue Journey handled-by column polish
# ----------------------------------------------------------------------
# User feedback:
# - Rename "مصير المحاولة بعد الرن" to "تم الرد من خلال".
# - Remove duplicated column "تم التعامل لاحقًا بواسطة".
# Applies to:
# - /queue-journey-report
# - Upper Management email
# - Customer Service Manager email
# Safety:
# - Backup first.
# - Does NOT edit report_api.py.
# - Does NOT touch Elastix / CDR / AMI config.

ROOT="${ROOT:-/opt/frappe_crm}"
SITE="${SITE:-crm.local}"
APP="restaurant_ops"

cd "$ROOT"

if docker compose version >/dev/null 2>&1; then
  COMPOSE=(docker compose)
elif command -v docker-compose >/dev/null 2>&1; then
  COMPOSE=(docker-compose)
else
  echo "❌ docker compose/docker-compose مش موجود"
  exit 1
fi

APP_DIR="$ROOT/apps/$APP"
PKG_DIR="$APP_DIR/$APP"
API_DIR="$PKG_DIR/api"
WWW_DIR="$PKG_DIR/www"
QUEUE_API="$API_DIR/queue_journey_api.py"
UPPER_API="$API_DIR/upper_management_email_api.py"
EMAIL_REPORT="$API_DIR/email_report.py"
PAGE_HTML="$WWW_DIR/queue-journey-report.html"
TS="$(date +%Y%m%d_%H%M%S)"
BACKUP_DIR="$ROOT/backups/FIX_QUEUE_JOURNEY_HANDLED_COLUMN_V41_BEFORE_$TS"
mkdir -p "$BACKUP_DIR/files"

BACKEND="$(${COMPOSE[@]} ps -q backend || true)"
if [[ -z "$BACKEND" ]]; then
  echo "❌ backend container مش شغال أو مش لاقيه"
  exit 1
fi

bench_exec() { "${COMPOSE[@]}" exec -T backend bench --site "$SITE" "$@"; }

echo "============================================================"
echo "🔧 Roshdy V41: Queue Journey handled-by column polish"
echo "📦 Backup: $BACKUP_DIR"
echo "============================================================"

echo "🧯 Step 1: Backup files + bench backup"
for f in "$QUEUE_API" "$UPPER_API" "$EMAIL_REPORT" "$PAGE_HTML"; do
  [[ -e "$f" ]] && cp -a "$f" "$BACKUP_DIR/files/$(basename "$f").before" || true
done
bench_exec backup --with-files | tee "$BACKUP_DIR/bench_backup_output.txt"

# -----------------------------------------------------------------------------
# 2) API enrich field: handled_by_text
# -----------------------------------------------------------------------------
echo "🧩 Step 2: Patch queue_journey_api.py"
cat >> "$QUEUE_API" <<'PYAPI'

# BEGIN ROSHDY QUEUE JOURNEY HANDLED COLUMN V41
try:
    import frappe
    from frappe.utils import cstr, today
except Exception:
    pass

try:
    _qj41_prev_get_queue_journey_report = get_queue_journey_report
except Exception:
    _qj41_prev_get_queue_journey_report = None


def _qj41_handled_by_text(row):
    row = row or {}
    fate = cstr(row.get("fate") or "")
    missed_ext = cstr(row.get("missed_extension") or "")
    ans_ext = cstr(row.get("answered_extension") or "")
    ans_emp = cstr(row.get("answered_employee") or "")
    if fate == "answered_later_same_extension":
        if ans_emp:
            return ans_emp + " (نفس التحويلة)"
        if ans_ext:
            return "نفس التحويلة " + ans_ext
        if missed_ext:
            return "نفس التحويلة " + missed_ext
        return "تم الرد لاحقًا من نفس التحويلة"
    if fate == "answered_later_other_extension":
        if ans_emp:
            return ans_emp
        if ans_ext:
            return "تحويلة " + ans_ext
        return "تم الرد لاحقًا"
    if fate == "customer_abandoned_after_attempt":
        return "العميل أغلق بعد المحاولة"
    if fate in ("timeout_after_attempt_no_final_connect_seen", "completed_after_attempt_connect_missing", "unknown_after_attempt"):
        return "مصير غير محسوم"
    if fate == "journey_unavailable":
        return "مصير غير متاح"
    return cstr(row.get("fate_label") or "مصير غير محسوم")


@frappe.whitelist()
def get_queue_journey_report(date_from=None, date_to=None, threshold=15, queues=None, mask_phones=0, limit_rows=500):
    if not _qj41_prev_get_queue_journey_report:
        return {"success": False, "message": "Base queue journey report missing"}
    data = _qj41_prev_get_queue_journey_report(date_from=date_from, date_to=date_to, threshold=threshold, queues=queues, mask_phones=mask_phones, limit_rows=limit_rows)
    try:
        rows = []
        for r in data.get("rows") or []:
            r = dict(r)
            r["handled_by_text"] = _qj41_handled_by_text(r)
            rows.append(r)
        data["rows"] = rows
        if data.get("attempt_rows_sample"):
            data["attempt_rows_sample"] = [dict(r, handled_by_text=_qj41_handled_by_text(r)) for r in data.get("attempt_rows_sample")]
    except Exception as e:
        data["handled_column_error"] = cstr(e)
    return data


@frappe.whitelist()
def debug_queue_journey_handled_column_v41(date_from=None, date_to=None):
    d = get_queue_journey_report(date_from=date_from or today(), date_to=date_to or date_from or today(), threshold=15, limit_rows=20)
    return {"success": True, "summary": d.get("summary"), "rows_sample": d.get("rows", [])[:10]}
# END ROSHDY QUEUE JOURNEY HANDLED COLUMN V41
PYAPI

# -----------------------------------------------------------------------------
# 3) Patch existing page/email source text to remove duplicated column.
# -----------------------------------------------------------------------------
