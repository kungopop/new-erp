p=pathlib.Path('$OUT_DIR/diagnostic_result.json')
d=json.loads(p.read_text())
print('Generated:', d.get('generated_at'))
print('Shift window:', d.get('shift_window'))
print('Feedback counts:', d.get('counts_calendar_vs_shift',{}).get('feedback'))
print('Cancellation counts:', d.get('counts_calendar_vs_shift',{}).get('cancellations'))
