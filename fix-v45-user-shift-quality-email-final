    return {'success':True,'employee_name':emp,'user':frappe.session.user,'date_from':cstr(df),'date_to':cstr(dt),'quality_category_filter':FOOD_QUALITY_CATEGORY_V45,'stats':_q45_stats(rows_all),'rows':rows,'total_rows':len(rows_all),'page':page,'page_size':page_size,'total_complaints':len(rows_all),'my_count':len(rows),'my_complaints':rows}

