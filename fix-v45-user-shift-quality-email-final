# -*- coding: utf-8 -*-
from datetime import datetime, time, timedelta
import frappe
from frappe.utils import now_datetime, getdate, cstr, cint


def _hour(v, default):
    try:
        if v is None or v == "": return default
        if isinstance(v, (int, float)): return int(v)
        s = cstr(v).strip()
        if s.isdigit(): return int(s)
        if ":" in s: return int(s.split(":",1)[0])
    except Exception:
        pass
    return default


def get_shift_hours():
    try:
        sh = frappe.db.get_single_value("Call Center Settings", "shift_start_hour")
        eh = frappe.db.get_single_value("Call Center Settings", "shift_end_hour")
    except Exception:
        sh, eh = 10, 5
    sh = _hour(sh, 10); eh = _hour(eh, 5)
    if not (0 <= sh <= 23): sh = 10
    if not (0 <= eh <= 23): eh = 5
    return sh, eh


def get_operational_date(ref_dt=None):
    ref_dt = ref_dt or now_datetime()
    sh, eh = get_shift_hours()
    d = ref_dt.date()
    # If current time is after midnight but before shift end, it belongs to previous operational day.
    if eh <= sh and ref_dt.time() < time(eh, 0):
        d = d - timedelta(days=1)
    return d


def get_shift_window(date_from=None, date_to=None):
    sh, eh = get_shift_hours()
    if date_from:
        start_date = getdate(date_from)
    else:
        start_date = get_operational_date()
    if date_to:
        end_date = getdate(date_to)
    else:
        end_date = start_date
    start_dt = datetime.combine(start_date, time(sh, 0))
    end_dt = datetime.combine(end_date, time(eh, 0))
    if end_dt <= start_dt:
        end_dt += timedelta(days=1)
    return start_dt, end_dt


@frappe.whitelist()
def get_current_shift_context(date_from=None, date_to=None):
    start_dt, end_dt = get_shift_window(date_from, date_to)
    op = start_dt.date()
    sh, eh = get_shift_hours()
    return {
        "success": True,
        "operational_date": op.isoformat(),
        "shift_start_hour": sh,
        "shift_end_hour": eh,
        "start_dt": start_dt.strftime("%Y-%m-%d %H:%M:%S"),
        "end_dt": end_dt.strftime("%Y-%m-%d %H:%M:%S"),
    }
PYSHIFT

