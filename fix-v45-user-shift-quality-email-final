    df=getdate(date_from) if date_from else getdate().replace(day=1); dt=getdate(date_to) if date_to else getdate(); return datetime.combine(df,time.min), datetime.combine(add_days(dt,1),time.min), df, dt

def _q45_fetch(date_from=None,date_to=None,status='All',priority='All',search='',assigned='All',limit=10000):
    meta=_q45_fields(); start,end,df,dt=_q45_bounds(date_from,date_to); date_expr='COALESCE(complaint_datetime, creation)' if 'complaint_datetime' in meta else 'creation'
    where=[f'{date_expr} >= %s', f'{date_expr} < %s']; vals=[start,end]
    if 'complaint_category' in meta:
        where.append('complaint_category=%s'); vals.append(FOOD_QUALITY_CATEGORY_V45)
    if status and status!='All': where.append('status=%s'); vals.append(status)
    if priority and priority!='All' and 'complaint_priority' in meta: where.append('complaint_priority=%s'); vals.append(priority)
    if search:
        like='%'+cstr(search).strip()+'%'; parts=[]
        for f in ['name','customer_name','phone_number','complaint_details','complaint_category']:
            if f=='name' or f in meta: parts.append(f'{f} like %s'); vals.append(like)
        if parts: where.append('('+' or '.join(parts)+')')
    if assigned=='mine' and 'assigned_quality_inspector' in meta: where.append('assigned_quality_inspector=%s'); vals.append(frappe.session.user)
    elif assigned=='unassigned' and 'assigned_quality_inspector' in meta: where.append("(assigned_quality_inspector is null or assigned_quality_inspector='')")
    base=['name','customer_name','phone_number','complaint_source','complaint_category','complaint_priority','status','assigned_quality_inspector','investigation_analysis','corrective_action','complaint_details','complaint_datetime','creation','modified','closing_notes','resolved_by','resolved_at','opened_by_agent','shift','shift_leader','call_record_link']
    fields=['name']+[f for f in base if f!='name' and f in meta]
    sql=f"select {', '.join(fields)} from `tabCall Center Complaint` where {' and '.join(where)} order by {date_expr} desc limit {int(limit or 10000)}"
    rows=frappe.db.sql(sql, vals, as_dict=True)
    for r in rows: r['dt']=cstr(r.get('complaint_datetime') or r.get('creation') or '')
    return rows, df, dt

def _q45_stats(rows):
    st={'total':len(rows),'open':0,'under_review':0,'resolved':0,'urgent':0,'reviewed':0,'unassigned':0,'mine':0,'by_status':{},'by_priority':{},'by_category':{}}
    for r in rows:
        status=cstr(r.get('status') or 'غير محدد'); pri=cstr(r.get('complaint_priority') or 'غير محدد'); cat=cstr(r.get('complaint_category') or 'غير محدد')
        if status in ('Draft','Open','مفتوحة','مفتوح'): st['open']+=1
        elif status in ('Under Review','قيد المراجعة'): st['under_review']+=1
        elif status in ('Resolved','Closed','تم الحل','مغلقة','محلولة'): st['resolved']+=1
        if pri in ('High','Urgent','عالية','عاجلة'): st['urgent']+=1
        if r.get('investigation_analysis') or r.get('corrective_action'): st['reviewed']+=1
        if not r.get('assigned_quality_inspector'): st['unassigned']+=1
        if r.get('assigned_quality_inspector')==frappe.session.user: st['mine']+=1
        st['by_status'][status]=st['by_status'].get(status,0)+1; st['by_priority'][pri]=st['by_priority'].get(pri,0)+1; st['by_category'][cat]=st['by_category'].get(cat,0)+1
    return st

@frappe.whitelist(allow_guest=False)
