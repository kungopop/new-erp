    allowed = doc.get("owner") == user or doc.get("employee") in _v16_user_employees(user) or (_v16_meta_has(BREAK_LOG_DT, "admin_close_target_user") and doc.get("admin_close_target_user") == user) or (doc.get("extension_at_start") and cstr(doc.get("extension_at_start")) in _v16_user_extensions(user)) or _v16_admin_allowed()
