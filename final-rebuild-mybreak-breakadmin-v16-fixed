@frappe.whitelist()
def get_active_breaks():
    if not _v16_admin_allowed():
        frappe.throw("غير مسموح")
    rows = frappe.db.sql(f"""
        select name, employee, break_type, break_date, status, start_time, end_time,
               duration_seconds, duration_minutes, extension_at_start, notes, creation, owner,
               closed_by, closure_type
        from `tabEmployee Break Log`
        where {_v16_active_condition()}
        order by coalesce(start_time, creation) asc
        limit 500
    """, as_dict=True)
    now = now_datetime()
    out = []
    overdue_count = 0
    for r in rows:
        dur = _v16_duration_minutes(r.get("start_time"))
        limit = _v16_break_limit_minutes(r.get("break_type"))
        over = dur >= limit
        if over:
            overdue_count += 1
        out.append({"name": r.name, "employee": r.employee, "employee_name": _v16_employee_name(r.employee), "break_type": r.break_type or "غير محدد", "start_time": cstr(r.start_time or ""), "duration_minutes": dur, "limit_minutes": limit, "overdue": over, "overdue_minutes": round(max(dur-limit,0),1), "extension": r.extension_at_start or "", "notes": r.notes or ""})
    return {"success": True, "server_now": now.strftime("%Y-%m-%d %H:%M:%S"), "active_count": len(out), "overdue_count": overdue_count, "rows": out}


