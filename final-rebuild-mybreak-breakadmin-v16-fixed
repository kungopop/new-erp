    date_from = date_from or today()
    date_to = date_to or date_from
    start_time = start_time or "00:00"
    end_time = end_time or "23:59"
    where = ["ifnull(b.docstatus,0)<2", "coalesce(b.start_time,b.creation) between %s and %s"]
    params = [f"{date_from} {start_time}:00" if len(start_time)<=5 else f"{date_from} {start_time}", f"{date_to} {end_time}:59" if len(end_time)<=5 else f"{date_to} {end_time}"]
    if employee:
        where.append("b.employee=%s"); params.append(employee)
    if status and status not in ("All", "الكل"):
        where.append("b.status=%s"); params.append(status)
    sql = f"""
        select b.name, b.employee, coalesce(e.employee_name,b.employee) employee_name,
               b.break_type, b.status, b.start_time, b.end_time, b.duration_minutes,
               b.duration_seconds, b.extension_at_start, b.closed_by, b.closure_type,
               b.admin_close_acknowledged, b.admin_close_acknowledged_at, b.notes
        from `tabEmployee Break Log` b
        left join `tabEmployee` e on e.name=b.employee
        where {' and '.join(where)}
        order by coalesce(b.start_time,b.creation) desc
        limit 2000
    """
    rows = frappe.db.sql(sql, params, as_dict=True)
    out = []
    total_minutes = 0
    by = {}
    for r in rows:
        mins = flt(r.get("duration_minutes") or 0)
        if not mins and r.get("start_time"):
            mins = _v16_duration_minutes(r.get("start_time"), r.get("end_time"))
        total_minutes += mins
        emp_name = r.get("employee_name") or r.get("employee") or "غير محدد"
        by.setdefault(emp_name, {"employee_name": emp_name, "count": 0, "minutes": 0})
        by[emp_name]["count"] += 1
        by[emp_name]["minutes"] += mins
        closed_by = r.get("closed_by") or ""
        closed_by_name = ""
        if closed_by:
            try:
                closed_by_name = frappe.db.get_value("User", closed_by, "full_name") or closed_by
            except Exception:
                closed_by_name = closed_by
        ctype = cstr(r.get("closure_type") or "")
        if ctype == "admin":
            ctype_label = "إغلاق إداري"
        elif ctype == "employee":
            ctype_label = "إغلاق الموظف"
        elif cstr(r.get("status") or "").lower() in ("active", "نشط"):
            ctype_label = "نشط"
        else:
            ctype_label = "غير محدد"
        out.append({
            "name": r.get("name"), "employee": r.get("employee"), "employee_name": emp_name,
            "break_type": r.get("break_type") or "", "status": r.get("status") or "",
            "start_time_text": cstr(r.get("start_time") or ""), "end_time_text": cstr(r.get("end_time") or ""),
            "duration_minutes_calc": round(mins, 2), "extension_at_start": r.get("extension_at_start") or "",
            "closed_by": closed_by, "closed_by_name": closed_by_name,
            "closure_type": ctype, "closure_type_label": ctype_label,
            "admin_close_acknowledged": r.get("admin_close_acknowledged"),
        })
    by_rows = list(by.values())
    for x in by_rows:
        x["minutes"] = round(x["minutes"], 2)
    csv_lines = ["رقم,الموظف,النوع,الحالة,بداية,نهاية,الدقائق,التحويلة,نوع الإغلاق,أغلق بواسطة"]
    for r in out:
        csv_lines.append(",".join('"'+cstr(v).replace('"','""')+'"' for v in [r["name"], r["employee_name"], r["break_type"], r["status"], r["start_time_text"], r["end_time_text"], r["duration_minutes_calc"], r["extension_at_start"], r["closure_type_label"], r["closed_by_name"]]))
    employees = []
    try:
        employees = frappe.get_all("Employee", filters={"status": "Active"} if _v16_meta_has("Employee","status") else {}, fields=["name", "employee_name"], order_by="employee_name", limit_page_length=1000)
    except Exception:
        pass
    return {"success": True, "summary": {"total_breaks": len(out), "total_minutes": round(total_minutes,2)}, "rows": out, "by_employee": by_rows, "employees": employees, "csv": "\n".join(csv_lines)}


