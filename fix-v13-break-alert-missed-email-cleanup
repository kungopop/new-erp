import re
import frappe

BLOCKED = {"admin@roshdy.com", "el.alfy@roshdy.com", "administrator@roshdy.com"}

def _clean_value(v):
    if not isinstance(v, str) or "@" not in v:
        return v, []
    found = []
    out = v
    for email in BLOCKED:
        if email.lower() in out.lower():
            found.append(email)
            out = re.sub(re.escape(email), "", out, flags=re.I)
    # clean common separators left behind
    out = re.sub(r"[,;]\s*[,;]+", ",", out)
    out = re.sub(r"(^\s*[,;]+|[,;]+\s*$)", "", out).strip()
    out = out.replace("\n\n", "\n").strip()
    return out, found

def execute():
    rows = frappe.db.sql("select doctype, field, value from `tabSingles` where value like '%%@roshdy.com%%'", as_dict=True)
    changed=[]
    for r in rows:
        new, found = _clean_value(r.value or "")
        if found and new != r.value:
            frappe.db.set_value(r.doctype, None, r.field, new)
            changed.append({"doctype": r.doctype, "field": r.field, "removed": found})
    frappe.db.commit()
    return {"success": True, "changed": changed, "blocked": sorted(BLOCKED)}
