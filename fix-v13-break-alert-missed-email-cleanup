#!/usr/bin/env bash
set -Eeuo pipefail

# Roshdy V13:
# 1) Reliable full-screen employee alert when admin ends break:
#    - stores admin_close_target_user on Break Log
#    - agent poll checks target_user + employee + owner + extension fallback
#    - agent overlay is inserted BEFORE </body>, removing older broken blocks after </html>
# 2) Upper Management email missed calls:
#    - includes explicit staff_missed + employee-side declined/rejected only when a real extension/agent is present
#    - shows employee name if mapped, otherwise clearly shows extension and mapping warning
#    - no empty misleading table when count exists
# 3) Email hidden recipients:
#    - filters admin@roshdy.com / el.alfy@roshdy.com
#    - removes those hidden emails from tabSingles values safely where found
# 4) Optional old failed backups cleanup (default dry-run, set CLEAN_OLD_FAILED_BACKUPS=1 to delete candidates)
# Safety: backup first; DOES NOT touch restaurant_ops.api.report_api / Elastix / CDR / AMI config.

ROOT="${ROOT:-/opt/frappe_crm}"
SITE="${SITE:-crm.local}"
APP="restaurant_ops"
CLEAN_OLD_FAILED_BACKUPS="${CLEAN_OLD_FAILED_BACKUPS:-0}"

cd "$ROOT"

if docker compose version >/dev/null 2>&1; then
  COMPOSE=(docker compose)
elif command -v docker-compose >/dev/null 2>&1; then
  COMPOSE=(docker-compose)
else
  echo "❌ docker compose/docker-compose مش موجود"
  exit 1
fi

APP_DIR="$ROOT/apps/$APP"
PKG_DIR="$APP_DIR/$APP"
WWW_DIR="$PKG_DIR/www"
API_DIR="$PKG_DIR/api"
EMAIL_REPORT="$API_DIR/email_report.py"
UPPER_API="$API_DIR/upper_management_email_api.py"
BREAK_API="$API_DIR/break_api.py"
AGENT_HTML="$WWW_DIR/agent-desk.html"
TS="$(date +%Y%m%d_%H%M%S)"
BACKUP_DIR="$ROOT/backups/V13_BREAK_ALERT_MISSED_EMAIL_CLEANUP_BEFORE_$TS"
mkdir -p "$BACKUP_DIR"

BACKEND="$(${COMPOSE[@]} ps -q backend || true)"
if [[ -z "$BACKEND" ]]; then
  echo "❌ backend container مش شغال أو مش لاقيه"
  exit 1
fi

bench_exec() {
  "${COMPOSE[@]}" exec -T backend bench --site "$SITE" "$@"
}

echo "============================================================"
echo "🔧 Roshdy V13: break alert + missed calls + hidden emails + cleanup"
echo "📦 Backup: $BACKUP_DIR"
echo "============================================================"

echo "🧯 Backup files + bench backup"
for f in "$EMAIL_REPORT" "$UPPER_API" "$BREAK_API" "$AGENT_HTML"; do
  [[ -f "$f" ]] && cp -a "$f" "$BACKUP_DIR/$(basename "$f").before"
done
bench_exec backup --with-files | tee "$BACKUP_DIR/bench_backup_output.txt"

echo "🧱 Ensure custom fields for employee admin-close alert"
mkdir -p "$PKG_DIR/scripts"
cat > "$PKG_DIR/scripts/setup_break_admin_alert_fields_v13.py" <<'PY'
import frappe
from frappe.custom.doctype.custom_field.custom_field import create_custom_field

def execute():
    dt = "Employee Break Log"
    if not frappe.db.exists("DocType", dt):
        return {"success": False, "error": "Employee Break Log not found"}
    meta = frappe.get_meta(dt)
    fields = {
        "admin_close_target_user": {"label": "Admin Close Target User", "fieldtype": "Data", "insert_after": "closure_type"},
        "admin_close_acknowledged": {"label": "Admin Close Acknowledged", "fieldtype": "Check", "default": "0", "insert_after": "admin_close_target_user"},
        "admin_close_acknowledged_at": {"label": "Admin Close Acknowledged At", "fieldtype": "Datetime", "insert_after": "admin_close_acknowledged"},
        "admin_close_message": {"label": "Admin Close Message", "fieldtype": "Small Text", "insert_after": "admin_close_acknowledged_at"},
    }
    made=[]
    for fn, df in fields.items():
        if not meta.has_field(fn) and not frappe.db.exists("Custom Field", {"dt": dt, "fieldname": fn}):
            data=dict(df); data["fieldname"]=fn
            create_custom_field(dt, data, ignore_validate=True)
            made.append(fn)
    frappe.db.commit(); frappe.clear_cache(doctype=dt)
    return {"success": True, "created": made}
PY
APP_OWNER="$(stat -c '%u:%g' "$APP_DIR" 2>/dev/null || echo '')"
[[ -n "$APP_OWNER" ]] && chown "$APP_OWNER" "$PKG_DIR/scripts/setup_break_admin_alert_fields_v13.py" 2>/dev/null || true
bench_exec execute restaurant_ops.scripts.setup_break_admin_alert_fields_v13.execute | tee "$BACKUP_DIR/setup_break_admin_alert_fields_v13.txt"

echo "🧩 Patch backend and agent page"
export BREAK_API UPPER_API EMAIL_REPORT AGENT_HTML
python3 - <<'PY'
