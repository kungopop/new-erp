    return {"success":True,"server_now":now.strftime("%Y-%m-%d %H:%M:%S"),"active_count":len(out),"overdue_count":overdue_count,"rows":out}


@frappe.whitelist()
def admin_end_break(break_log=None, note=None):
    if not _v13_admin_allowed(): frappe.throw("غير مسموح: إنهاء البريك من الإدارة فقط")
