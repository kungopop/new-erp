#!/usr/bin/env bash
set -Eeuo pipefail

# Roshdy V38: Final fix for leaked escaped HTML/JS in email feedback section
# -------------------------------------------------------------------------
# Fixes:
# - Escaped/double-escaped snippets like &lt;button...&gt;, &amp;lt;script...&amp;gt;
#   leaking into Center/Upper email reports near feedback table.
# - Rebuilds feedback email section as safe inline HTML table.
# - Adds final sanitizer wrappers around Center + Upper render/preview/send.
# - Cleans stored email builder/customizer settings from leaked HTML/JS.
# Safety:
# - Backup first.
# - Does NOT touch report_api.py / Elastix / CDR / AMI.

ROOT="${ROOT:-/opt/frappe_crm}"
SITE="${SITE:-crm.local}"
APP="restaurant_ops"
RUN_SEND_TEST="${RUN_SEND_TEST:-0}"

cd "$ROOT"

if docker compose version >/dev/null 2>&1; then
  COMPOSE=(docker compose)
elif command -v docker-compose >/dev/null 2>&1; then
  COMPOSE=(docker-compose)
else
  echo "❌ docker compose/docker-compose مش موجود"
  exit 1
fi

APP_DIR="$ROOT/apps/$APP"
PKG_DIR="$APP_DIR/$APP"
API_DIR="$PKG_DIR/api"
SCRIPTS_DIR="$PKG_DIR/scripts"
UPPER_API="$API_DIR/upper_management_email_api.py"
EMAIL_REPORT="$API_DIR/email_report.py"
TS="$(date +%Y%m%d_%H%M%S)"
BACKUP_DIR="$ROOT/backups/FIX_EMAIL_HTML_LEAK_V38_BEFORE_$TS"
mkdir -p "$BACKUP_DIR/files" "$SCRIPTS_DIR"

BACKEND="$(${COMPOSE[@]} ps -q backend || true)"
if [[ -z "$BACKEND" ]]; then
  echo "❌ backend container مش شغال أو مش لاقيه"
  exit 1
fi

bench_exec() { "${COMPOSE[@]}" exec -T backend bench --site "$SITE" "$@"; }

echo "============================================================"
echo "🔧 Roshdy V38: Fix email leaked HTML/JS near feedback table"
echo "📦 Backup: $BACKUP_DIR"
echo "============================================================"

if [[ ! -f "$UPPER_API" || ! -f "$EMAIL_REPORT" ]]; then
  echo "❌ ملفات الإيميل مش موجودة"
  exit 1
fi

echo "🧯 Step 1: Backup files + bench backup"
cp -a "$UPPER_API" "$BACKUP_DIR/files/upper_management_email_api.py.before"
cp -a "$EMAIL_REPORT" "$BACKUP_DIR/files/email_report.py.before"
bench_exec backup --with-files | tee "$BACKUP_DIR/bench_backup_output.txt"

# -----------------------------------------------------------------------------
# 2) Stored settings cleanup module
# -----------------------------------------------------------------------------
echo "🧹 Step 2: Install and run stored settings cleanup"
cat > "$SCRIPTS_DIR/cleanup_email_html_leaks_v38.py" <<'PYCLEAN'
# -*- coding: utf-8 -*-
import json
import re
import html
import frappe
from frappe.utils import cstr

BAD_MARKERS = [
    "loadBreakTypes", "previewBox", "onclick=\"save()\"", "sendReport()",
    "&lt;button", "&amp;lt;button", "<button", "&lt;script", "&amp;lt;script", "<script",
    "URLSearchParams", "release_extension_and_logout",
]


def _has_bad(s):
    s = cstr(s or "")
    low = s.lower()
    return any(m.lower() in low for m in BAD_MARKERS)


def _strip_leaks(s):
    s = cstr(s or "")
    if not _has_bad(s):
        return s
    # Remove real and escaped interactive blocks.
    patterns = [
        r"(?is)<script\b[\s\S]*?</script>", r"(?is)<button\b[\s\S]*?</button>", r"(?is)<form\b[\s\S]*?</form>", r"(?is)<iframe\b[\s\S]*?</iframe>", r"(?is)<select\b[\s\S]*?</select>", r"(?is)<textarea\b[\s\S]*?</textarea>", r"(?is)<input\b[^>]*>",
        r"(?is)&lt;script\b[\s\S]*?&lt;/script&gt;", r"(?is)&lt;button\b[\s\S]*?&lt;/button&gt;", r"(?is)&lt;form\b[\s\S]*?&lt;/form&gt;", r"(?is)&lt;iframe\b[\s\S]*?&lt;/iframe&gt;", r"(?is)&lt;select\b[\s\S]*?&lt;/select&gt;", r"(?is)&lt;textarea\b[\s\S]*?&lt;/textarea&gt;", r"(?is)&lt;input\b[\s\S]*?&gt;",
        r"(?is)&amp;lt;script\b[\s\S]*?&amp;lt;/script&amp;gt;", r"(?is)&amp;lt;button\b[\s\S]*?&amp;lt;/button&amp;gt;", r"(?is)&amp;lt;form\b[\s\S]*?&amp;lt;/form&amp;gt;", r"(?is)&amp;lt;iframe\b[\s\S]*?&amp;lt;/iframe&amp;gt;", r"(?is)&amp;lt;select\b[\s\S]*?&amp;lt;/select&amp;gt;", r"(?is)&amp;lt;textarea\b[\s\S]*?&amp;lt;/textarea&amp;gt;", r"(?is)&amp;lt;input\b[\s\S]*?&amp;gt;",
    ]
    for pat in patterns:
        s = re.sub(pat, "", s)
    # If a settings-page JS blob is present as text, remove from first known marker to the end of this stored field.
    marker_patterns = [
        r"(?is)(&amp;lt;button\s+class=\"btn\"\s+onclick=\"save\(\)\"[\s\S]*)$",
        r"(?is)(&lt;button\s+class=\"btn\"\s+onclick=\"save\(\)\"[\s\S]*)$",
        r"(?is)(<button\s+class=\"btn\"\s+onclick=\"save\(\)\"[\s\S]*)$",
        r"(?is)(async function loadBreakTypes\(\)[\s\S]*)$",
        r"(?is)(function M\(p\)\{return p\.join[\s\S]*)$",
    ]
    for pat in marker_patterns:
        s = re.sub(pat, "", s)
    return s.strip()


def _clean_obj(obj):
    if isinstance(obj, dict):
        return {k: _clean_obj(v) for k, v in obj.items()}
    if isinstance(obj, list):
        return [_clean_obj(v) for v in obj]
    if isinstance(obj, str):
        return _strip_leaks(obj)
    return obj


def _clean_value(value):
    value = cstr(value or "")
    if not _has_bad(value):
        return value, False
    try:
        parsed = json.loads(value)
        cleaned = _clean_obj(parsed)
        new = json.dumps(cleaned, ensure_ascii=False)
        return new, new != value
    except Exception:
        new = _strip_leaks(value)
        return new, new != value


def execute():
    changed = []
    # tabDefault
    try:
        rows = frappe.db.sql("select name, defkey, defvalue from `tabDefault` where defvalue like '%%button%%' or defvalue like '%%script%%' or defvalue like '%%loadBreakTypes%%' or defvalue like '%%previewBox%%'", as_dict=True)
        for r in rows:
            new, diff = _clean_value(r.defvalue)
            if diff:
                frappe.db.set_value("DefaultValue", r.name, "defvalue", new)
                changed.append({"table": "tabDefault", "name": r.name, "defkey": r.defkey})
    except Exception as e:
        changed.append({"table": "tabDefault", "error": cstr(e)})
    # tabSingles
    try:
        rows = frappe.db.sql("select doctype, field, value from `tabSingles` where value like '%%button%%' or value like '%%script%%' or value like '%%loadBreakTypes%%' or value like '%%previewBox%%'", as_dict=True)
        for r in rows:
            new, diff = _clean_value(r.value)
            if diff:
                frappe.db.set_value(r.doctype, None, r.field, new)
                changed.append({"table": "tabSingles", "doctype": r.doctype, "field": r.field})
    except Exception as e:
        changed.append({"table": "tabSingles", "error": cstr(e)})
    frappe.db.commit()
    return {"success": True, "changed": changed, "changed_count": len(changed)}
PYCLEAN

APP_OWNER="$(stat -c '%u:%g' "$APP_DIR" 2>/dev/null || echo '')"
[[ -n "$APP_OWNER" ]] && chown "$APP_OWNER" "$SCRIPTS_DIR/cleanup_email_html_leaks_v38.py" 2>/dev/null || true
bench_exec execute restaurant_ops.scripts.cleanup_email_html_leaks_v38.execute | tee "$BACKUP_DIR/cleanup_email_html_leaks_v38.txt"

