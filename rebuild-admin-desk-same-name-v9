#!/usr/bin/env bash
set -Eeuo pipefail

# Rebuild /admin-desk with the SAME route/name, clean from scratch.
# Also rebuild /break-admin with active-break admin controls.
# Keeps other pages/features intact.
# Does NOT touch report_api.py / Elastix / CDR / AMI config.

ROOT="${ROOT:-/opt/frappe_crm}"
SITE="${SITE:-crm.local}"
APP="restaurant_ops"

cd "$ROOT"

if docker compose version >/dev/null 2>&1; then
  COMPOSE=(docker compose)
elif command -v docker-compose >/dev/null 2>&1; then
  COMPOSE=(docker-compose)
else
  echo "❌ docker compose/docker-compose مش موجود"
  exit 1
fi

APP_DIR="$ROOT/apps/$APP"
PKG_DIR="$APP_DIR/$APP"
WWW_DIR="$PKG_DIR/www"
API_DIR="$PKG_DIR/api"
ADMIN_HTML="$WWW_DIR/admin-desk.html"
BREAK_ADMIN_HTML="$WWW_DIR/break-admin.html"
BREAK_API="$API_DIR/break_api.py"
UPPER_API="$API_DIR/upper_management_email_api.py"
TS="$(date +%Y%m%d_%H%M%S)"
BACKUP_DIR="$ROOT/backups/REBUILD_ADMIN_DESK_V9_BEFORE_$TS"
mkdir -p "$BACKUP_DIR"

BACKEND="$(${COMPOSE[@]} ps -q backend || true)"
if [[ -z "$BACKEND" ]]; then
  echo "❌ backend container مش شغال أو مش لاقيه"
  exit 1
fi

bench_exec() {
  "${COMPOSE[@]}" exec -T backend bench --site "$SITE" "$@"
}

echo "============================================================"
echo "🏗️ Rebuild Admin Desk V9 same-name"
echo "📦 Backup: $BACKUP_DIR"
echo "============================================================"

echo "🧯 Backup files + bench backup"
for f in "$ADMIN_HTML" "$BREAK_ADMIN_HTML" "$BREAK_API" "$UPPER_API"; do
  [[ -f "$f" ]] && cp -a "$f" "$BACKUP_DIR/$(basename "$f").before"
done
bench_exec backup --with-files | tee "$BACKUP_DIR/bench_backup_output.txt"

echo "🧩 Patch backend endpoints: active breaks + cancellations"
export BREAK_API UPPER_API
python3 - <<'PY'
# -*- coding: utf-8 -*-
from pathlib import Path
import os

break_api = Path(os.environ["BREAK_API"])
upper_api = Path(os.environ["UPPER_API"])

if break_api.exists():
    s = break_api.read_text(encoding="utf-8", errors="ignore")
    start = "# BEGIN ROSHDY BREAK API V9 FINAL SERVER TRUTH"
    end = "# END ROSHDY BREAK API V9 FINAL SERVER TRUTH"
    patch = r'''
# BEGIN ROSHDY BREAK API V9 FINAL SERVER TRUTH
# Final direct break endpoints for Admin Desk / Break Admin.
# Server is the source of truth for active status and duration.
try:
    import frappe
    from frappe.utils import now_datetime, get_datetime, flt, cstr
except Exception:
    frappe = None


def _v9_break_admin_allowed():
    try:
        if frappe.session.user == "Administrator":
            return True
        roles = set(frappe.get_roles(frappe.session.user))
        return bool(roles.intersection({"System Manager", "Call Center Admin", "Restaurant Manager", "Break Admin"}))
    except Exception:
        return False


def _v9_employee_name(emp):
    if not emp:
        return "غير محدد"
    try:
        return frappe.db.get_value("Employee", emp, "employee_name") or emp
    except Exception:
        return emp


def _v9_break_limit_minutes(break_type=None):
    default = 30.0
    try:
        conf = getattr(frappe.local, "conf", {}) or {}
        if conf.get("break_overdue_minutes"):
            return flt(conf.get("break_overdue_minutes")) or default
    except Exception:
        pass
    if break_type:
        try:
            if frappe.db.exists("DocType", "Break Type") and frappe.db.exists("Break Type", break_type):
                doc = frappe.get_doc("Break Type", break_type)
                for fn in ("max_duration_minutes", "allowed_minutes", "duration_minutes", "break_minutes", "max_minutes", "time_limit_minutes", "duration", "minutes", "limit_minutes"):
                    if hasattr(doc, fn) and flt(getattr(doc, fn) or 0) > 0:
                        return flt(getattr(doc, fn))
        except Exception:
            pass
    return default


def _v9_duration_minutes(start_time, end_time=None):
    if not start_time:
        return 0.0
    try:
        st = get_datetime(start_time)
        en = get_datetime(end_time) if end_time else now_datetime()
        return round(max((en - st).total_seconds(), 0) / 60.0, 1)
    except Exception:
        return 0.0


@frappe.whitelist()
def get_active_breaks():
    if not _v9_break_admin_allowed():
        frappe.throw("غير مسموح")
    dt = "Employee Break Log"
    if not frappe.db.exists("DocType", dt):
        return {"success": False, "active_count": 0, "overdue_count": 0, "rows": [], "error": "Employee Break Log not found"}
    rows = frappe.db.sql("""
        select name, employee, break_type, break_date, status, start_time, end_time,
               duration_seconds, duration_minutes, extension_at_start, notes, creation, owner,
               closed_by, closure_type
        from `tabEmployee Break Log`
        where ifnull(docstatus,0) < 2
          and (
                lower(ifnull(status,'')) in ('active','نشط')
                or (
                    (end_time is null or end_time='')
                    and lower(ifnull(status,'')) not in ('finished','closed','ended','cancelled','canceled','completed','منتهي','مغلق','ملغي')
                )
          )
        order by coalesce(start_time, creation) asc
        limit 500
    """, as_dict=True)
    server_now = now_datetime()
    out = []
    overdue_count = 0
    for r in rows:
        dur = _v9_duration_minutes(r.get("start_time"))
        limit = _v9_break_limit_minutes(r.get("break_type"))
        overdue = dur >= limit
        if overdue:
            overdue_count += 1
        out.append({
            "name": r.get("name"),
            "employee": r.get("employee"),
            "employee_name": _v9_employee_name(r.get("employee")),
            "break_type": r.get("break_type") or "غير محدد",
            "start_time": cstr(r.get("start_time") or ""),
            "duration_minutes": dur,
            "limit_minutes": limit,
            "overdue": overdue,
            "overdue_minutes": round(max(dur - limit, 0), 1),
            "extension": r.get("extension_at_start") or "",
            "notes": r.get("notes") or "",
        })
    return {"success": True, "server_now": server_now.strftime("%Y-%m-%d %H:%M:%S"), "active_count": len(out), "overdue_count": overdue_count, "rows": out}


@frappe.whitelist()
def admin_end_break(break_log=None, note=None):
    if not _v9_break_admin_allowed():
        frappe.throw("غير مسموح: إنهاء البريك من الإدارة فقط")
    if not break_log:
        frappe.throw("break_log مطلوب")
    dt = "Employee Break Log"
    if not frappe.db.exists(dt, break_log):
        frappe.throw("سجل البريك غير موجود")
    doc = frappe.get_doc(dt, break_log)
    now = now_datetime()
    dur_seconds = 0
    if doc.get("start_time"):
        dur_seconds = int(max((now - get_datetime(doc.get("start_time"))).total_seconds(), 0))
    dur_minutes = round(dur_seconds / 60.0, 2)
    admin_user = frappe.session.user
    admin_label = frappe.db.get_value("User", admin_user, "full_name") or admin_user
    old_notes = cstr(doc.get("notes") or "")
    append_note = f"\n[Admin Close] تم إنهاء البريك بواسطة {admin_label} في {now.strftime('%Y-%m-%d %H:%M:%S')}"
    if note:
        append_note += f" - ملاحظة: {note}"
    updates = {
        "status": "finished",
        "end_time": now,
        "duration_seconds": dur_seconds,
        "duration_minutes": dur_minutes,
        "closed_by": admin_user,
        "closure_type": "admin",
        "notes": (old_notes + append_note).strip(),
    }
    try:
        meta = frappe.get_meta(dt)
        if meta.has_field("admin_close_acknowledged"):
            updates["admin_close_acknowledged"] = 0
        if meta.has_field("admin_close_message"):
            updates["admin_close_message"] = f"تم إنهاء البريك بواسطة {admin_label}"
    except Exception:
        pass
    frappe.db.set_value(dt, break_log, updates, update_modified=True)
    frappe.db.commit()
    try:
        from restaurant_ops.api.break_notifications import notify_employee_break_closed, publish_active_breaks_changed
        notify_employee_break_closed(break_log, doc.get("employee"), admin_label)
        publish_active_breaks_changed()
    except Exception:
        pass
    return {"success": True, "message": "تم إنهاء البريك", "break_log": break_log, "closed_by": admin_label, "duration_minutes": dur_minutes}
# END ROSHDY BREAK API V9 FINAL SERVER TRUTH
'''
    if start in s and end in s:
        i = s.index(start); j = s.index(end, i) + len(end); s = s[:i] + patch.strip() + s[j:]
    else:
        s = s.rstrip() + "\n\n" + patch.strip() + "\n"
    compile(s, str(break_api), "exec")
    break_api.write_text(s, encoding="utf-8")

if upper_api.exists():
    s = upper_api.read_text(encoding="utf-8", errors="ignore")
    start = "# BEGIN ROSHDY CANCELLATION API V9 FINAL"
    end = "# END ROSHDY CANCELLATION API V9 FINAL"
    patch = r'''
# BEGIN ROSHDY CANCELLATION API V9 FINAL
# Manual order cancellations for Admin Desk and Upper Management Report.
try:
    import frappe
    from frappe.utils import now_datetime, get_datetime, getdate, cstr, cint
except Exception:
    pass


def _v9_can_manage_cancellations():
    try:
        if frappe.session.user == "Administrator":
            return True
        roles = set(frappe.get_roles(frappe.session.user))
        return bool(roles.intersection({"System Manager", "Call Center Admin", "Restaurant Manager"}))
    except Exception:
        return False


@frappe.whitelist()
def create_order_cancellation(order_no=None, shift=None, branch=None, customer_name=None, customer_phone=None, reason=None, notes=None, cancellation_time=None, **kwargs):
    ensure_order_cancellation_doctype()
    if not _v9_can_manage_cancellations():
        frappe.throw("غير مسموح: تسجيل الإلغاءات متاح لمدير خدمة العملاء أو مدير النظام فقط")
    order_no = cstr(order_no or kwargs.get("order") or kwargs.get("order_id") or kwargs.get("order_number") or "").strip()
    shift = cstr(shift or kwargs.get("shift_name") or "غير محدد").strip()
    branch = cstr(branch or kwargs.get("store") or kwargs.get("branch_name") or "").strip()
    customer_name = cstr(customer_name or kwargs.get("customer") or kwargs.get("client_name") or "").strip()
    customer_phone = cstr(customer_phone or kwargs.get("phone") or kwargs.get("mobile") or "").strip()
    reason = cstr(reason or kwargs.get("cancel_reason") or kwargs.get("cancellation_reason") or "").strip()
    notes = cstr(notes or kwargs.get("note") or kwargs.get("remarks") or "").strip()
    if not order_no:
        frappe.throw("رقم الطلب مطلوب")
    if not branch:
        frappe.throw("الفرع مطلوب")
    if not reason:
        frappe.throw("سبب الإلغاء مطلوب")
    ct = get_datetime(cancellation_time) if cancellation_time else now_datetime()
    doc = frappe.get_doc({
        "doctype": CANCELLATION_DOCTYPE,
        "order_no": order_no,
        "cancellation_time": ct,
        "report_date": getdate(ct),
        "shift": shift or "غير محدد",
        "branch": branch,
        "customer_name": customer_name,
        "customer_phone": customer_phone,
        "reason": reason,
        "notes": notes,
        "logged_by": frappe.session.user,
        "source": "manual",
    })
    doc.insert(ignore_permissions=True)
    frappe.db.commit()
    return {"success": True, "name": doc.name, "message": "تم تسجيل الإلغاء بنجاح"}


@frappe.whitelist()
def list_order_cancellations(date_from=None, date_to=None, limit=200, **kwargs):
    ensure_order_cancellation_doctype()
    start_date, end_date, start_dt, end_dt = _period(date_from, date_to)
    rows = frappe.get_all(
        CANCELLATION_DOCTYPE,
        filters={"cancellation_time": ["between", [_iso(start_dt), _iso(end_dt)]]},
        fields=["name", "order_no", "cancellation_time", "shift", "branch", "customer_name", "customer_phone", "reason", "notes", "logged_by", "creation"],
        order_by="cancellation_time desc, creation desc",
        limit_page_length=cint(limit) or 200,
    )
    return {"success": True, "count": len(rows), "rows": rows}
# END ROSHDY CANCELLATION API V9 FINAL
'''
    if start in s and end in s:
        i = s.index(start); j = s.index(end, i) + len(end); s = s[:i] + patch.strip() + s[j:]
    else:
        s = s.rstrip() + "\n\n" + patch.strip() + "\n"
    compile(s, str(upper_api), "exec")
    upper_api.write_text(s, encoding="utf-8")
PY

