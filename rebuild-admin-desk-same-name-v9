echo "🧪 Critical page smoke checks"
set +e
for p in admin-desk break-admin call-report email-report-customizer sales-report; do
  code="$(curl -k -s -o /dev/null -w '%{http_code}' "http://127.0.0.1/$p" 2>/dev/null || echo 000)"
  echo "$p => $code" | tee -a "$BACKUP_DIR/page_smoke_checks_after_v9.txt"
done
set -e

if ! grep -q "admin-desk => 200" "$BACKUP_DIR/page_smoke_checks_after_v9.txt"; then
  echo "❌ admin-desk وقع بعد V9. هنعمل Auto Restore للصفحات."
  [[ -f "$BACKUP_DIR/admin-desk.html.before" ]] && cp -a "$BACKUP_DIR/admin-desk.html.before" "$ADMIN_HTML"
  [[ -f "$BACKUP_DIR/break-admin.html.before" ]] && cp -a "$BACKUP_DIR/break-admin.html.before" "$BREAK_ADMIN_HTML"
  [[ -n "$APP_OWNER" ]] && chown "$APP_OWNER" "$ADMIN_HTML" "$BREAK_ADMIN_HTML" 2>/dev/null || true
  bench_exec clear-cache || true
  "${COMPOSE[@]}" restart backend frontend websocket >/dev/null
  sleep 6
  bench_exec clear-cache || true
  "${COMPOSE[@]}" logs --tail=250 backend > "$BACKUP_DIR/backend_logs_after_v9_failure.txt" 2>&1 || true
  echo "📄 Logs: $BACKUP_DIR/backend_logs_after_v9_failure.txt"
  exit 1
fi

echo "🧪 Backend validation"
set +e
bench_exec execute restaurant_ops.api.break_api.get_active_breaks | tee "$BACKUP_DIR/active_breaks_v9.txt"
V1=${PIPESTATUS[0]}
bench_exec execute restaurant_ops.api.upper_management_email_api.list_order_cancellations | tee "$BACKUP_DIR/cancellations_v9.txt"
V2=${PIPESTATUS[0]}
bench_exec execute restaurant_ops.api.upper_management_email_api.get_upper_management_report_data | tee "$BACKUP_DIR/upper_data_v9.txt"
V3=${PIPESTATUS[0]}
set -e

if [[ $V1 -ne 0 || $V2 -ne 0 || $V3 -ne 0 ]]; then
  echo "❌ Backend validation failed. راجع: $BACKUP_DIR"
  exit 1
fi

echo "🏥 Health Check - Elastix/CDR/AMI + Queue + Call Report"
set +e
bench_exec execute restaurant_ops.api.asterisk_bridge.run_full_system_diagnostics | tee "$BACKUP_DIR/health_asterisk_bridge.txt"
H1=${PIPESTATUS[0]}
bench_exec execute restaurant_ops.api.queue_api.get_queue_status | tee "$BACKUP_DIR/health_queue_status.txt"
H2=${PIPESTATUS[0]}
bench_exec execute restaurant_ops.api.report_api.get_calls_report --kwargs '{"page":1,"page_size":5,"view_mode":"admin"}' | tee "$BACKUP_DIR/health_call_report.txt"
H3=${PIPESTATUS[0]}
set -e

if [[ $H1 -ne 0 || $H2 -ne 0 || $H3 -ne 0 ]]; then
  echo "⚠️ Health returned non-zero. راجع: $BACKUP_DIR"
else
  echo "✅ Health checks OK"
fi

echo "============================================================"
echo "✅ DONE V9"
echo "📦 Backup folder: $BACKUP_DIR"
echo "🏠 /admin-desk rebuilt from scratch with same name"
echo "⏱️ /break-admin rebuilt with active breaks + End action"
echo "↩️ cancellations visible and saved via backend"
echo "🔔 bell opens admin notifications only"
echo "☰ sidebar collapse is native to the rebuilt page"
echo "🛡️ report_api.py لم يتم لمسه"
echo "============================================================"
