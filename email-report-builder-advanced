def _adv_get():
    raw = "{}"
    for key in ("roshdy_email_builder_v5", "roshdy_email_customizer_v4", "roshdy_email_customizer_v3"):
        try:
            raw = frappe.db.get_default(key) or "{}"
            if raw and raw != "{}":
                break
        except Exception:
            raw = "{}"
    try:
        saved = _adv_json.loads(raw or "{}")
    except Exception:
        saved = {}
    d = _adv_defaults()
    # merge shallow + nested known dicts
    for k,v in (saved or {}).items():
        if isinstance(v, dict) and isinstance(d.get(k), dict):
            d[k].update(v)
        else:
            d[k] = v
    if not isinstance(d.get("call_metrics"), list):
        d["call_metrics"] = _adv_default_metrics()
    return d


def _adv_save(data):
    frappe.db.set_default("roshdy_email_builder_v5", _adv_json.dumps(data, ensure_ascii=False))
    frappe.db.commit()
    return data


def _adv_escape(x):
    return frappe.utils.escape_html(str(x if x is not None else ""))


def _adv_table(headers, rows, st):
    h = "".join([f"<th>{_adv_escape(x)}</th>" for x in headers])
    body = ""
    for row in rows:
        body += "<tr>" + "".join([f"<td>{_adv_escape(x)}</td>" for x in row]) + "</tr>"
    if not rows:
        body = f"<tr><td colspan='{len(headers)}' style='text-align:center;color:#777'>لا توجد بيانات</td></tr>"
    return f"<table><thead><tr>{h}</tr></thead><tbody>{body}</tbody></table>"


