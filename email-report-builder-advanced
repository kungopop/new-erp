def _adv_complaints_section(st):
    df,dt,_,_ = _adv_period(st)
    try:
        rows = frappe.db.sql("""
            SELECT status, complaint_category category, complaint_priority priority, COUNT(*) count
            FROM `tabCall Center Complaint`
            WHERE COALESCE(complaint_datetime, creation) BETWEEN %s AND %s
            GROUP BY status, complaint_category, complaint_priority ORDER BY count DESC
        """, (f"{df} 00:00:00", f"{dt} 23:59:59"), as_dict=True)
    except Exception:
        rows = []
    cols = st.get("complaint_columns") or ["status","category","priority","count"]
    title = st.get("section_titles", {}).get("complaints", "الشكاوى")
    return "<h3>%s</h3>" % _adv_escape(title) + _adv_table([_adv_col_label(c) for c in cols], [[x.get(c, "") for c in cols] for x in rows], st)


