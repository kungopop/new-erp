def _adv_render(report_type="center"):
    st=_adv_get()
    title=st.get("center_title") if report_type=="center" else st.get("upper_title")
    sections_cfg=st.get("center_sections") if report_type=="center" else st.get("upper_sections")
    order=list(sections_cfg.keys())
    intro=st.get("center_intro") if report_type=="center" else st.get("upper_intro")
    footer=st.get("center_footer") if report_type=="center" else st.get("upper_footer")
    chunks=[]
    if intro: chunks.append(f"<div class='note'>{_adv_escape(intro)}</div>")
    for sec in order:
        if _adv_bool(sections_cfg.get(sec), 0):
            chunks.append(_adv_section_html(sec, st))
    if footer: chunks.append(f"<div class='note'>{_adv_escape(footer)}</div>")
    return {"success": True, "html": _adv_base(title or "تقرير", st, "".join(chunks)), "settings": st}


@frappe.whitelist()
def get_email_builder_settings():
    if not (frappe.session.user == "Administrator" or "System Manager" in frappe.get_roles(frappe.session.user)):
        return {"success": False, "message": "System Manager only"}
    return {"success": True, "settings": _adv_get(), "available_call_metric_keys": list((_adv_get().get("calls", {}) or {}).keys())}


@frappe.whitelist()
def save_email_builder_settings(settings_json=None):
    if not (frappe.session.user == "Administrator" or "System Manager" in frappe.get_roles(frappe.session.user)):
        return {"success": False, "message": "System Manager only"}
    try:
        data = _adv_json.loads(settings_json or "{}")
    except Exception as e:
        return {"success": False, "message": "Invalid JSON: " + str(e)}
    st=_adv_get(); st.update(data); _adv_save(st)
    return {"success": True, "settings": st}


@frappe.whitelist()
def preview_email_report(report_type="center"):
    return _adv_render(report_type or "center")


