#!/usr/bin/env bash
set -Eeuo pipefail

# email-report-builder-advanced
# Advanced email report builder/customizer:
# - Full style controls (colors/font/CSS)
# - Editable call metrics labels/notes/show/order
# - Choose visible columns per section
# - Separate Center Service Manager / Upper Management settings
# - Actual send_report_now uses these settings
# - Does NOT touch report_api.py core.

ROOT="/opt/frappe_crm"
SITE="crm.local"
APP_HOST="$ROOT/apps/restaurant_ops"
APP_DIR="$APP_HOST/restaurant_ops"
API_DIR="$APP_DIR/api"
WWW_DIR="$APP_DIR/www"
TS="$(date +%Y%m%d_%H%M%S)"
BACKUP_DIR="$ROOT/backups/EMAIL_REPORT_BUILDER_ADVANCED_BEFORE_$TS"

say(){ echo -e "\n============================================================\n$1\n============================================================"; }

if [[ "${EUID:-$(id -u)}" -ne 0 ]]; then
  echo "❌ شغّل كـ root: sudo -i ثم ./email-report-builder-advanced"
  exit 1
fi

say "1) Backup قبل Email Builder المتقدم"
cd "$ROOT"
BACKEND="$(docker compose ps -q backend || true)"
if [[ -z "$BACKEND" ]]; then
  echo "❌ لم أجد backend container. شغّل: cd /opt/frappe_crm && docker compose up -d"
  exit 1
fi
mkdir -p "$BACKUP_DIR"
cp -a "$APP_HOST" "$BACKUP_DIR/restaurant_ops"
[[ -f "$ROOT/docker-compose.yml" ]] && cp -a "$ROOT/docker-compose.yml" "$BACKUP_DIR/docker-compose.yml"
echo "✅ Backup: $BACKUP_DIR"

say "2) Append advanced email_report.py overrides"
cat >> "$API_DIR/email_report.py" <<'PY'

# ===== ROSHDY ADVANCED EMAIL BUILDER START =====
import json as _adv_json


def _adv_bool(v, default=1):
    if v is None:
        return bool(default)
    if isinstance(v, bool):
        return v
    try:
        return bool(int(v))
    except Exception:
        return str(v).strip().lower() in ("true", "yes", "on", "y")


def _adv_recipients(raw):
    return [x.strip() for x in str(raw or "").replace(";", ",").split(",") if x.strip()]


def _adv_place():
    try:
        return frappe.conf.get("restaurant_place_name") or "مطعم رشدي"
