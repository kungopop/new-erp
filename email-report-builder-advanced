get_email_customizer_settings = get_email_builder_settings
save_email_customizer_settings = save_email_builder_settings


def _adv_recipients_for(settings_doc, report_type, st):
    if report_type == "center":
        override=st.get("center_recipients_override") or ""
        fallback=getattr(settings_doc,"center_manager_recipients","") or getattr(settings_doc,"daily_report_recipients","") or "el.alfy@roshdy.com"
    else:
        override=st.get("upper_recipients_override") or ""
        fallback=getattr(settings_doc,"upper_management_recipients","") or "admin@roshdy.com"
    return _adv_recipients(override or fallback)


def send_center_manager_report(settings) -> dict:
    try:
        st=_adv_get(); recipients=_adv_recipients_for(settings,"center",st)
        if not recipients: return {"success": False, "message": "No center recipients"}
        rendered=_adv_render("center"); subject=f"📋 {st.get('center_title')} — {today()}"
        frappe.sendmail(recipients=recipients, subject=subject, message=rendered.get("html"), now=True)
        return {"success": True, "message": f"sent to {len(recipients)}", "recipients": recipients}
    except Exception as e:
        return {"success": False, "message": str(e)}


def send_upper_management_report(settings) -> dict:
    try:
        st=_adv_get(); recipients=_adv_recipients_for(settings,"upper",st)
        if not recipients: return {"success": False, "message": "No upper recipients"}
        rendered=_adv_render("upper"); subject=f"📊 {st.get('upper_title')} — {today()}"
        frappe.sendmail(recipients=recipients, subject=subject, message=rendered.get("html"), now=True)
        return {"success": True, "message": f"sent to {len(recipients)}", "recipients": recipients}
    except Exception as e:
        return {"success": False, "message": str(e)}


def send_daily_shift_report() -> dict:
    try:
        settings=frappe.get_single("Call Center Settings")
        if hasattr(settings,"daily_report_enabled") and not settings.daily_report_enabled:
            return {"success": False, "message": "Daily report disabled"}
        c=send_center_manager_report(settings); u=send_upper_management_report(settings)
        return {"success": True, "message": f"Center: {c.get('message')} | Upper: {u.get('message')}", "center": c, "upper": u}
    except Exception as e:
        return {"success": False, "message": str(e)}


@frappe.whitelist()
def send_report_now(report_type="both") -> dict:
