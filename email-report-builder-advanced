def _adv_period(st):
    dt = today()
    return dt, dt, st.get("shift_start") or "00:00", st.get("shift_end") or "23:59"


def _adv_col_label(col):
    labels = {
        "label":"البند", "count":"العدد", "percent":"النسبة", "note":"التفسير",
        "employee_name":"الموظف", "count":"العدد", "minutes":"الدقائق", "total_formatted":"الوقت",
        "orders":"عدد العمليات", "quantity":"الكمية", "item_name":"الصنف", "agent":"الموظف",
        "name":"رقم", "sale_date_text":"التاريخ", "customer_name":"العميل", "customer_phone":"الهاتف", "notes":"ملاحظات",
        "status":"الحالة", "category":"الفئة", "priority":"الأولوية", "duration":"المدة"
    }
    return labels.get(col, col)


def _adv_metric_percent(key, val, summary):
    try:
        if key == "queue_answered":
            return str(summary.get("answer_rate_of_queue", 0)) + "%"
        if key == "queue_total":
            return str(summary.get("queue_reach_rate_of_all", 0)) + "%"
        if key in ("raw_total", "answer_rate_of_queue", "queue_reach_rate_of_all"):
            return ""
        raw = float(summary.get("raw_total") or 0)
        if raw:
            return str(round(float(val or 0) * 100 / raw, 2)) + "%"
    except Exception:
        pass
    return ""


def _adv_calls_section(st):
    from restaurant_ops.api.ops_reports_api import get_owner_call_summary
    df,dt,ss,se = _adv_period(st)
    calls = get_owner_call_summary(df, dt, ss, se)
    summary = calls.get("summary", {})
    cols = st.get("call_columns") or ["label","count","percent","note"]
    metrics = st.get("call_metrics") or _adv_default_metrics()
    rows = []
    for m in metrics:
        if not _adv_bool(m.get("show"), 1):
            continue
        key = m.get("key")
        val = summary.get(key, "")
        row_map = {"label": m.get("label") or key, "count": val, "percent": _adv_metric_percent(key, val, summary), "note": m.get("note") or ""}
        rows.append([row_map.get(c, "") for c in cols])
    title = st.get("section_titles", {}).get("calls", "ملخص المكالمات الإداري")
    return "<h3>%s</h3>" % _adv_escape(title) + _adv_table([_adv_col_label(c) for c in cols], rows, st)


def _adv_call_kpi(st):
    from restaurant_ops.api.ops_reports_api import get_owner_call_summary
    df,dt,ss,se = _adv_period(st)
    sm = get_owner_call_summary(df, dt, ss, se).get("summary", {})
    title = st.get("section_titles", {}).get("call_kpi", "مؤشرات مختصرة")
    html = f"<h3>{_adv_escape(title)}</h3>"
    for label, key in [("كل الأحداث","raw_total"),("وصل للطوابير","queue_total"),("تم الرد","queue_answered"),("نسبة وصول للطابور","queue_reach_rate_of_all"),("نسبة رد داخل الطابور","answer_rate_of_queue")]:
        val = sm.get(key, 0)
        if key.endswith("rate_of_all") or key.endswith("rate_of_queue"):
            val = str(val) + "%"
        html += f"<span class='kpi'>{_adv_escape(label)}: {_adv_escape(val)}</span>"
    return html


