# -*- coding: utf-8 -*-
import re
import json
from datetime import datetime, time, timedelta

import frappe
from frappe.utils import cstr, cint, flt, getdate, get_datetime, today, now_datetime


def _safe(v):
    try:
        return cstr(v)
    except Exception:
        return str(v)


def _parse_time(v):
    s = cstr(v or "").strip()
    if not s:
        return None
    # Accept HH:MM, HH:MM:SS, timedelta-like, datetime-like
    m = re.search(r"(\d{1,2}):(\d{2})(?::(\d{2}))?", s)
    if m:
        hh, mm, ss = int(m.group(1)), int(m.group(2)), int(m.group(3) or 0)
        if 0 <= hh <= 23 and 0 <= mm <= 59:
            return time(hh, mm, ss)
    return None


def _scan_singles_for_shift():
    rows=[]
    try:
        data = frappe.db.sql("select doctype, field, value from `tabSingles` where value is not null and value!=''", as_dict=True)
    except Exception as e:
        return {"error": cstr(e), "rows": []}
    for r in data:
        hay = (cstr(r.doctype)+" "+cstr(r.field)).lower()
        val = cstr(r.value)
        t = _parse_time(val)
        score = 0
        if "shift" in hay: score += 5
        if "email" in hay or "report" in hay: score += 3
        if "start" in hay or "from" in hay or "begin" in hay or "بداية" in hay: score += 2
        if "end" in hay or "to" in hay or "finish" in hay or "نهاية" in hay: score += 2
        if t: score += 5
        if score >= 5 and (t or any(x in hay for x in ("shift","report","email"))):
            rows.append({"doctype": r.doctype, "field": r.field, "value": val, "parsed_time": t.isoformat() if t else None, "score": score})
    rows.sort(key=lambda x: x["score"], reverse=True)
    return {"rows": rows[:100]}


def _resolve_shift_window(date_from=None, date_to=None):
    scan = _scan_singles_for_shift().get("rows", [])
    start_candidates=[]; end_candidates=[]
    for r in scan:
        t = _parse_time(r.get("value"))
        if not t: continue
        hay = (cstr(r.get("doctype"))+" "+cstr(r.get("field"))).lower()
        score = r.get("score",0)
        if any(x in hay for x in ("start", "from", "begin", "بداية")):
            start_candidates.append((score, r, t))
        if any(x in hay for x in ("end", "to", "finish", "نهاية")):
            end_candidates.append((score, r, t))
    start_candidates.sort(key=lambda x:x[0], reverse=True)
    end_candidates.sort(key=lambda x:x[0], reverse=True)
    sd=getdate(date_from or today())
    ed=getdate(date_to or date_from or today())
    if start_candidates and end_candidates:
        st=start_candidates[0][2]; et=end_candidates[0][2]
        start_dt=datetime.combine(sd, st)
        end_dt=datetime.combine(ed, et)
        if end_dt <= start_dt:
            end_dt += timedelta(days=1)
        return {"found": True, "start_dt": start_dt.strftime('%Y-%m-%d %H:%M:%S'), "end_dt": end_dt.strftime('%Y-%m-%d %H:%M:%S'), "start_source": start_candidates[0][1], "end_source": end_candidates[0][1], "scan_sample": scan[:20]}
    return {"found": False, "start_dt": datetime.combine(sd, time.min).strftime('%Y-%m-%d %H:%M:%S'), "end_dt": datetime.combine(ed, time.max).strftime('%Y-%m-%d %H:%M:%S'), "scan_sample": scan[:20], "reason": "No confident shift start/end time found in tabSingles"}


def _call_report_page(page=1, page_size=1000, **kwargs):
    try:
        from restaurant_ops.api import report_api
        base={"page": page, "page_size": page_size, "view_mode": "admin"}
        base.update(kwargs)
        res=report_api.get_calls_report(**base)
        return res.get("message") if isinstance(res,dict) and isinstance(res.get("message"),dict) else res
    except Exception as e:
        return {"success": False, "error": cstr(e)}


def _rows(obj):
    if isinstance(obj,dict):
        for k in ("calls","rows","data","records","items","result"):
            if isinstance(obj.get(k),list): return obj.get(k)
    return []


def _fetch_call_rows(date_from=None, date_to=None, max_pages=10):
    first=_call_report_page(1,1000,date_from=date_from or today(),date_to=date_to or date_from or today())
    rows=list(_rows(first)); summary=first.get("summary") if isinstance(first,dict) else {}
    pagination=first.get("pagination") if isinstance(first,dict) else {}
    pages=min(cint((pagination or {}).get("total_pages") or 1), max_pages)
    for p in range(2,pages+1):
        res=_call_report_page(p,1000,date_from=date_from or today(),date_to=date_to or date_from or today())
        more=_rows(res)
        if not more: break
        rows.extend(more)
    return {"summary": summary, "pagination": pagination, "rows": rows, "first_error": first.get("error") if isinstance(first,dict) else None}


def _filter_rows_by_dt(rows, start_dt, end_dt):
    out=[]
    s=get_datetime(start_dt); e=get_datetime(end_dt)
    for r in rows:
        cd=r.get("calldate") or r.get("call_time") or r.get("time")
        if not cd: continue
        try:
            d=get_datetime(cd)
        except Exception:
            continue
        if s <= d <= e:
            out.append(r)
    return out


def _employee_map():
    out=[]
    try:
        if not frappe.db.exists("DocType","Employee"):
            return out
        meta=frappe.get_meta("Employee")
        fields=["name","employee_name","user_id","status"]
        for df in meta.fields:
            fn=cstr(df.fieldname).lower()
            if any(x in fn for x in ("extension","ext","sip")) and df.fieldname not in fields:
                fields.append(df.fieldname)
        # Use SQL-safe actual existing columns only by get_all; if custom meta mismatch, fallback.
        rows=frappe.get_all("Employee", fields=fields, limit_page_length=1000)
        for r in rows:
            exts=[]
            for k,v in r.items():
                if k not in ("name","employee_name","user_id","status") and v:
                    exts.append({"field": k, "value": cstr(v)})
            out.append({"employee": r.get("name"), "employee_name": r.get("employee_name"), "user_id": r.get("user_id"), "status": r.get("status"), "extensions": exts})
    except Exception as e:
        out.append({"error": cstr(e)})
    return out


def _email_debug():
    out={}
    try:
        from restaurant_ops.api import upper_management_email_api as up
        if hasattr(up,"debug_email_send_config"):
            out["upper_debug_email_send_config"]=up.debug_email_send_config()
        if hasattr(up,"verify_queue_journey_in_upper_email"):
            out["upper_verify_queue_journey"]=up.verify_queue_journey_in_upper_email()
        if hasattr(up,"verify_feedback_in_upper_email"):
            out["upper_verify_feedback"]=up.verify_feedback_in_upper_email()
    except Exception as e:
        out["upper_error"]=cstr(e)
    try:
        from restaurant_ops.api import email_report as er
        funcs=["send_report_now","preview_email_report","send_upper_management_report","debug_center_journey_email_section_v23","debug_center_feedback_email_section"]
        out["email_report_functions"]={fn: hasattr(er,fn) for fn in funcs}
        if hasattr(er,"debug_center_journey_email_section_v23"):
            out["center_journey_debug"]=er.debug_center_journey_email_section_v23()
        if hasattr(er,"debug_center_feedback_email_section"):
            out["center_feedback_debug"]=er.debug_center_feedback_email_section()
    except Exception as e:
        out["center_error"]=cstr(e)
    return out


def execute(date_from=None, date_to=None):
    date_from=date_from or today(); date_to=date_to or date_from
    shift=_resolve_shift_window(date_from,date_to)
    calls=_fetch_call_rows(date_from,date_to,max_pages=10)
    rows=calls.get("rows") or []
    filtered=_filter_rows_by_dt(rows, shift.get("start_dt"), shift.get("end_dt"))
    def count_answered(rs):
        return sum(1 for r in rs if cstr(r.get("smart_category") or "").lower()=="answered" or cstr(r.get("disposition") or "").upper()=="ANSWERED")
    return {
        "success": True,
        "generated_at": now_datetime().strftime('%Y-%m-%d %H:%M:%S'),
        "period": {"date_from": cstr(date_from), "date_to": cstr(date_to)},
        "shift_window_resolution": shift,
        "call_report_full_day": {"summary": calls.get("summary"), "pagination": calls.get("pagination"), "loaded_rows": len(rows), "answered_loaded": count_answered(rows), "first_error": calls.get("first_error")},
        "call_report_shift_filtered_loaded_rows": len(filtered),
        "call_report_shift_filtered_answered": count_answered(filtered),
        "call_report_shift_filtered_sample": filtered[:10],
        "employee_extension_map_sample": _employee_map()[:100],
        "email_debug": _email_debug(),
    }
PY

