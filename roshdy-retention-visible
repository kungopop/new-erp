.run_social_retention_now']));show(d)}async function clearAll(){let c=prompt('تحذير: سيتم حذف كل الشاتات والرسائل والكاش. اكتب DELETE_SOCIAL_CHATS للتأكيد');let d=await api(M(['restaurant','_ops.api.social_inbox','_api.clear_all_social_chats']),{confirm:c||''});show(d)}load();</script></body></html>
