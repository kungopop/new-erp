#!/usr/bin/env bash
set -Eeuo pipefail

# roshdy-retention-visible
# Rescue/force visible Social Retention controls for Administrator/System Manager.
# Adds a standalone System-Manager-only page: /social-retention-settings
# Also injects a dynamic panel into /social-settings that shows only if API confirms System Manager.

ROOT="/opt/frappe_crm"
SITE="crm.local"
APP_HOST="$ROOT/apps/restaurant_ops"
APP_DIR="$APP_HOST/restaurant_ops"
WWW_DIR="$APP_DIR/www"
TS="$(date +%Y%m%d_%H%M%S)"
BACKUP_DIR="$ROOT/backups/ROSHDY_RETENTION_VISIBLE_BEFORE_$TS"

say(){ echo -e "\n============================================================\n$1\n============================================================"; }

if [[ "${EUID:-$(id -u)}" -ne 0 ]]; then
  echo "❌ شغّل كـ root: sudo -i ثم ./roshdy-retention-visible"
  exit 1
fi

say "1) Backup"
cd "$ROOT"
BACKEND="$(docker compose ps -q backend || true)"
if [[ -z "$BACKEND" ]]; then
  echo "❌ لم أجد backend container. شغّل: cd /opt/frappe_crm && docker compose up -d"
  exit 1
fi
mkdir -p "$BACKUP_DIR"
cp -a "$APP_HOST" "$BACKUP_DIR/restaurant_ops"
echo "✅ Backup: $BACKUP_DIR"

say "2) Ensure retention setup/API exists"
mkdir -p "$APP_DIR/scripts" "$APP_DIR/api" "$WWW_DIR"
cat > "$APP_DIR/scripts/social_retention_setup_force.py" <<'PY'
import frappe
MODULE="Restaurant Operations"

def run():
    dt="Social Inbox Retention Settings"
    if not frappe.db.exists("DocType", dt):
        frappe.get_doc({
            "doctype":"DocType", "name":dt, "module":MODULE, "custom":0,
            "autoname":"field:settings_name", "naming_rule":"By fieldname", "title_field":"settings_name", "track_changes":1,
            "fields":[
                {"fieldname":"settings_name","label":"Settings Name","fieldtype":"Data","reqd":1,"unique":1,"default":"Default"},
                {"fieldname":"enable_auto_retention","label":"Enable Auto Retention","fieldtype":"Check","default":1},
                {"fieldname":"auto_archive_after_days","label":"Auto Archive After Inactive Days","fieldtype":"Int","default":7},
                {"fieldname":"delete_archived_after_days","label":"Delete Archived After Days","fieldtype":"Int","default":90},
                {"fieldname":"last_retention_run","label":"Last Retention Run","fieldtype":"Datetime","read_only":1},
                {"fieldname":"notes","label":"Notes","fieldtype":"Small Text"},
            ],
            "permissions":[{"role":"System Manager","read":1,"write":1,"create":1,"delete":1}],
        }).insert(ignore_permissions=True)
        print('✅ DocType created')
    if frappe.db.exists("DocType", "Social Conversation"):
        doc=frappe.get_doc("DocType","Social Conversation")
        for df in doc.fields:
            if df.fieldname=="status" and "Archived" not in (df.options or ""):
                df.options="Open\nPending\nClosed\nArchived"
                doc.save(ignore_permissions=True)
                print('✅ Social Conversation status patched')
                break
    frappe.db.commit()
    if not frappe.db.exists(dt,"Default"):
        frappe.get_doc({"doctype":dt,"settings_name":"Default","enable_auto_retention":1,"auto_archive_after_days":7,"delete_archived_after_days":90,"notes":"System Manager only"}).insert(ignore_permissions=True)
        frappe.db.commit()
        print('✅ Default settings created')
    print('✅ retention force setup complete')
PY
chmod 644 "$APP_DIR/scripts/social_retention_setup_force.py"

docker exec "$BACKEND" bench --site "$SITE" execute restaurant_ops.scripts.social_retention_setup_force.run

cat >> "$APP_DIR/api/social_inbox_api.py" <<'PY'

# ===== ROSHDY RETENTION VISIBLE FORCE API =====
def _rv_is_system_manager():
    try:
        user=frappe.session.user
        roles=set(frappe.get_roles(user))
        return user=="Administrator" or "System Manager" in roles
    except Exception:
        return False

def _rv_doc():
    dt="Social Inbox Retention Settings"
    if not frappe.db.exists("DocType",dt):
        return None
    if not frappe.db.exists(dt,"Default"):
        doc=frappe.get_doc({"doctype":dt,"settings_name":"Default","enable_auto_retention":1,"auto_archive_after_days":7,"delete_archived_after_days":90}).insert(ignore_permissions=True)
        frappe.db.commit()
        return doc
    return frappe.get_doc(dt,"Default")

@frappe.whitelist(allow_guest=False)
def retention_whoami():
    return {"success": True, "user": frappe.session.user, "roles": frappe.get_roles(frappe.session.user), "is_system_manager": _rv_is_system_manager()}

@frappe.whitelist(allow_guest=False)
def get_retention_settings():
    if not _rv_is_system_manager():
        return {"success": False, "message": "System Manager only"}
    doc=_rv_doc()
    if not doc:
        return {"success": False, "message": "Settings DocType not installed"}
    return {"success": True, "settings": doc.as_dict()}

@frappe.whitelist(allow_guest=False)
def save_retention_settings(enable_auto_retention=1, auto_archive_after_days=7, delete_archived_after_days=90):
    if not _rv_is_system_manager():
        return {"success": False, "message": "System Manager only"}
    doc=_rv_doc()
    archive_days=max(1,int(auto_archive_after_days or 7))
    delete_days=max(1,int(delete_archived_after_days or 90))
    if delete_days <= archive_days:
        return {"success": False, "message": "مدة حذف الأرشيف لازم تكون أكبر من مدة الأرشفة"}
    doc.enable_auto_retention=1 if int(enable_auto_retention or 0) else 0
    doc.auto_archive_after_days=archive_days
    doc.delete_archived_after_days=delete_days
    doc.save(ignore_permissions=True)
    frappe.db.commit()
    return {"success": True, "message": "تم حفظ إعدادات الأرشفة", "settings": doc.as_dict()}


def _rv_run_internal(force=False):
    doc=_rv_doc()
    if not doc:
        return {"success": False, "message": "Settings missing"}
    if not int(doc.enable_auto_retention or 0) and not force:
        return {"success": True, "message": "Auto retention disabled", "archived": 0, "deleted": 0}
    from frappe.utils import add_to_date, now_datetime
    archive_days=max(1,int(doc.auto_archive_after_days or 7))
    delete_days=max(1,int(doc.delete_archived_after_days or 90))
    archive_cutoff=add_to_date(now_datetime(), days=-archive_days)
    delete_cutoff=add_to_date(now_datetime(), days=-delete_days)
    archivable=frappe.db.sql("""
        select name from `tabSocial Conversation`
        where ifnull(status,'Open')!='Archived'
          and coalesce(last_message_at, modified, creation) <= %s
    """, (archive_cutoff,), as_dict=True)
    archived=0
    for r in archivable:
        frappe.db.set_value("Social Conversation", r.name, "status", "Archived", update_modified=False)
        archived+=1
    deletable=frappe.db.sql("""
        select name from `tabSocial Conversation`
        where status='Archived'
          and coalesce(last_message_at, modified, creation) <= %s
    """, (delete_cutoff,), as_dict=True)
    deleted=0
    for r in deletable:
        frappe.db.sql("delete from `tabSocial Message` where conversation=%s", (r.name,))
        frappe.db.sql("delete from `tabSocial Conversation` where name=%s", (r.name,))
        deleted+=1
    doc.last_retention_run=now_datetime()
    doc.save(ignore_permissions=True)
    frappe.db.commit()
    return {"success": True, "archived": archived, "deleted": deleted, "archive_cutoff": str(archive_cutoff), "delete_cutoff": str(delete_cutoff), "settings": doc.as_dict()}

@frappe.whitelist(allow_guest=False)
def run_social_retention_now():
    if not _rv_is_system_manager():
        return {"success": False, "message": "System Manager only"}
    return _rv_run_internal(force=True)

@frappe.whitelist(allow_guest=False)
def clear_all_social_chats(confirm=""):
    if not _rv_is_system_manager():
        return {"success": False, "message": "System Manager only"}
    if confirm != "DELETE_SOCIAL_CHATS":
        return {"success": False, "message": "للتأكيد اكتب DELETE_SOCIAL_CHATS"}
    before={}
    for dt in ["Social Message","Social Conversation","Customer Lookup Cache"]:
        try: before[dt]=frappe.db.count(dt)
        except Exception: before[dt]=None
    for table in ["tabSocial Message","tabSocial Conversation","tabCustomer Lookup Cache"]:
        try: frappe.db.sql(f"delete from `{table}`")
        except Exception: pass
    frappe.db.commit()
    after={}
    for dt in ["Social Message","Social Conversation","Customer Lookup Cache"]:
        try: after[dt]=frappe.db.count(dt)
        except Exception: after[dt]=None
    return {"success": True, "message": "تم حذف كل الشاتات والكاش", "before": before, "after": after}

def daily_retention_job():
    try: return _rv_run_internal(force=False)
    except Exception as e:
        try: frappe.log_error(str(e), "Social Inbox Retention Job Error")
        except Exception: pass
        return {"success": False, "message": str(e)}
PY
