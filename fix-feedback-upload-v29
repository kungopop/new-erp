# BEGIN ROSHDY FEEDBACK UPLOAD FIX V29
try:
    import base64 as _fb29_base64
    import csv as _fb29_csv
    import io as _fb29_io
    import json as _fb29_json
    import re as _fb29_re
    import frappe as _fb29_frappe
    from frappe.utils import today as _fb29_today, now_datetime as _fb29_now_datetime, cstr as _fb29_cstr
except Exception:
    pass


def _norm_phone(phone):
    """Normalize phone numbers imported from Excel.

    Excel often drops leading zero from Egyptian mobile numbers.
    Examples:
      1014434368  -> 01014434368
      1159174136  -> 01159174136
      1558539525  -> 01558539525
      502548189   -> 0502548189  (landline-like; best effort)
    """
    s = _fb29_cstr(phone or "").strip().replace("\xa0", "")
    # Convert floats like 1014434368.0
    if _fb29_re.match(r"^\d+\.0$", s):
        s = s[:-2]
    # Arabic/Persian digits are rare but support them.
    trans = str.maketrans("٠١٢٣٤٥٦٧٨٩۰۱۲۳۴۵۶۷۸۹", "01234567890123456789")
    s = s.translate(trans)
    # Keep plus if at beginning; remove spaces/dashes/brackets.
    plus = s.startswith("+")
    digits = _fb29_re.sub(r"\D+", "", s)
    if not digits:
        return ""
    if plus:
        return "+" + digits
    # Egypt mobile without leading zero after Excel numeric conversion.
    if len(digits) == 10 and digits[:2] in ("10", "11", "12", "15"):
        return "0" + digits
    # Egypt landline/area number without leading zero, best effort.
    if len(digits) == 9 and digits[:2] in ("2", "3", "40", "45", "46", "47", "48", "50", "55", "57", "62", "64", "65", "66", "68", "69", "82", "84", "86", "88", "92", "93", "95", "96", "97"):
        return "0" + digits
    return digits


def _looks_phone(s):
    digits = _fb29_re.sub(r"\D+", "", _fb29_cstr(s or ""))
    return len(digits) >= 7


def _fb29_cell_text(v):
    if v is None:
        return ""
    # Numeric Excel phone cells should not become scientific/float strings.
    try:
        if isinstance(v, float) and v.is_integer():
            return str(int(v))
    except Exception:
        pass
    return _fb29_cstr(v).strip()


def _find_header_map(headers):
    hmap = {}
    for i, h in enumerate(headers or []):
        key = _fb29_cell_text(h).lower().strip()
        if not key:
            continue
        if any(x in key for x in ("phone", "mobile", "tel", "number", "رقم", "موبايل", "تليفون", "هاتف", "تليفون العميل", "رقم العميل")):
            hmap.setdefault("phone", i)
        elif any(x in key for x in ("name", "customer", "client", "اسم", "عميل", "اسم العميل", "customer name")):
            hmap.setdefault("name", i)
    return hmap


def _parse_excel_bytes(content):
    """Parse xlsx/csv bytes. The extension does not matter."""
    rows = []
    # Try xlsx by content first.
    try:
        from openpyxl import load_workbook
        wb = load_workbook(filename=_fb29_io.BytesIO(content), read_only=True, data_only=True)
        ws = wb.active
        iterator = ws.iter_rows(values_only=True)
        try:
            first = next(iterator)
        except StopIteration:
            return []
        headers = list(first or [])
        hmap = _find_header_map(headers)
        data_iter = iterator if hmap.get("phone") is not None else iter([first] + list(iterator))
        for row in data_iter:
            vals = list(row or [])
            if hmap.get("phone") is not None:
                phone = vals[hmap["phone"]] if hmap["phone"] < len(vals) else ""
                name = vals[hmap.get("name")] if hmap.get("name") is not None and hmap.get("name") < len(vals) else ""
            else:
                phone = ""; name = ""
                for v in vals:
                    txt = _fb29_cell_text(v)
                    if _looks_phone(txt) and not phone:
                        phone = txt
                    elif txt and not name:
                        name = txt
            phone = _norm_phone(phone)
            name = _fb29_cell_text(name)
            if phone:
                rows.append({"customer_name": name, "customer_phone": phone})
        return rows
    except Exception:
        pass

    # CSV fallback.
    try:
        text = content.decode("utf-8-sig", errors="ignore")
        reader = _fb29_csv.reader(_fb29_io.StringIO(text))
        all_rows = list(reader)
        if not all_rows:
            return []
        hmap = _find_header_map(all_rows[0])
        data_rows = all_rows[1:] if hmap.get("phone") is not None else all_rows
        for row in data_rows:
            if hmap.get("phone") is not None:
                phone = row[hmap["phone"]] if hmap["phone"] < len(row) else ""
                name = row[hmap.get("name")] if hmap.get("name") is not None and hmap.get("name") < len(row) else ""
            else:
                phone = ""; name = ""
                for v in row:
                    if _looks_phone(v) and not phone:
                        phone = v
                    elif _fb29_cstr(v).strip() and not name:
                        name = v
            phone = _norm_phone(phone)
            if phone:
                rows.append({"customer_name": _fb29_cstr(name).strip(), "customer_phone": phone})
    except Exception:
        pass
    return rows


@_fb29_frappe.whitelist()
def upload_feedback_excel(feedback_date=None, shift_number=None, filedata=None, filename=None):
    """Upload Excel/CSV feedback list.

    Supports multipart file upload and base64 filedata fallback.
    """
    ensure_feedback_doctype()
    if not _is_admin():
        _fb29_frappe.throw("غير مسموح")
    feedback_date = _fb29_cstr(feedback_date or _fb29_frappe.form_dict.get("feedback_date") or _fb29_today())[:10]
    shift_number = _fb29_cstr(shift_number or _fb29_frappe.form_dict.get("shift_number") or "").strip()
    if not shift_number:
        _fb29_frappe.throw("رقم الوردية مطلوب قبل رفع الملف")

    content = None
    uploaded_name = filename or ""
    try:
        if _fb29_frappe.request and _fb29_frappe.request.files:
            f = _fb29_frappe.request.files.get("file") or next(iter(_fb29_frappe.request.files.values()))
            uploaded_name = getattr(f, "filename", "") or uploaded_name
            content = f.read()
    except Exception:
        content = None

    if content is None and filedata:
        raw = _fb29_cstr(filedata)
        if "," in raw and raw.split(",", 1)[0].startswith("data:"):
            raw = raw.split(",", 1)[1]
        content = _fb29_base64.b64decode(raw)

    if not content:
        _fb29_frappe.throw("ملف Excel/CSV مطلوب")

    rows = _parse_excel_bytes(content)
    if not rows:
        return {"success": False, "message": "لم يتم العثور على أرقام صالحة داخل الملف", "filename": uploaded_name, "parsed": 0}

    batch = "EXCEL-" + _fb29_now_datetime().strftime("%Y%m%d%H%M%S")
    created = skipped = 0
    errors = []
    samples = []
    for r in rows:
        try:
            res = _insert_item(r.get("customer_name"), r.get("customer_phone"), feedback_date, shift_number, source="excel", import_batch=batch, raw_payload=_fb29_json.dumps(r, ensure_ascii=False))
            if res.get("skipped_duplicate"):
                skipped += 1
            else:
                created += 1
            if len(samples) < 5:
                samples.append(r)
        except Exception as e:
            errors.append(_fb29_cstr(e))
    _fb29_frappe.db.commit()
    return {"success": True, "message": "تم رفع ملف الفيدباك", "filename": uploaded_name, "batch": batch, "parsed": len(rows), "created": created, "skipped_duplicates": skipped, "errors": errors[:20], "sample": samples}


@_fb29_frappe.whitelist()
def debug_feedback_upload_parser_sample():
    """Parser self-test using the same structure as user's Book1: headers name/phone."""
    from openpyxl import Workbook
    wb = Workbook()
    ws = wb.active
    ws.append(["name", "phone"])
    ws.append(["ا/ قمر محمود", 1014434368])
    ws.append(["ا/نورين احمد", 1026608655])
    ws.append(["ا/ امينه مصطفي", 502548189])
    bio = _fb29_io.BytesIO()
    wb.save(bio)
    rows = _parse_excel_bytes(bio.getvalue())
    return {"success": True, "parsed": len(rows), "rows": rows}
# END ROSHDY FEEDBACK UPLOAD FIX V29
