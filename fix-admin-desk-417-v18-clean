<script>
function qs(o){var p=new URLSearchParams();Object.keys(o||{}).forEach(function(k){var v=o[k];if(v!==undefined&&v!==null&&v!=="")p.append(k,v)});return p.toString()}
async function api(method,args){try{var q=qs(args||{});var r=await fetch('/api/method/'+method+(q?'?'+q:''),{method:'GET',credentials:'same-origin',cache:'no-store',headers:{'Accept':'application/json'}});var j=await r.json();if(j.exc)throw j;return j.message||j}catch(e){console.error(method,e);return null}}
