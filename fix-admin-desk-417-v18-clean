#!/usr/bin/env bash
set -Eeuo pipefail

# Roshdy V18: emergency clean rebuild for /admin-desk after V17 Step 4 caused 417.
# Scope:
# - Overwrites ONLY admin-desk.html with a clean static page.
# - Includes shift_number in cancellation form from the start; no injected script blocks.
# - Keeps cancellation full page /order-cancellations-report as-is.
# - Does NOT touch report_api.py / Elastix / CDR / AMI config.

ROOT="${ROOT:-/opt/frappe_crm}"
SITE="${SITE:-crm.local}"
APP="restaurant_ops"

cd "$ROOT"

if docker compose version >/dev/null 2>&1; then
  COMPOSE=(docker compose)
elif command -v docker-compose >/dev/null 2>&1; then
  COMPOSE=(docker-compose)
else
  echo "❌ docker compose/docker-compose مش موجود"
  exit 1
fi

APP_DIR="$ROOT/apps/$APP"
PKG_DIR="$APP_DIR/$APP"
WWW_DIR="$PKG_DIR/www"
ADMIN_HTML="$WWW_DIR/admin-desk.html"
TS="$(date +%Y%m%d_%H%M%S)"
BACKUP_DIR="$ROOT/backups/FIX_ADMIN_DESK_417_V18_BEFORE_$TS"
mkdir -p "$BACKUP_DIR"

BACKEND="$(${COMPOSE[@]} ps -q backend || true)"
if [[ -z "$BACKEND" ]]; then
  echo "❌ backend container مش شغال أو مش لاقيه"
  exit 1
fi

bench_exec() {
  "${COMPOSE[@]}" exec -T backend bench --site "$SITE" "$@"
}

echo "============================================================"
echo "🧯 Roshdy V18: Fix /admin-desk 417 with clean rebuild"
echo "📦 Backup: $BACKUP_DIR"
echo "============================================================"

[[ -f "$ADMIN_HTML" ]] && cp -a "$ADMIN_HTML" "$BACKUP_DIR/admin-desk.html.before"

cat > "$ADMIN_HTML" <<'HTML'
