APP_OWNER="$(stat -c '%u:%g' "$APP_DIR" 2>/dev/null || echo '')"
[[ -n "$APP_OWNER" ]] && chown "$APP_OWNER" "$QUEUE_API" "$UPPER_API" "$EMAIL_REPORT" "$PAGE_HTML" "$PAGE_PY" "$HOST_FETCH_SCRIPT" "$CONF_FILE" 2>/dev/null || true

echo "🧪 Step 7: Fetch journey now (if RUN_FETCH_NOW=1)"
FETCH_OK=0
if [[ "$RUN_FETCH_NOW" == "1" ]]; then
  set +e
  DATE_FROM="$(date +%F)" DATE_TO="$(date +%F)" "$HOST_FETCH_SCRIPT" 2>&1 | tee "$BACKUP_DIR/fetch_now_output.txt"
  FETCH_OK=${PIPESTATUS[0]}
  set -e
  if [[ $FETCH_OK -ne 0 ]]; then
    echo "⚠️ Fetch now failed. This is usually SSH/password/key issue. Install continues; API will use CDR fallback until JSON cache exists."
  fi
else
  echo "ℹ️ RUN_FETCH_NOW=0, skipped immediate SSH fetch."
fi

echo "🕒 Step 8: Install cron if SSH key works and INSTALL_CRON=1"
if [[ "$INSTALL_CRON" == "1" ]]; then
  if ssh -o BatchMode=yes -o ConnectTimeout=5 "$ELASTIX_SSH" "test -r '$QUEUE_LOG'" >/dev/null 2>&1; then
    cat > /etc/cron.d/roshdy_queue_journey <<EOF
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
*/$CRON_MINUTES * * * * root DATE_FROM=\$(date +\%F) DATE_TO=\$(date +\%F) $HOST_FETCH_SCRIPT >> $ROOT/logs/roshdy_queue_journey_cron.log 2>&1
EOF
    chmod 0644 /etc/cron.d/roshdy_queue_journey
    mkdir -p "$ROOT/logs"
    echo "✅ Cron installed: /etc/cron.d/roshdy_queue_journey"
  else
    echo "⚠️ SSH key/BachMode to $ELASTIX_SSH is not ready; cron not installed."
    echo "   Manual fetch works with password: $HOST_FETCH_SCRIPT"
    echo "   For cron, setup SSH key from ERP root to Elastix root."
  fi
else
  echo "ℹ️ INSTALL_CRON=0, skipped cron."
fi

echo "🧹 Step 9: Clear cache + restart app services"
bench_exec clear-cache || true
"${COMPOSE[@]}" restart backend frontend websocket queue-short queue-long scheduler >/dev/null
sleep 8
bench_exec clear-cache || true

echo "🧪 Step 10: Validation"
set +e
for p in queue-journey-report admin-desk email-report-customizer call-report; do
  code="$(curl -k -s -o /dev/null -w '%{http_code}' "http://127.0.0.1/$p" 2>/dev/null || echo 000)"
  echo "$p => $code" | tee -a "$BACKUP_DIR/page_smoke_checks_v20.txt"
done
bench_exec execute restaurant_ops.api.queue_journey_api.debug_queue_journey_status | tee "$BACKUP_DIR/debug_queue_journey_status.txt"
V1=${PIPESTATUS[0]}
bench_exec execute restaurant_ops.api.queue_journey_api.get_queue_journey_report | tee "$BACKUP_DIR/get_queue_journey_report.txt"
V2=${PIPESTATUS[0]}
bench_exec execute restaurant_ops.api.upper_management_email_api.verify_queue_journey_in_upper_email | tee "$BACKUP_DIR/verify_queue_journey_in_upper_email.txt"
V3=${PIPESTATUS[0]}
bench_exec execute restaurant_ops.api.email_report.debug_center_queue_journey_section | tee "$BACKUP_DIR/debug_center_queue_journey_section.txt"
V4=${PIPESTATUS[0]}
set -e

if [[ $V1 -ne 0 || $V2 -ne 0 || $V3 -ne 0 || $V4 -ne 0 ]]; then
  echo "❌ Validation failed. راجع: $BACKUP_DIR"
  exit 1
fi

echo "🏥 Step 11: Health Check - Elastix/CDR/AMI + Queue + Call Report"
set +e
bench_exec execute restaurant_ops.api.asterisk_bridge.run_full_system_diagnostics | tee "$BACKUP_DIR/health_asterisk_bridge.txt"
H1=${PIPESTATUS[0]}
bench_exec execute restaurant_ops.api.queue_api.get_queue_status | tee "$BACKUP_DIR/health_queue_status.txt"
