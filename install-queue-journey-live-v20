mkdir -p "$RUN_DIR" "$OUT_BASE"

echo "[$(date '+%F %T')] Fetching queue_log from $ELASTIX_SSH:$QUEUE_LOG for $DATE_FROM..$DATE_TO queues=$QUEUES threshold=$THRESHOLD max_lines=$MAX_LINES"

if [[ -n "${LOCAL_QUEUE_LOG:-}" && -f "$LOCAL_QUEUE_LOG" ]]; then
  if [[ "$MAX_LINES" == "0" ]]; then
    cat "$LOCAL_QUEUE_LOG" > "$TMP_LOG"
  else
    tail -n "$MAX_LINES" "$LOCAL_QUEUE_LOG" > "$TMP_LOG"
  fi
else
  if [[ "$MAX_LINES" == "0" ]]; then
    ssh -o ConnectTimeout=10 "$ELASTIX_SSH" "cat '$QUEUE_LOG'" > "$TMP_LOG"
  else
    ssh -o ConnectTimeout=10 "$ELASTIX_SSH" "tail -n '$MAX_LINES' '$QUEUE_LOG'" > "$TMP_LOG"
  fi
fi

python3 - "$TMP_LOG" "$DATE_FROM" "$DATE_TO" "$QUEUES" "$THRESHOLD" "$RUN_DIR" <<'PY'
import sys, os, re, json, csv, datetime, time
from collections import defaultdict, Counter

log_path, date_from, date_to, queues_s, threshold_s, run_dir = sys.argv[1:7]
queues = {q.strip() for q in queues_s.split(',') if q.strip()}
threshold = float(threshold_s or 15)
start = int(time.mktime(datetime.datetime.strptime(date_from+' 00:00:00', '%Y-%m-%d %H:%M:%S').timetuple()))
end = int(time.mktime(datetime.datetime.strptime(date_to+' 23:59:59', '%Y-%m-%d %H:%M:%S').timetuple()))
interesting = {'DID','ENTERQUEUE','RINGNOANSWER','RINGCANCELED','AGENTDUMP','CONNECT','COMPLETECALLER','COMPLETEAGENT','ABANDON','EXITWITHTIMEOUT','EXITEMPTY','EXITWITHKEY','TRANSFER'}

def ext_from_agent(agent):
    agent = str(agent or '')
    for pat in (r'(?:Local|SIP|PJSIP|Agent)/(\d{3,6})', r'^(\d{3,6})$', r'\b(\d{3,6})\b'):
        m = re.search(pat, agent, re.I)
        if m and m.group(1) not in ('123','1234'):
            return m.group(1)
    return ''

def ts_text(t):
    return datetime.datetime.fromtimestamp(int(t)).strftime('%Y-%m-%d %H:%M:%S')

def caller_from(evs):
    for e in evs:
        if e['event'] == 'ENTERQUEUE':
            for d in e.get('data') or []:
                if re.search(r'\d{5,}', d or ''):
                    return d
    return ''

rows=[]; counts=Counter(); by_queue=defaultdict(Counter)
with open(log_path, 'r', errors='ignore') as f:
    for line in f:
        line=line.rstrip('\n')
        if not line: continue
        parts=line.split('|')
        if len(parts)<5: continue
        try: t=int(float(parts[0]))
        except Exception: continue
        if not (start <= t <= end): continue
        callid, queue, agent, event = parts[1], parts[2], parts[3], parts[4]
        if queues and queue not in queues: continue
        counts[event]+=1; by_queue[queue][event]+=1
        if event not in interesting: continue
        rows.append({'time_epoch':t,'time_text':ts_text(t),'callid':callid,'queue':queue,'agent':agent,'agent_ext':ext_from_agent(agent),'event':event,'data':parts[5:],'raw':line})

by_call=defaultdict(list)
for r in rows: by_call[r['callid']].append(r)
for cid in by_call: by_call[cid].sort(key=lambda x:x['time_epoch'])

attempts=[]; call_summaries=[]
for cid, evs in by_call.items():
    caller=caller_from(evs)
    connects=[e for e in evs if e['event']=='CONNECT']
    abandons=[e for e in evs if e['event']=='ABANDON']
    completes=[e for e in evs if e['event'] in ('COMPLETECALLER','COMPLETEAGENT')]
    if connects:
        final='answered'; final_ext=connects[-1].get('agent_ext') or ''
    elif abandons:
        final='customer_abandoned_before_answer'; final_ext=''
    elif completes:
        final='completed_but_connect_missing'; final_ext=''
    else:
        final='unknown_or_still_in_queue'; final_ext=''
    call_summaries.append({'callid':cid,'caller':caller,'queue':evs[0]['queue'] if evs else '','events_count':len(evs),'events':[e['event'] for e in evs],'final_outcome':final,'final_extension':final_ext})
    for i,e in enumerate(evs):
        if e['event'] not in ('RINGNOANSWER','RINGCANCELED','AGENTDUMP'): continue
        missed_ext=e.get('agent_ext') or ''
        if not missed_ext: continue
        raw=(e.get('data') or [''])[0] if e.get('data') else ''
        try:
            # Asterisk queue_log RINGNOANSWER duration is milliseconds.
            ring_seconds=round(float(raw or 0)/1000.0, 1)
        except Exception:
            ring_seconds=0
        if ring_seconds < threshold: continue
        later=evs[i+1:]
        conn=next((x for x in later if x['event']=='CONNECT'), None)
        aban=next((x for x in later if x['event']=='ABANDON'), None)
        comp=next((x for x in later if x['event'] in ('COMPLETECALLER','COMPLETEAGENT')), None)
        tout=next((x for x in later if x['event'] in ('EXITWITHTIMEOUT','EXITEMPTY','EXITWITHKEY')), None)
        if conn:
            ans_ext=conn.get('agent_ext') or ''
            fate='answered_later_same_extension' if ans_ext==missed_ext else 'answered_later_other_extension'
            fate_time=conn['time_text']
        elif aban:
            ans_ext=''; fate='customer_abandoned_after_attempt'; fate_time=aban['time_text']
        elif comp:
            ans_ext=''; fate='completed_after_attempt_connect_missing'; fate_time=comp['time_text']
        elif tout:
            ans_ext=''; fate='timeout_after_attempt_no_final_connect_seen'; fate_time=tout['time_text']
        else:
            ans_ext=''; fate='unknown_after_attempt'; fate_time=''
        attempts.append({'attempt_time':e['time_text'],'callid':cid,'queue':e['queue'],'caller':caller,'missed_extension':missed_ext,'missed_event':e['event'],'ring_seconds':ring_seconds,'fate':fate,'fate_time':fate_time,'answered_extension':ans_ext,'final_outcome_for_call':final,'raw_data':e.get('data') or []})

by_ext=defaultdict(lambda:{'extension':'','attempts':0,'answered_later_same_extension':0,'answered_later_other_extension':0,'customer_abandoned_after_attempt':0,'timeout_no_final_connect':0,'unknown':0})
for a in attempts:
    row=by_ext[a['missed_extension']]
    row['extension']=a['missed_extension']; row['attempts']+=1
    if a['fate'] in ('answered_later_same_extension','answered_later_other_extension'):
        row[a['fate']]+=1
    elif a['fate']=='customer_abandoned_after_attempt': row['customer_abandoned_after_attempt']+=1
    elif a['fate']=='timeout_after_attempt_no_final_connect_seen': row['timeout_no_final_connect']+=1
    else: row['unknown']+=1

attempts_by_fate=dict(Counter(a['fate'] for a in attempts))
answered_later=sum(v for k,v in attempts_by_fate.items() if k.startswith('answered_later'))
summary={'success':True,'generated_at':datetime.datetime.now().strftime('%Y-%m-%d %H:%M:%S'),'date_from':date_from,'date_to':date_to,'queues':sorted(queues),'threshold_seconds':threshold,'events_loaded':len(rows),'event_counts':dict(counts),'event_counts_by_queue':{q:dict(c) for q,c in by_queue.items()},'calls_seen':len(by_call),'attempts_total':len(attempts),'answered_later_total':answered_later,'customer_abandoned_after_attempt':attempts_by_fate.get('customer_abandoned_after_attempt',0),'unknown_or_timeout':attempts_by_fate.get('unknown_after_attempt',0)+attempts_by_fate.get('timeout_after_attempt_no_final_connect_seen',0)+attempts_by_fate.get('completed_after_attempt_connect_missing',0),'attempts_by_fate':attempts_by_fate,'attempts_by_missed_extension':sorted(by_ext.values(), key=lambda x:x['attempts'], reverse=True),'attempts':attempts,'call_journey_samples':call_summaries[:300],'can_determine_journey':True}

json_path=os.path.join(run_dir,'queue_journey_result.json')
open(json_path,'w',encoding='utf-8').write(json.dumps(summary,ensure_ascii=False,indent=2))
with open(os.path.join(run_dir,'queue_journey_attempts.csv'),'w',newline='',encoding='utf-8-sig') as f:
    headers=['attempt_time','queue','caller','missed_extension','ring_seconds','fate','answered_extension','fate_time','callid','final_outcome_for_call']
    w=csv.DictWriter(f,fieldnames=headers); w.writeheader()
    for a in attempts: w.writerow({k:a.get(k,'') for k in headers})
with open(os.path.join(run_dir,'queue_journey_summary.txt'),'w',encoding='utf-8') as f:
    f.write('Date: %s to %s\n' % (date_from,date_to))
    f.write('Threshold seconds: %s\n' % threshold)
    f.write('Queues: %s\n' % ','.join(sorted(queues)))
    f.write('Events loaded: %s\n' % len(rows))
    f.write('Event counts: %s\n' % dict(counts))
    f.write('Calls seen: %s\n' % len(by_call))
    f.write('Attempts total: %s\n' % len(attempts))
    f.write('Answered later total: %s\n' % answered_later)
    f.write('Customer abandoned after attempt: %s\n' % attempts_by_fate.get('customer_abandoned_after_attempt',0))
    f.write('Unknown/timeout: %s\n' % summary['unknown_or_timeout'])
    f.write('Attempts by fate: %s\n\n' % attempts_by_fate)
    f.write('By missed extension:\n')
    for r in summary['attempts_by_missed_extension']: f.write(str(r)+'\n')
    f.write('\nFirst 30 attempts:\n')
    for a in attempts[:30]: f.write(str(a)+'\n')
print(json_path)
PY

