#!/usr/bin/env bash
set -Eeuo pipefail

# Roshdy V20 - LIVE Queue Journey integration
# ------------------------------------------------------------
# What this installs:
# 1) Host fetch/parser script that pulls /var/log/asterisk/queue_log from Elastix via SSH,
#    parses missed employee attempts, and writes JSON into Frappe private files.
# 2) Frappe API: restaurant_ops.api.queue_journey_api
#    - get_queue_journey_report
#    - debug_queue_journey_status
# 3) Full page: /queue-journey-report
# 4) Upper Management email integration with journey summary:
#    - total missed attempts
#    - answered later
#    - customer abandoned after attempt
#    - details with employee/extension names
# 5) Customer Service Manager email missed-attempt section fixed to use the same journey source.
#
# Safety:
# - Backup first.
# - Does NOT edit restaurant_ops.api.report_api.
# - Does NOT touch Elastix/Asterisk configs, CDR, AMI.
# - Host parser reads queue_log over SSH only.
#
# Usage:
#   cd /opt/frappe_crm
#   chmod +x install-queue-journey-live-v20
#   ./install-queue-journey-live-v20
#
# Optional:
#   ELASTIX_SSH=root@10.11.1.253 ./install-queue-journey-live-v20
#   RUN_FETCH_NOW=0 ./install-queue-journey-live-v20
#   INSTALL_CRON=0 ./install-queue-journey-live-v20

ROOT="${ROOT:-/opt/frappe_crm}"
SITE="${SITE:-crm.local}"
APP="restaurant_ops"
ELASTIX_SSH="${ELASTIX_SSH:-root@10.11.1.253}"
QUEUE_LOG="${QUEUE_LOG:-/var/log/asterisk/queue_log}"
QUEUES="${QUEUES:-1234,123}"
THRESHOLD="${THRESHOLD:-15}"
MAX_LINES="${MAX_LINES:-500000}"
RUN_FETCH_NOW="${RUN_FETCH_NOW:-1}"
INSTALL_CRON="${INSTALL_CRON:-1}"
CRON_MINUTES="${CRON_MINUTES:-5}"
TS="$(date +%Y%m%d_%H%M%S)"

cd "$ROOT"

if docker compose version >/dev/null 2>&1; then
  COMPOSE=(docker compose)
elif command -v docker-compose >/dev/null 2>&1; then
  COMPOSE=(docker-compose)
else
  echo "❌ docker compose/docker-compose مش موجود"
  exit 1
fi

APP_DIR="$ROOT/apps/$APP"
PKG_DIR="$APP_DIR/$APP"
API_DIR="$PKG_DIR/api"
WWW_DIR="$PKG_DIR/www"
SCRIPTS_DIR="$ROOT/scripts"
APP_SCRIPTS_DIR="$PKG_DIR/scripts"
SITES_DIR="$ROOT/sites"
PRIVATE_FILES="$SITES_DIR/$SITE/private/files"
JOURNEY_DIR="$PRIVATE_FILES/queue_journey"
HOST_FETCH_SCRIPT="$SCRIPTS_DIR/roshdy_queue_journey_fetch_parse"
CONF_FILE="$ROOT/queue_journey.conf"
UPPER_API="$API_DIR/upper_management_email_api.py"
EMAIL_REPORT="$API_DIR/email_report.py"
QUEUE_API="$API_DIR/queue_journey_api.py"
PAGE_HTML="$WWW_DIR/queue-journey-report.html"
PAGE_PY="$WWW_DIR/queue-journey-report.py"
BACKUP_DIR="$ROOT/backups/QUEUE_JOURNEY_LIVE_V20_BEFORE_$TS"

mkdir -p "$BACKUP_DIR" "$SCRIPTS_DIR" "$APP_SCRIPTS_DIR" "$JOURNEY_DIR"

BACKEND="$(${COMPOSE[@]} ps -q backend || true)"
if [[ -z "$BACKEND" ]]; then
  echo "❌ backend container مش شغال أو مش لاقيه"
  exit 1
fi

bench_exec() {
  "${COMPOSE[@]}" exec -T backend bench --site "$SITE" "$@"
}

echo "============================================================"
echo "🚀 Roshdy V20: LIVE Queue Journey integration"
echo "📦 Backup: $BACKUP_DIR"
echo "🔐 Elastix SSH: $ELASTIX_SSH"
echo "☎️ Queues: $QUEUES"
echo "⏱️ Threshold: $THRESHOLD seconds"
echo "============================================================"

echo "🧯 Step 1: Backup files + bench backup"
for f in "$UPPER_API" "$EMAIL_REPORT" "$QUEUE_API" "$PAGE_HTML" "$PAGE_PY" "$HOST_FETCH_SCRIPT" "$CONF_FILE"; do
  [[ -e "$f" ]] && cp -a "$f" "$BACKUP_DIR/$(basename "$f").before" || true
done
bench_exec backup --with-files | tee "$BACKUP_DIR/bench_backup_output.txt"

cat > "$CONF_FILE" <<EOF
# Roshdy Queue Journey config
ROOT="$ROOT"
SITE="$SITE"
ELASTIX_SSH="$ELASTIX_SSH"
QUEUE_LOG="$QUEUE_LOG"
QUEUES="$QUEUES"
THRESHOLD="$THRESHOLD"
MAX_LINES="$MAX_LINES"
EOF

echo "🧩 Step 2: Install host fetch/parser script"
cat > "$HOST_FETCH_SCRIPT" <<'PYHOST'
