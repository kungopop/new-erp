set -Eeuo pipefail

CONF_FILE="${CONF_FILE:-/opt/frappe_crm/queue_journey.conf}"
[[ -f "$CONF_FILE" ]] && source "$CONF_FILE"

ROOT="${ROOT:-/opt/frappe_crm}"
SITE="${SITE:-crm.local}"
ELASTIX_SSH="${ELASTIX_SSH:-root@10.11.1.253}"
QUEUE_LOG="${QUEUE_LOG:-/var/log/asterisk/queue_log}"
QUEUES="${QUEUES:-1234,123}"
THRESHOLD="${THRESHOLD:-15}"
MAX_LINES="${MAX_LINES:-500000}"
DATE_FROM="${DATE_FROM:-$(date +%F)}"
DATE_TO="${DATE_TO:-$DATE_FROM}"
OUT_BASE="$ROOT/sites/$SITE/private/files/queue_journey"
RUN_ID="$(date +%Y%m%d_%H%M%S)"
RUN_DIR="$OUT_BASE/runs/$RUN_ID"
