min-desk">Admin Desk</a></div></div><div class="wrap"><div class="panel"><div class="head"><b>الفلاتر</b><span class="muted" id="cache"></span></div><div class="body"><div class="grid"><div><label>من تاريخ</label><input type="date" id="df"></div><div><label>إلى تاريخ</label><input type="date" id="dt"></div><div><label>الطوابير</label><input id="queues" value="1234,123"></div><div><label>أقل مدة رن بالثواني</label><input id="threshold" value="15"></div><div><label>إخفاء أرقام العملاء</label><select id="mask"><option value="0">لا</option><option value="1">نعم</option></select></div><div style="align-self:end"><button class="btn green" onclick="load()">تحديث</button><button class="btn orange" onclick="window.print()">PDF/طباعة</button><button class="btn" onclick="csv()">CSV</button></div></div></div></div><div class="cards"><div class="card orangeb">محاولات لم يرد عليها<div class="num" id="total">0</div></div><div class="card greenb">تم الرد لاحقًا<div class="num" id="answered">0</div></div><div class="card red">العميل أغلق بعدها<div class="num" id="abandoned">0</div></div><div class="card">غير محدد<div class="num" id="unknown">0</div></div></div><br><div class="panel"><div class="head"><b>حسب التحويلة</b></div><div class="body scroll"><table class="table"><thead><tr><th>التحويلة</th><th>الموظف</th><th>المحاولات</th><th>تم الرد لاحقًا</th><th>العميل أغلق بعدها</th><th>غير محدد</th></tr></thead><tbody id="byext"></tbody></table></div></div><div class="panel"><div class="head"><b>التفاصيل</b></div><div class="body scroll"><table class="table"><thead><tr><th>الوقت</th><th>الطابور</th><th>رقم العميل</th><th>لم يرد</th><th>التحويلة</th><th>مدة الرن</th><th>مصير المحاولة</th><th>تم الرد لاحقًا بواسطة</th><th>وقت المصير</th></tr></thead><tbody id="rows"></tbody></table></div></div></div><script>let last=null;function today(){return new Date().toISOString().slice(0,10)}function esc(s){return String(s||'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}function qs(o){let p=new URLSearchParams();Object.keys(o||{}).forEach(k=>{let v=o[k];if(v!==undefined&&v!==null&&v!=='')p.append(k,v)});return p.toString()}async function api(m,args){let q=qs(args||{});let r=await fetch('/api/method/'+m+(q?'?'+q:''),{method:'GET',credentials:'same-origin',cache:'no-store'});let j=await r.json();if(j.exc)throw j;return j.message||j}async function load(){last=await api('restaurant_ops.api.queue_journey_api.get_queue_journey_report',{date_from:df.value,date_to:dt.value,threshold:threshold.value,queues:queues.value,mask_phones:mask.value,limit_rows:1000});let s=last.summary||{};total.textContent=s.attempts_total||0;answered.textContent=s.answered_later_total||0;abandoned.textContent=s.customer_abandoned_after_attempt||0;unknown.textContent=s.unknown_or_timeout||0;cache.textContent=(last.journey_available?'Journey source: ':'Fallback source: ')+(last.cache_source||last.source||'');byext.innerHTML=(s.attempts_by_missed_extension||[]).map(x=>'<tr><td>'+esc(x.extension)+'</td><td>'+esc(x.employee)+'</td><td>'+esc(x.attempts)+'</td><td>'+esc(x.answered_later)+'</td><td>'+esc(x.customer_abandoned_after_attempt)+'</td><td>'+esc(x.unknown_or_timeout)+'</td></tr>').join('')||'<tr><td colspan="6" style="text-align:center;color:#64748b">لا توجد بيانات</td></tr>';rows.innerHTML=(last.rows||[]).map(r=>'<tr><td>'+esc(r.attempt_time)+'</td><td>'+esc(r.queue)+'</td><td>'+esc(r.caller)+'</td><td>'+esc(r.missed_employee)+'</td><td>'+esc(r.missed_extension)+'</td><td>'+esc(r.ring_seconds)+'</td><td>'+esc(r.fate_label)+'</td><td>'+esc(r.answered_employee||r.answered_extension)+'</td><td>'+esc(r.fate_time)+'</td></tr>').join('')||'<tr><td colspan="9" style="text-align:center;color:#64748b">لا توجد محاولات</td></tr>'}function csv(){if(!last)return;let headers=['time','queue','caller','missed_employee','missed_extension','ring_seconds','fate','answered_by','fate_time'];let lines=[headers.join(',')].concat((last.rows||[]).map(r=>[r.attempt_time,r.queue,r.caller,r.missed_employee,r.missed_extension,r.ring_seconds,r.fate_label,r.answered_employee||r.answered_extension,r.fate_time].map(x=>'"'+String(x||'').replace(/"/g,'""')+'"').join(',')));let blob=new Blob(['\ufeff'+lines.join('\n')],{type:'text/csv;charset=utf-8'});let a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='queue-journey.csv';a.click()}df.value=today();dt.value=today();load();</script></body></html>
